  background: transparent;
}

.login-field input::placeholder {
  color: var(--bp-grey-o);
}

.checkbox-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 10px 0 18px 0;
}

.checkbox-row input[type="checkbox"] {
  width: 18px;
  height: 18px;
}

.login-btn {
  margin-top: 40px;
  width: 100%;
  padding: 12px 16px;
  border-radius: 10px;
  border: none;
  font-weight: 700;
  font-size: 15px;
  cursor: pointer;
  background: linear-gradient(90deg, var(--bp-yellow-a), var(--bp-yellow-a));
  color: var(--bp-blue-expert);
  background-color: var(--bp-yellow-opt);
  transition: opacity 0.2s ease;
}

.login-btn:hover:not(:disabled) {
  opacity: 0.9;
}

.login-btn:disabled,
.login-btn.disabled {
  opacity: 0.6;
  cursor: not-allowed;
  background-color: var(--bp-grey-l);
}

.loading {
  display: block;
  margin: 8px auto;
  height: 30px;
}

.div-error {
  background-color: var(--bp-white);
  border: 1px solid var(--bp-red-light);
  border-radius: 5px;
  padding: 10px;
  width: 100%;
  height: 50px;
  box-shadow: -3px 0px 0px 0px var(--bp-red);
}

.label-error {
  color: var(--bp-red);
  width: 100%;
  height: 50px;
  font-size: 12px;
}

