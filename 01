import { Fragment } from "react";
import { Link } from "react-router-dom";
import { Menu } from "lucide-react";
import styles from "./Navbar.module.css";

export function Navbar({
  user = { name: "Pamela Suazo", role: "Administrador", initials: "PS" },
  crumbs = [],
  onMenuClick,
}) {
  return (
    <header className={styles.header}>
      <div className={styles.brandGroup}>
        <button
          type="button"
          className={styles.iconBtn}
          onClick={onMenuClick}
          aria-label="Mostrar u ocultar menú"
        >
          <Menu size={20} />
        </button>

        <Link to="/home" className={styles.brand}>
          <div className={styles.logo}>eC</div>
          <span className={styles.brandName}>
            <span className={styles.brandE}>e</span>Coaching
          </span>
        </Link>

        {crumbs.length > 0 && (
          <nav className={styles.breadcrumb} aria-label="Ruta actual">
            {crumbs.map((c, i) => (
              <Fragment key={c.to}>
                <span className={styles.separator}>/</span>
                {i < crumbs.length - 1 ? (
                  <Link to={c.to} className={styles.crumbLink}>{c.label}</Link>
                ) : (
                  <span className={styles.currentPage}>{c.label}</span>
                )}
              </Fragment>
            ))}
          </nav>
        )}
      </div>

      <div className={styles.actions}>
        <div className={styles.userGroup}>
          <div className={styles.userMeta}>
            <div className={styles.userName}>{user.name}</div>
            <span className={styles.rolePill}>{user.role}</span>
          </div>
          <div className={styles.avatar}>{user.initials}</div>
        </div>
      </div>
    </header>
  );
}