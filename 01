.header {
  height: 80px;
  background: var(--bp-blue-expert);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20px;
  position: sticky;
  top: 0;
  z-index: 50;
  border-bottom: 3px solid var(--bp-yellow-opt);
}

.brandGroup { display: flex; align-items: center; gap: 14px; }
.brand { display: flex; align-items: center; gap: 10px; }

.logo {
  width: 32px; height: 32px; border-radius: 8px; background: var(--bp-yellow-opt);
  display: flex; align-items: center; justify-content: center;
  font-weight: 800; color: var(--bp-blue-expert); font-size: 14px;
}
.brandName { color: #fff; font-weight: 700; font-size: 30px; letter-spacing: -0.01em; }

.search { flex: 1; max-width: 420px; margin: 0 24px; position: relative; }
.searchIcon { position: absolute; left: 12px; top: 10px; color: rgba(255,255,255,0.55); }
.searchInput {
  width: 100%; height: 36px; background: rgba(255,255,255,0.1);
  border: 1px solid rgba(255,255,255,0.16); border-radius: 8px;
  color: #fff; font-size: 13.5px; padding: 0 12px 0 36px; outline: none;
}
.searchInput::placeholder { color: rgba(255,255,255,0.55); }

.actions { display: flex; align-items: center; gap: 6px; }

.iconBtn {
  display: inline-flex; align-items: center; justify-content: center;
  width: 36px; height: 36px; border-radius: 6px; border: none;
  background: transparent; color: #fff; cursor: pointer;
}
.iconBtn:hover { background: rgba(255,255,255,0.08); }

.menuBtn { display: none; }

.userGroup {
  display: flex; align-items: center; gap: 10px; margin-left: 8px;
  padding-left: 12px; border-left: 1px solid rgba(255,255,255,0.16);
}
.userMeta { text-align: right; }
.userName { color: #fff; font-size: 13.5px; font-weight: 700; }
.userRole { color: var(--bp-yellow-light); font-size: 11.5px; font-weight: 700; }

.avatar {
  width: 34px; height: 34px; border-radius: 50%; background: var(--bp-blue-digital);
  display: flex; align-items: center; justify-content: center;
  font-weight: 800; font-size: 13px; color: var(--bp-blue-expert);
}

@media (max-width: 860px) {
  .menuBtn { display: inline-flex; }
  .userMeta { display: none; }
}




