import { Link } from "react-router-dom";
import { ArrowRight } from "lucide-react";
import styles from "./NavCard.module.css";

export function CardGrid({ children }) {
  return <div className={styles.grid}>{children}</div>;
}

export function NavCard({ to, icon: Icon, title, description, meta, disabled = false }) {
  const content = (
    <>
      <div className={styles.iconWrap}>
        <Icon size={24} strokeWidth={2} />
      </div>
      <div>
        <h3 className={styles.title}>{title}</h3>
        {description && <p className={styles.description}>{description}</p>}
      </div>
      <div className={styles.footer}>
        <span className={disabled ? styles.soon : undefined}>{meta}</span>
        {!disabled && <ArrowRight size={18} className={styles.arrow} />}
      </div>
    </>
  );

  if (disabled) {
    return (
      <div className={`${styles.card} ${styles.disabled}`} aria-disabled="true">
        {content}
      </div>
    );
  }

  return (
    <Link to={to} className={styles.card}>
      {content}
    </Link>
  );
}