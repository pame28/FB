<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;800&display=swap" rel="stylesheet" />




import { Menu } from "lucide-react";
import styles from "./Navbar.module.css";

/**
 * <Navbar
 *   user={{ name, role, initials }}
 *   currentPage="Mantenimiento"
 *   onMenuClick={() => {}}
 * />
 */
export function Navbar({
  user = { name: "Pamela Suazo", role: "Administrador", initials: "PS" },
  currentPage,
  onMenuClick,
}) {
  return (
    <header className={styles.header}>
      <div className={styles.brandGroup}>
        <button className={`${styles.iconBtn} ${styles.menuBtn}`} onClick={onMenuClick}>
          <Menu size={20} />
        </button>

        <div className={styles.brand}>
          <div className={styles.logo}>eC</div>
          <span className={styles.brandName}>
            <span className={styles.brandE}>e</span>Coaching
          </span>
        </div>

        {currentPage && (
          <nav className={styles.breadcrumb} aria-label="Ruta actual">
            <span className={styles.separator}>/</span>
            <span className={styles.currentPage}>{currentPage}</span>
          </nav>
        )}
      </div>

      <div className={styles.actions}>
        <div className={styles.userGroup}>
          <div className={styles.userMeta}>
            <div className={styles.userName}>{user.name}</div>
            <span className={styles.rolePill}>{user.role}</span>
          </div>
          <div className={styles.avatar}>{user.initials}</div>
        </div>
      </div>
    </header>
  );
}







/* ---- Logo ---- */
.brandName {
  font-family: "Sora", system-ui, sans-serif;
  color: #fff;
  font-weight: 800;
  font-size: 24px;
  letter-spacing: -0.04em;
  line-height: 1;
}
.brandE {
  font-weight: 400;          /* la "e" más ligera le da el toque de logo */
  color: var(--bp-yellow-opt);
}

/* ---- Ruta / breadcrumb ---- */
.breadcrumb {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-left: 4px;
}
.separator {
  color: rgba(255, 255, 255, 0.25);
  font-size: 20px;
  font-weight: 300;
}
.currentPage {
  font-family: "Sora", system-ui, sans-serif;
  color: rgba(255, 255, 255, 0.65);
  font-size: 15px;
  font-weight: 600;
}

/* ---- Rol encapsulado (debajo del nombre) ---- */
.userMeta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
}
.rolePill {
  display: inline-block;
  padding: 2px 10px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
  color: var(--bp-yellow-light);
  background: color-mix(in srgb, var(--bp-yellow-opt) 15%, transparent);
  border: 1px solid color-mix(in srgb, var(--bp-yellow-opt) 45%, transparent);
  white-space: nowrap;
}

/* ---- Responsive ---- */
@media (max-width: 860px) {
  .menuBtn { display: inline-flex; }
  .userMeta { display: none; }
}
@media (max-width: 600px) {
  .breadcrumb { display: none; }
}