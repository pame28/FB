const FORM_ID = "catalog-form";

// "Name" (backend) → "name" (formulario)
const mapApiErrors = (errors = {}) =>
  Object.fromEntries(
    Object.entries(errors).map(([key, msg]) => [key.charAt(0).toLowerCase() + key.slice(1), msg])
  );

const toValues = (fields, item) =>
  Object.fromEntries(fields.map((f) => [f.name, item?.[f.name] ?? ""]));

const validate = (fields, values, items, currentId) => {
  const errors = {};

  fields.forEach((f) => {
    const value = String(values[f.name] ?? "").trim();

    if (f.required && !value) {
      errors[f.name] = `${f.label} es obligatorio.`;
      return;
    }

    if (f.type === "number" && value && (!Number.isInteger(Number(value)) || Number(value) < 0)) {
      errors[f.name] = `${f.label} debe ser un número entero positivo.`;
      return;
    }

    // Duplicados: compara sin tildes ni mayúsculas y excluye el registro que se está editando
    if (f.unique && value) {
      const duplicate = items.find(
        (it) => it.id !== currentId && normalizeText(it[f.name]) === normalizeText(value)
      );
      if (duplicate) errors[f.name] = `Ya existe un registro con ese ${f.label.toLowerCase()} (ID ${duplicate.id}).`;
    }
  });

  return errors;
};

const toBody = (fields, values) =>
  Object.fromEntries(
    fields.map((f) => {
      const raw = values[f.name];
      if (f.type === "number") return [f.name, raw === "" || raw === null ? null : Number(raw)];
      if (f.type === "select") return [f.name, raw];
      return [f.name, String(raw ?? "").trim()];
    })
  );

export function CatalogFormModal({ open, item, items = [], config, onClose, onSaved }) {
  const { singular, plural, feminine, fields, service } = config;
  const isEdit = Boolean(item);
  const e = feminine ? "a" : "o";

  const [values, setValues] = useState({});
  const [errors, setErrors] = useState({});
  const [saving, setSaving] = useState(false);
  const [submitError, setSubmitError] = useState("");

  useEffect(() => {
    if (open) {
      setValues(toValues(fields, item));
      setErrors({});
      setSubmitError("");
    }
  }, [open, item, fields]);

  const handleChange = (ev) => {
    const { name, value } = ev.target;
    setValues((v) => ({ ...v, [name]: value }));
    setErrors((err) => ({ ...err, [name]: undefined }));
  };

  const handleSubmit = async (ev) => {
    ev.preventDefault();
    const found = validate(fields, values, items, item?.id);
    setErrors(found);
    if (Object.keys(found).length > 0) return;

    setSaving(true);
    setSubmitError("");
    const body = toBody(fields, values);

    try {
      const saved = isEdit ? await service.update(item.id, body) : await service.create(body);
      onSaved(saved ?? { ...item, ...body }, isEdit);
    } catch (err) {
      const data = err.response?.data;
      if (data?.errors) setErrors(mapApiErrors(data.errors));
      setSubmitError(
        err.noAccess
          ? `No tienes permiso para ${isEdit ? "editar" : "crear"} ${plural}.`
          : data?.message ?? "No se pudo guardar. Intenta de nuevo."
      );
    } finally {
      setSaving(false);
    }
  };

  const handleClose = () => { if (!saving) onClose(); };

  const renderInput = (f, index) => {
    const common = {
      id: `catalog-${f.name}`,
      name: f.name,
      value: values[f.name] ?? "",
      onChange: handleChange,
      "aria-invalid": !!errors[f.name],
      autoFocus: index === 0,
    };

    if (f.type === "select") {
      return (
        <select {...common} className={`${styles.select} ${errors[f.name] ? styles.invalid : ""}`}>
          <option value="">Selecciona una opción</option>
          {f.options.map((o) => <option key={o.value} value={o.value}>{o.label}</option>)}
        </select>
      );
    }

    return (
      <input
        {...common}
        type={f.type === "number" ? "number" : "text"}
        min={f.type === "number" ? 0 : undefined}
        inputMode={f.type === "number" ? "numeric" : undefined}
        className={`${styles.input} ${errors[f.name] ? styles.invalid : ""}`}
        placeholder={f.placeholder}
        autoComplete="off"
      />
    );
  };

  return (
    <Modal
      open={open}
      size="sm"
      title={isEdit ? `Editar ${singular}` : `Nuev${e} ${singular}`}
      onClose={handleClose}
      footer={
        <>
          <button type="button" className={`${styles.btn} ${styles.btnOutline}`} onClick={handleClose} disabled={saving}>
            Cancelar
          </button>
          <button type="submit" form={FORM_ID} className={`${styles.btn} ${styles.btnPrimary}`} disabled={saving}>
            {saving && <Loader2 size={18} className={styles.spin} />}
            {saving ? "Guardando..." : isEdit ? "Guardar cambios" : "Guardar"}
          </button>
        </>
      }
    >
      <form id={FORM_ID} className={styles.form} style={{ gridTemplateColumns: "1fr" }} onSubmit={handleSubmit} noValidate>
        {submitError && (
          <div className={`${styles.banner} ${styles.bannerError}`} role="alert" style={{ marginBottom: 0 }}>
            <AlertCircle size={18} />
            <p>{submitError}</p>
          </div>
        )}

        {isEdit && (
          <div className={styles.field}>
            <label className={styles.label} htmlFor="catalog-id">
              ID <span className={styles.readOnlyTag}>SOLO LECTURA</span>
            </label>
            <input id="catalog-id" className={styles.input} value={item.id} readOnly />
          </div>
        )}

        {fields.map((f, index) => (
          <div key={f.name} className={styles.field}>
            <label className={styles.label} htmlFor={`catalog-${f.name}`}>
              {f.label}
              {f.required && <span className={styles.required}>*</span>}
            </label>
            {renderInput(f, index)}
            {errors[f.name] && <span className={styles.fieldError}>{errors[f.name]}</span>}
          </div>
        ))}
      </form>
    </Modal>
  );
}









