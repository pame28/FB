using dllwsDivideloTodoBXI.Models.GatewayLogin;
using Log4NetLogger;
using Newtonsoft.Json;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Net;
using System.Net.Http;
using System.Net.Http.Headers;
using System.Net.Security;
using System.Security.Cryptography.X509Certificates;
using System.Text;
using System.Threading.Tasks;

namespace dllwsDivideloTodoBXI.Services
{
    public class BaseApiService
    {
        protected HttpClient client;

        protected BaseApiService(string baseUrl, bool ignoreSslErrors)
        {
            ServicePointManager.SecurityProtocol = SecurityProtocolType.Tls12;
            if (ignoreSslErrors)
            {
                ServicePointManager.ServerCertificateValidationCallback =
                      delegate (object sender, X509Certificate cert, X509Chain chain, SslPolicyErrors sslPolicyErrors)
                      {
                          return true;
                      };
            }

            client = new HttpClient
            {
                BaseAddress = new Uri(baseUrl)
            };

            client.DefaultRequestHeaders.Accept.Clear();
            client.DefaultRequestHeaders.Accept.Add(new MediaTypeWithQualityHeaderValue("application/json"));

            // [LOG] Configuración con la que se creó el cliente
            AppLogger.Info($"[BaseApiService] HttpClient creado. BaseAddress='{client.BaseAddress}'; IgnoreSsl={ignoreSslErrors}; TLS={ServicePointManager.SecurityProtocol}; Timeout={client.Timeout.TotalSeconds}s; ProxySistema='{ObtenerProxySistema(client.BaseAddress)}'");
        }

        protected async Task<T> GetAsync<T>(string url)
        {
            HttpResponseMessage response = await client.GetAsync(url);
            if (!response.IsSuccessStatusCode)
                throw new Exception($"Error consumiendo API {url} - GET");

            string json = await response.Content.ReadAsStringAsync();
            return JsonConvert.DeserializeObject<T>(json);
        }

        protected async Task<T> PostAsync<T>(string url, object data)
        {
            var jsonData = JsonConvert.SerializeObject(data);

            var content = new StringContent(
                JsonConvert.SerializeObject(data),
                Encoding.UTF8,
                "application/json"
                );

            // Log del request
            AppLogger.Info($"Request a endpoint {url} (URL final: {UrlFinal(url)}) con body: {jsonData}");

            HttpResponseMessage response;
            try
            {
                response = await client.PostAsync(url, content);
            }
            catch (Exception ex)
            {
                // [LOG] Falla de conexión (no llegó respuesta HTTP). Se relanza igual que antes.
                AppLogger.Error($"[PostAsync] FALLÓ la conexión a {UrlFinal(url)}. {DescribirError(ex)}");
                throw;
            }

            if (!response.IsSuccessStatusCode)
            {
                AppLogger.Info($"Llamado a endpoint {url} fallo con statuscode: {response.StatusCode.ToString()}");

                var errorContent = await response.Content.ReadAsStringAsync();

                AppLogger.Info($"Llamado a endpoint {url} fallo con ERROR: {errorContent}");

                return JsonConvert.DeserializeObject<T>(errorContent);
            }

            AppLogger.Info($"Llamado a endpoint {url} exitoso");

            string json = await response.Content.ReadAsStringAsync();

            AppLogger.Info($"Llamado a endpoint {url} exitoso, respuesta: {json}");

            return JsonConvert.DeserializeObject<T>(json);
        }

        protected async Task<string> LoginAsync(string url, string user, string password)
        {
            var loginRequest = new
            {
                username = user,
                password = password
            };

            var content = new StringContent(
                JsonConvert.SerializeObject(loginRequest),
                Encoding.UTF8,
                "application/json");

            // [LOG] A dónde va realmente el login
            AppLogger.Info($"[LoginAsync] Llamando login. URL final: {UrlFinal(url)}; Usuario='{user}'");

            HttpResponseMessage responseMessage;
            try
            {
                responseMessage = await client.PostAsync(url, content);
            }
            catch (Exception ex)
            {
                // [LOG] Aquí cae si nunca llega al gateway (proxy, DNS, firewall, SSL, timeout). Se relanza igual que antes.
                AppLogger.Error($"[LoginAsync] FALLÓ la conexión a {UrlFinal(url)}. {DescribirError(ex)}");
                throw;
            }

            // [LOG] Sí hubo respuesta HTTP
            AppLogger.Info($"[LoginAsync] Respuesta HTTP: {(int)responseMessage.StatusCode} {responseMessage.StatusCode}");

            if (!responseMessage.IsSuccessStatusCode)
            {
                // [LOG] Cuerpo del error antes de lanzar la misma excepción de siempre
                string errorBody = await responseMessage.Content.ReadAsStringAsync();
                AppLogger.Error($"[LoginAsync] Login respondió error. Body: {errorBody}");
                throw new Exception($"Error consumiendo API {url} - POST");
            }

            string json = await responseMessage.Content.ReadAsStringAsync();

            GatewayLoginResponse response = JsonConvert.DeserializeObject<GatewayLoginResponse>(json);
            if (!response.hasError)
            {
                AppLogger.Info("[LoginAsync] Login OK, token asignado al header Authorization.");
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", response.data.accessToken);
                return response.data.accessToken;
            }

            // [LOG]
            AppLogger.Error($"[LoginAsync] Login respondió hasError=true. Body: {json}");
            return string.Empty;
        }

        // ================== Helpers solo para logs ==================

        /// <summary>URL completa que realmente se consume (BaseAddress + url).</summary>
        private string UrlFinal(string url)
        {
            try
            {
                return client.BaseAddress != null ? new Uri(client.BaseAddress, url).ToString() : url;
            }
            catch
            {
                return $"{client.BaseAddress} + {url}";
            }
        }

        /// <summary>Proxy que .NET va a usar para esa URL (o 'SIN PROXY').</summary>
        private static string ObtenerProxySistema(Uri destino)
        {
            try
            {
                IWebProxy proxy = WebRequest.DefaultWebProxy;
                if (proxy == null || destino == null) return "SIN PROXY";
                Uri p = proxy.GetProxy(destino);
                return (p == null || p == destino) ? "SIN PROXY (directo)" : p.ToString();
            }
            catch (Exception ex)
            {
                return "No se pudo leer: " + ex.Message;
            }
        }

        /// <summary>Tipo de error, WebException.Status, si fue timeout, y la excepción completa con InnerException.</summary>
        protected static string DescribirError(Exception ex)
        {
            StringBuilder sb = new StringBuilder();

            if (ex is TaskCanceledException)
                sb.Append("Posible TIMEOUT (TaskCanceledException). ");

            Exception actual = ex;
            while (actual != null)
            {
                WebException wex = actual as WebException;
                if (wex != null)
                {
                    sb.Append($"WebException.Status={wex.Status}. ");
                    break;
                }
                actual = actual.InnerException;
            }

            sb.AppendLine();
            sb.Append(ex.ToString());
            return sb.ToString();
        }
    }
}