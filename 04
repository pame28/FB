import { useState } from "react";
import { Calculator, Check, CheckCircle2, CircleDashed, Pencil, Settings2 } from "lucide-react";
import { useToast } from "../../../shared/components";
import { EMPTY_CALC, RULES, findRule, unitLabel, validateCalc } from "./indicatorUtils";
import styles from "../../Pages.module.css";
import s from "./Indicators.module.css";

/**
 * Sección "Forma de cálculo" dentro del formulario del indicador.
 * value: configuración guardada · configured: si ya se guardó
 * onSave(calc): guarda la configuración en el formulario
 */
export const CalculationPanel = ({ value, configured, units, invalid, onSave }) => {
  const toast = useToast();
  const [editing, setEditing] = useState(false);
  const [draft, setDraft] = useState(EMPTY_CALC);
  const [errors, setErrors] = useState({});

  const open = () => {
    setDraft({ ...EMPTY_CALC, ...value });
    setErrors({});
    setEditing(true);
  };

  const change = (e) => {
    const { name, value: v } = e.target;
    setDraft((d) => ({ ...d, [name]: v }));
    setErrors((er) => ({ ...er, [name]: undefined }));
  };

  const save = () => {
    const found = validateCalc(draft);
    setErrors(found);
    if (Object.keys(found).length > 0) return;
    onSave(draft);
    setEditing(false);
    toast.success("¡Forma de cálculo guardada exitosamente!");
  };

  const unit = units.find((u) => String(u.id) === String(value.unitId));

  return (
    <section className={`${s.calc} ${invalid && !editing ? s.calcInvalid : ""}`}>
      <div className={s.calcHead}>
        <span className={s.calcIcon}><Calculator size={18} /></span>
        <div className={s.calcTitleWrap}>
          <h3 className={s.calcTitle}>Forma de cálculo<span className={styles.required}>*</span></h3>
          <p className={s.calcSub}>Obligatoria antes de guardar el indicador</p>
        </div>
        {!editing && (
          <>
            <span className={`${s.calcBadge} ${configured ? s.calcBadgeOk : ""}`}>
              {configured ? <CheckCircle2 size={14} /> : <CircleDashed size={14} />}
              {configured ? "Configurada" : "Pendiente"}
            </span>
            <button type="button" className={`${styles.btn} ${styles.btnOutline} ${s.calcBtn}`} onClick={open}>
              {configured ? <Pencil size={15} /> : <Settings2 size={15} />}
              {configured ? "Editar" : "Configurar"}
            </button>
          </>
        )}
      </div>

      {editing ? (
        <div className={s.calcForm}>
          <div className={s.calcGrid}>
            <div className={styles.field}>
              <label className={styles.label} htmlFor="calc-unit">Unidad<span className={styles.required}>*</span></label>
              <select id="calc-unit" name="unitId" className={`${styles.select} ${errors.unitId ? styles.invalid : ""}`}
                value={draft.unitId} onChange={change}>
                <option value="">— Selecciona —</option>
                {units.map((u) => <option key={u.id} value={u.id}>{unitLabel(u)}</option>)}
              </select>
              {errors.unitId && <span className={styles.fieldError}>{errors.unitId}</span>}
            </div>

            <div className={styles.field}>
              <label className={styles.label} htmlFor="calc-min">Valor mínimo<span className={styles.required}>*</span></label>
              <input id="calc-min" name="minimumValue" inputMode="decimal" autoComplete="off"
                className={`${styles.input} ${errors.minimumValue ? styles.invalid : ""}`}
                value={draft.minimumValue} onChange={change} placeholder="0" />
              {errors.minimumValue && <span className={styles.fieldError}>{errors.minimumValue}</span>}
            </div>

            <div className={styles.field}>
              <label className={styles.label} htmlFor="calc-max">Valor máximo<span className={styles.required}>*</span></label>
              <input id="calc-max" name="maximumValue" inputMode="decimal" autoComplete="off"
                className={`${styles.input} ${errors.maximumValue ? styles.invalid : ""}`}
                value={draft.maximumValue} onChange={change} placeholder="100" />
              {errors.maximumValue && <span className={styles.fieldError}>{errors.maximumValue}</span>}
            </div>

            <div className={styles.field}>
              <label className={styles.label} htmlFor="calc-weight">Peso (%)</label>
              <input id="calc-weight" name="weight" inputMode="decimal" autoComplete="off"
                className={`${styles.input} ${errors.weight ? styles.invalid : ""}`}
                value={draft.weight} onChange={change} placeholder="30" />
              {errors.weight && <span className={styles.fieldError}>{errors.weight}</span>}
            </div>

            <div className={styles.field}>
              <label className={styles.label} htmlFor="calc-rule">Regla</label>
              <select id="calc-rule" name="rule" className={`${styles.select} ${errors.rule ? styles.invalid : ""}`}
                value={draft.rule} onChange={change}>
                {RULES.map((r) => <option key={r.value} value={r.value}>{r.label}</option>)}
              </select>
              {errors.rule && <span className={styles.fieldError}>{errors.rule}</span>}
            </div>

            <div className={styles.field}>
              <label className={styles.label} htmlFor="calc-formula">Fórmula</label>
              <input id="calc-formula" name="formula" maxLength={200} autoComplete="off"
                className={`${styles.input} ${s.mono}`}
                value={draft.formula} onChange={change} placeholder="(Real/Meta)*100" />
            </div>
          </div>

          <div className={s.calcActions}>
            <button type="button" className={`${styles.btn} ${styles.btnOutline}`} onClick={() => setEditing(false)}>
              Cancelar
            </button>
            <button type="button" className={`${styles.btn} ${styles.btnPrimary}`} onClick={save}>
              <Check size={16} /> Guardar forma de cálculo
            </button>
          </div>
        </div>
      ) : configured ? (
        <dl className={s.calcSummary}>
          <div><dt>Unidad</dt><dd>{unit ? unitLabel(unit) : "—"}</dd></div>
          <div><dt>Mín / Máx</dt><dd>{value.minimumValue} / {value.maximumValue}</dd></div>
          <div><dt>Peso</dt><dd>{String(value.weight).trim() === "" ? "—" : `${value.weight}%`}</dd></div>
          <div><dt>Regla</dt><dd>{findRule(value.rule)?.label ?? "—"}</dd></div>
          <div className={s.calcSummaryWide}><dt>Fórmula</dt><dd className={s.mono}>{value.formula || "—"}</dd></div>
        </dl>
      ) : (
        <p className={s.calcEmpty}>
          Define la unidad, el rango de valores, el peso, la regla y la fórmula del indicador.
        </p>
      )}

      {invalid && !editing && <span className={styles.fieldError}>Configura la forma de cálculo antes de guardar.</span>}
    </section>
  );
};














import { useEffect, useMemo, useState } from "react";
import { AlertCircle, Check, Eye, Info, Loader2 } from "lucide-react";
import { Modal, useToast } from "../../../shared/components";
import { indicatorsService } from "../../../api/indicatorsService";
import { templatesService } from "../../../api/templatesService";
import { mapTemplate } from "../templates/templates/templateUtils";
import { CalculationPanel } from "./CalculationPanel";
import {
  EMPTY_CALC, INDICATOR_STATUS, INDICATOR_TYPES, buildIndicatorBody, fieldError, fieldKind, fieldText,
  indicatorCode, mapCatalogItem, templateCode, toFormState, unitLabel, validateCalc,
} from "./indicatorUtils";
import styles from "../../Pages.module.css";
import s from "./Indicators.module.css";

const FORM_ID = "indicator-form";
const MAX_TEXT = 200;

const EMPTY_FORM = {
  type: "",
  templateId: "",
  status: INDICATOR_STATUS.ACTIVE,
  periodId: null,
  values: {},
  calc: EMPTY_CALC,
  calcConfigured: false,
};

const templateLabel = (t) => `${templateCode(t.id)} — ${t.markers.map((m) => `{ ${m.value} }`).join(" ")}`;

/**
 * Modal para crear / editar un indicador.
 * indicatorId: null = crear
 */
export const IndicatorFormModal = ({ open, indicatorId, onClose, onSaved }) => {
  const toast = useToast();
  const isEdit = indicatorId != null;

  // Catálogos
  const [templates, setTemplates] = useState([]);
  const [verbs, setVerbs] = useState([]);
  const [units, setUnits] = useState([]);
  const [loading, setLoading] = useState(false);
  const [loadError, setLoadError] = useState("");

  // Formulario
  const [form, setForm] = useState(EMPTY_FORM);
  const [submitted, setSubmitted] = useState(false);
  const [saving, setSaving] = useState(false);
  const [submitError, setSubmitError] = useState("");

  /* ---------- Carga al abrir ---------- */
  useEffect(() => {
    if (!open) return;
    let cancelled = false;

    setForm(EMPTY_FORM);
    setSubmitted(false);
    setSubmitError("");
    setLoadError("");
    setLoading(true);

    (async () => {
      try {
        const [tpl, vb, un, detail] = await Promise.all([
          templatesService.list(),
          indicatorsService.verbs(),
          indicatorsService.units(),
          isEdit ? indicatorsService.getById(indicatorId) : Promise.resolve(null),
        ]);
        if (cancelled) return;

        const mappedTemplates = tpl.map(mapTemplate);
        setTemplates(mappedTemplates);
        setVerbs(vb.map(mapCatalogItem));
        setUnits(un.map(mapCatalogItem));

        if (detail) {
          const template = mappedTemplates.find((t) => String(t.id) === String(detail.templateId ?? detail.template?.id));
          const state = toFormState(detail, template?.markers ?? []);
          setForm({
            ...EMPTY_FORM,
            ...state,
            type: String(state.type),
            templateId: String(state.templateId),
            calcConfigured: Object.keys(validateCalc(state.calc)).length === 0,
          });
        }
      } catch (err) {
        if (!cancelled) {
          setLoadError(err.noAccess
            ? "No tienes permiso para esta acción."
            : isEdit ? "No se pudo cargar el indicador." : "No se pudieron cargar las plantillas y catálogos.");
        }
      } finally {
        if (!cancelled) setLoading(false);
      }
    })();

    return () => { cancelled = true; };
  }, [open, indicatorId, isEdit]);

  /* ---------- Derivados ---------- */
  // Solo plantillas activas (y la actual, si se edita una con plantilla inactiva)
  const templateOptions = useMemo(
    () => templates.filter((t) => t.active || String(t.id) === form.templateId),
    [templates, form.templateId]
  );
  const template = templates.find((t) => String(t.id) === form.templateId) ?? null;
  const markers = template?.markers ?? [];
  const catalogs = { verbs, units, unitId: form.calc.unitId };

  const fieldErrors = Object.fromEntries(
    markers.map((m) => [m.position, fieldError(m, form.values[m.position], form.calc.unitId)])
  );
  const formErrors = {
    type: form.type === "" ? "Selecciona el tipo de indicador." : "",
    templateId: form.templateId === "" ? "Selecciona una plantilla." : "",
    fields: Object.values(fieldErrors).some(Boolean),
    calc: !form.calcConfigured,
  };
  const hasErrors = Boolean(formErrors.type || formErrors.templateId || formErrors.fields || formErrors.calc);

  const segments = markers.map((m) => ({
    key: m.position,
    label: m.value,
    text: fieldText(m, form.values[m.position], catalogs),
  }));
  const phrase = segments.map((x) => x.text).filter(Boolean).join(" ");

  /* ---------- Cambios ---------- */
  const setField = (name, value) => setForm((f) => ({ ...f, [name]: value }));

  const changeTemplate = (templateId) => setForm((f) => ({ ...f, templateId, values: {} }));

  const setValue = (position, value) =>
    setForm((f) => ({ ...f, values: { ...f.values, [position]: value } }));

  /* ---------- Guardar ---------- */
  const handleSubmit = async (e) => {
    e.preventDefault();
    setSubmitted(true);
    if (hasErrors) return;

    setSaving(true);
    setSubmitError("");
    const body = buildIndicatorBody({ ...form, name: phrase, markers, verbs, units });
    try {
      if (isEdit) await indicatorsService.update(indicatorId, body);
      else await indicatorsService.create(body);
      toast.success("¡Indicador guardado exitosamente!", phrase);
      onSaved();
    } catch (err) {
      setSubmitError(err.noAccess
        ? `No tienes permiso para ${isEdit ? "editar" : "crear"} indicadores.`
        : err.response?.data?.message ?? "No se pudo guardar el indicador. Intenta de nuevo.");
    } finally {
      setSaving(false);
    }
  };

  const handleClose = () => { if (!saving) onClose(); };

  /* ---------- Controles de cada campo ---------- */
  const renderField = (m) => {
    const kind = fieldKind(m);
    const id = `ind-field-${m.position}`;
    const value = form.values[m.position] ?? "";
    const error = submitted ? fieldErrors[m.position] : "";
    const invalid = error ? styles.invalid : "";

    let control;
    if (kind === "verb") {
      control = (
        <select id={id} className={`${styles.select} ${invalid}`} value={value} onChange={(e) => setValue(m.position, e.target.value)}>
          <option value="">— Selecciona —</option>
          {verbs.map((v) => <option key={v.id} value={v.id}>{v.name}</option>)}
        </select>
      );
    } else if (kind === "unit") {
      const unit = units.find((u) => String(u.id) === String(form.calc.unitId));
      control = (
        <div id={id} className={`${s.linkedField} ${error ? s.linkedFieldInvalid : ""}`}>
          {unit ? <strong>{unitLabel(unit)}</strong> : <span>Sin definir</span>}
          <small>Se define en Forma de cálculo</small>
        </div>
      );
    } else if (kind === "bool") {
      control = (
        <select id={id} className={`${styles.select} ${invalid}`} value={value} onChange={(e) => setValue(m.position, e.target.value)}>
          <option value="">— Selecciona —</option>
          <option value="true">Sí</option>
          <option value="false">No</option>
        </select>
      );
    } else if (kind === "date") {
      control = (
        <input id={id} type="date" className={`${styles.input} ${invalid}`} value={value}
          onChange={(e) => setValue(m.position, e.target.value)} />
      );
    } else {
      control = (
        <input id={id} className={`${styles.input} ${invalid}`} value={value} maxLength={MAX_TEXT} autoComplete="off"
          inputMode={kind === "number" ? "decimal" : undefined}
          placeholder={kind === "number" ? "0" : ""}
          onChange={(e) => setValue(m.position, e.target.value)} />
      );
    }

    return (
      <div key={m.position} className={styles.field}>
        <label className={styles.label} htmlFor={id}>
          {m.value}<span className={styles.required}>*</span>
        </label>
        {control}
        {error ? (
          <span className={styles.fieldError}>{error}</span>
        ) : kind === "text" ? (
          <span className={s.counter}>{value.length}/{MAX_TEXT}</span>
        ) : null}
      </div>
    );
  };

  /* ---------- Render ---------- */
  return (
    <Modal
      open={open}
      size="lg"
      title={isEdit ? `Editar indicador — ${indicatorCode(indicatorId)}` : "Crear indicador"}
      onClose={handleClose}
      footer={
        <>
          <button type="button" className={`${styles.btn} ${styles.btnOutline}`} onClick={handleClose} disabled={saving}>
            Cancelar
          </button>
          <button type="submit" form={FORM_ID} className={`${styles.btn} ${styles.btnPrimary}`} disabled={saving || loading || !!loadError}>
            {saving ? <Loader2 size={16} className={styles.spin} /> : <Check size={16} />}
            {saving ? "Guardando..." : "Guardar indicador"}
          </button>
        </>
      }
    >
      {loading ? (
        <div className={s.modalLoading}><Loader2 size={22} className={styles.spin} /> Cargando...</div>
      ) : loadError ? (
        <div className={`${styles.banner} ${styles.bannerError}`} role="alert" style={{ margin: 0 }}>
          <AlertCircle size={18} /><p>{loadError}</p>
        </div>
      ) : (
        <form id={FORM_ID} onSubmit={handleSubmit} noValidate className={s.form}>
          <p className={s.formIntro}>
            Completa los campos obligatorios. La frase se construye únicamente con los campos de la plantilla.
          </p>

          {submitError && (
            <div className={`${styles.banner} ${styles.bannerError}`} role="alert" style={{ margin: 0 }}>
              <AlertCircle size={18} /><p>{submitError}</p>
            </div>
          )}
          {submitted && hasErrors && !submitError && (
            <div className={`${styles.banner} ${styles.bannerError}`} role="alert" style={{ margin: 0 }}>
              <AlertCircle size={18} />
              <p>Faltan datos obligatorios. Revisa los campos marcados en rojo.</p>
            </div>
          )}

          {/* Tipo y plantilla */}
          <div className={s.grid2}>
            <div className={styles.field}>
              <label className={styles.label} htmlFor="ind-type">Tipo de indicador<span className={styles.required}>*</span></label>
              <select id="ind-type" className={`${styles.select} ${submitted && formErrors.type ? styles.invalid : ""}`}
                value={form.type} onChange={(e) => setField("type", e.target.value)}>
                <option value="">— Selecciona —</option>
                {INDICATOR_TYPES.map((t) => <option key={t.value} value={t.value}>{t.label}</option>)}
              </select>
              {submitted && formErrors.type && <span className={styles.fieldError}>{formErrors.type}</span>}
            </div>

            <div className={styles.field}>
              <label className={styles.label} htmlFor="ind-template">Plantilla<span className={styles.required}>*</span></label>
              <select id="ind-template" className={`${styles.select} ${submitted && formErrors.templateId ? styles.invalid : ""}`}
                value={form.templateId} disabled={form.type === ""} onChange={(e) => changeTemplate(e.target.value)}>
                <option value="">{form.type === "" ? "— Primero selecciona el tipo —" : "— Selecciona —"}</option>
                {templateOptions.map((t) => <option key={t.id} value={t.id}>{templateLabel(t)}</option>)}
              </select>
              {submitted && formErrors.templateId && <span className={styles.fieldError}>{formErrors.templateId}</span>}
              {form.type !== "" && templateOptions.length === 0 && (
                <span className={styles.hint}>No hay plantillas activas. Créalas en Mantenimiento de plantillas.</span>
              )}
            </div>
          </div>

          {template && (
            <>
              <div className={s.templateExample}>
                <Info size={16} />
                <div>
                  <span className={s.kicker}>Ejemplo de plantilla</span>
                  <p>{template.example}</p>
                </div>
              </div>

              {/* Campos de la plantilla */}
              <div className={s.grid2}>{markers.map(renderField)}</div>

              {/* Previsualización */}
              <div className={s.preview} aria-live="polite">
                <span className={s.kicker}><Eye size={13} /> Previsualización · solo lectura</span>
                <p className={s.previewText}>
                  {segments.map((seg, i) => (
                    <span key={seg.key}>
                      {i > 0 && " "}
                      {seg.text ? <span>{seg.text}</span> : <span className={s.previewMissing}>{`{${seg.label}}`}</span>}
                    </span>
                  ))}
                </p>
              </div>
            </>
          )}

          {/* Forma de cálculo */}
          <CalculationPanel
            value={form.calc}
            configured={form.calcConfigured}
            units={units}
            invalid={submitted && formErrors.calc}
            onSave={(calc) => setForm((f) => ({ ...f, calc, calcConfigured: true }))}
          />
        </form>
      )}
    </Modal>
  );
};











import { useCallback, useEffect, useRef, useState } from "react";
import { AlertCircle, Eraser, ListFilter, Lock, Pencil, Plus, Search, SearchX, Trash2 } from "lucide-react";
import { ConfirmDialog, Pagination, StatusSwitch, useToast } from "../../../shared/components";
import { indicatorsService } from "../../../api/indicatorsService";
import { IndicatorFormModal } from "./IndicatorFormModal";
import { INDICATOR_TYPES, formatDate, mapIndicator } from "./indicatorUtils";
import styles from "../../Pages.module.css";
import s from "./Indicators.module.css";

const EMPTY_FILTERS = { type: "all", name: "" };

const TONES = {
  number: s.toneNumber,
  quality: s.toneQuality,
  ops: s.toneOps,
  attitude: s.toneAttitude,
  sales: s.toneSales,
};

const TypeTag = ({ type }) =>
  type ? <span className={`${s.typeTag} ${TONES[type.tone]}`}>{type.label}</span> : <span className={s.muted}>—</span>;

export const IndicadoresPage = () => {
  const toast = useToast();

  // Resumen (tarjetas)
  const [stats, setStats] = useState(null);

  // Filtros: "draft" es lo que se escribe, "applied" lo que se buscó (null = aún no se busca)
  const [draft, setDraft] = useState(EMPTY_FILTERS);
  const [applied, setApplied] = useState(null);
  const [page, setPage] = useState(1);
  const [pageSize, setPageSize] = useState(10);

  // Listado
  const [rows, setRows] = useState([]);
  const [total, setTotal] = useState(0);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");
  const requestRef = useRef(0);

  // Acciones
  const [modal, setModal] = useState({ open: false, id: null });
  const [toggling, setToggling] = useState(() => new Set());
  const [toDelete, setToDelete] = useState(null);
  const [deleting, setDeleting] = useState(false);
  const [deleteError, setDeleteError] = useState("");

  /* ---------- Resumen ---------- */
  const loadStats = useCallback(async () => {
    try {
      const all = (await indicatorsService.list()).map(mapIndicator);
      const active = all.filter((x) => x.active).length;
      const templates = new Set(all.map((x) => x.templateId).filter((v) => v != null));
      setStats({ total: all.length, active, inactive: all.length - active, templates: templates.size });
    } catch {
      setStats(null);
    }
  }, []);

  useEffect(() => { loadStats(); }, [loadStats]);

  /* ---------- Listado (solo después de buscar) ---------- */
  const load = useCallback(async () => {
    if (!applied) return;
    const id = ++requestRef.current;
    setLoading(true);
    setError("");
    try {
      const { items, total: count } = await indicatorsService.filter({
        name: applied.name || null,
        type: applied.type === "all" ? null : Number(applied.type),
        status: null,
        templateId: null,
        period: null,
        pageNumber: page,
        pageSize,
      });
      if (id !== requestRef.current) return;
      setRows(items.map(mapIndicator));
      setTotal(count);
    } catch (err) {
      if (id !== requestRef.current) return;
      setError(err.noAccess
        ? "No tienes permiso para ver los indicadores."
        : "No se pudieron cargar los indicadores. Intenta de nuevo.");
    } finally {
      if (id === requestRef.current) setLoading(false);
    }
  }, [applied, page, pageSize]);

  useEffect(() => { load(); }, [load]);

  const search = (e) => {
    e.preventDefault();
    setApplied({ type: draft.type, name: draft.name.trim() });
    setPage(1);
  };

  const clear = () => {
    requestRef.current++; // descarta respuestas pendientes
    setDraft(EMPTY_FILTERS);
    setApplied(null);
    setRows([]);
    setTotal(0);
    setError("");
    setLoading(false);
    setPage(1);
  };

  /* ---------- Estatus ---------- */
  const toggleStatus = async (row) => {
    setToggling((set) => new Set(set).add(row.id));
    try {
      if (row.active) await indicatorsService.deactivate(row.id);
      else await indicatorsService.activate(row.id);
      setRows((rs) => rs.map((r) => (r.id === row.id ? { ...r, active: !r.active } : r)));
      toast.success(
        row.active ? "Indicador inactivado" : "Indicador activado",
        row.active ? "Ya no estará disponible para asignación ni coaching." : "Ya está disponible para asignación y coaching."
      );
      loadStats();
    } catch (err) {
      toast.error(
        "No se pudo cambiar el estatus",
        err.noAccess ? "No tienes permiso para esta acción." : err.response?.data?.message ?? "Intenta de nuevo."
      );
    } finally {
      setToggling((set) => { const n = new Set(set); n.delete(row.id); return n; });
    }
  };

  /* ---------- Eliminar ---------- */
  const confirmDelete = async () => {
    setDeleting(true);
    setDeleteError("");
    try {
      await indicatorsService.remove(toDelete.id);
      toast.success("Indicador eliminado", toDelete.name);
      setToDelete(null);
      loadStats();
      if (rows.length === 1 && page > 1) setPage((p) => p - 1);
      else load();
    } catch (err) {
      setDeleteError(err.noAccess
        ? "No tienes permiso para eliminar indicadores."
        : err.response?.data?.message ?? "No se pudo eliminar el indicador. Intenta de nuevo.");
    } finally {
      setDeleting(false);
    }
  };

  /* ---------- Modal ---------- */
  const handleSaved = () => {
    setModal({ open: false, id: null });
    loadStats();
    // Regresa al listado: si aún no se había buscado, muestra todos
    if (!applied) { setApplied({ ...EMPTY_FILTERS }); setPage(1); }
    else load();
  };

  const statCards = [
    { label: "Total", value: stats?.total },
    { label: "Activos", value: stats?.active, tone: s.statGreen },
    { label: "Inactivos", value: stats?.inactive, tone: s.statGrey },
    { label: "Plantillas usadas", value: stats?.templates, tone: s.statYellow },
  ];

  /* ---------- Render ---------- */
  return (
    <>
      <header className={styles.pageHeader}>
        <div>
          <span className={styles.eyebrow}>Mantenimiento</span>
          <h1 className={styles.title}>Mantenimiento de indicadores</h1>
          <p className={styles.subtitle}>Indicadores construidos a partir de las plantillas.</p>
        </div>
        <div className={styles.actions}>
          <button type="button" className={`${styles.btn} ${styles.btnPrimary}`} onClick={() => setModal({ open: true, id: null })}>
            <Plus size={18} /> Crear indicador
          </button>
        </div>
      </header>

      {/* ---------- Resumen ---------- */}
      <div className={s.stats}>
        {statCards.map((c) => (
          <div key={c.label} className={`${s.stat} ${c.tone ?? ""}`}>
            <span className={s.statLabel}>{c.label}</span>
            <strong className={s.statValue}>{c.value ?? "—"}</strong>
          </div>
        ))}
      </div>

      {/* ---------- Filtros ---------- */}
      <form className={s.filters} onSubmit={search}>
        <div className={styles.field}>
          <label className={styles.label} htmlFor="f-type">Tipo</label>
          <select id="f-type" className={styles.select} value={draft.type}
            onChange={(e) => setDraft((d) => ({ ...d, type: e.target.value }))}>
            <option value="all">Todos</option>
            {INDICATOR_TYPES.map((t) => <option key={t.value} value={t.value}>{t.label}</option>)}
          </select>
        </div>

        <div className={`${styles.field} ${s.filterName}`}>
          <label className={styles.label} htmlFor="f-name">Nombre del indicador</label>
          <div className={s.searchField}>
            <Search size={16} />
            <input id="f-name" className={styles.input} placeholder="Buscar..." value={draft.name}
              onChange={(e) => setDraft((d) => ({ ...d, name: e.target.value }))} autoComplete="off" />
          </div>
        </div>

        <div className={s.filterActions}>
          <button type="submit" className={`${styles.btn} ${styles.btnPrimary}`}>
            <Search size={16} /> Buscar
          </button>
          <button type="button" className={`${styles.btn} ${styles.btnOutline}`} onClick={clear}
            disabled={!applied && draft.type === "all" && !draft.name}>
            <Eraser size={16} /> Limpiar
          </button>
        </div>
      </form>

      {error && (
        <div className={`${styles.banner} ${styles.bannerError}`} role="alert">
          <AlertCircle size={18} />
          <p>
            {error}{" "}
            <button type="button" className={styles.linkBtn} style={{ padding: 0 }} onClick={load}>Reintentar</button>
          </p>
        </div>
      )}

      {/* ---------- Tabla ---------- */}
      <div className={s.tableCard}>
        <table className={s.table}>
          <thead>
            <tr>
              <th className={s.colStatus}>Estatus</th>
              <th>Indicador</th>
              <th className={s.colType}>Tipo</th>
              <th className={s.colDate}>Última modif.</th>
              <th className={s.colActions}>Acciones</th>
            </tr>
          </thead>
          <tbody>
            {!applied ? (
              <tr>
                <td colSpan={5} className={s.emptyCell}>
                  <div className={s.empty}>
                    <span className={s.emptyIcon}><ListFilter size={24} /></span>
                    <h3>Aplica un filtro para ver los indicadores</h3>
                    <p>Elige un tipo o escribe el nombre del indicador y presiona <strong>Buscar</strong>.</p>
                  </div>
                </td>
              </tr>
            ) : loading && rows.length === 0 ? (
              Array.from({ length: 4 }, (_, i) => (
                <tr key={i} aria-hidden="true">
                  <td><span className={s.skel} style={{ width: 80 }} /></td>
                  <td><span className={s.skel} style={{ width: `${80 - i * 8}%` }} /></td>
                  <td><span className={s.skel} style={{ width: 70 }} /></td>
                  <td><span className={s.skel} style={{ width: 76 }} /></td>
                  <td><span className={s.skel} style={{ width: 56 }} /></td>
                </tr>
              ))
            ) : rows.length === 0 ? (
              <tr>
                <td colSpan={5} className={s.emptyCell}>
                  {!error && (
                    <div className={s.empty}>
                      <span className={`${s.emptyIcon} ${s.emptyIconGrey}`}><SearchX size={24} /></span>
                      <h3>No se encontraron indicadores</h3>
                      <p>Prueba con otro tipo o nombre.</p>
                    </div>
                  )}
                </td>
              </tr>
            ) : (
              rows.map((row) => (
                <tr key={row.id} className={`${!row.active ? s.rowInactive : ""} ${loading ? s.rowLoading : ""}`}>
                  <td className={s.cellStatus}>
                    <StatusSwitch
                      checked={row.active}
                      disabled={toggling.has(row.id)}
                      onChange={() => toggleStatus(row)}
                      ariaLabel={`Estatus de ${row.code}`}
                    />
                  </td>
                  <td className={s.cellName}>
                    <p className={s.name}>{row.name}</p>
                    <span className={s.code}>{row.code}</span>
                  </td>
                  <td className={s.cellType}><TypeTag type={row.type} /></td>
                  <td className={s.cellDate}>{formatDate(row.updatedAt)}</td>
                  <td className={s.cellActions}>
                    <div className={s.actionBtns}>
                      <button
                        type="button"
                        className={s.actBtn}
                        disabled={!row.editable}
                        title={row.editable ? "Editar" : "No se puede editar por reglas de negocio"}
                        aria-label={`Editar ${row.code}`}
                        onClick={() => setModal({ open: true, id: row.id })}
                      >
                        {row.editable ? <Pencil size={16} /> : <Lock size={16} />}
                      </button>
                      <button
                        type="button"
                        className={`${s.actBtn} ${s.actBtnDanger}`}
                        title="Eliminar"
                        aria-label={`Eliminar ${row.code}`}
                        onClick={() => { setDeleteError(""); setToDelete(row); }}
                      >
                        <Trash2 size={16} />
                      </button>
                    </div>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>

        {applied && (
          <Pagination
            page={page}
            pageSize={pageSize}
            total={total}
            onPageChange={setPage}
            onPageSizeChange={(n) => { setPageSize(n); setPage(1); }}
          />
        )}
      </div>

      <IndicatorFormModal
        open={modal.open}
        indicatorId={modal.id}
        onClose={() => setModal({ open: false, id: null })}
        onSaved={handleSaved}
      />

      <ConfirmDialog
        open={Boolean(toDelete)}
        danger
        title="Eliminar indicador"
        message="Esta acción eliminará un indicador ¿Desea continuar?"
        detail={toDelete && (
          <div className={s.deleteDetail}>
            <span className={s.code}>{toDelete.code}</span>
            <p>{toDelete.name}</p>
          </div>
        )}
        confirmText={deleting ? "Eliminando..." : "Sí"}
        cancelText="No"
        loading={deleting}
        error={deleteError}
        onConfirm={confirmDelete}
        onCancel={() => setToDelete(null)}
      />
    </>
  );
};





