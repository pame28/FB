const getInitials = (name = "") =>
  name.split(" ").filter(Boolean).map((n) => n[0]).join("").toUpperCase().slice(0, 2);

const sessionTitle = (s) => `Indicadores — ${s.teamName}`;

const apiMessage = (err, fallback) => err.response?.data?.message ?? fallback;

function StatCard({ value, label, tone }) {
  return (
    <div className={`${ui.statCard} ${tone ?? ""}`}>
      <div className={ui.statValue}>{value}</div>
      <div className={ui.statLabel}>{label}</div>
    </div>
  );
}

export const ConsultaIndicadoresPage = () => {
  const toast = useToast();

  const [sessions, setSessions] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [selectedId, setSelectedId] = useState(null);
  const [statusFilter, setStatusFilter] = useState("todos");
  const [modal, setModal] = useState(null); // "approve" | "reject" | null
  const [reason, setReason] = useState("");
  const [saving, setSaving] = useState(false);

  const load = useCallback(async () => {
    setLoading(true);
    setError("");
    try {
      setSessions(await coachService.mySessions());
    } catch (err) {
      setError(err.noAccess ? "No tienes permiso para consultar tus indicadores." : "No se pudieron cargar los indicadores asignados.");
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    load();
  }, [load]);

  const selected = sessions.find((s) => s.sessionId === selectedId) ?? null;
  const filtered = sessions.filter((s) => statusFilter === "todos" || s.acceptanceStatus === statusFilter);

  const closeModal = () => {
    setModal(null);
    setReason("");
  };

  const handleConfirm = async () => {
    if (modal === "reject" && !reason.trim()) {
      toast.warning("Debes indicar el motivo del rechazo");
      return;
    }
    setSaving(true);
    try {
      if (modal === "approve") {
        await coachService.acceptSession(selectedId);
        toast.success("Indicadores aprobados correctamente");
      } else {
        await coachService.rejectSession(selectedId, reason.trim());
        toast.success("Indicadores rechazados correctamente");
      }
      closeModal();
      await load();
    } catch (err) {
      toast.error("No se pudo registrar la respuesta", apiMessage(err, "Intenta nuevamente."));
    } finally {
      setSaving(false);
    }
  };

  const onRowKey = (e, fn) => {
    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      fn();
    }
  };

  /* ===================== DETALLE ===================== */
  if (selected) {
    const s = selected;
    const pending = s.acceptanceStatus === "Pending";

    return (
      <div className={base.page}>
        <div className={ui.topBar}>
          <button type="button" className={`${base.btn} ${base.btnOutline} ${base.btnSm}`} onClick={() => setSelectedId(null)}>
            <ChevronLeft size={15} /> Volver al listado
          </button>
          {pending && (
            <div className={ui.topActions}>
              <button type="button" className={`${base.btn} ${base.btnOutline} ${base.btnSm}`} onClick={() => setModal("reject")}>
                <X size={15} /> Rechazar
              </button>
              <button type="button" className={`${base.btn} ${base.btnPrimary} ${base.btnSm}`} onClick={() => setModal("approve")}>
                <Check size={15} /> Aprobar indicadores
              </button>
            </div>
          )}
        </div>

        <div>
          <h1 className={ui.detailTitle}>{sessionTitle(s)}</h1>
          <p className={ui.detailSub}>Revisa los indicadores asignados para tu proceso de coaching.</p>
        </div>

        <section className={ui.hero}>
          <div className={ui.heroAvatar}>{getInitials(s.coachName)}</div>
          <div className={ui.heroInfo}>
            <div className={ui.heroName}>Coach: {s.coachName ?? "—"}</div>
            <div className={ui.heroMeta}>Equipo: {s.teamName}</div>
          </div>
          <div className={ui.heroField}>
            <span className={ui.heroLabel}>Estado</span>
            <span className={`${ui.pill} ${STATUS_PILL[s.acceptanceStatus]}`}>{STATUS_LABEL[s.acceptanceStatus]}</span>
          </div>
          <div className={ui.heroField}>
            <span className={ui.heroLabel}>Asignado el</span>
            <span className={ui.heroValue}>{formatDate(s.createdAt)}</span>
          </div>
        </section>

        {pending && (
          <div className={ui.warning}>
            <TriangleAlert size={16} />
            <span>
              Estos indicadores están <strong>Pendientes de tu aprobación</strong>. Revísalos y presiona <strong>Aprobar indicadores</strong> o <strong>Rechazar</strong>.
            </span>
          </div>
        )}

        {s.acceptanceStatus === "Rejected" && (
          <div className={ui.warning}>
            <TriangleAlert size={16} />
            <span>
              Rechazaste estos indicadores el {formatDate(s.acceptanceRejectedAt)}. Motivo: {s.acceptanceRejectionReason}
            </span>
          </div>
        )}

        <section className={base.card}>
          <div className={base.cardHeader}>
            <h2 className={base.cardTitle}>Indicadores asignados</h2>
          </div>
          <div className={base.cardBody}>
            <div className={ui.indicatorList}>
              {s.indicators.map((ind) => (
                <div key={ind.assignmentId} className={ui.indicatorItem}>
                  <div>
                    <div>{ind.indicatorName}</div>
                    <div className={ui.goal} style={{ textAlign: "left" }}>
                      Vigencia: {formatDate(ind.validFrom)} – {formatDate(ind.validTo)}
                    </div>
                  </div>
                  <div className={ui.indicatorRight}>
                    <span className={ui.goal}>Meta: {goalText(ind)}</span>
                    <span className={`${ui.result} ${ui.pass}`}>Peso {formatNumber(ind.weight)}%</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>

        <Modal
          open={modal !== null}
          title={modal === "approve" ? "Aprobar indicadores" : "Rechazar indicadores"}
          onClose={closeModal}
          footer={
            <div className={ui.modalFooter}>
              <button type="button" className={`${base.btn} ${base.btnOutline} ${base.btnSm}`} onClick={closeModal} disabled={saving}>
                Cancelar
              </button>
              <button type="button" className={`${base.btn} ${base.btnPrimary} ${base.btnSm}`} onClick={handleConfirm} disabled={saving}>
                {modal === "approve" ? <><Check size={15} /> Sí, aprobar</> : <><X size={15} /> Sí, rechazar</>}
              </button>
            </div>
          }
        >
          {modal === "approve" ? (
            <p className={base.modalText}>
              Al aprobar confirmas que revisaste y aceptas los indicadores asignados para tu proceso de coaching. Esta decisión no se puede modificar.
            </p>
          ) : (
            <div className={base.field}>
              <label className={base.label} htmlFor="ci-reason">Motivo del rechazo</label>
              <textarea
                id="ci-reason"
                className={base.textarea}
                rows={4}
                maxLength={500}
                value={reason}
                onChange={(e) => setReason(e.target.value)}
              />
            </div>
          )}
        </Modal>
      </div>
    );
  }

  /* ===================== LISTADO ===================== */
  const count = (status) => sessions.filter((s) => s.acceptanceStatus === status).length;

  return (
    <>
      <header className={styles.pageHeader}>
        <div>
          <h1 className={styles.title}>Mis indicadores asignados</h1>
          <p className={styles.subtitle}>Consulta los indicadores que te asignaron y apruébalos para iniciar tu proceso de coaching.</p>
        </div>
      </header>

      <div className={base.page}>
        <div className={base.infoBanner}>
          <Info size={16} />
          <span>Solo puedes ver y responder los indicadores asignados a tu usuario.</span>
        </div>

        <div className={ui.stats}>
          <StatCard value={sessions.length} label="Total asignaciones" />
          <StatCard value={count("Pending")} label="Pend. aprobación" tone={ui.pending} />
          <StatCard value={count("Accepted")} label="Aprobadas" tone={ui.approved} />
        </div>

        <section className={base.card}>
          <div className={base.cardHeader}>
            <h2 className={base.cardTitle}>Filtrar</h2>
          </div>
          <div className={base.cardBody}>
            <div className={base.field}>
              <label className={base.label} htmlFor="ci-status">Estado</label>
              <select id="ci-status" className={base.select} value={statusFilter} onChange={(e) => setStatusFilter(e.target.value)}>
                <option value="todos">Todos los estados</option>
                {Object.entries(STATUS_LABEL).map(([value, label]) => <option key={value} value={value}>{label}</option>)}
              </select>
            </div>
          </div>
        </section>

        <div className={ui.list}>
          {loading ? (
            <div className={ui.empty}>Cargando indicadores...</div>
          ) : error ? (
            <div className={ui.empty}>{error}</div>
          ) : filtered.length === 0 ? (
            <div className={ui.empty}>No hay indicadores asignados que coincidan con el filtro.</div>
          ) : (
            filtered.map((s) => (
              <div
                key={s.sessionId}
                className={ui.row}
                onClick={() => setSelectedId(s.sessionId)}
                onKeyDown={(e) => e.target === e.currentTarget && onRowKey(e, () => setSelectedId(s.sessionId))}
                tabIndex={0}
                role="button"
                aria-label={`Ver ${sessionTitle(s)}`}
              >
                <div className={ui.rowAvatar}>{getInitials(s.coachName)}</div>
                <div className={ui.rowInfo}>
                  <div className={ui.rowTitle}>{sessionTitle(s)}</div>
                  <div className={ui.rowSub}>Coach: {s.coachName ?? "—"} · {s.indicators.length} indicadores asignados</div>
                </div>
                <div className={ui.rowRight}>
                  <span className={`${ui.pill} ${STATUS_PILL[s.acceptanceStatus]}`}>{STATUS_LABEL[s.acceptanceStatus]}</span>
                  <span className={ui.rowDate}>{formatDate(s.createdAt)}</span>
                </div>
              </div>
            ))
          )}
        </div>
      </div>
    </>
  );
};

