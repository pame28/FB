	       ,@opeRegion CHAR(1)
	       ,@opeRefinByte CHAR(1)
	       ,@opeVecesRefin NUMERIC(3,0)
	       ,@opeFecUltPagCapital CHAR(8)
		   ,@opeCAT SMALLMONEY
		   ,@opeMontoCuotaPagar MONEY
		   ,@opeTasaInteresMoratoria SMALLMONEY
		   ,@opeSaldoTotal MONEY
	
		
	--Campos para calculos      
	DECLARE @ID AS INT
	DECLARE @TipoCambio AS DECIMAL(6 ,4)
	DECLARE @factor AS DECIMAL(6,4)
	DECLARE @Moneda AS CHAR(2)
	DECLARE @FechaOtorgado AS CHAR(8)
	DECLARE @Estado AS int
	DECLARE @BIN AS CHAR(8)
	DECLARE @MontoOtorgado AS DECIMAL(12,2)
	DECLARE @Tasa AS DECIMAL(6,2)
	DECLARE @SaldoActual AS DECIMAL(12,2)
	DECLARE @NumeroCuotas AS DECIMAL(3,0)
	DECLARE @FechaVencimiento AS VARCHAR(8)
	DECLARE @TRUNCAR AS BIT
	
	--Estable si se debe truncar al redondear
	SET @TRUNCAR = 1
	--Factor de cambio y fecha de Proceso
	SELECT @TipoCambio = g.genTasa
	      ,@opeFecRep = CONVERT(VARCHAR(8) ,g.genFecha ,112)
	FROM   GENERALES g
	WHERE  g.genStatus = 1
	
	--Obtenemos el primer ID para realizar el Ciclo
	SELECT @ID = MIN(t.ID)
	FROM TMPExtrasVASA t
	
	--Recorremos todos los registros
	WHILE (@ID IS NOT NULL)
	BEGIN
	    --Obtenemos los datos de la tabla
	    SELECT 
	          @CifCliente               = t.CIF
	          ,@opeNum					 = 'EF' + RTRIM(LTRIM(t.IdExtra))
	          ,@opeProducto              = 0
	          ,@opeEmpresa               = '1'
	          ,@opeGar                   = '09'
	          ,@opeTipo                  = '130100'
	          ,@opeTipIns                = '01'
	          ,@opeCodIns                = '15'
	          ,@OpeProductoByte          = 'EF'
	          ,@opeStatusByte            = 0
	          ,@opeFrecPagInt            = 0
	          ,@opeSector                = 0
	          ,@opeOficial               = 0
	          ,@opeInCong                = ''
	          ,@opeRegion                = 'U'
	          ,@opeRefinByte             = ' '
	          ,@opeTasa                  = 0
	          ,@opeDepto                 = '01'
	          ,@opeZona                  = '01'
	          ,@opeGenDiv				 = 'ZZ'
	          ,@opeFdic                  = '140107'
	          ,@opeTipCred				 = 2
	          ,@opeOrigen				 = 1
	          ,@opeForPago				 = '11' --Requerimiento 109-2016
	          ,@opeSaldoVi               = 0
	          ,@opeSaldoMo               = 0
	          ,@opeSaldoCo               = 0
	          ,@opeSaldoVe               = 0
	          ,@opeSaldoEj               = 0
	          ,@opeSalCXC                = 0
	          ,@opeSaldoCa               = 0
	          ,@opeIntXcob               = 0
	          ,@opeIntSus                = 0
	          ,@opeMoraCap               = 0
	          ,@opeMoraInt               = 0
	          ,@opeMontoOt               = 0
			  ,@opeDiasMora              = 0
	          ,@opeCredEsp               = 0
	          ,@opeRefin                 = ''
	          ,@opeCateg                 = 'CFM'
	          ,@opeBrch                  = 1
	          ,@opePerGra                = 0
	          ,@opeVecesRefin            = 0
	          ,@opeValGar				 = 0
	          ,@opeFecUltPagCapital		 = ''--Campos capturador 2015
			  ,@opeCAT					 = 0 --Campos capturador 2015
			  ,@opeTasaInteresMoratoria  = 0 --Campos capturador 2015
			  ,@opeSaldoTotal			 = 0 --Campos capturador 2015
	          ,@Moneda					 = t.Moneda
	          ,@FechaOtorgado			 = t.FechaOtorgado
	          ,@Estado					 = t.Estado
	          ,@MontoOtorgado		     = t.MontoOtorgado
	          ,@Tasa					 = t.Tasa
	          ,@SaldoActual			     = t.SaldoActual
	          ,@BIN					     = t.BIN
	          ,@NumeroCuotas			 = t.NumeroCuotas
	          ,@FechaVencimiento         = t.FechaVencimiento
	          ,@opeMontoCuotaPagar		 = t.MontoCuota --Campos capturador 2015	
	    FROM TMPExtrasVASA t
	    WHERE  T.ID = @ID
	    
	    
	    
	    --PRINT 'Procesando operacion: ID = ' + CAST(@ID AS VARCHAR(20)) + 
	    --', NO = ' + @opeNum
	    --Moneda
	    SET @opeMoneda = CASE @Moneda
	                          WHEN 'HN' THEN 1
	                          ELSE 2
	                     END
	    
	    --Factor de cambio
	    IF (@opeMoneda = 2)
	        SET @factor = @TipoCambio
	    ELSE
	        SET @factor = 1
	    
	    --Estado
	    IF(@Estado IN(10, 22))
			SET @opeStatus = 2
		ELSE
			SET @opeStatus = 0
	
		 --Fecha de otorgado
	    IF (ISDATE(@FechaOtorgado) = 1)
			IF(@FechaOtorgado > @opeFecRep)
				set @opeFecOto = @opeFecRep
			ELSE
				SET @opeFecOto = @FechaOtorgado
	    ELSE
	        SET @opeFecOto = @opeFecRep		 
		
	    --Fecha de vencimiento
	    --SET @opeFecVen = CONVERT(VARCHAR(8),DATEADD(MM, @T1RPLA, @opeFecOto), 112)
	    
	    --Fecha de vencimiento tomando en cuenta la fecha de corte
	    SET @opeFecVen = @FechaVencimiento 
	    
	        
	    SET @opeTasa = @Tasa
	    
	    IF(@TRUNCAR = 1)
			SET @opeMontoOt = ROUND(@MontoOtorgado * @factor,2,1)
		ELSE
			SET @opeMontoOt = CAST(@MontoOtorgado * @factor AS NUMERIC(18,2))
			
		IF(@TRUNCAR = 1)
			SET @opeSaldoVi = ROUND(@SaldoActual * @factor,2,1)
		ELSE
			SET @opeSaldoVi = CAST(@SaldoActual * @factor AS NUMERIC(18,2))
		
		IF(@opeStatus = 2)
		BEGIN
			set @opeSaldoCa =  @opeSaldoVi
			SET @opeSaldoVi = 0
		END
		
		/*******************************************************************/
	    --Ajuste monto Cuota a Pagar
	    --Requerimiento 107-2016
	    --Fecha: 2016-08-26
	    
	    --Para las operaciones, Vencidas, Ejecución y Castigado, se debe reportar 0
		IF(@opeSaldoVe > 0 OR @opeSaldoEj > 0 OR @opeSaldoCa > 0)
		BEGIN
			SET @opeMontoCuotaPagar = @SaldoActual
		END
		/*********************Fin requerimiento 107-2016***************************/
	    

		--Validacion para colocar la empresa 3 para los extras castigados
		IF @opeSaldoCa > 0
			SET @opeEmpresa = '3'
	    
	    EXECUTE usp_OPERACIONES_INSERT
	    @opeNum,
	    @opeMoneda,
	    @CifCliente,
	    @opeTipIns,
	    @opeCodIns,
	    @opeFecRep,
	    @opeFecOto,
	    @opeFecVen,
	    @opeSaldoVi,
	    @opeSaldoMo,
	    @opeSaldoVe,
	    @opeSaldoCo,
	    @opeSaldoEj,
	    @opeSaldoCa,
	    @opeGar,
	    @opeTipo,
	    @opeCateg,
	    @opeTipCred,
	    @opeMontoOt,
	    @opeIntXcob,
	    @opeIntSus,
	    @opeValGar,
	    @opeTasa,
	    @opeForPago,
	    @opePerGra,
	    @opeDiasMora,
	    @opeCredEsp,
	    @opeSalCXC,
	    @opeRefin,
	    @opeMoraCap,
	    @opeZona,
	    @opeMoraInt,
	    @opeDepto,
	    @opeFdic,
	    @opeBrch,
	    @opeStatus,
	    @opeProducto,
	    @opeOrigen,
	    @opeEmpresa,
	    @OpeProductoByte,
	    @opeStatusByte,
	    @opeFrecPagInt,
	    @opeSector,
	    @opeOficial,
	    @opeInCong,
	    @opeGenDiv,
	    @opeRegion,
	    @opeRefinByte,
	    @opeVecesRefin
	     ,@opeFecUltPagCapital
	   ,@opeCAT
	   ,@opeMontoCuotaPagar
	   ,@opeTasaInteresMoratoria
	   ,@opeSaldoTotal
	    
	    
	    SELECT @ID = MIN(t.ID)
	    FROM TMPExtrasVASA t
	    WHERE  T.ID > @ID
	END
	
	
	
	
	
	
	
END




