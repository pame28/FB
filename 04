export const MODULES = RAW_MODULES.map((m) => ({
  ...m,
  pages: m.pages.map((p) => {
    const fullPath = `${m.path}/${p.path}`;
    return {
      ...p,
      fullPath,
      children: (p.children ?? []).map((c) => ({ ...c, fullPath: `${fullPath}/${c.path}` })),
    };
  }),
}));









export const getBreadcrumb = (pathname) => {
  const module = MODULES.find((m) => pathname === m.path || pathname.startsWith(`${m.path}/`));
  if (!module) return [];

  const crumbs = [{ label: module.label, to: module.path }];
  const page = module.pages.find((p) => pathname === p.fullPath || pathname.startsWith(`${p.fullPath}/`));

  if (page) {
    crumbs.push({ label: page.label, to: page.fullPath });
    const child = page.children.find((c) => pathname.startsWith(c.fullPath));
    if (child) crumbs.push({ label: child.label, to: child.fullPath });
  }
  return crumbs;
};










