import { useEffect, useMemo, useState } from "react";
import { AlertCircle, Check, Loader2, TriangleAlert } from "lucide-react";
import { Modal } from "../../../../shared/components";
import { teamsService } from "../../../../api/teamsService";
import { useAvailableUsers } from "./useAvailableUsers";
import { UserPickList } from "./UserPickList";
import pages from "../../../Pages.module.css";
import t from "./Teams.module.css";

export function LeadersModal({ team, onClose, onSaved }) {
  const open = Boolean(team);
  const available = useAvailableUsers("leaders", team?.areaId, open);

  const [selectedIds, setSelectedIds] = useState([]);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState("");

  useEffect(() => {
    if (team) {
      setSelectedIds(team.leaders.map((l) => l.id));
      setError("");
    }
  }, [team]);

  // Líderes actuales (marcados como "Actual") + disponibles del área
  const options = useMemo(() => {
    if (!team) return [];
    const current = team.leaders.map((l) => ({ ...l, code: "", branch: "", isCurrent: true }));
    const ids = new Set(current.map((c) => c.id));
    return [...current, ...available.items.filter((u) => !ids.has(u.id))];
  }, [team, available.items]);

  const removed = team ? team.leaders.filter((l) => !selectedIds.includes(l.id)) : [];
  const unchanged = team
    && removed.length === 0
    && selectedIds.length === team.leaders.length;

  const handleSave = async () => {
    setSaving(true);
    setError("");
    try {
      await teamsService.update(team.id, {
        name: team.name,
        companyAreaId: team.areaId,
        leaderUserIds: selectedIds,
      });
      onSaved();
    } catch (err) {
      setError(err.noAccess
        ? "No tienes permiso para cambiar líderes."
        : err.response?.data?.message ?? "No se pudo actualizar el líder. Intenta de nuevo.");
    } finally {
      setSaving(false);
    }
  };

  const handleClose = () => { if (!saving) onClose(); };

  return (
    <Modal
      open={open}
      title={team ? `Líderes — ${team.name}` : ""}
      onClose={handleClose}
      footer={
        <>
          <button type="button" className={`${pages.btn} ${pages.btnOutline}`} onClick={handleClose} disabled={saving}>Cancelar</button>
          <button type="button" className={`${pages.btn} ${pages.btnPrimary}`} onClick={handleSave} disabled={saving || unchanged}>
            {saving ? <Loader2 size={16} className={pages.spin} /> : <Check size={16} />}
            {saving ? "Guardando..." : "Confirmar cambio"}
          </button>
        </>
      }
    >
      {error && (
        <div className={`${pages.banner} ${pages.bannerError}`} role="alert">
          <AlertCircle size={18} />
          <p>{error}</p>
        </div>
      )}

      {removed.length > 0 && (
        <div className={t.warnBox}>
          <TriangleAlert size={16} />
          <p>
            {removed.map((l) => l.name).join(", ")} {removed.length === 1 ? "será desvinculado" : "serán desvinculados"} del equipo.
            {selectedIds.length === 0 && " El equipo quedará sin líder."}
          </p>
        </div>
      )}

      <UserPickList
        users={options}
        selectedIds={selectedIds}
        onChange={setSelectedIds}
        loading={available.loading && options.length === 0}
        error={options.length === 0 ? available.error : ""}
        emptyMessage="No hay líderes disponibles en el área del equipo."
        showSelectAll={false}
      />
    </Modal>
  );
}












import { useEffect, useMemo, useState } from "react";
