import { useEffect, useMemo, useState } from "react";
import {
  AlertCircle, FileSpreadsheet, FileText, Info,
  Loader2, Pencil, Plus, Search, Trash2, TriangleAlert,
} from "lucide-react";
import { Can, ConfirmDialog, Datatable, useToast } from "../../../shared/components";
import { usersService, USER_STATUS } from "../../../api/usersService";
import { useCatalogs } from "../../../hooks/useCatalogs";
import { useDebounce } from "../../../hooks/useDebounce";
import { downloadBlob, readBlobError } from "../../../helpers/downloadFile";
import { fullName, initials, userColumns } from "./components/UserColumns";
import { UserFormModal } from "./components/UserFormModal";
import styles from "../../Pages.module.css";

const PAGE_SIZE = 10;
const EMPTY_FILTERS = { search: "", roleId: "", companyAreaId: "", companyPositionId: "", status: "" };

const toNumber = (value) => (value === "" ? undefined : Number(value));


function StatCard({ value, label, tone }) {
  return (
    <div className={`${styles.statCard} ${tone}`}>
      <div className={styles.statValue}>{value ?? "—"}</div>
      <div className={styles.statLabel}>{label}</div>
    </div>
  );
}

export const UsuariosRolesPage = () => {
  const catalogs = useCatalogs();
  const toast = useToast();
  const [filters, setFilters] = useState(EMPTY_FILTERS);
  const [firstLoad, setFirstLoad] = useState(true);
  const search = useDebounce(filters.search, 400);
  const [page, setPage] = useState(1);

  const [result, setResult] = useState({ items: [], totalCount: 0, totalPages: 0, pageSize: PAGE_SIZE });
  const [stats, setStats] = useState({ active: null, inactive: null });
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [exporting, setExporting] = useState(null); // "excel" | "pdf" | null
  const [reloadKey, setReloadKey] = useState(0);

  // Formulario: open + user (null = crear, objeto = editar)
  const [form, setForm] = useState({ open: false, user: null });

  // Eliminar
  const [toDelete, setToDelete] = useState(null);
  const [deleting, setDeleting] = useState(false);
  const [deleteError, setDeleteError] = useState("");

  // Filtros en el formato que espera la API
  const request = useMemo(() => ({
    search: search.trim() || undefined,
    roleId: toNumber(filters.roleId),
    companyAreaId: toNumber(filters.companyAreaId),
    companyPositionId: toNumber(filters.companyPositionId),
    status: toNumber(filters.status),
  }), [search, filters.roleId, filters.companyAreaId, filters.companyPositionId, filters.status]);

  const hasFilters = Object.values(filters).some((v) => v !== "");

  // Lista de usuarios
  useEffect(() => {
    let cancelled = false;
    setLoading(true);
    setError("");

    usersService
      .filter({ ...request, pageNumber: page, pageSize: PAGE_SIZE })
      .then((data) => { if (!cancelled) setResult(data); setFirstLoad(false); })
      .catch((err) => {
        if (!cancelled) setError(err.noAccess
          ? "No tienes permiso para ver la lista de usuarios."
          : "No se pudo cargar la lista de usuarios. Intenta de nuevo.");
      })
      .finally(() => { if (!cancelled) setLoading(false); });

    return () => { cancelled = true; };
  }, [request, page, reloadKey]);

  // Tarjetas: usan los mismos filtros que la tabla
  useEffect(() => {
    let cancelled = false;

    const count = (status) =>
      usersService
        .filter({ ...request, status, pageNumber: 1, pageSize: 1 })
        .then((d) => d.totalCount)
        .catch(() => null);

    // Si ya se filtró por un estado, el otro estado es 0 sin necesidad de consultar
    const applies = (status) => request.status === undefined || request.status === status;

    Promise.all([
      applies(USER_STATUS.ACTIVO) ? count(USER_STATUS.ACTIVO) : 0,
      applies(USER_STATUS.INACTIVO) ? count(USER_STATUS.INACTIVO) : 0,
    ]).then(([active, inactive]) => {
      if (!cancelled) setStats({ active, inactive });
    });

    return () => { cancelled = true; };
  }, [request, reloadKey]);


  const handleFilterChange = (e) => {
    const { name, value } = e.target;
    setFilters((f) => ({ ...f, [name]: value }));
    setPage(1);
  };

  const clearFilters = () => {
    setFilters(EMPTY_FILTERS);
    setPage(1);
  };

  // Exporta TODOS los usuarios filtrados (no solo la página actual)
  const handleExport = async (type) => {
    const label = type === "excel" ? "Excel" : "PDF";
    setExporting(type);
    try {
      const exportRequest = { ...request, pageNumber: 1, pageSize: Math.max(result.totalCount, 1) };
      const response = type === "excel"
        ? await usersService.exportExcel(exportRequest)
        : await usersService.exportPdf(exportRequest);
      downloadBlob(response, type === "excel" ? "usuarios.xlsx" : "usuarios.pdf");
      toast.success(`${label} generado`, `Se exportaron ${result.totalCount} usuarios.`);
    } catch (err) {
      const apiMessage = await readBlobError(err);
      toast.error(
        `No se pudo exportar a ${label}`,
        err.noAccess ? "No tienes permiso para exportar usuarios." : apiMessage ?? "Intenta de nuevo en unos momentos."
      );
    } finally {
      setExporting(null);
    }
  };

  const handleSaved = (user, isEdit) => {
    setForm({ open: false, user: null });
    toast.success(
      isEdit ? "Usuario actualizado" : "Usuario creado",
      isEdit
        ? `Los datos de ${fullName(user)} se actualizaron correctamente.`
        : `${fullName(user)} se agregó al sistema.`
    );
    setReloadKey((k) => k + 1);
  };

  const openDelete = (user) => {
    setDeleteError("");
    setToDelete(user);
  };

  const confirmDelete = async () => {
    setDeleting(true);
    setDeleteError("");
    try {
      await usersService.remove(toDelete.id);
      toast.success("Usuario eliminado", `${fullName(toDelete)} se eliminó del sistema.`);
      setToDelete(null);
      // Si era el último de la página, regresa a la anterior
      if (result.items.length === 1 && page > 1) setPage((p) => p - 1);
      else setReloadKey((k) => k + 1);
    } catch (err) {
      setDeleteError(err.noAccess
        ? "No tienes permiso para eliminar usuarios."
        : err.response?.data?.message ?? "No se pudo eliminar el usuario. Intenta de nuevo.");
    } finally {
      setDeleting(false);
    }
  };

  const columns = [
    ...userColumns,
    {
      key: "actions",
      header: "Acciones",
      align: "right",
      render: (u) => (
        <div className={styles.rowActions}>
          <Can permission="edit.users">
            <button type="button" className={styles.iconBtn} title="Editar"
              aria-label={`Editar a ${fullName(u)}`} onClick={() => setForm({ open: true, user: u })}>
              <Pencil size={16} />
            </button>
          </Can>
          <Can permission="delete.users">
            <button type="button" className={`${styles.iconBtn} ${styles.iconBtnDanger}`} title="Eliminar"
              aria-label={`Eliminar a ${fullName(u)}`} onClick={() => openDelete(u)}>
              <Trash2 size={16} />
            </button>
          </Can>
        </div>
      ),
    },
  ];

  return (
    <>
      <header className={styles.pageHeader}>
        <div>
          <span className={styles.eyebrow}>Administración</span>
          <h1 className={styles.title}>Usuarios del sistema</h1>
          <p className={styles.subtitle}>Gestiona el acceso y el rol asignado. Cada usuario tiene un único rol.</p>
        </div>

        <div className={styles.actions}>
          <button type="button" className={`${styles.btn} ${styles.btnOutline} ${styles.btnExcel}`}
            onClick={() => handleExport("excel")} disabled={exporting !== null}>
            {exporting === "excel" ? <Loader2 size={18} className={styles.spin} /> : <FileSpreadsheet size={18} />}
            Exportar Excel
          </button>

          <button type="button" className={`${styles.btn} ${styles.btnOutline} ${styles.btnPdf}`}
            onClick={() => handleExport("pdf")} disabled={exporting !== null}>
            {exporting === "pdf" ? <Loader2 size={18} className={styles.spin} /> : <FileText size={18} />}
            Exportar PDF
          </button>

          <Can permission="create.users">
            <button type="button" className={`${styles.btn} ${styles.btnPrimary}`}
              onClick={() => setForm({ open: true, user: null })}>
              <Plus size={18} /> Nuevo usuario
            </button>
          </Can>
        </div>
      </header>

      <section className={styles.stats} aria-label="Resumen de usuarios">
        <StatCard
          value={firstLoad ? null : result.totalCount}
          label={hasFilters ? "Usuarios encontrados" : "Usuarios totales"}
          tone={styles.statTeal}
        />
        <StatCard value={stats.active} label="Activos" tone={styles.statYellow} />
        <StatCard value={stats.inactive} label="Inactivos" tone={styles.statBlue} />
      </section>

      <div className={styles.banner}>
        <Info size={18} />
        <p>
          Los permisos se heredan del <strong>rol asignado</strong>. Para cambiar los permisos de un grupo
          de usuarios, modifica el rol en <strong>Permisos por rol</strong>.
        </p>
      </div>

      {catalogs.warnings.map((warning) => (
        <div key={warning} className={`${styles.banner} ${styles.bannerWarning}`} role="status">
          <TriangleAlert size={18} />
          <p>{warning} Algunos filtros u opciones no estarán disponibles.</p>
        </div>
      ))}


      {error && (
        <div className={`${styles.banner} ${styles.bannerError}`} role="alert">
          <AlertCircle size={18} />
          <p>{error}</p>
        </div>
      )}

      <section className={styles.panel}>
        <div className={styles.toolbar}>
          <label className={styles.search}>
            <Search size={16} />
            <input name="search" className={styles.input} placeholder="Buscar por nombre o usuario"
              value={filters.search} onChange={handleFilterChange} aria-label="Buscar usuarios" />
          </label>

          <select name="roleId" className={styles.select} value={filters.roleId}
            onChange={handleFilterChange} aria-label="Filtrar por rol">
            <option value="">Todos los roles</option>
            {catalogs.roles.map((r) => <option key={r.value} value={r.value}>{r.label}</option>)}
          </select>

          {catalogs.areas.length > 0 && (
            <select name="companyAreaId" className={styles.select} value={filters.companyAreaId}
              onChange={handleFilterChange} aria-label="Filtrar por área">
              <option value="">Todas las áreas</option>
              {catalogs.areas.map((a) => <option key={a.value} value={a.value}>{a.label}</option>)}
            </select>
          )}

          {catalogs.positions.length > 0 && (
            <select name="companyPositionId" className={styles.select} value={filters.companyPositionId}
              onChange={handleFilterChange} aria-label="Filtrar por puesto">
              <option value="">Todos los puestos</option>
              {catalogs.positions.map((p) => <option key={p.value} value={p.value}>{p.label}</option>)}
            </select>
          )}

          <select name="status" className={styles.select} value={filters.status}
            onChange={handleFilterChange} aria-label="Filtrar por estado">
            <option value="">Todos los estados</option>
            <option value={USER_STATUS.ACTIVO}>Activo</option>
            <option value={USER_STATUS.INACTIVO}>Inactivo</option>
          </select>

          {hasFilters && (
            <button type="button" className={styles.linkBtn} onClick={clearFilters}>Limpiar filtros</button>
          )}

          <span className={styles.count}>{result.totalCount} usuarios</span>
        </div>

        <Datatable
          columns={columns}
          rows={result.items}
          loading={loading}
          emptyMessage={hasFilters ? "Ningún usuario coincide con los filtros." : "Aún no hay usuarios registrados."}
          pagination={{
            page,
            pageSize: result.pageSize || PAGE_SIZE,
            totalCount: result.totalCount,
            totalPages: result.totalPages,
            onPageChange: setPage,
          }}
        />
      </section>

      <UserFormModal
        open={form.open}
        user={form.user}
        onClose={() => setForm({ open: false, user: null })}
        onSaved={handleSaved}
        catalogs={catalogs}
      />


      <ConfirmDialog
        open={Boolean(toDelete)}
        danger
        title="¿ Seguro de Eliminar usuario?"
        message="Esta acción no se puede deshacer."
        detail={toDelete && (
          <div className={styles.personChip}>
            <div className={styles.personAvatar}>{initials(toDelete)}</div>
            <div className={styles.personInfo}>
              <span className={styles.personName}>{fullName(toDelete)}</span>
              <span className={styles.personMeta}>Usuario: {toDelete.userName}</span>
            </div>
          </div>
        )}
        confirmText={deleting ? "Eliminando..." : "Sí, eliminar"}
        loading={deleting}
        error={deleteError}
        onConfirm={confirmDelete}
        onCancel={() => setToDelete(null)}
      />
    </>
  );
};



