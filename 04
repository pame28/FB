using System.ComponentModel.DataAnnotations;

namespace ApiCoaching.Models
{
    public class CoachingSession : BaseEntity
    {
        [Key]
        public long Id { get; set; }

        public int TeamId { get; set; }

        [MaxLength(50)]
        public string MemberUserId { get; set; } = null!;

        public CoachingSessionAcceptanceStatus AcceptanceStatus { get; private set; } =
            CoachingSessionAcceptanceStatus.Pending;

        public DateTime? AcceptedAt { get; private set; }

        public DateTime? AcceptanceRejectedAt { get; private set; }

        [MaxLength(500)]
        public string? AcceptanceRejectionReason { get; private set; }

        public CoachingSessionReviewStatus ReviewStatus { get; private set; } =
            CoachingSessionReviewStatus.NotSubmitted;

        public DateTime? SubmittedAt { get; private set; }

        public DateTime? ReviewedAt { get; private set; }

        [MaxLength(50)]
        public string? ReviewedBy { get; private set; }

        [MaxLength(500)]
        public string? ReviewRejectionReason { get; private set; }

        public virtual TeamMember TeamMember { get; set; } = null!;

        public virtual ICollection<TeamMemberIndicatorAssignment> IndicatorAssignments { get; set; } = [];

        public virtual CoachingActionPlan? ActionPlan { get; set; }

        public void Accept(string userId)
        {
            ValidateMember(userId);
            ValidatePendingAcceptance();

            AcceptanceStatus = CoachingSessionAcceptanceStatus.Accepted;
            AcceptedAt = DateTime.UtcNow;
            RecordDecision(userId, AcceptedAt.Value);
        }

        public void RejectAcceptance(string userId, string reason)
        {
            ValidateMember(userId);
            ValidatePendingAcceptance();
            var validatedReason = ValidateReason(reason);

            AcceptanceStatus = CoachingSessionAcceptanceStatus.Rejected;
            AcceptanceRejectedAt = DateTime.UtcNow;
            AcceptanceRejectionReason = validatedReason;
            RecordDecision(userId, AcceptanceRejectedAt.Value);
        }

        public void SubmitForReview()
        {
            if (AcceptanceStatus != CoachingSessionAcceptanceStatus.Accepted)
            {
                throw new InvalidOperationException("El colaborador debe aceptar el inicio del coaching antes de enviar la sesión a revisión.");
            }

            if (ReviewStatus != CoachingSessionReviewStatus.NotSubmitted)
            {
                throw new InvalidOperationException("La sesión ya fue enviada a revisión.");
            }

            if (IndicatorAssignments.Count == 0 || IndicatorAssignments.Any(assignment =>
                !assignment.AchievedValue.HasValue || !assignment.AchievementPercentage.HasValue || !assignment.EvaluatedAt.HasValue))
            {
                throw new InvalidOperationException("Debes completar todos los resultados de la sesión antes de enviarla a revisión.");
            }

            if (ActionPlan is null || ActionPlan.Actions.Count == 0)
            {
                throw new InvalidOperationException("La sesión debe tener un plan con al menos una acción antes de enviarla a revisión.");
            }

            ReviewStatus = CoachingSessionReviewStatus.Pending;
            SubmittedAt = DateTime.UtcNow;
        }

        public void ApproveReview(string userId)
        {
            ValidateMember(userId);
            ValidatePendingReview();

            ReviewStatus = CoachingSessionReviewStatus.Approved;
            ReviewedAt = DateTime.UtcNow;
            ReviewedBy = userId;
            RecordDecision(userId, ReviewedAt.Value);
        }

        public void RejectReview(string userId, string reason)
        {
            ValidateMember(userId);
            ValidatePendingReview();
            var validatedReason = ValidateReason(reason);

            ReviewStatus = CoachingSessionReviewStatus.Rejected;
            ReviewedAt = DateTime.UtcNow;
            ReviewedBy = userId;
            ReviewRejectionReason = validatedReason;
            RecordDecision(userId, ReviewedAt.Value);
        }

        private void ValidateMember(string userId)
        {
            if (string.IsNullOrWhiteSpace(userId) || string.IsNullOrWhiteSpace(MemberUserId) ||
                !string.Equals(MemberUserId, userId, StringComparison.OrdinalIgnoreCase))
            {
                throw new InvalidOperationException("Solo el colaborador relacionado con la sesión puede aceptar, aprobar o rechazar el coaching.");
            }
        }

        private void ValidatePendingAcceptance()
        {
            if (AcceptanceStatus != CoachingSessionAcceptanceStatus.Pending)
            {
                throw new InvalidOperationException("La aceptación del inicio del coaching ya fue respondida.");
            }
        }

        private void ValidatePendingReview()
        {
            if (ReviewStatus != CoachingSessionReviewStatus.Pending)
            {
                throw new InvalidOperationException("Solo se puede aprobar o rechazar una sesión pendiente de revisión.");
            }
        }

        private static string ValidateReason(string reason)
        {
            if (string.IsNullOrWhiteSpace(reason) || reason.Trim().Length > 500)
            {
                throw new ArgumentException("Debes indicar un motivo de rechazo de hasta 500 caracteres.", nameof(reason));
            }

            return reason.Trim();
        }

        private void RecordDecision(string userId, DateTime decidedAt)
        {
            LastModifiedAt = decidedAt;
            LastModifiedBy = userId;
        }
    }

    public enum CoachingSessionAcceptanceStatus
    {
        Pending = 0,
        Accepted = 1,
        Rejected = 2
    }

    public enum CoachingSessionReviewStatus
    {
        NotSubmitted = 0,
        Pending = 1,
        Approved = 2,
        Rejected = 3
    }
}




