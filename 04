    const [search, setSearch] = useState("");

    // El backend ya devuelve solo los equipos asignados, sin importar quién aplicó la certificación
    const mine = certifications;
    const certifiers = [...new Set(mine.map((c) => c.certifier))];

    const q = search.trim().toLowerCase();
