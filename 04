        public Boolean blnAutorizado(DataRow drDatos)
        {
            AppLogger.Debug("blnAutorizado - Validando si esta autorizado");
            AppLogger.Debug($"Datos Parametrizados:  {drDatos.Table.DataSet.GetXml()}");
            Boolean blnAutorizado = true;
            int reglaNoAceptada = 0;

            try
            {
                int diasAutorizados = Convert.ToInt32(drDatos["DiasAutorizados"]);
                if (DateTime.Now >= Convert.ToDateTime(drDatos["FechaCorteProx"]).AddDays(-diasAutorizados) && DateTime.Now <= Convert.ToDateTime(drDatos["FechaCorteProx"]))
                {
                    reglaNoAceptada = 1;
                    blnAutorizado = false;
                }
                if (Convert.ToInt32(drDatos["DiasMoraML"]) > 0)
                {
                    reglaNoAceptada = 2;
                    blnAutorizado = false;
                }
                if (Convert.ToInt32(drDatos["DiasMoraUSD"]) > 0)
                {
                    reglaNoAceptada = 3;
                    blnAutorizado = false;
                }
                if (Convert.ToDouble(drDatos["SaldoActualML"]) + (Convert.ToDouble(drDatos["SaldoActualUSD"]) * Convert.ToDouble(drDatos["TipoCambioVendedor"]))
                    >= (Convert.ToDouble(drDatos["ImporteLimiteCompra"]) * Convert.ToDouble(drDatos["TipoCambioVendedor"])))
                {
                    reglaNoAceptada = 4;
                    blnAutorizado = false;
                }
            }
            catch (Exception ex)
            {
                blnAutorizado = false;
                AppLogger.Error($"Error al verificar método autorizado: {ex.Message.ToString()}");
            }


            AppLogger.Info($"Cliente Autorizado - Resultado: { blnAutorizado }; Regla: {reglaNoAceptada.ToString()}");
            return blnAutorizado;
        }

