import { useEffect, useState } from "react";
import { AlertCircle, Loader2 } from "lucide-react";
import { Modal } from "../../../../shared/components";
import styles from "../../../Pages.module.css";

const FORM_ID = "catalog-form";

// "Name" (backend) → "name" (formulario)
const mapApiErrors = (errors = {}) =>
  Object.fromEntries(
    Object.entries(errors).map(([key, msg]) => [key.charAt(0).toLowerCase() + key.slice(1), msg])
  );

const toValues = (fields, item) =>
  Object.fromEntries(fields.map((f) => [f.name, item?.[f.name] ?? ""]));

const validate = (fields, values) => {
  const errors = {};
  fields.forEach((f) => {
    const value = String(values[f.name] ?? "").trim();
    if (f.required && !value) {
      errors[f.name] = `${f.label} es obligatorio.`;
    } else if (f.type === "number" && value && (!Number.isInteger(Number(value)) || Number(value) < 0)) {
      errors[f.name] = `${f.label} debe ser un número entero positivo.`;
    }
  });
  return errors;
};

const toBody = (fields, values) =>
  Object.fromEntries(
    fields.map((f) => [f.name, f.type === "number" ? Number(values[f.name]) : String(values[f.name]).trim()])
  );

export function CatalogFormModal({ open, item, config, onClose, onSaved }) {
  const { singular, feminine, fields, service } = config;
  const isEdit = Boolean(item);
  const e = feminine ? "a" : "o";

  const [values, setValues] = useState({});
  const [errors, setErrors] = useState({});
  const [saving, setSaving] = useState(false);
  const [submitError, setSubmitError] = useState("");

  useEffect(() => {
    if (open) {
      setValues(toValues(fields, item));
      setErrors({});
      setSubmitError("");
    }
  }, [open, item, fields]);

  const handleChange = (ev) => {
    const { name, value } = ev.target;
    setValues((v) => ({ ...v, [name]: value }));
    setErrors((err) => ({ ...err, [name]: undefined }));
  };

  const handleSubmit = async (ev) => {
    ev.preventDefault();
    const found = validate(fields, values);
    setErrors(found);
    if (Object.keys(found).length > 0) return;

    setSaving(true);
    setSubmitError("");
    const body = toBody(fields, values);

    try {
      const saved = isEdit ? await service.update(item.id, body) : await service.create(body);
      onSaved(saved ?? { ...item, ...body }, isEdit);
    } catch (err) {
      const data = err.response?.data;
      if (data?.errors) setErrors(mapApiErrors(data.errors));
      setSubmitError(
        err.noAccess
          ? `No tienes permiso para ${isEdit ? "editar" : "crear"} ${config.plural}.`
          : data?.message ?? "No se pudo guardar. Intenta de nuevo."
      );
    } finally {
      setSaving(false);
    }
  };

  const handleClose = () => { if (!saving) onClose(); };

  return (
    <Modal
      open={open}
      size="sm"
      title={`${isEdit ? "Editar" : `Nuev${e}`} ${singular}`}
      onClose={handleClose}
      footer={
        <>
          <button type="button" className={`${styles.btn} ${styles.btnOutline}`} onClick={handleClose} disabled={saving}>
            Cancelar
          </button>
          <button type="submit" form={FORM_ID} className={`${styles.btn} ${styles.btnPrimary}`} disabled={saving}>
            {saving && <Loader2 size={18} className={styles.spin} />}
            {saving ? "Guardando..." : isEdit ? "Guardar cambios" : "Guardar"}
          </button>
        </>
      }
    >
      <form id={FORM_ID} className={styles.form} style={{ gridTemplateColumns: "1fr" }} onSubmit={handleSubmit} noValidate>
        {submitError && (
          <div className={`${styles.banner} ${styles.bannerError}`} role="alert" style={{ marginBottom: 0 }}>
            <AlertCircle size={18} />
            <p>{submitError}</p>
          </div>
        )}

        {fields.map((f, index) => (
          <div key={f.name} className={styles.field}>
            <label className={styles.label} htmlFor={`catalog-${f.name}`}>
              {f.label}
              {f.required && <span className={styles.required}>*</span>}
            </label>
            <input
              id={`catalog-${f.name}`}
              name={f.name}
              type={f.type === "number" ? "number" : "text"}
              min={f.type === "number" ? 0 : undefined}
              inputMode={f.type === "number" ? "numeric" : undefined}
              className={`${styles.input} ${errors[f.name] ? styles.invalid : ""}`}
              placeholder={f.placeholder}
              value={values[f.name] ?? ""}
              onChange={handleChange}
              aria-invalid={!!errors[f.name]}
              autoFocus={index === 0}
              autoComplete="off"
            />
            {errors[f.name] && <span className={styles.fieldError}>{errors[f.name]}</span>}
          </div>
        ))}
      </form>
    </Modal>
  );
}












import { useCallback, useEffect, useMemo, useState } from "react";
import { AlertCircle, Pencil, Plus, Search, Trash2 } from "lucide-react";
import { ConfirmDialog, Datatable, useToast } from "../../../../shared/components";
import { CatalogFormModal } from "./CatalogFormModal";
import styles from "../../../Pages.module.css";

const PAGE_SIZE = 10;

// Quita tildes y mayúsculas para buscar: "foranea" encuentra "Foránea"
const normalize = (value) =>
  String(value ?? "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();

const capitalize = (text) => text.charAt(0).toUpperCase() + text.slice(1);

export function CatalogCrudPage({ config }) {
  const { title, subtitle, singular, plural, feminine, icon: Icon, service, fields } = config;
  const e = feminine ? "a" : "o";
  const article = feminine ? "la" : "el";

  const toast = useToast();

  const [items, setItems] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  const [search, setSearch] = useState("");
  const [page, setPage] = useState(1);

  const [form, setForm] = useState({ open: false, item: null });

  const [toDelete, setToDelete] = useState(null);
  const [deleting, setDeleting] = useState(false);
  const [deleteError, setDeleteError] = useState("");

  /* ---------- Carga ---------- */
  const load = useCallback(async () => {
    setLoading(true);
    setError("");
    try {
      setItems(await service.list());
    } catch (err) {
      setError(err.noAccess
        ? `No tienes permiso para ver ${plural}.`
        : `No se pudo cargar el listado de ${plural}.`);
    } finally {
      setLoading(false);
    }
  }, [service, plural]);

  useEffect(() => { load(); }, [load]);

  /* ---------- Búsqueda, orden y paginación (en el navegador) ---------- */
  const filtered = useMemo(() => {
    const q = normalize(search.trim());
    const list = q
      ? items.filter((it) => fields.some((f) => normalize(it[f.name]).includes(q)))
      : items;
    return [...list].sort((a, b) => String(a.name ?? "").localeCompare(String(b.name ?? ""), "es"));
  }, [items, search, fields]);

  const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
  const currentPage = Math.min(page, totalPages);
  const rows = filtered.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);

  /* ---------- Acciones ---------- */
  const handleSaved = (item, isEdit) => {
    setForm({ open: false, item: null });
    toast.success(
      `${capitalize(singular)} ${isEdit ? "actualizad" : "cread"}${e}`,
      `"${item.name}" se ${isEdit ? "actualizó" : "agregó"} correctamente.`
    );
    load();
  };

  const openDelete = (item) => {
    setDeleteError("");
    setToDelete(item);
  };

  const confirmDelete = async () => {
    setDeleting(true);
    setDeleteError("");
    try {
      await service.remove(toDelete.id);
      toast.success(`${capitalize(singular)} eliminad${e}`, `"${toDelete.name}" se eliminó correctamente.`);
      setToDelete(null);
      load();
    } catch (err) {
      setDeleteError(err.noAccess
        ? `No tienes permiso para eliminar ${plural}.`
        : err.response?.data?.message
          ?? `No se pudo eliminar. Es posible que ${article} ${singular} esté asignad${e} a uno o más usuarios.`);
    } finally {
      setDeleting(false);
    }
  };

  /* ---------- Columnas ---------- */
  const columns = [
    ...fields.map((f) => ({
      key: f.name,
      header: f.label,
      width: f.width,
      render: (it) => {
        const value = it[f.name];
        if (value === null || value === undefined || value === "") return <span className={styles.muted}>—</span>;
        if (f.type === "number") return <span className={styles.mono}>{value}</span>;
        if (f.name === "name") return <span className={styles.cellMain}>{value}</span>;
        return value;
      },
    })),
    {
      key: "actions",
      header: "Acciones",
      align: "right",
      width: 120,
      render: (it) => (
        <div className={styles.rowActions}>
          <button type="button" className={styles.iconBtn} title="Editar"
            aria-label={`Editar ${it.name}`} onClick={() => setForm({ open: true, item: it })}>
            <Pencil size={16} />
          </button>
          <button type="button" className={`${styles.iconBtn} ${styles.iconBtnDanger}`} title="Eliminar"
            aria-label={`Eliminar ${it.name}`} onClick={() => openDelete(it)}>
            <Trash2 size={16} />
          </button>
        </div>
      ),
    },
  ];

  return (
    <>
      <header className={styles.pageHeader}>
        <div style={{ display: "flex", alignItems: "center", gap: 16 }}>
          <div className={styles.headerIcon}>
            <Icon size={26} />
          </div>
          <div>
            <span className={styles.eyebrow}>Administración</span>
            <h1 className={styles.title}>{title}</h1>
            <p className={styles.subtitle}>{subtitle}</p>
          </div>
        </div>

        <div className={styles.actions}>
          <button type="button" className={`${styles.btn} ${styles.btnPrimary}`}
            onClick={() => setForm({ open: true, item: null })}>
            <Plus size={18} /> Nuev{e} {singular}
          </button>
        </div>
      </header>

      {error && (
        <div className={`${styles.banner} ${styles.bannerError}`} role="alert">
          <AlertCircle size={18} />
          <p>
            {error}{" "}
            <button type="button" className={styles.linkBtn} style={{ padding: 0 }} onClick={load}>
              Reintentar
            </button>
          </p>
        </div>
      )}

      <section className={styles.panel}>
        <div className={styles.toolbar}>
          <label className={styles.search}>
            <Search size={16} />
            <input className={styles.input} placeholder={`Buscar ${plural}...`} value={search}
              onChange={(ev) => { setSearch(ev.target.value); setPage(1); }}
              aria-label={`Buscar ${plural}`} />
          </label>
          {!loading && (
            <span className={styles.count}>
              {filtered.length} {filtered.length === 1 ? singular : plural}
            </span>
          )}
        </div>

        <Datatable
          columns={columns}
          rows={rows}
          loading={loading}
          emptyMessage={search
            ? `No hay resultados para "${search}".`
            : `Aún no hay ${plural} registrad${e}s.`}
          pagination={{
            page: currentPage,
            pageSize: PAGE_SIZE,
            totalCount: filtered.length,
            totalPages,
            onPageChange: setPage,
          }}
        />
      </section>

      <CatalogFormModal
        open={form.open}
        item={form.item}
        config={config}
        onClose={() => setForm({ open: false, item: null })}
        onSaved={handleSaved}
      />

      <ConfirmDialog
        open={Boolean(toDelete)}
        danger
        title={`¿Eliminar ${singular}?`}
        message="Esta acción no se puede deshacer."
        detail={toDelete && (
          <div className={styles.personChip}>
            <div className={styles.personAvatar}><Icon size={18} /></div>
            <div className={styles.personInfo}>
              <span className={styles.personName}>{toDelete.name}</span>
              {toDelete.code != null && <span className={styles.personMeta}>Código: {toDelete.code}</span>}
            </div>
          </div>
        )}
        confirmText={deleting ? "Eliminando..." : "Sí, eliminar"}
        loading={deleting}
        error={deleteError}
        onConfirm={confirmDelete}
        onCancel={() => setToDelete(null)}
      />
    </>
  );
}









