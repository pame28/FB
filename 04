SELECT       S.NO_PRESTAMO      , MAX(S.DESTINO) DESTINO      , MIN(S.ESTADO) ESTADO      , MAX(S.CIF) CIF      , MAX(S.NOMBRE_CLIENTE) NOMBRE_CLIENTE      , SUM(S.DIAS_MORA) DIAS_MORA      , MAX(S.CAL_FINAL) CAL_FINAL      , SUM(S.TOTAL_CARTERA) TOTAL_CARTERA      , SUM(S.RESERVA) RESERVA      , MAX(S.PORCENTAJE) PORCENTAJE      , SUM(S.RESERVA_ANTERIOR) RESERVA_ANTERIOR      , SUM(S.INCREMENTO) INCREMENTO      , MAX(S.REF) REF      , MAX(S.METODOLOGIA) METODOLOGIA      , MAX(S.METODOLOGIA_ANTERIOR) METODOLOGIA_ANTERIOR      , MAX(S.CATE_INDIVIDUAL) CATE_INDIVIDUAL      , MAX(S.CATEGORIA_INDIVIDUAL_ANTERIOR) CATEGORIA_INDIVIDUAL_ANTERIOR      , MAX(S.OPESECTOR) OPESECTOR      , MAX(S.SEGMENTO_COMERCIAL) SEGMENTO_COMERCIAL      , MAX(S.FECHA_PROCESO) FECHA_PROCESO     FROM(       SELECT        CASE WHEN ER.GDROPNUM54 IS NULL THEN RES.GDRNUM44 ELSE ER.GDROPNUM54 END AS NO_PRESTAMO       , CASE WHEN MAX(O.GDRTIP01) IN ('130000') THEN MAX(RS.DES) ELSE MAX(D.GDROPDES) END AS DESTINO       , MIN(CASE WHEN O.GDRSVI01 > 0 THEN 'VIG'         ELSE (CASE WHEN O.GDRSMO01 > 0 THEN 'MOR'          ELSE (CASE WHEN O.GDRSVE01 > 0 THEN 'VEN'          ELSE (CASE WHEN O.GDRSEJ01 > 0 THEN 'EJE'           ELSE (CASE WHEN O.GDRSCA01 > 0 THEN 'CAS'            ELSE (CASE WHEN O.GDRSVI01 = 0 THEN 'VIG' END) END) END) END) END) END) AS ESTADO           , RES.GDRCIF44 AS CIF       , (SELECT DISTINCT DC.CLNOMB FROM CLIDAT.CLMCTE DC WHERE DC.CLDOC = RES.GDRCIF44) AS NOMBRE_CLIENTE        , MAX(O.GDRDMO01) AS DIAS_MORA       , MAX(RES.GDRCFI44) AS CAL_FINAL       , SUM(O.GDRSTO01 + O.GDRIXC01) AS TOTAL_CARTERA       , SUM(RES.GDRREC44) AS RESERVA       , MAX(RES.GDPPR144) AS PORCENTAJE       , SUM((SELECT GDRREC44 FROM BPDAT.GDROP44F WHERE GDRANO44 || '-' || LPAD(GDRMES44, 2, 0) || '-' || LPAD(GDRDIA44, 2, 0) = '2026-10-31' AND GDRNUM44 = O.GDRNUM01 AND GDRMON44 = O.GDRMON01 FETCH FIRST 1 ROW ONLY)) AS RESERVA_ANTERIOR       , SUM(RES.GDRREC44) - SUM((SELECT GDRREC44 FROM BPDAT.GDROP44F WHERE GDRANO44 || '-' || LPAD(GDRMES44, 2, 0) || '-' || LPAD(GDRDIA44, 2, 0) = '2026-10-31' AND GDRNUM44 = O.GDRNUM01 AND GDRMON44 = O.GDRMON01 FETCH FIRST 1 ROW ONLY)) AS INCREMENTO        , CASE WHEN MAX(O.GDRRBY01) = '1' THEN 'F' ELSE '' END AS REF       , RES.GDRCAL44 AS METODOLOGIA       , MAX((SELECT DISTINCT GDRCFA32 FROM BPDAT.GDROP32F WHERE GDRANO32 || '-' || LPAD(GDRMES32, 2, 0) || '-' || LPAD(GDRDIA32, 2, 0) = '2026-10-31' AND GDRNUM32 = O.GDRNUM01 AND GDRMON32 = O.GDRMON01 FETCH FIRST 1 ROW ONLY)) AS METODOLOGIA_ANTERIOR       , MAX(CAL.GDRCIN33) AS CATE_INDIVIDUAL       , MAX((SELECT GDRCIN33 FROM BPDAT.GDROP33F WHERE GDRANO33 || '-' || LPAD(GDRMES33, 2, 0) || '-' || LPAD(GDRDIA33, 2, 0) = '2026-10-31' AND GDRNUM33 = O.GDRNUM01 AND GDRMON33 = O.GDRMON01 FETCH FIRST 1 ROW ONLY)) AS CATEGORIA_INDIVIDUAL_ANTERIOR       , MAX(CASE WHEN ER.GDROPBIN54 IS NULL THEN CAST(O.GDRPBY01 AS DECIMAL(6,0)) ELSE ER.GDROPBIN54 END) OPESECTOR       , RS.DES AS SEGMENTO_COMERCIAL       , '2026-11-19' AS FECHA_PROCESO          FROM BPDAT.GDROP44F RES         LEFT JOIN BPDAT.GDROP54F ER          ON RES.GDRNUM44 = ER.GDROPNEX54        INNER JOIN BPDAT.GDROPR1F O          ON RES.GDRNUM44 = O.GDRNUM01 AND RES.GDRMON44 = O.GDRMON01 AND RES.GDRANO44=O.GDRANO01 AND RES.GDRMES44 = O.GDRMES01 AND RES.GDRDIA44 = O.GDRDIA01        LEFT JOIN BPDAT.GDROP33F CAL          ON RES.GDRNUM44 = CAL.GDRNUM33 AND RES.GDRMON44 = CAL.GDRMON33 AND RES.GDRANO44=CAL.GDRANO33 AND RES.GDRMES44 = CAL.GDRMES33 AND RES.GDRDIA44 = CAL.GDRDIA33        LEFT JOIN BPDAT.GDROP18F D                                  ON D.GDRCODES=O.GDRFDI01        LEFT JOIN (SELECT GDRCOD23 AS COD, GDRSEE23 AS DES FROM BPDAT.GDROP23F            UNION             SELECT GDRCOD24 AS COD, GDRSEE24 AS DES FROM BPDAT.GDROP24F            UNION             SELECT GDRCOD25 AS COD, GDRSEE25 AS DES FROM BPDAT.GDROP25F            UNION             SELECT GDRCOD26 AS COD, GDRSEE26 AS DES FROM BPDAT.GDROP26F            UNION             SELECT GDRBIN27 AS COD, GDRTIP27 AS DES FROM BPDAT.GDROP27F            UNION             SELECT GDRBIN28 AS COD, GDRTIP28 AS DES FROM BPDAT.GDROP28F             ) RS ON CASE WHEN O.GDRSEC01 = 0 AND O.GDRPBY01 <> 'EF' THEN CAST(O.GDRPBY01 AS DECIMAL(6,0)) ELSE O.GDRSEC01 END = RS.COD        WHERE RES.GDRANO44 || '-' || LPAD(RES.GDRMES44, 2, 0) || '-' || LPAD(RES.GDRDIA44, 2, 0) = '2026-11-19'        AND O.GDREMP01='1' AND O.GDRSCA01=0       GROUP BY        CASE WHEN ER.GDROPNUM54 IS NULL THEN RES.GDRNUM44 ELSE ER.GDROPNUM54 END        , RES.GDRCIF44        , RES.GDRCAL44        , RS.DES       ORDER BY 4, 1      ) AS S     GROUP BY       S.NO_PRESTAMO     



