                //1. Mando los datos a SQL para que arme la trama
                dsDatos = dllSQL.sp_Select("usp_DTCreaTramaParaAS400"
                    , new SqlParameter("@Equivalente", strNoTarjeta)
                    , new SqlParameter("@NoComprobante", strNoComprabante)
                    , new SqlParameter("@Importe", dImporteTotal.ToString("0.00"))
                    , new SqlParameter("@CantidadCuotas", Convert.ToString(CantidadCuotas))
                    , new SqlParameter("@Moneda", strMonedas)
                    );
                if (dsDatos.Tables.Count > 0)
                {
                    if (dsDatos.Tables[0].Rows.Count > 0)
                    {
                        foreach (DataRow item in dsDatos.Tables[0].Rows)
                        {
                            //2. Manda la trama al AS400
                            string strTramaAS40 = string.Empty;
                            string strRefencia = string.Empty;

                            strTramaAS40 = item["TramaAS400"].ToString();
                            strRefencia = item["Referencia"].ToString();

                            //Para trabajar con programa
                            string strSecuencia = item["Secuencia"].ToString();

                            //Procesamos utilizando el programa de AS400
                            if (this.UsePGM)
                            {
                                AppLogger.Debug("Procesando utilizando progrma de AS400");

                                return this.CallAS400Pgm(strTramaAS40, strSecuencia);
                            }

                            AppLogger.Info($"Cuotificando tarjeta: {strRefencia}, Trama: {strTramaAS40}");
                            if (EnviarTramaAS400iSeries(strTramaAS40, _ServidorDB2, "TARJETA", "TARCSND")) //Registrar Trama en Cola del AS400)
                            {
                                int milliseconds = 3000;
                                Thread.Sleep(milliseconds);

                                //Lee la trama en 10 intentos
                                //int iConta = 0;
                                string Respuesta = string.Empty;

                                for (int i = 0; i < 10; i++)
                                {

                                    DataSet dsRespuesta0200 = new DataSet();
                                    dsRespuesta0200 = dtRespuestaWinServerISO(strRefencia);

                                    if (dsRespuesta0200.Tables.Count > 0)
                                    {
                                        dsRespuesta = dsRespuesta0200.Clone();
                                        dsRespuesta = dsRespuesta0200.Copy();

                                        break;
                                    }
                                    else
                                    {
                                        Thread.Sleep(milliseconds);
                                    }
                                }
                            }
                        }

                    }
                }
            }
            catch (Exception ex)
            {
                AppLogger.Error($"Ocurrió un error al realizar la cuotificación: {ex.Message.ToString()}");
                //LogMessageToFile($"Ocurrió un error al realizar la cuotificación: {ex.Message.ToString()}", 1);
            }

            return dsRespuesta;
        }

