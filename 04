SELECT a.NumeroTarjeta, a.NoCuenta, a.Cif, a.EstadoTarjeta,
       a.NoCuentaClaro  AS NoCuentaClaro_MaestroSaldos,
       t.NoCuentaClaro  AS NoCuentaClaro_ETarjetas,
       t.NoDocumento, t.EstadoHabilitar
FROM MaestroSaldos a WITH (NOLOCK)
JOIN ETarjetas t WITH (NOLOCK) ON a.NumeroTarjeta = t.NumeroTarjeta
WHERE a.CategoriaTarjeta = '0'
  AND a.EstadoTarjeta IN (20,22,25,29)
  AND (a.NoCuentaClaro IS NULL OR LTRIM(RTRIM(a.NoCuentaClaro)) = '');