import { useState } from "react";
import { Check, Download, Filter, RotateCcw, Search, Shield } from "lucide-react";
import styles from "../../Pages.module.css";
import base from "../coach/CollaboratorCoachingPage.module.css";
import cert from "./ManageCertificationPage.module.css";
import shared from "./CertificationShared.module.css";
import ui from "./ApplyCertificationPage.module.css";
import { Datatable, Modal, useToast } from "../../../shared/components";
import {
    AREAS, CURRENT_CERTIFIER, FORMATS, STATUS, TEAMS,
    addCertification, computeFinal, hasRating, useCertificationStore,
} from "./certificationStore";
import { ApproveCertificationModal, CertifierCell, ScoreCell, StatCard, StatusPill, formatDate, initials, plural } from "./certificationUi";

const todayISO = () => new Date().toLocaleDateString("en-CA");

const latestOf = (list) => [...list].sort((a, b) => b.date.localeCompare(a.date))[0];

// Solo números (o NA cuando el criterio tiene más de una columna)
const sanitizeNumeric = (raw, prev, allowNA) => {
    const v = raw.toUpperCase();
    if (v === "" || /^\d*\.?\d*$/.test(v)) return v;
    if (allowNA && "NA".startsWith(v)) return v;
    return prev ?? "";
};

const noteClass = (value) => {
    if (value === "NA") return ui.na;
    if (typeof value !== "number") return ui.noteEmpty;
    if (value >= 80) return ui.good;
    if (value >= 50) return ui.mid;
    return ui.bad;
};

const noteText = (value) => (value === "NA" ? "NA" : typeof value === "number" ? `${value}%` : "—");

/* ===================== Formulario de certificación ===================== */
function ApplyForm({ team, format, onClose }) {
    const toast = useToast();
    const [leaderId, setLeaderId] = useState(team.leaders.length === 1 ? String(team.leaders[0].id) : "");
    const [date, setDate] = useState(todayISO());
    const [answers, setAnswers] = useState({});
    const [suggestions, setSuggestions] = useState("");
    const [stamp] = useState(() => new Date().toLocaleString("es-ES"));

    const leader = team.leaders.find((l) => String(l.id) === leaderId) ?? null;
    const { rows, total } = computeFinal(format, answers);
    const passes = total >= format.minScore;

    const setCell = (critId, indId, key, value) =>
        setAnswers((prev) => ({
            ...prev,
            [critId]: { ...prev[critId], [indId]: { ...prev[critId]?.[indId], [key]: value } },
        }));

    const renderCell = (crit, ind, col) => {
        const value = answers[crit.id]?.[ind.id]?.[col] ?? "";
        const allowNA = crit.columns.length > 1;

        if (ind.type === "CE/NCE") {
            const options = allowNA ? ["CE", "NCE", "NA"] : ["CE", "NCE"];
            return (
                <div className={ui.choices} role="group" aria-label={`${ind.name} ${col}`}>
                    {options.map((opt) => (
                        <button
                            key={opt}
                            type="button"
                            className={`${ui.choice} ${ui[opt.toLowerCase()]} ${value === opt ? ui.on : ""}`}
                            aria-pressed={value === opt}
                            onClick={() => setCell(crit.id, ind.id, col, value === opt ? "" : opt)}
                        >
                            {opt}
                        </button>
                    ))}
                </div>
            );
        }

        if (ind.type === "Texto") {
            return (
                <input
                    type="text"
                    className={`${ui.cellInput} ${ui.wide}`}
                    value={value}
                    onChange={(e) => setCell(crit.id, ind.id, col, e.target.value)}
                    aria-label={`${ind.name} ${col}`}
                />
            );
        }

        return (
            <input
                type="text"
                inputMode="decimal"
                className={ui.cellInput}
                placeholder="—"
                value={value}
                onChange={(e) => setCell(crit.id, ind.id, col, sanitizeNumeric(e.target.value, value, allowNA))}
                aria-label={`${ind.name} ${col}`}
            />
        );
    };

    const handleSave = () => {
        if (!leader) {
            toast.error("Falta completar: Líder evaluado");
            return;
        }
        if (!date) {
            toast.error("Falta completar: Fecha de aplicación");
            return;
        }
        const empty = format.criteria.find((c) => !hasRating(c, answers[c.id]));
        if (empty) {
            toast.error(`Registra al menos una calificación en el criterio "${empty.name}"`);
            return;
        }

        addCertification(
            {
                teamId: team.id, teamName: team.name, area: team.area,
                leaderId: leader.id, leaderName: leader.name,
                formatName: format.name, minScore: format.minScore,
                score: total, date, suggestions,
            },
            CURRENT_CERTIFIER
        );
        toast.success("Certificación registrada correctamente — pendiente de aprobación");
        onClose();
    };

    return (
        <Modal
            open
            size="lg"
            title={
                <span className={cert.modalTitle}>
                    Aplicar certificación — {team.name}
                    <span className={cert.modalSub}>Formato: {format.name}{leader ? ` · Líder: ${leader.name}` : ""}</span>
                </span>
            }
            onClose={onClose}
            footer={
                <div className={shared.modalFooter}>
                    <button type="button" className={`${base.btn} ${base.btnOutline} ${base.btnSm}`} onClick={onClose}>
                        Cancelar
                    </button>
                    <button type="button" className={`${base.btn} ${base.btnPrimary} ${base.btnSm}`} onClick={handleSave}>
                        <Check size={15} /> Guardar certificación
                    </button>
                </div>
            }
        >
            <div className={ui.formHead}>
                <div className={base.field}>
                    <label className={base.label}>Equipo</label>
                    <input type="text" className={`${base.input} ${base.inputReadonly}`} value={team.name} readOnly />
                </div>
                <div className={base.field}>
                    <label className={base.label} htmlFor="ap-leader">Líder evaluado</label>
                    {team.leaders.length === 1 ? (
                        <input id="ap-leader" type="text" className={`${base.input} ${base.inputReadonly}`} value={team.leaders[0].name} readOnly />
                    ) : (
                        <select id="ap-leader" className={base.select} value={leaderId} onChange={(e) => setLeaderId(e.target.value)}>
                            <option value="">— Selecciona el líder —</option>
                            {team.leaders.map((l) => <option key={l.id} value={l.id}>{l.name}</option>)}
                        </select>
                    )}
                </div>
                <div className={base.field}>
                    <label className={base.label} htmlFor="ap-date">Fecha *</label>
                    <input id="ap-date" type="date" className={base.input} value={date} onChange={(e) => setDate(e.target.value)} />
                </div>
            </div>

            <div className={ui.criteria}>
                {rows.map(({ criterion: c, colNotes }, idx) => (
                    <section key={c.id} className={ui.criterion}>
                        <div className={ui.criterionHead}>
                            <span className={ui.criterionNumber}>{idx + 1}</span>
                            <div className={ui.criterionTitle}>
                                <div className={ui.criterionName}>{c.name}</div>
                                {c.description && <div className={ui.criterionDesc}>{c.description}</div>}
                            </div>
                            <span className={ui.criterionWeight}>Peso: {c.weight}%</span>
                        </div>
                        <div className={ui.tableScroll}>
                            <table className={ui.grid}>
                                <thead>
                                    <tr>
                                        <th>Indicador</th>
                                        {c.columns.map((col) => <th key={col}>{col}</th>)}
                                        <th>Observaciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {c.indicators.map((ind) => (
                                        <tr key={ind.id}>
                                            <td>{ind.name}</td>
                                            {c.columns.map((col) => <td key={col}>{renderCell(c, ind, col)}</td>)}
                                            <td>
                                                <input
                                                    type="text"
                                                    className={ui.obsInput}
                                                    placeholder="Observación..."
                                                    value={answers[c.id]?.[ind.id]?.__obs ?? ""}
                                                    onChange={(e) => setCell(c.id, ind.id, "__obs", e.target.value)}
                                                    aria-label={`Observaciones de ${ind.name}`}
                                                />
                                            </td>
                                        </tr>
                                    ))}
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td>{c.noteLabel}</td>
                                        {c.columns.map((col) => (
                                            <td key={col}>
                                                {col in colNotes && <span className={`${ui.note} ${noteClass(colNotes[col])}`}>{noteText(colNotes[col])}</span>}
                                            </td>
                                        ))}
                                        <td />
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </section>
                ))}
            </div>

            <div className={ui.breakdown}>
                <div className={ui.breakdownLeft}>
                    <span className={ui.breakdownHeading}>Desglose puntaje final</span>
                    <div className={ui.breakdownList}>
                        {rows.map((r, i) => (
                            <div key={r.criterion.id}>
                                <span className={ui.breakdownLabel}>C{i + 1} · {r.criterion.weight}%</span>
                                <span className={ui.breakdownValue}>
                                    {r.nota ?? 0}% × {r.criterion.weight}% = <em>{r.points} pts</em>
                                </span>
                            </div>
                        ))}
                    </div>
                </div>
                <div className={ui.finalBox}>
                    <span className={ui.finalLabel}>Nota final</span>
                    <span className={`${ui.finalValue} ${passes ? ui.pass : ui.fail}`}>{total}%</span>
                    <span className={ui.finalMin}>Mín. para aprobar: {format.minScore}%</span>
                    <span className={ui.finalFlag}>{passes ? "Alcanza el mínimo" : "No alcanza el mínimo"}</span>
                </div>
            </div>

            <div className={`${base.field} ${ui.suggestions}`}>
                <label className={base.label} htmlFor="ap-sugg">Sugerencias, recomendaciones y compromisos</label>
                <textarea
                    id="ap-sugg"
                    className={base.textarea}
                    placeholder="Indicar sugerencias, recomendaciones y compromisos a dejar en la agencia..."
                    value={suggestions}
                    onChange={(e) => setSuggestions(e.target.value)}
                />
            </div>

            <div className={ui.approvalNote}>
                <div>
                    <div className={ui.approvalNoteTitle}>Aprobación del certificador</div>
                    <div className={ui.approvalNoteText}>
                        Al guardar quedará en estado <strong>Pendiente de aprobación</strong> hasta que el administrador lo apruebe.
                    </div>
                </div>
                <div className={ui.approvalNoteRight}>
                    <span className={ui.small}>Certificador</span>
                    <span className={ui.who}>{CURRENT_CERTIFIER}</span>
                    <span className={ui.when}>{stamp}</span>
                </div>
            </div>
        </Modal>
    );
}

/* ===================== Historial del equipo ===================== */
function TeamHistoryModal({ team, onClose }) {
    const toast = useToast();
    const { certifications } = useCertificationStore();
    const [status, setStatus] = useState("todos");
    const [certifier, setCertifier] = useState("todos");
    const [search, setSearch] = useState("");

    // Todas las certificaciones del equipo, sin importar quién las aplicó
    const all = certifications.filter((c) => c.teamId === team.id);
    const certifiers = [...new Set(all.map((c) => c.certifier))];
    const q = search.trim().toLowerCase();
    const rows = all
        .filter(
            (c) =>
                (status === "todos" || c.status === status) &&
                (certifier === "todos" || c.certifier === certifier) &&
                (!q || c.leaderName.toLowerCase().includes(q))
        )
        .sort((a, b) => b.date.localeCompare(a.date));

    const columns = [
        { key: "date", header: "Fecha", render: (r) => <span className={shared.mutedLight}>{formatDate(r.date)}</span> },
        { key: "leaderName", header: "Líder certificado", render: (r) => <span className={shared.strong}>{r.leaderName}</span> },
        { key: "certifier", header: "Certificador", render: (r) => <CertifierCell name={r.certifier} /> },
        { key: "formatName", header: "Formato", render: (r) => <span className={shared.muted}>{r.formatName}</span> },
        { key: "score", header: "Puntaje", align: "center", render: (r) => <ScoreCell cert={r} /> },
        { key: "status", header: "Estado", render: (r) => <StatusPill status={r.status} /> },
        {
            key: "pdf",
            header: "PDF",
            align: "center",
            render: (r) => (
                <button
                    type="button"
                    className={`${shared.iconBtn} ${shared.downloadBtn}`}
                    disabled={r.status !== STATUS.approved}
                    onClick={() => toast.success("Descargando PDF...")}
                    title={r.status === STATUS.approved ? "Descargar PDF" : "El PDF solo está disponible para certificaciones aprobadas"}
                    aria-label={`Descargar PDF de la certificación del ${formatDate(r.date)}`}
                >
                    <Download size={16} />
                </button>
            ),
        },
    ];

    return (
        <Modal
            open
            size="lg"
            title={
                <span className={cert.modalTitle}>
                    Historial — {team.name}
                    <span className={cert.modalSub}>Todas las certificaciones aplicadas a este equipo, sin importar quién las realizó</span>
                </span>
            }
            onClose={onClose}
            footer={
                <div className={shared.modalFooter}>
                    <button type="button" className={`${base.btn} ${base.btnOutline} ${base.btnSm} ${shared.btnTeal}`} onClick={() => toast.success("Descargando Excel del historial...")}>
                        <Download size={15} /> Exportar Excel
                    </button>
                    <button type="button" className={`${base.btn} ${base.btnOutline} ${base.btnSm}`} onClick={onClose}>
                        Cerrar
                    </button>
                </div>
            }
        >
            <div className={ui.historyFilters}>
                <select className={`${base.select} ${shared.filterSelect}`} value={status} onChange={(e) => setStatus(e.target.value)} aria-label="Filtrar por estado">
                    <option value="todos">Todos los estados</option>
                    {Object.values(STATUS).map((s) => <option key={s} value={s}>{s}</option>)}
                </select>
                <select className={`${base.select} ${shared.filterSelect}`} value={certifier} onChange={(e) => setCertifier(e.target.value)} aria-label="Filtrar por certificador">
                    <option value="todos">Todos los certificadores</option>
                    {certifiers.map((c) => <option key={c} value={c}>{c}</option>)}
                </select>
                <div className={`${base.inputIcon} ${shared.filterSearch}`}>
                    <Search size={16} />
                    <input type="text" className={base.input} placeholder="Buscar por líder..." value={search} onChange={(e) => setSearch(e.target.value)} aria-label="Buscar por líder" />
                </div>
            </div>
            <div className={ui.historyTable}>
                <Datatable columns={columns} rows={rows} rowKey="id" maxHeight={340} emptyMessage="Este equipo aún no tiene certificaciones." />
            </div>
        </Modal>
    );
}

/* ===================== Página ===================== */
const TEAM_STATE = {
    pending: { label: "Pendiente aprobación", status: STATUS.pending },
    approved: { label: "Certificado", status: STATUS.approved },
    rejected: { label: "No aprobado", status: STATUS.rejected },
    none: { label: "Sin certificación", status: STATUS.rejected },
};

const stateOf = (c) => (!c ? "none" : c.status === STATUS.pending ? "pending" : c.status === STATUS.approved ? "approved" : "rejected");

export const ApplyCertificationPage = () => {
    const toast = useToast();
    const { certifications } = useCertificationStore();

    const [area, setArea] = useState("todas");
    const [search, setSearch] = useState("");
    const [stateFilter, setStateFilter] = useState("todos");
    const [applyTeam, setApplyTeam] = useState(null);
    const [historyTeam, setHistoryTeam] = useState(null);
    const [approveTarget, setApproveTarget] = useState(null);

    const infoByTeam = TEAMS.map((team) => {
        const own = certifications.filter((c) => c.teamId === team.id);
        const latest = latestOf(own);
        return { team, hasAny: own.length > 0, latest, state: stateOf(latest) };
    });

    const q = search.trim().toLowerCase();
    const visible = infoByTeam.filter(
        ({ team, hasAny, state }) =>
            (area === "todas" || team.area === area) &&
            (!q || team.name.toLowerCase().includes(q)) &&
            (stateFilter === "todos" ||
                (stateFilter === "con" && hasAny) ||
                (stateFilter === "pending" && state === "pending") ||
                (stateFilter === "none" && !hasAny))
    );

    const handleApply = (team) => {
        if (!team.formatId) {
            toast.error("El equipo no tiene un formato activo asignado. No es posible iniciar la certificación.");
            return;
        }
        if (team.leaders.length === 0) {
            toast.error("El equipo no tiene un líder asignado. No es posible iniciar la certificación.");
            return;
        }
        setApplyTeam(team);
    };

    return (
        <>
            <header className={shared.headerRow}>
                <div>
                    <h1 className={styles.title}>Aplicar certificación</h1>
                    <p className={styles.subtitle}>Selecciona un equipo y aplica la certificación a su líder o líderes designados.</p>
                </div>
            </header>

            <div className={base.page}>
                <div className={shared.stats}>
                    <StatCard value={TEAMS.length} label="Equipos activos" />
                    <StatCard value={infoByTeam.filter((i) => i.hasAny).length} label="Con certificación aplicada" tone="green" />
                    <StatCard value={infoByTeam.filter((i) => i.state === "pending").length} label="Pendiente de aprobación" tone="amber" />
                    <StatCard value={infoByTeam.filter((i) => !i.hasAny).length} label="Sin certificación" tone="red" />
                </div>

                <section className={shared.filterCard}>
                    <div className={shared.filterTitle}><Filter size={16} /> Filtrar equipos</div>
                    <div className={shared.filterRow}>
                        <select className={`${base.select} ${shared.filterSelect}`} value={area} onChange={(e) => setArea(e.target.value)} aria-label="Filtrar por área">
                            <option value="todas">Todas las áreas</option>
                            {AREAS.map((a) => <option key={a} value={a}>{a}</option>)}
                        </select>
                        <div className={`${base.inputIcon} ${shared.filterSearch}`}>
                            <Search size={16} />
                            <input type="text" className={base.input} placeholder="Buscar equipo..." value={search} onChange={(e) => setSearch(e.target.value)} aria-label="Buscar equipo" />
                        </div>
                        <select className={`${base.select} ${shared.filterSelect}`} value={stateFilter} onChange={(e) => setStateFilter(e.target.value)} aria-label="Filtrar por estado de certificación">
                            <option value="todos">Todos los estados</option>
                            <option value="con">Con certificación</option>
                            <option value="pending">Pendiente aprobación</option>
                            <option value="none">Sin certificación</option>
                        </select>
                    </div>
                </section>

                {visible.length === 0 ? (
                    <div className={ui.empty}>No hay equipos que coincidan con los filtros.</div>
                ) : (
                    <div className={ui.teams}>
                        {visible.map(({ team, state }) => (
                            <section key={team.id} className={ui.teamCard}>
                                <div className={ui.teamHeader}>
                                    <div>
                                        <div className={ui.teamName}>{team.name}</div>
                                        <div className={ui.teamMeta}>{team.area} · {plural(team.members, "miembro", "miembros")}</div>
                                    </div>
                                    <div className={ui.teamActions}>
                                        <StatusPill status={TEAM_STATE[state].status}>{TEAM_STATE[state].label}</StatusPill>
                                        <button type="button" className={`${base.btn} ${base.btnSm} ${ui.btnGhost}`} onClick={() => setHistoryTeam(team)}>
                                            <Shield size={14} /> Historial
                                        </button>
                                        {state === "approved" ? (
                                            <button type="button" className={`${base.btn} ${base.btnSm} ${ui.btnWhite}`} onClick={() => handleApply(team)}>
                                                <RotateCcw size={14} /> Nueva certificación
                                            </button>
                                        ) : (
                                            <button type="button" className={`${base.btn} ${base.btnPrimary} ${base.btnSm}`} onClick={() => handleApply(team)}>
                                                <Check size={14} /> Aplicar certificación
                                            </button>
                                        )}
                                    </div>
                                </div>
                                <div className={ui.teamBody}>
                                    <div className={ui.leadersLabel}>
                                        {state === "pending" ? "Líderes que recibirán la certificación" : state === "approved" ? "Líderes certificados" : "Líderes del equipo"}
                                    </div>
                                    {team.leaders.length === 0 ? (
                                        <div className={ui.noFormat}>Este equipo no tiene líder asignado.</div>
                                    ) : (
                                        team.leaders.map((leader) => {
                                            const lastCert = latestOf(certifications.filter((c) => c.teamId === team.id && c.leaderId === leader.id));
                                            const leaderState = stateOf(lastCert);
                                            return (
                                                <div key={leader.id} className={ui.leaderRow}>
                                                    <div className={ui.leaderAvatar}>{initials(leader.name)}</div>
                                                    <div className={ui.leaderInfo}>
                                                        <div className={ui.leaderName}>{leader.name}</div>
                                                        <div className={ui.leaderSub}>{leader.role} · {leader.code}</div>
                                                    </div>
                                                    <div className={ui.leaderRight}>
                                                        <StatusPill status={TEAM_STATE[leaderState].status}>
                                                            {leaderState === "approved" ? "Certificado ✓" : TEAM_STATE[leaderState].label}
                                                        </StatusPill>
                                                        {leaderState === "pending" && (
                                                            <button type="button" className={`${base.btn} ${base.btnPrimary} ${base.btnSm}`} onClick={() => setApproveTarget(lastCert)}>
                                                                Aprobar
                                                            </button>
                                                        )}
                                                        {lastCert && leaderState !== "pending" && <span className={shared.mutedLight}>{formatDate(lastCert.date)}</span>}
                                                    </div>
                                                </div>
                                            );
                                        })
                                    )}
                                    {!team.formatId && <div className={ui.noFormat}>Este equipo no tiene un formato de certificación activo.</div>}
                                </div>
                            </section>
                        ))}
                    </div>
                )}
            </div>

            {applyTeam && <ApplyForm key={applyTeam.id} team={applyTeam} format={FORMATS[applyTeam.formatId]} onClose={() => setApplyTeam(null)} />}
            {historyTeam && <TeamHistoryModal team={historyTeam} onClose={() => setHistoryTeam(null)} />}
            <ApproveCertificationModal cert={approveTarget} onClose={() => setApproveTarget(null)} />
        </>
    );
};






import { useState } from "react";
import { Check } from "lucide-react";
import { Modal, useToast } from "../../../shared/components";
import base from "../coach/CollaboratorCoachingPage.module.css";
import ui from "./CertificationShared.module.css";
import { CURRENT_CERTIFIER, STATUS, resolveCertification } from "./certificationStore";

export const formatDate = (iso) => iso.split("-").reverse().join("/");

export const initials = (name) =>
    name
        .split(" ")
        .map((n) => n[0])
        .join("")
        .toUpperCase()
        .slice(0, 2);

export const plural = (n, one, many) => `${n} ${n === 1 ? one : many}`;

export function StatCard({ value, label, tone }) {
    return (
        <div className={`${ui.statCard} ${tone ? ui[tone] : ""}`}>
            <div className={ui.statValue}>{value}</div>
            <div className={ui.statLabel}>{label}</div>
        </div>
    );
}

const PILL_BY_STATUS = {
    [STATUS.pending]: ui.pillPending,
    [STATUS.approved]: ui.pillApproved,
    [STATUS.rejected]: ui.pillRejected,
};

export function StatusPill({ status, children }) {
    return <span className={`${ui.pill} ${PILL_BY_STATUS[status] ?? ui.pillRejected}`}>{children ?? status}</span>;
}

export function CertifierCell({ name, showAvatar = true, otherLabel = "Otro" }) {
    const mine = name === CURRENT_CERTIFIER;
    if (!showAvatar) return <span className={ui.muted}>{name}</span>;
    return (
        <div className={ui.certifier}>
            <span className={`${ui.avatarSm} ${mine ? "" : ui.other}`}>{initials(name)}</span>
            <span>{name}</span>
            <span className={`${ui.tag} ${mine ? ui.tagYou : ui.tagOther}`}>{mine ? "Tú" : otherLabel}</span>
        </div>
    );
}

// El puntaje solo se muestra una vez resuelta la certificación
export function ScoreCell({ cert }) {
    if (cert.status === STATUS.pending || cert.score == null) return <span className={ui.mutedLight}>—</span>;
    const ok = cert.score >= cert.minScore;
    return <span className={ok ? ui.scoreOk : ui.scoreBad}>{Number(cert.score.toFixed(2))}/100</span>;
}

const RESULT_OPTIONS = [
    { value: "approved", label: "Aprobado" },
    { value: "rejected", label: "Reprobado" },
