function TeamHistoryModal({ team, certifications, onClose }) {
    const { downloadPdf, exportHistory, busy } = useCertificationReports();
    const [status, setStatus] = useState("todos");
    const [certifier, setCertifier] = useState("todos");
    const [search, setSearch] = useState("");

    // Todas las certificaciones del equipo, sin importar quién las aplicó
    const all = certifications.filter((c) => c.teamId === team.id);
    const certifiers = [...new Set(all.map((c) => c.certifier))];
    const q = search.trim().toLowerCase();
    const rows = all
        .filter(
            (c) =>
                (status === "todos" || c.status === status) &&
                (certifier === "todos" || c.certifier === certifier) &&
                (!q || c.leaderName.toLowerCase().includes(q))
        )
        .sort((a, b) => b.date.localeCompare(a.date));

    const columns = [
        { key: "date", header: "Fecha", render: (r) => <span className={shared.mutedLight}>{formatDate(r.date)}</span> },
        { key: "leaderName", header: "Líder certificado", render: (r) => <span className={shared.strong}>{r.leaderName}</span> },
        { key: "certifier", header: "Certificador", render: (r) => <CertifierCell name={r.certifier} certifierId={r.certifierId} /> },
        { key: "formatName", header: "Formato", render: (r) => <span className={shared.muted}>{r.formatName}</span> },
        { key: "score", header: "Puntaje", align: "center", render: (r) => <ScoreCell cert={r} /> },
        { key: "status", header: "Estado", render: (r) => <StatusPill status={r.status} /> },
        {
            key: "pdf",
            header: "PDF",
            align: "center",
            render: (r) => (
                <button
                    type="button"
                    className={`${shared.iconBtn} ${shared.downloadBtn}`}
                    disabled={r.status !== STATUS.approved || busy !== null}
                    onClick={() => downloadPdf(r)}
                    title={r.status === STATUS.approved ? "Descargar PDF" : "El PDF solo está disponible para certificaciones aprobadas"}
                    aria-label={`Descargar PDF de la certificación del ${formatDate(r.date)}`}
                >
                    <Download size={16} />
                </button>
            ),
        },
    ];

    return (
        <Modal
            open
            size="lg"
            title={
                <span className={cert.modalTitle}>
                    Historial — {team.name}
                    <span className={cert.modalSub}>Todas las certificaciones aplicadas a este equipo, sin importar quién las realizó</span>
                </span>
            }
            onClose={onClose}
            footer={
                <div className={shared.modalFooter}>
                    <button
                        type="button"
                        className={`${base.btn} ${base.btnOutline} ${base.btnSm} ${shared.btnTeal}`}
                        disabled={busy !== null}
                        onClick={() => exportHistory({
                            title: `Historial de certificaciones — ${team.name}`,
                            rows,
                            filters: historyFilters({ status, certifier, search }),
                            hideArea: true,
                        })}
                    >
                        <Download size={15} /> Exportar Excel
                    </button>
                    <button type="button" className={`${base.btn} ${base.btnOutline} ${base.btnSm}`} onClick={onClose}>
                        Cerrar
                    </button>
                </div>
            }
        >
            <div className={ui.historyFilters}>
                <select className={`${base.select} ${shared.filterSelect}`} value={status} onChange={(e) => setStatus(e.target.value)} aria-label="Filtrar por estado">
                    <option value="todos">Todos los estados</option>
                    {Object.values(STATUS).map((s) => <option key={s} value={s}>{s}</option>)}
                </select>
                <select className={`${base.select} ${shared.filterSelect}`} value={certifier} onChange={(e) => setCertifier(e.target.value)} aria-label="Filtrar por certificador">
                    <option value="todos">Todos los certificadores</option>
                    {certifiers.map((c) => <option key={c} value={c}>{c}</option>)}
                </select>
                <div className={`${base.inputIcon} ${shared.filterSearch}`}>
                    <Search size={16} />
                    <input type="text" className={base.input} placeholder="Buscar por líder..." value={search} onChange={(e) => setSearch(e.target.value)} aria-label="Buscar por líder" />
                </div>
            </div>
            <div className={ui.historyTable}>
                <Datatable columns={columns} rows={rows} rowKey="id" maxHeight={340} emptyMessage="Este equipo aún no tiene certificaciones." />
            </div>
        </Modal>
    );
