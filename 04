// Quita tildes, mayúsculas y espacios extra: "Zona 2 Local " = "zona 2 local"
export const normalizeText = (value) =>
  String(value ?? "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();





