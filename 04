import pdfMake from "pdfmake/build/pdfmake";
import vfsFonts from "pdfmake/build/vfs_fonts";
import { cellTone, cellValue, columnAlign, displayValue, formatDateTime } from "./reportFormat";

pdfMake.addVirtualFileSystem(vfsFonts);

/* =========================================================
   Reporte tipo "documento" (una ficha con secciones), en PDF.
   Secciones: fields (campo / valor) · table · blocks (tarjetas)
   ========================================================= */

const GREY = "#6B7A8F";
const LIGHT = "#F4F8FD";
const LINE = "#E6EBF1";
const TEXT = "#22303F";
const M = 32; // margen lateral
const pageWidth = (config) => (config.pageSize === "A4" ? 595.28 : 612);

const noLines = {
  hLineWidth: () => 0,
  vLineWidth: () => 0,
  paddingLeft: () => 0,
  paddingRight: () => 0,
  paddingTop: () => 0,
  paddingBottom: () => 0,
};

const pill = (text, tone) =>
  tone
    ? { text: `  ${text}  `, bold: true, fontSize: 7.5, color: tone.fg, background: tone.bg }
    : { text: text || "—", color: text ? TEXT : "#A3ADBB" };

const fieldValue = (f) => pill(f.value ?? "", f.tone ? cellTone({ tone: () => f.tone }, f.value) : null);

/* ---------- Encabezado (banda de marca) ---------- */
const banner = (config, doc) => {
  const brand = config.brandName ?? config.system;
  return [
    {
      table: {
        widths: ["*"],
        body: [[{
          fillColor: config.primaryColor,
          margin: [16, 14, 16, 12],
          columns: [
            {
              width: "auto",
              stack: [
                { text: brand, fontSize: 20, bold: true, color: config.accentColor },
                { text: config.brandTagline ?? config.organization ?? "", fontSize: 7.5, color: "#C9D6E6", margin: [0, 1, 0, 0] },
              ],
            },
            { width: "auto", text: "/", fontSize: 18, color: "#6F8DB0", margin: [14, 3, 14, 0] },
            { width: "*", text: doc.title, fontSize: 12.5, bold: true, color: "#FFFFFF", margin: [0, 7, 0, 0] },
            {
              width: "auto",
              alignment: "right",
              stack: [
                { text: "Generado el", fontSize: 7, color: "#C9D6E6" },
                { text: formatDateTime(doc.generatedAt), fontSize: 10, bold: true, color: "#FFFFFF", margin: [0, 2, 0, 0] },
              ],
            },
          ],
        }]],
      },
      layout: noLines,
    },
    { canvas: [{ type: "rect", x: 0, y: 0, w: pageWidth(config) - M * 2, h: 3, color: config.accentColor }] },
  ];
};

/* ---------- Franja con datos clave ---------- */
const highlights = (config, doc) => {
  const items = [
    ...(doc.highlights ?? []),
    ...(config.showGeneratedBy && doc.generatedBy ? [{ label: "Generado por", value: doc.generatedBy }] : []),
  ];
  if (!items.length) return [];
  return [{
    table: {
      widths: ["*"],
      body: [[{
        fillColor: LIGHT,
        margin: [14, 8, 14, 8],
        fontSize: 8.5,
        lineHeight: 1.3,
        text: items.flatMap((h, i) => [
          ...(i > 0 ? [{ text: "      " }] : []),
          { text: `${h.label}: `, color: GREY },
          h.tone ? pill(h.value, cellTone({ tone: () => h.tone }, h.value)) : { text: h.value || "—", bold: true, color: TEXT },
        ]),
      }]],
    },
    layout: noLines,
  }];
};

/* ---------- Título de sección ---------- */
const sectionTitle = (config, title) => ({
  margin: [0, 14, 0, 0],
  table: {
    widths: ["*"],
    body: [[{
      text: title.toUpperCase(),
      fillColor: config.primaryColor,
      color: "#FFFFFF",
      bold: true,
      fontSize: 8.5,
      characterSpacing: 0.5,
      margin: [10, 6, 10, 6],
    }]],
  },
  layout: noLines,
});

/* ---------- Secciones ---------- */
const fieldsSection = (fields) => {
  const rows = [];
  for (let i = 0; i < fields.length; i += 2) {
    const pair = [fields[i], fields[i + 1]];
    rows.push(pair.flatMap((f) => (f
      ? [
          { text: f.label, color: GREY, fontSize: 8, margin: [10, 5, 6, 5] },
          { ...fieldValue(f), margin: [0, 5, 10, 5] },
        ]
      : [{ text: "" }, { text: "" }])));
  }
  return {
    table: { widths: [88, "*", 88, "*"], body: rows },
    layout: {
      ...noLines,
      hLineWidth: (i, node) => (i === 0 || i === node.table.body.length ? 0 : 0.5),
      hLineColor: () => LINE,
    },
  };
};

const tableSection = (section) => {
  if (!section.rows?.length) {
    return { text: section.empty ?? "Sin registros.", italics: true, color: GREY, margin: [10, 8, 0, 0] };
  }
  const head = section.columns.map((c) => ({
    text: c.header.toUpperCase(),
    bold: true,
    fontSize: 7,
    color: "#3D5A80",
    characterSpacing: 0.3,
    alignment: columnAlign(c),
  }));
  const body = section.rows.map((row) =>
    section.columns.map((c) => {
      const raw = cellValue(c, row);
      const tone = cellTone(c, raw);
      return tone
        ? { ...pill(displayValue(c, raw), tone), alignment: columnAlign(c) }
        : { text: displayValue(c, raw), alignment: columnAlign(c), color: raw ? TEXT : "#A3ADBB" };
    })
  );
  return {
    table: { headerRows: 1, dontBreakRows: true, widths: section.columns.map((c) => c.pdfWidth ?? "*"), body: [head, ...body] },
    layout: {
      fillColor: (i) => (i === 0 ? "#EAF0F7" : null),
      hLineWidth: (i, node) => (i === 0 || i === node.table.body.length ? 0 : 0.5),
      vLineWidth: () => 0,
      hLineColor: () => LINE,
      paddingTop: () => 6,
      paddingBottom: () => 6,
      paddingLeft: () => 10,
      paddingRight: () => 8,
    },
  };
};

const blocksSection = (section) => {
  if (!section.rows?.length) {
    return { text: section.empty ?? "Sin registros.", italics: true, color: GREY, margin: [10, 8, 0, 0] };
  }
  return {
    stack: section.rows.map((row, index) => {
      const fields = section.columns.map((c) => ({ label: c.header, value: displayValue(c, cellValue(c, row)) }));
      const grid = [];
      for (let i = 0; i < fields.length; i += 2) {
        grid.push([fields[i], fields[i + 1]].map((f) => (f
          ? {
              margin: [0, 0, 12, 8],
              stack: [
                { text: f.label.toUpperCase(), fontSize: 6.5, bold: true, color: GREY, characterSpacing: 0.4 },
                { text: f.value, fontSize: 8.5, color: TEXT, margin: [0, 2, 0, 0], lineHeight: 1.25 },
              ],
            }
          : { text: "" })));
      }
      return {
        margin: [0, 8, 0, 0],
        unbreakable: true,
        table: {
          widths: ["*"],
          body: [[{
            fillColor: LIGHT,
            margin: [12, 10, 12, 2],
            stack: [
              { text: (section.itemTitle?.(row, index) ?? `#${index + 1}`).toUpperCase(), fontSize: 7.5, bold: true, color: "#3D5A80", margin: [0, 0, 0, 8] },
              { table: { widths: ["*", "*"], body: grid }, layout: noLines },
            ],
          }]],
        },
        layout: noLines,
      };
    }),
  };
};

/** Definición del documento (pdfmake) */
export const buildDocumentPdfDefinition = (config, doc) => {
  const brand = config.brandName ?? config.system;

  const content = [...banner(config, doc), ...highlights(config, doc)];
  doc.sections.forEach((s) => {
    content.push(sectionTitle(config, s.title));
    if (s.type === "fields") content.push(fieldsSection(s.fields));
    else if (s.type === "blocks") content.push(blocksSection(s));
    else content.push(tableSection(s));
  });

  const footer = (currentPage, pageCount) => ({
    margin: [M, 8, M, 0],
    stack: [
      { canvas: [{ type: "line", x1: 0, y1: 0, x2: pageWidth(config) - M * 2, y2: 0, lineWidth: 0.6, lineColor: LINE }] },
      {
        margin: [0, 5, 0, 0],
        columns: [
          {
            width: "*",
            fontSize: 6.5,
            color: "#A3ADBB",
            text: [
              "Documento generado automáticamente por ",
              { text: `${brand}${config.organization ? ` — ${config.organization}` : ""}`, bold: true, color: GREY },
              ...(doc.generatedBy ? ["  ·  Generado por ", { text: doc.generatedBy, bold: true, color: GREY }] : []),
              "  ·  Fecha ", { text: formatDateTime(doc.generatedAt), bold: true, color: GREY },
              ...(config.confidentialText ? [`  ·  ${config.confidentialText}`] : []),
            ],
          },
          { width: 60, text: `Página ${currentPage} de ${pageCount}`, alignment: "right", fontSize: 7, color: GREY },
        ],
      },
    ],
  });

  return {
    pageSize: config.pageSize ?? "LETTER",
    pageOrientation: "portrait",
    pageMargins: [M, 28, M, 46],
    info: { title: doc.title, author: config.organization, creator: brand },
    footer,
    content,
    defaultStyle: { fontSize: 8.5, color: TEXT },
  };
};

/** Devuelve el PDF como Blob */
export const buildDocumentPdf = (config, doc) => pdfMake.createPdf(buildDocumentPdfDefinition(config, doc)).getBlob();













import ExcelJS from "exceljs";
import { cellTone, cellValue, displayValue, formatDateTime } from "./reportFormat";

/* =========================================================
   Reporte tipo "documento" (una ficha con secciones), en Excel.
   Secciones: fields (campo / valor) · table · blocks (como tabla)
   ========================================================= */

const argb = (hex) => `FF${String(hex).replace("#", "").toUpperCase()}`;
const solid = (hex) => ({ type: "pattern", pattern: "solid", fgColor: { argb: argb(hex) } });

const COLS = 5;
const GREY = "#6B7A8F";
const SUBHEAD = "#2D5A88";
const LIGHT = "#F4F8FD";
const LINE = "#E6EBF1";
const thin = { style: "thin", color: { argb: argb(LINE) } };
const box = { top: thin, bottom: thin, left: thin, right: thin };

export const buildDocumentExcel = async (config, doc) => {
  const brand = config.brandName ?? config.system;

  const workbook = new ExcelJS.Workbook();
  workbook.creator = brand;
  workbook.created = doc.generatedAt;

  const sheet = workbook.addWorksheet((doc.sheetName ?? "Reporte").slice(0, 31), {
    pageSetup: {
      paperSize: config.pageSize === "A4" ? 9 : 1,
      orientation: "portrait",
      fitToPage: true,
      fitToWidth: 1,
      fitToHeight: 0,
      margins: { left: 0.4, right: 0.4, top: 0.5, bottom: 0.5, header: 0.2, footer: 0.2 },
    },
    headerFooter: { oddFooter: "&R&8Página &P de &N" },
    views: [{ showGridLines: false }],
  });
  sheet.columns = [{ width: 26 }, { width: 30 }, { width: 24 }, { width: 26 }, { width: 18 }];

  let r = 1;
  const merge = (from, to) => { if (to > from) sheet.mergeCells(r, from, r, to); };
  const set = (col, props) => Object.assign(sheet.getCell(r, col), props);

  /* ---------- Encabezado ---------- */
  merge(1, COLS);
  sheet.getRow(r).height = 34;
  set(1, {
    value: `${brand}${config.organization ? ` — ${config.organization}` : ""}   |   ${doc.title}`,
    font: { size: 15, bold: true, color: { argb: "FFFFFFFF" } },
    fill: solid(config.primaryColor),
    alignment: { horizontal: "center", vertical: "middle" },
  });
  r++;

  merge(1, COLS);
  sheet.getRow(r).height = 4;
  set(1, { fill: solid(config.accentColor) });
  r++;

  merge(1, COLS);
  sheet.getRow(r).height = 20;
  set(1, {
    value: ["Documento generado automáticamente", config.confidentialText ? "Confidencial" : null, "Solo lectura"].filter(Boolean).join("   ·   "),
    font: { size: 9, italic: true, color: { argb: argb(GREY) } },
    alignment: { horizontal: "center", vertical: "middle" },
  });
  r++;

  merge(1, COLS);
  set(1, {
    value: [
      `Generado el ${formatDateTime(doc.generatedAt)}`,
      config.showGeneratedBy && doc.generatedBy ? `Generado por ${doc.generatedBy}` : null,
      ...(doc.highlights ?? []).map((h) => `${h.label}: ${h.value || "—"}`),
    ].filter(Boolean).join("   ·   "),
    font: { size: 9, color: { argb: argb(config.primaryColor) } },
    fill: solid(LIGHT),
    alignment: { horizontal: "center", vertical: "middle", wrapText: true },
  });
  sheet.getRow(r).height = 22;
  r += 2;

  /* ---------- Helpers ---------- */
  const sectionTitle = (title) => {
    merge(1, COLS);
    sheet.getRow(r).height = 22;
    set(1, {
      value: title.toUpperCase(),
      font: { size: 10, bold: true, color: { argb: "FFFFFFFF" } },
      fill: solid(config.primaryColor),
      alignment: { vertical: "middle", indent: 1 },
    });
    r++;
  };

  // Escribe una fila repartida en columnas; la última ocupa hasta la columna 5
  const writeRow = (cells, style) => {
    cells.forEach((cell, i) => {
      const col = i + 1;
      const last = i === cells.length - 1;
      if (last) merge(col, COLS);
      const target = sheet.getCell(r, col);
      Object.assign(target, style(cell, i));
      for (let c = col; c <= (last ? COLS : col); c++) sheet.getCell(r, c).border = box;
    });
    r++;
  };

  const headStyle = (text) => ({
    value: text,
    font: { size: 9, bold: true, color: { argb: "FFFFFFFF" } },
    fill: solid(SUBHEAD),
    alignment: { horizontal: "center", vertical: "middle", wrapText: true },
  });

  const valueStyle = (value, tone, align) => ({
    value: value ?? "",
    font: tone ? { size: 10, bold: true, color: { argb: argb(tone.fg) } } : { size: 10 },
    ...(tone ? { fill: solid(tone.bg) } : {}),
    alignment: { vertical: "top", wrapText: true, horizontal: align ?? (tone ? "center" : "left") },
  });

  const emptyRow = (text) => {
    merge(1, COLS);
    set(1, { value: text, font: { italic: true, size: 10, color: { argb: argb(GREY) } }, alignment: { indent: 1 } });
    r++;
  };

  const tableRows = (columns, rows) => {
    writeRow(columns.map((c) => c.header), headStyle);
    rows.forEach((row) =>
      writeRow(columns, (c) => {
        const raw = cellValue(c, row);
        return valueStyle(displayValue({ ...c, empty: "" }, raw), cellTone(c, raw), c.align);
      })
    );
  };

  /* ---------- Secciones ---------- */
  doc.sections.forEach((s) => {
    sectionTitle(s.title);

    if (s.type === "fields") {
      writeRow(["Campo", "Valor", "Campo", "Valor"], headStyle);
      for (let i = 0; i < s.fields.length; i += 2) {
        const pair = [s.fields[i], s.fields[i + 1]];
        writeRow(pair.flatMap((f) => (f ? [{ label: true, f }, { f }] : [{}, {}])), (cell) => {
          if (!cell.f) return { value: "" };
          if (cell.label) {
            return { value: cell.f.label, font: { size: 10, color: { argb: argb(GREY) } }, fill: solid(LIGHT), alignment: { vertical: "top", indent: 1 } };
          }
          return valueStyle(cell.f.value, cell.f.tone ? cellTone({ tone: () => cell.f.tone }, cell.f.value) : null);
        });
      }
    } else if (!s.rows?.length) {
      emptyRow(s.empty ?? "Sin registros.");
    } else {
      tableRows(s.columns, s.rows); // "table" y "blocks" se muestran como tabla
    }
    r++;
  });

  /* ---------- Pie ---------- */
  merge(1, COLS);
  sheet.getRow(r).height = 30;
  set(1, {
    value: [
      `Documento generado automáticamente por ${brand}${config.organization ? ` — ${config.organization}` : ""}`,
      doc.generatedBy ? `Generado por ${doc.generatedBy}` : null,
      `Fecha ${formatDateTime(doc.generatedAt)}`,
      config.confidentialText || null,
    ].filter(Boolean).join("   ·   "),
    font: { size: 8, italic: true, color: { argb: argb(GREY) } },
    alignment: { horizontal: "center", vertical: "middle", wrapText: true },
  });

  const buffer = await workbook.xlsx.writeBuffer();
  return new Blob([buffer], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" });
};






