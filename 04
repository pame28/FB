CREATE View [dbo].[uvw_NombreFiadores]
As

	With cteListadoFiadores As(
			Select Row_Number() Over (Partition By C.NoUsuario Order By C.NoUsuario) As NoRow, 
				C.*
			From dbo.EMaestroFiadores C)
		
		Select 
			 Cast('VASA' As Varchar(4))																				As Origen
			,Cast(Tar.NoUsuario As Varchar(13))																		As NoUsuario
			,Cast(IsNull(Max(Case ListF1.NoRow When 1 Then ListF1.NombreApellido End),'') As Varchar(40))			As NombreFiador1
			,Cast(IsNull(Max(Case ListF1.NoRow When 1 Then ListF1.NoDocumento End), '') As Varchar(15))				As NumCedulaFiador1
			,Cast(IsNull(Max(Case ListF1.NoRow When 1 Then ListF1.DomicilioParticular1 End),'') As Varchar(40))		As DireccionFiador1
			,Cast(IsNull(Max(Case ListF1.NoRow When 1 Then ListF1.DomicilioParticular2 End),'') As Varchar(40))		As DireccionFiador1_2
			,Cast(IsNull(Max(Case ListF1.NoRow When 1 Then ListF1.DomicilioParticular3 End),'') As Varchar(40))		As DireccionFiador1_3
			,Cast(IsNull(Max(Case ListF1.NoRow When 1 Then ListF1.Telefono End),'') As Varchar(30))					As Telefono1_1
			,Cast(IsNull(Max(Case ListF1.NoRow When 1 Then ListF1.TelefonoLaboral End),'') As Varchar(30))			As Telefono1_2
			,Cast(IsNull(Max(Case ListF1.NoRow When 2 Then ListF1.NombreApellido End),'') As Varchar(40))			As NombreFiador2
			,Cast(IsNull(Max(Case ListF1.NoRow When 2 Then ListF1.NoDocumento End),'') As Varchar(15))				As NumCedulaFiador2
			,Cast(IsNull(Max(Case ListF1.NoRow When 2 Then ListF1.DomicilioParticular1 End),'') As Varchar(40))		As DireccionFiador2
			,Cast(IsNull(Max(Case ListF1.NoRow When 2 Then ListF1.DomicilioParticular2 End),'') As Varchar(40))		As DireccionFiador2_2
			,Cast(IsNull(Max(Case ListF1.NoRow When 2 Then ListF1.DomicilioParticular3 End),'') As Varchar(40))		As DireccionFiador2_3
			,Cast(IsNull(Max(Case ListF1.NoRow When 2 Then ListF1.Telefono End),'') As Varchar(30))					As Telefono2_1
			,Cast(IsNull(Max(Case ListF1.NoRow When 2 Then ListF1.TelefonoLaboral End),'') As Varchar(30))			As Telefono2_2
			,Cast(IsNull(Max(Case ListF1.NoRow When 3 Then ListF1.NombreApellido End),'') As Varchar(40))			As NombreFiador3
			,Cast(IsNull(Max(Case ListF1.NoRow When 3 Then ListF1.NoDocumento End),'') As Varchar(15))				As NumCedulaFiador3
			,Cast(IsNull(Max(Case ListF1.NoRow When 3 Then ListF1.DomicilioParticular1 End),'') As Varchar(40))		As DireccionFiador3
			,Cast(IsNull(Max(Case ListF1.NoRow When 3 Then ListF1.DomicilioParticular2 End),'') As Varchar(40))		As DireccionFiador3_2
			,Cast(IsNull(Max(Case ListF1.NoRow When 3 Then ListF1.DomicilioParticular3 End),'') As Varchar(40))		As DireccionFiador3_3
			,Cast(IsNull(Max(Case ListF1.NoRow When 3 Then ListF1.Telefono End),'') As Varchar(30))					As Telefono3_1
			,Cast(IsNull(Max(Case ListF1.NoRow When 3 Then ListF1.TelefonoLaboral End),'') As Varchar(30))			As Telefono3_2
			,Cast(Tar.NoCuentaClaro As Varchar(10))																	As NoCuentaClaro
		From
			cteListadoFiadores ListF1
				LEFT OUTER JOIN cteListadoFiadores ListF2 On (ListF2.NoUsuario = ListF1.NoUsuario AND ListF2.NoRow = ListF1.NoRow - 1)
		Inner Join
			ETarjetas Tar
		On Tar.NoUsuario = ListF1.NoUsuario
		Group By
			Tar.NoUsuario, Tar.NoCuentaClaro

GO






