import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import { AlertCircle, Braces, Check, Loader2, Pencil, Plus, Search, Trash2, X } from "lucide-react";
import { ConfirmDialog, useToast } from "../../../shared/components";
import { markersService } from "../../../api/markersService";
import { MARKER_TYPES, findMarkerType } from "./markerTypes";
import styles from "../../Pages.module.css";
import m from "./Markers.module.css";

const MAX_LENGTH = 60;
const EMPTY_FORM = { value: "", valueType: "" };

const TONES = {
  text: m.toneText,
  number: m.toneNumber,
  money: m.toneMoney,
  date: m.toneDate,
  bool: m.toneBool,
};

// Compara nombres sin tildes, mayúsculas ni espacios extra
const normalize = (v) => String(v ?? "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();

const mapMarker = (x) => ({ id: x.id, value: x.value ?? "", type: findMarkerType(x.valueType) });

const tokenOf = (value) => `{ ${value} }`;

function TypeTag({ type }) {
  if (!type) return <span className={`${m.typeTag} ${m.toneNeutral}`}>Sin tipo</span>;
  const Icon = type.icon;
  return (
    <span className={`${m.typeTag} ${TONES[type.tone]}`}>
      <Icon size={12} strokeWidth={2.4} />
      {type.label}
    </span>
  );
}

export const MarcadoresPage = () => {
  const toast = useToast();

  // Listado
  const [markers, setMarkers] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  // Filtros
  const [search, setSearch] = useState("");
  const [typeFilter, setTypeFilter] = useState("all");

  // Panel crear / editar
  const [composer, setComposer] = useState({ open: false, editing: null });
  const [form, setForm] = useState(EMPTY_FORM);
  const [errors, setErrors] = useState({});
  const [saving, setSaving] = useState(false);
  const [submitError, setSubmitError] = useState("");
  const composerRef = useRef(null);
  const inputRef = useRef(null);

  // Eliminar
  const [toDelete, setToDelete] = useState(null);
  const [deleting, setDeleting] = useState(false);
  const [deleteError, setDeleteError] = useState("");

  /* ---------- Carga ---------- */
  const load = useCallback(async () => {
    setLoading(true);
    setError("");
    try {
      const data = await markersService.list();
      setMarkers(data.map(mapMarker));
    } catch (err) {
      setError(err.noAccess
        ? "No tienes permiso para ver los marcadores."
        : "No se pudieron cargar los marcadores. Intenta de nuevo.");
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => { load(); }, [load]);

  // Al abrir el panel: lo muestra y enfoca el nombre
  useEffect(() => {
    if (!composer.open) return;
    composerRef.current?.scrollIntoView({ behavior: "smooth", block: "nearest" });
    inputRef.current?.focus();
  }, [composer]);

  /* ---------- Panel ---------- */
  const openComposer = (editing = null) => {
    setComposer({ open: true, editing });
    setForm(editing
      ? { value: editing.value, valueType: editing.type ? String(editing.type.value) : "" }
      : EMPTY_FORM);
    setErrors({});
    setSubmitError("");
  };

  const closeComposer = () => {
    if (saving) return;
    setComposer({ open: false, editing: null });
  };

  const handleFormChange = (e) => {
    const { name, value } = e.target;
    setForm((f) => ({ ...f, [name]: value }));
    setErrors((er) => ({ ...er, [name]: undefined }));
  };

  // Duplicado: mismo nombre (sin importar tipo, mayúsculas ni tildes), excluyendo el que se edita
  const trimmed = form.value.trim();
  const duplicate = trimmed
    ? markers.find((x) => x.id !== composer.editing?.id && normalize(x.value) === normalize(trimmed))
    : null;

  const selectedType = MARKER_TYPES.find((t) => String(t.value) === form.valueType) ?? null;
  const canSubmit = Boolean(trimmed) && form.valueType !== "" && !duplicate;

  const nameError = errors.value
    || (duplicate ? `Ya existe ${tokenOf(duplicate.value)}${duplicate.type ? ` (${duplicate.type.label})` : ""}. Los nombres no se pueden repetir.` : "");

  const handleSubmit = async (e) => {
    e.preventDefault();
    const found = {};
    if (!trimmed) found.value = "Escribe el nombre del marcador.";
    if (form.valueType === "") found.valueType = "Selecciona el tipo de valor.";
    setErrors(found);
    if (Object.keys(found).length > 0 || duplicate) return;

    setSaving(true);
    setSubmitError("");
    const body = { value: trimmed, valueType: Number(form.valueType) };
    const isEdit = Boolean(composer.editing);

    try {
      if (isEdit) await markersService.update(composer.editing.id, body);
      else await markersService.create(body);

      toast.success(
        isEdit ? "Marcador actualizado" : "Marcador creado",
        `${tokenOf(trimmed)} · ${selectedType?.label ?? ""}`
      );
      setComposer({ open: false, editing: null });
      load();
    } catch (err) {
      setSubmitError(err.noAccess
        ? `No tienes permiso para ${isEdit ? "editar" : "crear"} marcadores.`
        : err.response?.data?.message ?? "No se pudo guardar el marcador. Intenta de nuevo.");
    } finally {
      setSaving(false);
    }
  };

  /* ---------- Copiar ---------- */
  const copyMarker = async (marker) => {
    const text = `{${marker.value}}`;
    try {
      await navigator.clipboard.writeText(text);
      toast.info("Marcador copiado", `${text} está listo para pegar en una plantilla.`, { duration: 2500 });
    } catch {
      toast.error("No se pudo copiar", "Copia el marcador manualmente.");
    }
  };

  /* ---------- Eliminar ---------- */
  const openDelete = (marker) => {
    setDeleteError("");
    setToDelete(marker);
  };

  const confirmDelete = async () => {
    setDeleting(true);
    setDeleteError("");
    try {
      await markersService.remove(toDelete.id);
      toast.success("Marcador eliminado", `${tokenOf(toDelete.value)} ya no está disponible.`);
      if (composer.editing?.id === toDelete.id) setComposer({ open: false, editing: null });
      setToDelete(null);
      load();
    } catch (err) {
      setDeleteError(err.noAccess
        ? "No tienes permiso para eliminar marcadores."
        : err.response?.data?.message ?? "No se pudo eliminar. Es posible que el marcador esté en uso en una plantilla.");
    } finally {
      setDeleting(false);
    }
  };

  /* ---------- Filtros ---------- */
  const counts = useMemo(() => {
    const c = new Map();
    markers.forEach((x) => {
      const key = x.type?.value ?? "none";
      c.set(key, (c.get(key) ?? 0) + 1);
    });
    return c;
  }, [markers]);

  // Solo se muestran los filtros de los tipos que tienen marcadores
  const typeOptions = MARKER_TYPES.filter((t) => counts.get(t.value));

  const visible = useMemo(() => {
    const q = normalize(search);
    return markers
      .filter((x) => typeFilter === "all" || x.type?.value === typeFilter)
      .filter((x) => !q || normalize(x.value).includes(q))
      .sort((a, b) => a.value.localeCompare(b.value, "es"));
  }, [markers, search, typeFilter]);

  /* ---------- Render ---------- */
  return (
    <>
      <header className={styles.pageHeader}>
        <div>
          <span className={styles.eyebrow}>Indicadores</span>
          <h1 className={styles.title}>Marcadores</h1>
          <p className={styles.subtitle}>Marcadores disponibles para usar en las plantillas de indicadores.</p>
        </div>
        <div className={styles.actions}>
          <button type="button" className={`${styles.btn} ${styles.btnPrimary}`} onClick={() => openComposer()}>
            <Plus size={18} /> Insertar nuevo marcador
          </button>
        </div>
      </header>

      {error && (
        <div className={`${styles.banner} ${styles.bannerError}`} role="alert">
          <AlertCircle size={18} />
          <p>
            {error}{" "}
            <button type="button" className={styles.linkBtn} style={{ padding: 0 }} onClick={load}>Reintentar</button>
          </p>
        </div>
      )}

      {/* ---------- Panel crear / editar ---------- */}
      {composer.open && (
        <form
          ref={composerRef}
          className={m.composer}
          onSubmit={handleSubmit}
          onKeyDown={(e) => e.key === "Escape" && closeComposer()}
          noValidate
        >
          <div className={m.composerHead}>
            <div>
              <span className={m.composerEyebrow}>{composer.editing ? "Editar marcador" : "Nuevo marcador"}</span>
              <h2 className={m.composerTitle}>
                {composer.editing ? "Actualiza el nombre o el tipo de valor" : "Define el nombre y el tipo de valor"}
              </h2>
            </div>
            <button type="button" className={styles.iconBtn} onClick={closeComposer} aria-label="Cerrar" disabled={saving}>
              <X size={16} />
            </button>
          </div>

          {submitError && (
            <div className={`${styles.banner} ${styles.bannerError}`} role="alert" style={{ margin: "14px 0 0" }}>
              <AlertCircle size={18} />
              <p>{submitError}</p>
            </div>
          )}

          <div className={m.composerGrid}>
            <div className={styles.field}>
              <label className={styles.label} htmlFor="marker-value">
                Nombre del marcador<span className={styles.required}>*</span>
              </label>
              <div className={`${m.braceInput} ${nameError ? m.braceInputInvalid : ""}`}>
                <span className={m.brace} aria-hidden="true">{"{"}</span>
                <input
                  ref={inputRef}
                  id="marker-value"
                  name="value"
                  className={m.braceField}
                  placeholder="ValorX"
                  value={form.value}
                  onChange={handleFormChange}
                  maxLength={MAX_LENGTH}
                  autoComplete="off"
                  aria-invalid={!!nameError}
                />
                <span className={m.brace} aria-hidden="true">{"}"}</span>
              </div>
              {nameError
                ? <span className={styles.fieldError}>{nameError}</span>
                : <span className={styles.hint}>Así aparecerá dentro de las plantillas.</span>}
            </div>

            <div className={styles.field}>
              <label className={styles.label} htmlFor="marker-type">
                Tipo de valor<span className={styles.required}>*</span>
              </label>
              <select
                id="marker-type"
                name="valueType"
                className={`${styles.select} ${errors.valueType ? styles.invalid : ""}`}
                value={form.valueType}
                onChange={handleFormChange}
                aria-invalid={!!errors.valueType}
              >
                <option value="">— Selecciona el tipo —</option>
                {MARKER_TYPES.map((t) => <option key={t.value} value={t.value}>{t.label}</option>)}
              </select>
              {errors.valueType && <span className={styles.fieldError}>{errors.valueType}</span>}
            </div>
          </div>

          <div className={m.composerFoot}>
            <div className={m.preview} aria-live="polite">
              <span className={m.previewLabel}>Vista previa</span>
              {trimmed ? (
                <span className={m.previewToken}>
                  <span className={m.tokenText}>{tokenOf(trimmed)}</span>
                  {selectedType && <TypeTag type={selectedType} />}
                </span>
              ) : (
                <span className={m.previewEmpty}>Escribe un nombre para ver el marcador</span>
              )}
            </div>

            <div className={m.composerActions}>
              <button type="button" className={`${styles.btn} ${styles.btnOutline}`} onClick={closeComposer} disabled={saving}>
                Cancelar
              </button>
              <button type="submit" className={`${styles.btn} ${styles.btnPrimary}`} disabled={!canSubmit || saving}>
                {saving ? <Loader2 size={16} className={styles.spin} /> : <Check size={16} />}
                {saving ? "Guardando..." : composer.editing ? "Guardar cambios" : "Insertar marcador"}
              </button>
            </div>
          </div>
        </form>
      )}

      {/* ---------- Pool ---------- */}
      <section className={m.pool} aria-label="Pool de marcadores">
        <div className={m.poolHead}>
          <div>
            <h2 className={m.poolTitle}><Braces size={18} /> Pool de marcadores</h2>
            <p className={m.poolSub}>
              {loading
                ? "Cargando marcadores..."
                : `${markers.length} ${markers.length === 1 ? "disponible" : "disponibles"} · haz clic en un marcador para copiarlo`}
            </p>
          </div>

          {markers.length > 0 && (
            <div className={m.search}>
              <Search size={16} />
              <input className={styles.input} placeholder="Buscar marcador..." value={search}
                onChange={(e) => setSearch(e.target.value)} aria-label="Buscar marcador" />
            </div>
          )}
        </div>

        {markers.length > 0 && (
          <div className={m.filters} role="toolbar" aria-label="Filtrar por tipo de valor">
            <button type="button" className={`${m.filterChip} ${typeFilter === "all" ? m.filterChipOn : ""}`}
              onClick={() => setTypeFilter("all")} aria-pressed={typeFilter === "all"}>
              Todos <span className={m.filterCount}>{markers.length}</span>
            </button>
            {typeOptions.map((t) => {
              const Icon = t.icon;
              const on = typeFilter === t.value;
              return (
                <button key={t.value} type="button" className={`${m.filterChip} ${on ? m.filterChipOn : ""}`}
                  onClick={() => setTypeFilter(on ? "all" : t.value)} aria-pressed={on}>
                  <Icon size={13} strokeWidth={2.4} />
                  {t.label}
                  <span className={m.filterCount}>{counts.get(t.value)}</span>
                </button>
              );
            })}
          </div>
        )}

        {loading ? (
          <ul className={m.tokenGrid} style={{ marginTop: 18 }} aria-hidden="true">
            {[180, 220, 150, 200, 170, 240, 160].map((w, i) => (
              <li key={i} className={m.skeletonToken} style={{ width: w }} />
            ))}
          </ul>
        ) : markers.length === 0 ? (
          !error && (
            <div className={m.empty}>
              <div className={m.emptyArt} aria-hidden="true">
                <span>{"{"}</span><span className={m.cursor} /><span>{"}"}</span>
              </div>
              <h3>Aún no hay marcadores</h3>
              <p>Crea el primero para empezar a usarlo en las plantillas.</p>
              <button type="button" className={`${styles.btn} ${styles.btnPrimary}`} onClick={() => openComposer()}>
                <Plus size={18} /> Insertar nuevo marcador
              </button>
            </div>
          )
        ) : visible.length === 0 ? (
          <p className={m.noResults}>Ningún marcador coincide con la búsqueda o el filtro.</p>
        ) : (
          <ul className={m.tokenGrid}>
            {visible.map((marker) => (
              <li key={marker.id} className={m.token}>
                <button type="button" className={m.tokenMain} onClick={() => copyMarker(marker)}
                  title={`Copiar {${marker.value}}`}>
                  <span className={m.tokenText}>{tokenOf(marker.value)}</span>
                  <TypeTag type={marker.type} />
                </button>
                <span className={m.tokenActions}>
                  <button type="button" className={m.tokenBtn} onClick={() => openComposer(marker)}
                    aria-label={`Editar ${marker.value}`} title="Editar">
                    <Pencil size={14} />
                  </button>
                  <button type="button" className={`${m.tokenBtn} ${m.tokenBtnDanger}`} onClick={() => openDelete(marker)}
                    aria-label={`Eliminar ${marker.value}`} title="Eliminar">
                    <Trash2 size={14} />
                  </button>
                </span>
              </li>
            ))}
          </ul>
        )}
      </section>

      {/* ---------- Eliminar ---------- */}
      <ConfirmDialog
        open={Boolean(toDelete)}
        danger
        title="¿Eliminar marcador?"
        message="Las plantillas que lo usen dejarán de poder reemplazarlo. Esta acción no se puede deshacer."
        detail={toDelete && (
          <div style={{ display: "flex", justifyContent: "center" }}>
            <span className={m.previewToken}>
              <span className={m.tokenText}>{tokenOf(toDelete.value)}</span>
              <TypeTag type={toDelete.type} />
            </span>
          </div>
        )}
        confirmText={deleting ? "Eliminando..." : "Sí, eliminar"}
        loading={deleting}
        error={deleteError}
        onConfirm={confirmDelete}
        onCancel={() => setToDelete(null)}
      />
    </>
  );
};













