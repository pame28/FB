/* ---- Casillas para completar 3 filas de miembros ---- */
.slotItem {
  display: flex;
  align-items: center;
  min-height: var(--member-row);
  padding: 0 4px 0 2px;
  border-top: 1px solid #f1f4f8;
}

.memberSlot {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  height: 44px;
  padding: 0 12px 0 4px;
  border: 1.5px dashed #d9e0ea;
  border-radius: 10px;
  background: transparent;
  font: inherit;
  font-size: 13px;
  font-weight: 700;
  text-align: left;
  color: #a3adbb;
  cursor: pointer;
  transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
}
.memberSlot:hover {
  border-color: var(--bp-yellow-opt);
  background: #fffbeb;
  color: #8a5a00;
}
.memberSlot:focus-visible { outline: 2px solid var(--bp-blue-digital); outline-offset: 2px; }

.slotIcon {
  width: 28px;
  height: 28px;
  flex-shrink: 0;
  margin-left: 4px;
  display: grid;
  place-items: center;
  border: 1.5px dashed currentColor;
  border-radius: 50%;
}











