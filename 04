import { toTitleCase } from "../../../../helpers/format";

// Quita tildes y mayúsculas para buscar y comparar
export const normalize = (value) =>
  String(value ?? "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();

export const initials = (name = "") =>
  name.trim().split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join("").toUpperCase() || "?";

const cleanName = (name) => toTitleCase(name ?? "").trim() || "Sin nombre";

/** Equipo de la API → formato de la pantalla. Los campos opcionales aparecen cuando backend los envíe. */
export const mapTeam = (t) => ({
  id: t.id,
  name: t.name ?? "",
  areaId: t.companyAreaId ?? null,
  areaName: t.companyAreaName ?? "",
  leaders: (t.leaders ?? []).map((l) => ({
    id: l.leaderUserId,
    name: cleanName(l.leaderUserFullName),
    status: l.leaderUserStatus ?? "",
    position: l.leaderUserCompanyPosition ?? "",
  })),
  members: (t.members ?? []).map((m) => ({
    id: m.memberUserId,
    name: cleanName(m.memberUserFullName),
    status: m.memberUserStatus ?? "",
    position: m.memberUserCompanyPosition ?? "",
    branch: m.memberUserCompanyBranch ?? "",
  })),
});

/** Usuario de available/leaders o available/members → formato de la pantalla */
export const mapAvailableUser = (u) => ({
  id: u.id,
  name: cleanName(u.fullName),
  code: u.userName ?? u.employeeCode ?? "",
  status: u.userStatus ?? "",
  position: u.userCompanyPosition ?? "",
  branch: u.userCompanyBranch ?? "",
  location: u.userCompanyLocation ?? "",
});

export const userSubtitle = (u) =>
  [u.position, u.branch ? toTitleCase(u.branch) : u.location].filter(Boolean).join(" · ");

export const statusTone = (status) =>
  status === "Activo" ? "active" : status === "Inactivo" ? "inactive" : "warning";

export const MOVE_REASONS = ["Traslado", "Cambio de líder", "Reestructuración", "Solicitud"];

// Fecha de hoy en formato YYYY-MM-DD (hora local, no UTC)
export const todayISO = () => {
  const d = new Date();
  d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
  return d.toISOString().slice(0, 10);
};











import { useEffect, useState } from "react";
import { teamsService } from "../../../../api/teamsService";
import { mapAvailableUser } from "./teamUtils";

/**
 * Carga líderes o miembros disponibles de un área.
 * kind: "leaders" | "members". Solo consulta cuando enabled es true.
 */
export function useAvailableUsers(kind, areaId, enabled) {
  const [state, setState] = useState({ items: [], loading: false, error: "" });

  useEffect(() => {
    if (!enabled || !areaId) return;
    let cancelled = false;
    setState({ items: [], loading: true, error: "" });

    const fetcher = kind === "leaders" ? teamsService.availableLeaders : teamsService.availableMembers;

    fetcher(areaId)
      .then((data) => {
        if (!cancelled) setState({ items: data.map(mapAvailableUser), loading: false, error: "" });
      })
      .catch((err) => {
        if (!cancelled) setState({
          items: [],
          loading: false,
          error: err.noAccess ? "No tienes permiso para consultar usuarios." : "No se pudo cargar la lista de usuarios.",
        });
      });

    return () => { cancelled = true; };
  }, [kind, areaId, enabled]);

  return state;
}












import { Fragment } from "react";
import { Check } from "lucide-react";
import t from "./Teams.module.css";

export function Stepper({ steps, current }) {
  return (
    <div className={t.stepper} role="list" aria-label="Pasos">
      {steps.map((label, i) => {
        const n = i + 1;
        const done = n < current;
        const active = n === current;
        return (
          <Fragment key={label}>
            {i > 0 && <span className={`${t.stepLine} ${n <= current ? t.stepLineDone : ""}`} aria-hidden="true" />}
            <div
              role="listitem"
              className={`${t.step} ${done ? t.stepDone : ""} ${active ? t.stepActive : ""}`}
              aria-current={active ? "step" : undefined}
            >
              <span className={t.stepDot}>{done ? <Check size={14} strokeWidth={3} /> : n}</span>
              <span className={t.stepLabel}>{label}</span>
            </div>
          </Fragment>
        );
      })}
    </div>
  );
}













import { useMemo, useState } from "react";
import { Search } from "lucide-react";
import { initials, normalize, statusTone, userSubtitle } from "./teamUtils";
import pages from "../../../Pages.module.css";
import t from "./Teams.module.css";

export function UserPickList({
  users,
  selectedIds,
  onChange,
  loading = false,
  error = "",
  emptyMessage = "No hay usuarios disponibles.",
  maxHeight = 280,
  showSelectAll = true,
}) {
  const [query, setQuery] = useState("");
  const selected = new Set(selectedIds);

  const visible = useMemo(() => {
    const q = normalize(query);
    return q ? users.filter((u) => normalize(`${u.name} ${u.code}`).includes(q)) : users;
  }, [users, query]);

  const toggle = (id) =>
    onChange(selected.has(id) ? selectedIds.filter((x) => x !== id) : [...selectedIds, id]);

  const allVisibleSelected = visible.length > 0 && visible.every((u) => selected.has(u.id));

  const toggleAll = () => {
    const visibleIds = visible.map((u) => u.id);
    onChange(allVisibleSelected
      ? selectedIds.filter((id) => !visibleIds.includes(id))
      : [...new Set([...selectedIds, ...visibleIds])]);
  };

  return (
    <div className={t.pick}>
      <div className={t.search}>
        <Search size={16} />
        <input className={pages.input} placeholder="Buscar por nombre o código..." value={query}
          onChange={(e) => setQuery(e.target.value)} aria-label="Buscar usuarios" />
      </div>

      <div className={t.pickList} style={{ maxHeight }} role="group">
        {loading ? (
          Array.from({ length: 4 }, (_, i) => <div key={i} className={t.pickSkeleton} />)
        ) : error ? (
          <p className={t.pickEmpty}>{error}</p>
        ) : visible.length === 0 ? (
          <p className={t.pickEmpty}>{query ? `Sin resultados para "${query}".` : emptyMessage}</p>
        ) : (
          visible.map((u) => {
            const sub = userSubtitle(u);
            const on = selected.has(u.id);
            return (
              <label key={u.id} className={`${t.pickItem} ${on ? t.pickItemOn : ""}`}>
                <input type="checkbox" className={t.checkbox} checked={on} onChange={() => toggle(u.id)} />
                <span className={t.avatar}>{initials(u.name)}</span>
                <span className={t.personText}>
                  <span className={t.personName}>
                    {u.name}
                    {u.code && <span className={t.code}> — {u.code}</span>}
                    {u.isCurrent && <span className={t.currentTag}>Actual</span>}
                  </span>
                  {sub && <span className={t.personSub}>{sub}</span>}
                </span>
                {u.status && <span className={`${t.status} ${t[statusTone(u.status)]}`}>{u.status}</span>}
              </label>
            );
          })
        )}
      </div>

      <div className={t.pickFooter}>
        <span>{selectedIds.length} {selectedIds.length === 1 ? "seleccionado" : "seleccionados"}</span>
        {showSelectAll && !loading && visible.length > 1 && (
          <label className={t.selectAll}>
            <input type="checkbox" className={t.checkbox} checked={allVisibleSelected} onChange={toggleAll} />
            Seleccionar todos
          </label>
        )}
      </div>
    </div>
  );
}










