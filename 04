const TEAM_STATE = {
    pending: { label: "Pendiente aprobación", status: STATUS.pending },
    approved: { label: "Certificado", status: STATUS.approved },
    rejected: { label: "No aprobado", status: STATUS.rejected },
    none: { label: "Sin certificación", status: STATUS.rejected },
};

const stateOf = (c) => (!c ? "none" : c.status === STATUS.pending ? "pending" : c.status === STATUS.approved ? "approved" : "rejected");

export const ApplyCertificationPage = () => {
    const toast = useToast();
    const me = useCurrentUser();
    const [TEAMS, setTeams] = useState([]);
    const [certifications, setCertifications] = useState([]);

    const load = useCallback(async () => {
        try {
            const [teams, certs] = await Promise.all([certificationService.myTeams(), certificationService.mine()]);
            setTeams(teams);
            setCertifications(certs.map(mapCertification));
        } catch (error) {
            toast.error(error.noAccess ? "No tienes permiso para aplicar certificaciones." : "No se pudieron cargar los equipos asignados.");
        }
    }, []);

    useEffect(() => { load(); }, [load]);

    const AREAS = [...new Set(TEAMS.map((t) => t.area))].sort();

    const [area, setArea] = useState("todas");
    const [search, setSearch] = useState("");
    const [stateFilter, setStateFilter] = useState("todos");
    const [applyTeam, setApplyTeam] = useState(null);
    const [historyTeam, setHistoryTeam] = useState(null);
    const [approveTarget, setApproveTarget] = useState(null);

    const infoByTeam = TEAMS.map((team) => {
        const own = certifications.filter((c) => c.teamId === team.id);
        const latest = latestOf(own);
        return { team, hasAny: own.length > 0, latest, state: stateOf(latest) };
    });

    const q = search.trim().toLowerCase();
    const visible = infoByTeam.filter(
        ({ team, hasAny, state }) =>
            (area === "todas" || team.area === area) &&
            (!q || team.name.toLowerCase().includes(q)) &&
            (stateFilter === "todos" ||
                (stateFilter === "con" && hasAny) ||
                (stateFilter === "pending" && state === "pending") ||
                (stateFilter === "none" && !hasAny))
    );

    const handleApply = (team) => {
        if (!team.format) {
            toast.error("El equipo no tiene un formato activo asignado. No es posible iniciar la certificación.");
            return;
        }
        if (team.leaders.length === 0) {
            toast.error("El equipo no tiene un líder asignado. No es posible iniciar la certificación.");
            return;
        }
        setApplyTeam(team);
    };

    return (
        <>
            <header className={shared.headerRow}>
                <div>
                    <h1 className={styles.title}>Aplicar certificación</h1>
                    <p className={styles.subtitle}>Selecciona un equipo y aplica la certificación a su líder o líderes designados.</p>
                </div>
            </header>

            <div className={base.page}>
                <div className={shared.stats}>
                    <StatCard value={TEAMS.length} label="Equipos activos" />
                    <StatCard value={infoByTeam.filter((i) => i.hasAny).length} label="Con certificación aplicada" tone="green" />
                    <StatCard value={infoByTeam.filter((i) => i.state === "pending").length} label="Pendiente de aprobación" tone="amber" />
                    <StatCard value={infoByTeam.filter((i) => !i.hasAny).length} label="Sin certificación" tone="red" />
                </div>

                <section className={shared.filterCard}>
                    <div className={shared.filterTitle}><Filter size={16} /> Filtrar equipos</div>
                    <div className={shared.filterRow}>
                        <select className={`${base.select} ${shared.filterSelect}`} value={area} onChange={(e) => setArea(e.target.value)} aria-label="Filtrar por área">
                            <option value="todas">Todas las áreas</option>
                            {AREAS.map((a) => <option key={a} value={a}>{a}</option>)}
                        </select>
                        <div className={`${base.inputIcon} ${shared.filterSearch}`}>
                            <Search size={16} />
                            <input type="text" className={base.input} placeholder="Buscar equipo..." value={search} onChange={(e) => setSearch(e.target.value)} aria-label="Buscar equipo" />
                        </div>
                        <select className={`${base.select} ${shared.filterSelect}`} value={stateFilter} onChange={(e) => setStateFilter(e.target.value)} aria-label="Filtrar por estado de certificación">
                            <option value="todos">Todos los estados</option>
                            <option value="con">Con certificación</option>
                            <option value="pending">Pendiente aprobación</option>
                            <option value="none">Sin certificación</option>
                        </select>
                    </div>
                </section>

                {visible.length === 0 ? (
                    <div className={ui.empty}>No hay equipos que coincidan con los filtros.</div>
                ) : (
                    <div className={ui.teams}>
                        {visible.map(({ team, state }) => (
                            <section key={team.id} className={ui.teamCard}>
                                <div className={ui.teamHeader}>
                                    <div>
                                        <div className={ui.teamName}>{team.name}</div>
                                        <div className={ui.teamMeta}>{team.area} · {plural(team.members, "miembro", "miembros")}</div>
                                    </div>
                                    <div className={ui.teamActions}>
                                        <StatusPill status={TEAM_STATE[state].status}>{TEAM_STATE[state].label}</StatusPill>
                                        <button type="button" className={`${base.btn} ${base.btnSm} ${ui.btnGhost}`} onClick={() => setHistoryTeam(team)}>
                                            <Shield size={14} /> Historial
                                        </button>
                                        {state === "approved" ? (
                                            <button type="button" className={`${base.btn} ${base.btnSm} ${ui.btnWhite}`} onClick={() => handleApply(team)}>
                                                <RotateCcw size={14} /> Nueva certificación
                                            </button>
                                        ) : (
                                            <button type="button" className={`${base.btn} ${base.btnPrimary} ${base.btnSm}`} onClick={() => handleApply(team)}>
                                                <Check size={14} /> Aplicar certificación
                                            </button>
                                        )}
                                    </div>
                                </div>
                                <div className={ui.teamBody}>
                                    <div className={ui.leadersLabel}>
                                        {state === "pending" ? "Líderes que recibirán la certificación" : state === "approved" ? "Líderes certificados" : "Líderes del equipo"}
                                    </div>
                                    {team.leaders.length === 0 ? (
                                        <div className={ui.noFormat}>Este equipo no tiene líder asignado.</div>
                                    ) : (
                                        team.leaders.map((leader) => {
                                            const lastCert = latestOf(certifications.filter((c) => c.teamId === team.id && c.leaderId === leader.id));
                                            const leaderState = stateOf(lastCert);
                                            return (
                                                <div key={leader.id} className={ui.leaderRow}>
                                                    <div className={ui.leaderAvatar}>{initials(leader.name)}</div>
                                                    <div className={ui.leaderInfo}>
                                                        <div className={ui.leaderName}>{leader.name}</div>
                                                        <div className={ui.leaderSub}>{leader.role} · {leader.code}</div>
                                                    </div>
                                                    <div className={ui.leaderRight}>
                                                        <StatusPill status={TEAM_STATE[leaderState].status}>
                                                            {leaderState === "approved" ? "Certificado ✓" : TEAM_STATE[leaderState].label}
                                                        </StatusPill>
                                                        {leaderState === "pending" && (
                                                            <button type="button" className={`${base.btn} ${base.btnPrimary} ${base.btnSm}`} onClick={() => setApproveTarget(lastCert)}>
                                                                Aprobar
                                                            </button>
                                                        )}
                                                        {lastCert && leaderState !== "pending" && <span className={shared.mutedLight}>{formatDate(lastCert.date)}</span>}
                                                    </div>
                                                </div>
                                            );
                                        })
                                    )}
                                    {!team.format && <div className={ui.noFormat}>Este equipo no tiene un formato de certificación activo.</div>}
                                </div>
                            </section>
                        ))}
                    </div>
                )}
            </div>

            {applyTeam && (
                <ApplyForm
                    key={applyTeam.id}
                    team={applyTeam}
                    format={toApplyFormat(applyTeam.format)}
                    certifierName={me?.name ?? ""}
                    onClose={() => setApplyTeam(null)}
                    onSaved={load}
                />
            )}
            {historyTeam && (
                <TeamHistoryModal team={historyTeam} certifications={certifications.filter((c) => c.teamId === historyTeam.id)} onClose={() => setHistoryTeam(null)} />
            )}
            <ApproveCertificationModal cert={approveTarget} onClose={() => setApproveTarget(null)} onResolved={load} />
        </>
    );
};






