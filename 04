namespace ApiCoaching.Validators.Coaching
{
    public class CalculateCoachingAchievementRequestDtoValidator : AbstractValidator<CalculateCoachingAchievementRequestDto>
    {
        public CalculateCoachingAchievementRequestDtoValidator()
        {
            RuleFor(x => x.AchievedValue)
                .Cascade(CascadeMode.Stop)
                .NotNull().WithMessage("El resultado obtenido es obligatorio.")
                .PrecisionScale(18, 2, true)
                .WithMessage("El resultado obtenido admite hasta 16 dígitos enteros y dos decimales.");

            RuleFor(x => x.TargetValue)
                .Cascade(CascadeMode.Stop)
                .NotNull().WithMessage("La meta es obligatoria.")
                .PrecisionScale(18, 2, true)
                .WithMessage("La meta admite hasta 16 dígitos enteros y dos decimales.");

            RuleFor(x => x.MinimumValue)
                .PrecisionScale(18, 2, true)
                .WithMessage("El mínimo admite hasta 16 dígitos enteros y dos decimales.");

            RuleFor(x => x.MaximumValue)
                .PrecisionScale(18, 2, true)
                .WithMessage("El máximo admite hasta 16 dígitos enteros y dos decimales.");

            RuleFor(x => x.Rule)
                .IsInEnum().WithMessage("La regla del indicador no es válida.");

            RuleFor(x => x.Formula)
                .Cascade(CascadeMode.Stop)
                .NotEmpty().WithMessage("La fórmula es obligatoria.")
                .MaximumLength(200).WithMessage("La fórmula no puede superar 200 caracteres.")
                .Custom((formula, context) =>
                {
                    if (!IndicatorFormulaEvaluator.TryValidate(formula, out var error))
                    {
                        context.AddFailure(error!);
                    }
                });
        }
    }
}
using ApiCoaching.Dtos.Coaching;
using FluentValidation;

namespace ApiCoaching.Validators.Coaching
{
    public class CreateIndicatorAssignmentsRequestDtoValidator
        : AbstractValidator<CreateIndicatorAssignmentsRequestDto>
    {
        public CreateIndicatorAssignmentsRequestDtoValidator()
        {
            RuleFor(x => x.Teams)
                .Cascade(CascadeMode.Stop)
                .NotEmpty()
                .WithMessage("Debes enviar al menos un equipo.")
                .Must(teams => teams.Where(x => x != null).Select(x => x.TeamId).Distinct().Count()
                    == teams.Count(x => x != null))
                .WithMessage("La lista de equipos no puede contener duplicados.");

            RuleForEach(x => x.Teams)
                .NotNull().WithMessage("Cada equipo es obligatorio.")
                .SetValidator(new TeamIndicatorAssignmentsRequestDtoValidator());
        }
    }

    public class TeamIndicatorAssignmentsRequestDtoValidator
        : AbstractValidator<TeamIndicatorAssignmentsRequestDto>
    {
        public TeamIndicatorAssignmentsRequestDtoValidator()
        {
            RuleFor(x => x.TeamId)
                .GreaterThan(0)
                .WithMessage("El equipo es obligatorio.");

            RuleFor(x => x.Members)
                .Cascade(CascadeMode.Stop)
                .NotNull()
                .WithMessage("La lista de miembros es obligatoria.")
                .Must(members => members is { Count: > 0 })
                .WithMessage("Debes enviar al menos un miembro.")
                .Must(HaveUniqueMembers)
                .WithMessage("La lista de miembros no puede contener duplicados.");

            RuleForEach(x => x.Members)
                .NotNull().WithMessage("Cada miembro es obligatorio.")
                .SetValidator(new TeamMemberIndicatorAssignmentsRequestDtoValidator());
        }

        private static bool HaveUniqueMembers(
            List<TeamMemberIndicatorAssignmentsRequestDto>? members)
        {
            return members is null || members.Count(x => x != null) == members
                .Where(x => x != null)
                .Select(x => x.MemberUserId)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Count();
        }
    }

    public class TeamMemberIndicatorAssignmentsRequestDtoValidator
        : AbstractValidator<TeamMemberIndicatorAssignmentsRequestDto>
    {
        public TeamMemberIndicatorAssignmentsRequestDtoValidator()
        {
            RuleFor(x => x.MemberUserId)
                .NotEmpty()
                .WithMessage("El identificador del miembro es obligatorio.")
                .MaximumLength(50)
                .WithMessage("El identificador del miembro no puede superar 50 caracteres.");

            RuleFor(x => x.Indicators)
                .Cascade(CascadeMode.Stop)
                .NotNull()
                .WithMessage("La lista de indicadores es obligatoria.")
                .Must(indicators => indicators is { Count: > 0 })
                .WithMessage("Debes enviar al menos un indicador.")
                .Must(HaveUniqueIndicators)
                .WithMessage("Un miembro no puede recibir el mismo indicador más de una vez en la solicitud.")
                .Must(HaveTotalWeight)
                .WithMessage("Los pesos de los indicadores de cada miembro deben sumar exactamente 100 %.");

            RuleForEach(x => x.Indicators)
                .NotNull().WithMessage("Cada indicador es obligatorio.")
                .SetValidator(new IndicatorAssignmentRequestDtoValidator());
        }

        private static bool HaveTotalWeight(List<IndicatorAssignmentRequestDto> indicators)
        {
            if (indicators.Any(x => x == null || x.Weight <= 0m || x.Weight > 100m))
            {
                return true;
            }

            return indicators.Sum(x => x.Weight) == 100m;
        }

        private static bool HaveUniqueIndicators(
            List<IndicatorAssignmentRequestDto>? indicators)
        {
            return indicators is null || indicators.Count(x => x != null) == indicators
                .Where(x => x != null)
                .Select(x => x.IndicatorId)
                .Distinct()
                .Count();
        }
    }

    public class IndicatorAssignmentRequestDtoValidator
        : AbstractValidator<IndicatorAssignmentRequestDto>
    {
        public IndicatorAssignmentRequestDtoValidator()
        {
            RuleFor(x => x.IndicatorId)
                .GreaterThan(0)
                .WithMessage("El indicador es obligatorio.");

            RuleFor(x => x.Weight)
                .Cascade(CascadeMode.Stop)
                .GreaterThan(0m)
                .WithMessage("El peso debe ser mayor que 0 %.")
                .LessThanOrEqualTo(100m)
                .WithMessage("El peso no puede ser mayor que 100 %.")
                .Must(weight => decimal.Round(weight, 2) == weight)
                .WithMessage("El peso puede tener como máximo dos decimales.");

            RuleFor(x => x.TargetUnitId)
                .GreaterThan(0)
                .WithMessage("La unidad de medida de la meta es obligatoria.");

            RuleFor(x => x.ValidFrom)
                .NotEmpty()
                .WithMessage("La fecha de inicio de vigencia es obligatoria.");

            RuleFor(x => x.ValidTo)
                .Cascade(CascadeMode.Stop)
                .NotEmpty()
                .WithMessage("La fecha de fin de vigencia es obligatoria.")
                .GreaterThanOrEqualTo(x => x.ValidFrom)
                .WithMessage("La fecha de fin de vigencia no puede ser anterior a la fecha de inicio.");
        }
    }
}


