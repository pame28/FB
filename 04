  margin: 14px 0 2px;
  font-size: 18px;
  font-weight: 800;
  letter-spacing: -0.01em;
  color: var(--bp-blue-expert);
}

.teamMeta { margin: 0 0 14px; font-size: 12.5px; font-weight: 600; color: #8592a3; }









/* ---- Panel de líderes ---- */
.leaderPanel {
  padding: 12px 14px 14px;
  border: 1px solid color-mix(in srgb, var(--bp-blue-expert) 10%, white);
  border-radius: 14px;
  background: linear-gradient(
    135deg,
    color-mix(in srgb, var(--bp-blue-expert) 6%, white) 0%,
    color-mix(in srgb, var(--bp-blue-digital) 9%, white) 100%
  );
}

.panelHead { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }

.panelLabel {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 11.5px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--bp-blue-expert);
}
.panelLabel svg { color: var(--bp-blue-fin); }

.pillBtn {
  height: 28px;
  padding: 0 14px;
  border: none;
  border-radius: 999px;
  background: #fff;
  font: inherit;
  font-size: 12.5px;
  font-weight: 800;
  color: var(--bp-blue-expert);
  box-shadow: 0 1px 3px rgba(0, 57, 100, 0.15);
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease;
}
.pillBtn:hover { background: var(--bp-blue-expert); color: #fff; }
.pillBtn:focus-visible { outline: 2px solid var(--bp-blue-digital); outline-offset: 2px; }

.leaderList { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }

.leaderItem {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
  padding: 8px 10px;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.8);
  box-shadow: 0 1px 2px rgba(0, 57, 100, 0.06);
}

.leaderAvatar {
  width: 36px;
  height: 36px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--bp-blue-expert) 0%, var(--bp-blue-fin) 100%);
  font-size: 12.5px;
  font-weight: 800;
  color: #fff;
}

.noLeader {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 12px;
  border: 1px dashed color-mix(in srgb, var(--bp-blue-expert) 20%, white);
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.6);
  font-size: 13px;
  font-weight: 600;
  color: #6b7a8f;
}











.sectionLabel {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 11.5px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #8592a3;
}













