-- =============================================
-- Author:		Orlin Alvarado
-- Create date: 2014-01-28
-- Description:	Establece el monto contingente de las tarjetas de credito
-- =============================================
-- Modificado: Orlin Alvarado
-- Descripcion: Se agrego validacion para que coloque cero cuando el monto contingente sea
--              igual al monto otorgado.
-- Fecha:       2016-10-05
-- =============================================
ALTER PROCEDURE [dbo].[usp_CR_PROC_OPERACIONES_TC_CONTINGENTE] 
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;

    -- Insert statements for procedure here
		--Eliminamos operaciones en dolares sin Movimiento
	DELETE 
	FROM   operaciones
	WHERE  opeTipo = '130000'
	       AND (
	               opeSaldoVi + opeSaldoMo + opeSaldoVe + opeSaldoEj + 
	               opeSaldoCa
	           ) = 0
	       AND opeMoneda = 2
	
	--Eliminamos operaciones con saldo 0 o negativo con estatus castigado
	DELETE 
	FROM   operaciones
	WHERE  opeTipo = '130000'
	       AND (
	               opeSaldoVi + opeSaldoMo + opeSaldoVe + opeSaldoEj + 
	               opeSaldoCa
	           ) <= 0
	       AND opeStatus = 2
	
	--Reemplaza procedimiento usp_updateSaldoVigenteNegativoTarjetas
	UPDATE operaciones
	SET    opeSaldoVi = 0
	WHERE  opeSaldoVi < 0
	       AND opeTipo = 130000  
	
	--Saldo vencido negativo tarjetas
	UPDATE operaciones
	SET    opeSaldoVe = 0
	WHERE  opeSaldoVe < 0
	       AND opeTipo = 130000 
	              
	--Actualiza saldo contingente
	UPDATE operaciones
	SET    opeSaldoCo = a.SaldoContingente
	FROM   operaciones o
	       INNER JOIN (
	                SELECT s.opeNum
	                      ,s.opeMontoOt
	                      ,s.sLoc
	                      ,s.sInt
	                      ,CASE 
	                            WHEN (s.opeMontoOt -(s.sLoc + s.sInt)) > 0 THEN (s.opeMontoOt -(s.sLoc + s.sInt))
	                            WHEN (s.opeMontoOt -(s.sLoc + s.sInt)) <= 0 THEN 
	                                 0
	                            ELSE s.opeMontoOt
	                       END     SaldoContingente
	                FROM   (
	                           SELECT o.opeNum
	                                 ,o.opeMontoOt
	                                 ,o.opeStatus
	                                 ,(
	                                      o.opeSaldoVi + o.opeSaldoMo + o.opeSaldoVe 
	                                      + o.opeSaldoEj + o.opeSaldoCa
	                                  )     sLoc
	                                 ,(
	                                      ISNULL(o2.opeSaldoVi ,0) + ISNULL(o2.opeSaldoMo ,0) 
	                                      + ISNULL(o2.opeSaldoVe ,0) + ISNULL(o2.opeSaldoEj ,0) 
	                                      + ISNULL(o2.opeSaldoCa ,0)
	                                  )     sInt
	                           FROM   operaciones o
	                                  LEFT JOIN operaciones o2
	                                       ON  o.opeNum = o2.opeNum
	                                       AND o2.opeMoneda = 2
	                                       AND o2.opeStatus <> 2
	                           WHERE  o.opeTipo = '130000'
	                                  AND o.opeMoneda = 1
	                                  AND o.opeStatus <> 2
	                       )       s
	            )a
	            ON  o.opeNum = a.opeNum
	
	       
	--Eliminamos aquellas operaciones en lempiras con saldo Cero y que tengan transaccion en dolares
	DELETE o
	FROM   operaciones o
	WHERE  opeTipo = '130000'
	       AND (
	               opeSaldoVi + opeSaldoMo + opeSaldoVe + opeSaldoEj + 
	               opeSaldoCa
	           ) = 0
	       AND opeMoneda = 1
	       AND EXISTS(
	               SELECT 1
	               FROM   operaciones o2
	               WHERE  o2.opeMoneda = 2
	                      AND o2.opeNum = o.opeNum
	           ) 
	  
       
	
	--Eliminamos el saldo contigente a dolares cuando tienen
	--valor en lempiras
	UPDATE operaciones
	SET    opeSaldoCo     = 0
	      ,opeMontoOt     = 0
	FROM   operaciones o
	WHERE  o.opeTipo = '130000'
	       AND o.opeMoneda = 2
	       AND EXISTS(
	               SELECT 1
	               FROM   operaciones o2
	               WHERE  o2.opeNum = o.opeNum
	                      AND o2.opeMoneda = 1
	           )
END




