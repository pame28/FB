CREATE VIEW [dbo].[uvw_TARJETAS_VASA]
AS

SELECT
	  Sal.NumeroTarjeta
	  ,Sal.Nombre 
	  ,'HN' Moneda
      ,CASE WHEN Sal.NoClienteUnico LIKE ' %' THEN '0' ELSE Sal.NoClienteUnico END   'CIF'
      ,Sal.ImporteLimiteCompra 'LimiteCredito'
      ,Sal.BinTarjeta
      ,Sal.TNAInteresConsumoFinanML 'Tasa'
      ,Sal.Dias_Mora_ML DiasMora
      ,Sal.SaldoActualML SaldoActual
      ,Sal.InteresSuspensoFinanciacionML 'InteresesSuspenso'
      ,case when YEAR(Sal.FechaAltaCuenta) = 1900 then Sal.FechaAltaTarjeta ELSE Sal.FechaAltaCuenta END 'FechaAlta'
      ,Sal.FechaVencimientoCuenta 'FechaVencimiento'
      ,0 SaldoConsumido
      --,Sal.PagoMinimoUltimaLiquidacionML 'CapitalPagoMinimo' --MODIFICADO 16/10/2019 SOLICITADO POR VICTORIA LARA
	  ,Sal.CapitalPagoMinimoML 'CapitalPagoMinimo'
      ,Sal.FechaGeneracion
      ,Sal.SaldoIntraMN 'SaldoIntra'
      ,Sal.ModeloLiquidacion
      ,Sal.GrupoAfinidad
      ,Sal.CodigoProducto
      ,Sal.PagoMinimoUltimaLiquidacionML 'PagoMinimo'
      ,Sal.MonedaLimiteCompra
FROM uvw_SaldosTarjetas Sal

UNION


SELECT
	  Sal.NumeroTarjeta
	  ,Sal.Nombre
	  ,'DO' 'Moneda'
      ,CASE WHEN Sal.NoClienteUnico LIKE ' %' THEN '0' ELSE Sal.NoClienteUnico END   'CIF'
      ,Sal.ImporteLimiteCompra 'LimiteCredito'
      ,Sal.BinTarjeta
      ,Sal.TNAInteresConsumoFinanUSD 'Tasa'
      ,Sal.Dias_Mora_USD DiasMora
      ,Sal.SaldoActualUSD SaldoActual
      ,Sal.InteresSuspensoFinanciacionUSD 'InteresesSuspenso'
      ,case when YEAR(Sal.FechaAltaCuenta) = 1900 then Sal.FechaAltaTarjeta ELSE Sal.FechaAltaCuenta END 'FechaAlta'
      ,Sal.FechaVencimientoCuenta 'FechaVencimiento'
      ,0 'SaldoConsumido'
      --,Sal.PagoMinimoUltimaLiquidacionUSD 'CapitalPagoMinimo' --MODIFICADO 16/10/2019 SOLICITADO POR VICTORIA LARA
	  ,Sal.CapitalPagoMinimoUSD 'CapitalPagoMinimo'
      ,Sal.FechaGeneracion
      ,Sal.SaldoIntraME 'SaldoIntra'
      ,Sal.ModeloLiquidacion
      ,Sal.GrupoAfinidad
      ,Sal.CodigoProducto
      ,Sal.PagoMinimoUltimaLiquidacionUSD 'PagoMinimo'
      ,Sal.MonedaLimiteCompra
FROM uvw_SaldosTarjetas Sal









GO




