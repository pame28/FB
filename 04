import { useEffect, useMemo, useState } from "react";
import { AlertCircle, Check, ChevronLeft, ChevronRight, Info, Loader2 } from "lucide-react";
import { Modal } from "../../../../shared/components";
import { teamsService } from "../../../../api/teamsService";
import { normalize } from "./teamUtils";
import { useAvailableUsers } from "./useAvailableUsers";
import { Stepper } from "./Stepper";
import { UserPickList } from "./UserPickList";
import pages from "../../../Pages.module.css";
import t from "./Teams.module.css";

const STEPS = ["Nombre", "Líderes", "Miembros"];
const FORM_ID = "team-wizard-form";

export function TeamWizardModal({ open, areas, teams, defaultAreaId, onClose, onCreated }) {
  const [step, setStep] = useState(1);
  const [name, setName] = useState("");
  const [areaId, setAreaId] = useState("");
  const [errors, setErrors] = useState({});
  const [leaderIds, setLeaderIds] = useState([]);
  const [memberIds, setMemberIds] = useState([]);
  const [saving, setSaving] = useState(false);
  const [submitError, setSubmitError] = useState("");

  const area = Number(areaId) || null;
  const leaders = useAvailableUsers("leaders", area, open && step >= 2);
  const members = useAvailableUsers("members", area, open && step >= 3);

  // Reinicia el asistente cada vez que se abre
  useEffect(() => {
    if (open) {
      setStep(1);
      setName("");
      setAreaId(defaultAreaId ? String(defaultAreaId) : "");
      setErrors({});
      setLeaderIds([]);
      setMemberIds([]);
      setSubmitError("");
    }
  }, [open, defaultAreaId]);

  // Un usuario no puede ser líder y miembro a la vez
  const memberOptions = useMemo(
    () => members.items.filter((u) => !leaderIds.includes(u.id)),
    [members.items, leaderIds]
  );

  const changeArea = (value) => {
    setAreaId(value);
    setLeaderIds([]);
    setMemberIds([]);
    setErrors((e) => ({ ...e, areaId: undefined }));
  };

  const validateStep1 = () => {
    const e = {};
    const value = name.trim();
    if (!value) e.name = "El nombre del equipo es obligatorio.";
    else if (teams.some((tm) => tm.areaId === area && normalize(tm.name) === normalize(value))) {
      e.name = "Ya existe un equipo con ese nombre en esta área.";
    }
    if (!areaId) e.areaId = "Selecciona un área.";
    setErrors(e);
    return Object.keys(e).length === 0;
  };

  const handleCreate = async () => {
    setSaving(true);
    setSubmitError("");
    try {
      await teamsService.create({
        name: name.trim(),
        companyAreaId: area,
        leaderUserIds: leaderIds,
        memberUserIds: memberIds.filter((id) => !leaderIds.includes(id)),
      });
      onCreated(name.trim());
    } catch (err) {
      setSubmitError(err.noAccess
        ? "No tienes permiso para crear equipos."
        : err.response?.data?.message ?? "No se pudo crear el equipo. Intenta de nuevo.");
    } finally {
      setSaving(false);
    }
  };

  const handleNext = (e) => {
    e?.preventDefault();
    if (step === 1) {
      if (validateStep1()) setStep(2);
    } else if (step === 2) {
      setMemberIds((ids) => ids.filter((id) => !leaderIds.includes(id)));
      setStep(3);
    } else {
      handleCreate();
    }
  };

  const handleClose = () => { if (!saving) onClose(); };

  return (
    <Modal
      open={open}
      title="Nuevo equipo"
      onClose={handleClose}
      footer={
        <>
          {step === 1 ? (
            <button type="button" className={`${pages.btn} ${pages.btnOutline}`} onClick={handleClose}>Cancelar</button>
          ) : (
            <button type="button" className={`${pages.btn} ${pages.btnOutline}`} onClick={() => setStep(step - 1)} disabled={saving}>
              <ChevronLeft size={16} /> Atrás
            </button>
          )}
          <button type="submit" form={FORM_ID} className={`${pages.btn} ${pages.btnPrimary}`} disabled={saving}>
            {step < 3 ? (
              <>Siguiente <ChevronRight size={16} /></>
            ) : saving ? (
              <><Loader2 size={16} className={pages.spin} /> Creando...</>
            ) : (
              <><Check size={16} /> Crear equipo</>
            )}
          </button>
        </>
      }
    >
      <Stepper steps={STEPS} current={step} />

      <form id={FORM_ID} onSubmit={handleNext} noValidate>
        {submitError && (
          <div className={`${pages.banner} ${pages.bannerError}`} role="alert">
            <AlertCircle size={18} />
            <p>{submitError}</p>
          </div>
        )}

        {/* Paso 1: nombre y área */}
        {step === 1 && (
          <div className={pages.form} style={{ gridTemplateColumns: "1fr" }}>
            <div className={pages.field}>
              <label className={pages.label} htmlFor="wizard-name">
                Nombre del equipo<span className={pages.required}>*</span>
              </label>
              <input id="wizard-name" className={`${pages.input} ${errors.name ? pages.invalid : ""}`}
                placeholder="Ej. Equipo La Ceiba A" value={name} maxLength={100} autoFocus
                onChange={(e) => { setName(e.target.value); setErrors((er) => ({ ...er, name: undefined })); }}
                aria-invalid={!!errors.name} />
              {errors.name && <span className={pages.fieldError}>{errors.name}</span>}
            </div>

            <div className={pages.field}>
              <label className={pages.label} htmlFor="wizard-area">
                Área<span className={pages.required}>*</span>
              </label>
              <select id="wizard-area" className={`${pages.select} ${errors.areaId ? pages.invalid : ""}`}
                value={areaId} onChange={(e) => changeArea(e.target.value)} aria-invalid={!!errors.areaId}>
                <option value="">— Selecciona un área —</option>
                {areas.map((a) => <option key={a.value} value={a.value}>{a.label}</option>)}
              </select>
              {errors.areaId
                ? <span className={pages.fieldError}>{errors.areaId}</span>
                : <span className={pages.hint}>El área determina qué líderes y usuarios estarán disponibles para este equipo.</span>}
            </div>
          </div>
        )}

        {/* Paso 2: líderes */}
        {step === 2 && (
          <>
            <div className={t.infoBox}>
              <Info size={16} />
              <p>Puedes asignar uno o varios líderes ahora o hacerlo después. Solo se muestran líderes disponibles del área seleccionada.</p>
            </div>
            <UserPickList
              users={leaders.items}
              selectedIds={leaderIds}
              onChange={setLeaderIds}
              loading={leaders.loading}
              error={leaders.error}
              emptyMessage="No hay líderes disponibles en esta área."
              showSelectAll={false}
            />
            {leaderIds.length === 0 && !leaders.loading && (
              <p className={t.stepHint}>Puedes continuar sin asignar líder y hacerlo después desde la tarjeta del equipo.</p>
            )}
          </>
        )}

        {/* Paso 3: miembros */}
        {step === 3 && (
          <>
            <div className={t.infoBox}>
              <Info size={16} />
              <p>Puedes agregar miembros ahora o hacerlo después desde la tarjeta del equipo. Solo se muestran usuarios activos del área seleccionada.</p>
            </div>
            <UserPickList
              users={memberOptions}
              selectedIds={memberIds}
              onChange={setMemberIds}
              loading={members.loading}
              error={members.error}
              emptyMessage="No hay usuarios disponibles en esta área."
            />
          </>
        )}
      </form>
    </Modal>
  );
}











