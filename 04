ALTER PROCEDURE [dbo].[sp_ActualizaProceso] 
  @Proceso NVARCHAR(100),
  @EstadoProceso NVARCHAR(5),
  @Mensaje NVARCHAR(500)
AS
BEGIN
    SET NOCOUNT ON;
	UPDATE ParametrosEjecucionDescarga SET EstadoProceso = @EstadoProceso,
	Mensaje = @Mensaje
	WHERE PROCESO = @Proceso
	AND FechaProceso IN (SELECT ValorParametro FROM ParametrosDescargaTablas 
	WHERE Proceso = 'General' 
	AND IdParametro = 'FechaProceso')
END







