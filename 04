.textarea { height: auto; min-height: 96px; padding: 10px 12px; line-height: 1.5; resize: vertical; }

.stepHint { margin: 10px 0 0; font-size: 12.5px; color: #8592a3; }

/* ---- Asistente de pasos ---- */
.stepper { display: flex; align-items: center; gap: 10px; margin-bottom: 20px; }
.step { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; color: #a3adbb; white-space: nowrap; }
.stepDot {
  width: 28px;
  height: 28px;
  display: grid;
  place-items: center;
  border: 2px solid #d9e0ea;
  border-radius: 50%;
  background: #fff;
  font-size: 12.5px;
  font-weight: 800;
  color: #a3adbb;
