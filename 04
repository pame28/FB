                                                <Plus size={14} /> Agregar indicador
                                            </button>

                                            <span className={ui.sectionLabel}>Fórmula para calcular el resultado de este criterio</span>
                                            <textarea
                                                className={`${base.textarea} ${ui.formula}`}
