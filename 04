        public DataTable ConvertirADataTable(List<DEstadoCuenta> hEstados)
        {

            try
            {
                DataTable dt = new DataTable();

                dt.Columns.Add("idRow", typeof(int));
                dt.Columns.Add("Origen", typeof(string));
                dt.Columns.Add("FechaCarga", typeof(DateTime));
                dt.Columns.Add("Codigo_Emisor", typeof(string));
                dt.Columns.Add("EC_DetalleNo_Cuenta", typeof(string));
                dt.Columns.Add("Fecha_Corte", typeof(DateTime));
                dt.Columns.Add("EC_DetalleNo_Tarjeta", typeof(string));
                dt.Columns.Add("Nombre_TH_P", typeof(string));
                dt.Columns.Add("EC_DetalleEmisor_Madre", typeof(string));
                dt.Columns.Add("EC_DetalleCuenta_Madre", typeof(string));
                dt.Columns.Add("No_Autorizacion", typeof(string));
                dt.Columns.Add("Fecha_Consumo", typeof(DateTime));
                dt.Columns.Add("Codigo_Mov", typeof(string));
                dt.Columns.Add("Descripcion_Mov", typeof(string));
                dt.Columns.Add("Moneda_Mov", typeof(string));
                dt.Columns.Add("Monto_Mov", typeof(decimal));
                dt.Columns.Add("Tarjeta_Imprimir", typeof(string));
                dt.Columns.Add("Tasa_Efectiva_Anual_EF_MN", typeof(decimal));
                dt.Columns.Add("Tasa_Efectiva_Anual_EF_ME", typeof(decimal));
                dt.Columns.Add("NoCuentaClaro", typeof(string));
                dt.Columns.Add("ProcesadorOrigen", typeof(string));

                foreach (var h in hEstados)
                {
                    dt.Rows.Add(
                        0, // idRow, puedes dejarlo en 0 si es autoincremental en SQL
                        LimpiarEspacios(h.Origen),
                        h.FechaCarga,
                        LimpiarEspacios(h.CodigoEmisor),
                        LimpiarEspacios(h.EcDetalleNoCuenta),
                        h.FechaCorte,
                        LimpiarEspacios(h.EcDetalleNoTarjeta),
                        LimpiarEspacios(h.NombreThP),
                        LimpiarEspacios(h.EcDetalleEmisorMadre),
                        LimpiarEspacios(h.EcDetalleCuentaMadre),
                        LimpiarEspacios(h.NoAutorizacion),
                        h.FechaConsumo,
                        LimpiarEspacios(h.CodigoMov),
                        LimpiarEspacios(h.DescripcionMov),
                        LimpiarEspacios(h.MonedaMov),
                        h.MontoMov,
                        LimpiarEspacios(h.TarjetaImprimir),
                        h.TasaEfectivaAnualEfMn,
                        h.TasaEfectivaAnualEfMe,
                        LimpiarEspacios(h.NoCuentaClaro),
                        LimpiarEspacios(h.ProcesadorOrigen)
                    );
                }


                return dt;
            }

            catch (Exception ex)
            {
                RegistraProceso("F", $"Falló proceso de conversión DataTable {parametros["ArchivoDestino"]} con error {ex.Message}");

                return new DataTable();
            }
        }

        public bool EjecutarBulkInsertBandejaVasa(DataTable tableCuentas)
        {
            ConnectionManager cm = Dts.Connections["BANDEJAVASA"];
            SqlConnection conn = null;

            try
            {
                conn = cm.AcquireConnection(null) as SqlConnection;
                if (conn == null)
                {
                    throw new InvalidOperationException("No se pudo obtener la conexión desde el Connection Manager.");
                }

                using (SqlBulkCopy bulkCopy = new SqlBulkCopy(conn))
                {
                    bulkCopy.DestinationTableName = parametros["ArchivoDestino"];
                    bulkCopy.BulkCopyTimeout = TimeoutSegundos;
                    bulkCopy.BatchSize = 5000;
                    bulkCopy.WriteToServer(tableCuentas);
                }

                return true;

            }


            catch (Exception ex)
            {
                RegistraProceso("F", $"Falló bulkInsert {parametros["ArchivoDestino"]} con error {ex.Message}");

                return false;
            }
            finally
            {
                if (conn != null)
                    cm.ReleaseConnection(conn);
            }
        }

        public bool UpdateArchivoAS400()
        {

            ConnectionManager cm = Dts.Connections["AS400"];
            OleDbConnection conn = null;

            try
            {
                conn = cm.AcquireConnection(null) as OleDbConnection;
                if (conn == null)
                {
                    throw new InvalidOperationException("No se pudo obtener la conexión desde el Connection Manager.");
                }

                using (IDbCommand cmd = conn.CreateCommand())
                {
                    cmd.CommandText = sql_ConsultaActualizar;
                    cmd.CommandTimeout = TimeoutSegundos;
                    int rowsAffected = cmd.ExecuteNonQuery();

                    if (rowsAffected == 0)
                    {
                        RegistraProceso("F", $"Actualizar estado archivo: {parametros["ArchivoControl"]} no afectó ningún registro");
                        return false;
                    }
                }

            }
            catch (Exception ex)
            {

                RegistraProceso("F", $"Falló actualizar estado archivo: {parametros["ArchivoControl"]} con error {ex.Message}");

                return false;

            }
            finally
            {
                if (conn != null)
                    cm.ReleaseConnection(conn);
            }

            return true;
        }

        private object LimpiarEspacios(object valor)
        {
            if (valor == null || valor == DBNull.Value)
                return DBNull.Value;

            // Convertimos a string y eliminamos espacios
            var texto = valor.ToString().Trim();

            // Si después del Trim queda vacío, lo tratamos como NULL
            if (texto.Length == 0)
                return DBNull.Value;

            return texto;
        }

        public void RegistraProceso(string estadoProceso, string mensaje)
        {
            ConnectionManager cm = Dts.Connections["DESCARGAINFO"];
            SqlConnection conn = null;

            try
            {
                conn = cm.AcquireConnection(null) as SqlConnection;
                if (conn == null)
                {
                    throw new InvalidOperationException("No se pudo obtener la conexión desde el Connection Manager.");
                }

                using (SqlCommand cmd = new SqlCommand(parametros["RegistroProceso"], conn))
                {
                    cmd.CommandType = CommandType.StoredProcedure;
                    cmd.CommandTimeout = TimeoutSegundos;

                    cmd.Parameters.Add("@Proceso", SqlDbType.VarChar).Value = "DEstadoCuenta";
                    cmd.Parameters.Add("@EstadoProceso", SqlDbType.VarChar).Value = estadoProceso;
                    cmd.Parameters.Add("@Mensaje", SqlDbType.VarChar).Value = mensaje;

                    cmd.ExecuteNonQuery();
                }

            }
            catch (Exception ex)
            {
                // Si el log falla, al menos queda en el historial del Job / log de SSIS
                Dts.Events.FireWarning(0, "RegistraProceso",
                    $"No se pudo registrar en log. Mensaje original: {mensaje} | Error: {ex.Message}", "", 0);
            }
            finally
            {
                if (conn != null)
                    cm.ReleaseConnection(conn);
            }
        }

