import { useEffect, useState } from "react";
import { Download, Check, X, Search } from "lucide-react";
import { Modal, useToast } from "../../../shared/components";
import { useAuthStore } from "../../../hooks/useAuthStore";
import { displayName } from "../../../helpers/format";
import { exportPdf } from "../../../shared/reports";
import { buildCoachingFormatPdf, coachingFileName } from "./coachingFormatReport";
import { coachService } from "../../../api/coachService";
import styles from "../../Pages.module.css";
import base from "./CollaboratorCoachingPage.module.css";
import ui from "./HistoryCoachingPage.module.css";

const STATUS = {
    process: "En proceso",
    pending: "Pendiente de aprobación",
    approved: "Aprobado",
};

const STATUS_PILL = {
    [STATUS.process]: { label: "En proceso", className: ui.pillProcess },
    [STATUS.pending]: { label: "Pend. aprobación", className: ui.pillPending },
    [STATUS.approved]: { label: "Aprobado", className: ui.pillApproved },
};

const MONTHS = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];

const MONTHS_SHORT = ["Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic"];

const API_STATUS = { Process: STATUS.process, Pending: STATUS.pending, Approved: STATUS.approved };

const formatNumber = (n) => Number(n).toLocaleString("es-ES", { maximumFractionDigits: 2 });

const formatDateTime = (value) => {
    const d = new Date(value);
    return `${d.toLocaleDateString("es-ES")} ${d.toLocaleTimeString("es-ES", { hour: "2-digit", minute: "2-digit" })}`;
};

// Adapta la respuesta de /api/coaching/history a la forma que usa la pantalla
const mapCoaching = (c) => ({
    id: c.sessionId,
    collaboratorName: c.collaboratorName,
    collaboratorCode: c.collaboratorCode ?? "-----",
    coachName: c.coachName ?? "—",
    date: new Date(c.date).toLocaleDateString("en-CA"),
    status: API_STATUS[c.status] ?? STATUS.process,
    position: c.position ?? "—",
    location: c.location ?? "—",
    indicators: c.indicators.map((ind) => ({
        name: ind.indicatorName,
        result: ind.achievedValue != null ? `${formatNumber(ind.achievedValue)} ${ind.targetUnitName}` : "—",
        passed: ind.passed,
    })),
    approvals: c.approvals.map((a) => ({ role: a.role, name: a.name, date: formatDateTime(a.date) })),
});

const getInitials = (name) =>
    name
        .split(" ")
        .map((n) => n[0])
        .join("")
        .toUpperCase()
        .slice(0, 2);

const formatPeriod = (iso) => {
    const [year, month] = iso.split("-");
    return `${MONTHS_SHORT[Number(month) - 1]} ${year}`;
};

const formatDate = (iso) => iso.split("-").reverse().join("/");

function StatCard({ value, label, tone }) {
    return (
        <div className={`${ui.statCard} ${tone ?? ""}`}>
            <div className={ui.statValue}>{value ?? "—"}</div>
            <div className={ui.statLabel}>{label}</div>
        </div>
    );
}

export const HistoryCoachingPage = () => {
    const { user } = useAuthStore();
    const [downloadingId, setDownloadingId] = useState(null);
    const toast = useToast();
    const [searchQuery, setSearchQuery] = useState("");
    const [selectedStatus, setSelectedStatus] = useState("todos");
    const [selectedPeriod, setSelectedPeriod] = useState("todos");
    const [selectedCoachingModal, setSelectedCoachingModal] = useState(null);
    const [showDetailModal, setShowDetailModal] = useState(false);
    const [history, setHistory] = useState([]);
    const [loading, setLoading] = useState(true);

    useEffect(() => {
        coachService.history()
            .then((data) => setHistory(data.map(mapCoaching)))
            .catch((error) => toast.error(error.noAccess ? "No tienes permiso para ver el historial." : "No se pudo cargar el historial de coaching."))
            .finally(() => setLoading(false));
    }, []);

    const STATS = {
        total: history.length,
        process: history.filter((c) => c.status === STATUS.process).length,
        pending: history.filter((c) => c.status === STATUS.pending).length,
        approved: history.filter((c) => c.status === STATUS.approved).length,
    };

    const PERIODS = [...new Set(history.map((c) => c.date.slice(0, 7)))].sort().reverse().map((value) => {
        const [year, month] = value.split("-");
        return { value, label: `${MONTHS[Number(month) - 1]} ${year}` };
    });

    const filteredCoachings = history.filter((c) => {
        const q = searchQuery.trim().toLowerCase();
        const matchSearch = !q || c.collaboratorName.toLowerCase().includes(q) || c.collaboratorCode.toLowerCase().includes(q);
        const matchStatus = selectedStatus === "todos" || c.status === selectedStatus;
        const matchPeriod = selectedPeriod === "todos" || c.date.startsWith(selectedPeriod);
        return matchSearch && matchStatus && matchPeriod;
    });

    const handleDownloadPDF = async (coaching) => {
        if (coaching.status !== STATUS.approved) {
            toast.error("El PDF solo está disponible para procesos aprobados");
            return;
        }
        setDownloadingId(coaching.id);
        try {
            const data = await coachService.exportSession(coaching.id);
            const fileName = coachingFileName(data);
            await exportPdf(
                buildCoachingFormatPdf(data, { generatedBy: displayName(user) || data.coachName }),
                fileName
            );
            toast.success("PDF generado", fileName);
        } catch (err) {
            console.error(err);
            toast.error("No se pudo generar el PDF", "Intenta de nuevo en unos momentos.");
        } finally {
            setDownloadingId(null);
        }
    };


    const handleViewDetails = (coaching) => {
        setSelectedCoachingModal(coaching);
        setShowDetailModal(true);
    };

    const isApproved = (c) => c.status === STATUS.approved;

    return (
        <>
            <header className={styles.pageHeader}>
                <div>
                    <h1 className={styles.title}>Historial de coaching</h1>
                    <p className={styles.subtitle}>Consulta los procesos de coaching aplicados y descarga el PDF de cada uno.</p>
                </div>
            </header>

            <div className={base.page}>
                <div className={ui.stats}>
                    <StatCard value={STATS.total} label="Total procesos" />
                    <StatCard value={STATS.process} label="En proceso" tone={ui.process} />
                    <StatCard value={STATS.pending} label="Pend. aprobación" tone={ui.pending} />
                    <StatCard value={STATS.approved} label="Aprobados" tone={ui.approved} />
                </div>

                <div className={ui.filters}>
                    <div className={`${base.inputIcon} ${ui.searchBox}`}>
                        <Search size={16} />
                        <input
                            type="text"
                            placeholder="Buscar por colaborador..."
                            value={searchQuery}
                            onChange={(e) => setSearchQuery(e.target.value)}
                            className={base.input}
                            aria-label="Buscar por colaborador"
                        />
                    </div>
                    <select
                        value={selectedStatus}
                        onChange={(e) => setSelectedStatus(e.target.value)}
                        className={`${base.select} ${ui.filterSelect}`}
                        aria-label="Filtrar por estado"
                    >
                        <option value="todos">Todos los estados</option>
                        {Object.values(STATUS).map((s) => <option key={s} value={s}>{s}</option>)}
                    </select>
                    <select
                        value={selectedPeriod}
                        onChange={(e) => setSelectedPeriod(e.target.value)}
                        className={`${base.select} ${ui.filterSelect}`}
                        aria-label="Filtrar por período"
                    >
                        <option value="todos">Todos los períodos</option>
                        {PERIODS.map((p) => <option key={p.value} value={p.value}>{p.label}</option>)}
                    </select>
                </div>

                <div className={ui.list}>
                    {loading ? (
                        <div className={ui.empty}>Cargando historial...</div>
                    ) : filteredCoachings.length === 0 ? (
                        <div className={ui.empty}>No hay registros de coaching que coincidan con la búsqueda.</div>
                    ) : (
                        filteredCoachings.map((c) => {
                            const pill = STATUS_PILL[c.status];
                            return (
                                <div
                                    key={c.id}
                                    className={ui.row}
                                    onClick={() => handleViewDetails(c)}
                                    onKeyDown={(e) => e.key === "Enter" && handleViewDetails(c)}
                                    tabIndex={0}
                                    title="Doble clic o Enter para ver el detalle"
                                >
                                    <span className={ui.rowDate}>{formatPeriod(c.date)}</span>
                                    <div className={ui.avatar}>{getInitials(c.collaboratorName)}</div>
                                    <div className={ui.rowInfo}>
                                        <div className={ui.rowName}>{c.collaboratorName} — {c.collaboratorCode}</div>
                                        <div className={ui.rowSub}>
                                            {c.position} · {c.location} · {c.indicators.length} indicadores
                                        </div>
                                    </div>
                                    <div className={ui.rowActions}>
                                        <span className={`${ui.pill} ${pill.className}`}>{pill.label}</span>
                                        <button
                                            type="button"
                                            className={`${base.btn} ${base.btnOutline} ${base.btnSm}`}
                                            disabled={!isApproved(c) || downloadingId !== null}
                                            onClick={(e) => {
                                                e.stopPropagation();
                                                handleDownloadPDF(c);
                                            }}
                                        >
                                            <Download size={15} /> {downloadingId === c.id ? "Generando..." : "Descargar PDF"}
                                        </button>
                                    </div>
                                </div>
                            );
                        })
                    )}
                </div>
            </div>

            <Modal
                open={showDetailModal}
