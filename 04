		private void Log(string estado, string mensaje)
		{
			string texto = "[" + Fmt(_swTotal) + "] " + mensaje;
			bool fireAgain = true;

			if (estado == LogError)
			{
				_ultimoError = mensaje;
				Dts.Events.FireWarning(0, NombreProceso, "ERROR: " + texto, "", 0);
			}
			else
