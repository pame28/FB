import { apiFeedbackAuthorized } from "./APIS";
import { endpointsAPI } from "./endpointApi";

export const rolesService = {
  list: async () => {
    const { data } = await apiFeedbackAuthorized.get(endpointsAPI.roles);
    return data.data ?? [];
  },

  // ⚠️ Endpoint pendiente de backend: ajustar ruta y cuerpo cuando lo definan
  updatePermissions: async (roleId, permissionIds) => {
    const { data } = await apiFeedbackAuthorized.put(`${endpointsAPI.roles}/${roleId}/permissions`, { permissionIds });
    return data.data;
  },
};











/* =========================================================
   Permisos por rol
   ========================================================= */

/* ---- Contenedor: roles a la izquierda, detalle a la derecha ---- */
.layout {
  display: grid;
  grid-template-columns: 260px 1fr;
  min-height: 520px;
  border: 1px solid #e6ebf1;
  border-radius: 16px;
  background: #fff;
  overflow: hidden;
}

/* ---- Lista de roles ---- */
.rolesPane { padding: 14px 10px; border-right: 1px solid #eef1f5; background: #fbfcfe; }

.paneLabel {
  padding: 4px 12px 8px;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #a3adbb;
}

.roleList { display: flex; flex-direction: column; gap: 2px; margin: 0; padding: 0; list-style: none; }

.roleBtn {
  position: relative;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 10px 12px;
  border: none;
  border-radius: 10px;
  background: none;
  font: inherit;
  font-size: 13.5px;
  font-weight: 600;
  text-align: left;
  color: #3d4b5f;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease;
}
.roleBtn:hover { background: #f2f5f9; color: var(--bp-blue-expert); }

.roleBtnActive {
  background: color-mix(in srgb, var(--bp-blue-expert) 7%, white);
  font-weight: 800;
  color: var(--bp-blue-expert);
}
.roleBtnActive::before {
  content: "";
  position: absolute;
  left: 0;
  top: 8px;
  bottom: 8px;
  width: 3px;
  border-radius: 0 3px 3px 0;
  background: var(--bp-yellow-opt);
}

.roleName { min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.roleMeta { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }

.countBadge {
  min-width: 22px;
  height: 22px;
  padding: 0 7px;
  display: inline-grid;
  place-items: center;
  border-radius: 999px;
  background: #e8eef5;
  font-size: 11.5px;
  font-weight: 800;
  color: #5b6b80;
}
.roleBtnActive .countBadge { background: var(--bp-blue-expert); color: #fff; }

.dirtyDot { width: 8px; height: 8px; border-radius: 50%; background: var(--bp-yellow-opt); }

