        private static Task<IResult> ApproveSessionReview(
            long sessionId,
            ICoachingRepository repository,
            ClaimsPrincipal claimsPrincipal,
            ILoggerFactory loggerFactory) =>
            RespondSession(sessionId, true, null, repository, claimsPrincipal, loggerFactory, review: true);

        private static Task<IResult> RejectSessionReview(
            long sessionId,
            RejectCoachingSessionRequestDto request,
            ICoachingRepository repository,
            ClaimsPrincipal claimsPrincipal,
            ILoggerFactory loggerFactory)
        {
            if (string.IsNullOrWhiteSpace(request?.Reason) || request.Reason.Trim().Length > 500)
            {
                return Task.FromResult(Results.Json(new ResponseObjectError
                {
                    Code = StatusCodes.Status400BadRequest,
                    Message = "Debes indicar un motivo de rechazo de hasta 500 caracteres."
                }, statusCode: StatusCodes.Status400BadRequest));
            }

            return RespondSession(sessionId, false, request.Reason, repository, claimsPrincipal, loggerFactory, review: true);
        }

        private static Task<IResult> AcceptSession(
            long sessionId,
            ICoachingRepository repository,
            ClaimsPrincipal claimsPrincipal,
            ILoggerFactory loggerFactory) =>
            RespondSession(sessionId, true, null, repository, claimsPrincipal, loggerFactory);

        private static Task<IResult> RejectSession(
            long sessionId,
            RejectCoachingSessionRequestDto request,
            ICoachingRepository repository,
            ClaimsPrincipal claimsPrincipal,
            ILoggerFactory loggerFactory)
        {
            if (string.IsNullOrWhiteSpace(request?.Reason) || request.Reason.Trim().Length > 500)
            {
                return Task.FromResult(Results.Json(new ResponseObjectError
                {
                    Code = StatusCodes.Status400BadRequest,
                    Message = "Debes indicar un motivo de rechazo de hasta 500 caracteres."
                }, statusCode: StatusCodes.Status400BadRequest));
            }

            return RespondSession(sessionId, false, request.Reason, repository, claimsPrincipal, loggerFactory);
        }

        private static async Task<IResult> RespondSession(
            long sessionId,
            bool accept,
            string? reason,
            ICoachingRepository repository,
            ClaimsPrincipal claimsPrincipal,
            ILoggerFactory loggerFactory,
            bool review = false)
        {
            var logger = loggerFactory.CreateLogger(typeof(CoachingEndpoints));
            var currentUserId = GetCurrentUserId(claimsPrincipal);

            try
            {
                if (string.IsNullOrWhiteSpace(currentUserId))
                {
                    return Unauthorized();
                }

                var status = review
                    ? await repository.RespondSessionReviewAsync(sessionId, currentUserId, accept, reason)
                    : await repository.RespondSessionAcceptanceAsync(sessionId, currentUserId, accept, reason);

                if (status == RespondSessionStatus.NotFound)
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = StatusCodes.Status404NotFound,
                        Message = "No se encontró la sesión de coaching del colaborador."
                    }, statusCode: StatusCodes.Status404NotFound);
                }

                if (status == RespondSessionStatus.Invalid)
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = StatusCodes.Status409Conflict,
                        Message = review
                            ? "El proceso ya fue respondido o no está pendiente de aprobación."
                            : "La aceptación de esta sesión ya fue respondida."
                    }, statusCode: StatusCodes.Status409Conflict);
                }

                return Results.Ok(new ResponseObject<object>
                {
                    Code = StatusCodes.Status200OK,
                    Message = accept ? "Indicadores aprobados correctamente." : "Indicadores rechazados correctamente.",
                    Data = new { sessionId }
                });
            }
            catch (Exception exception)
            {
                logger.LogError(exception, "RespondCoachingSessionError");
                return ServerError();
            }
        }

        private static IResult Unauthorized() => Results.Json(new ResponseObjectError
        {
            Code = StatusCodes.Status401Unauthorized,
            Message = GenericErrors.UnauthorizedUserMessage
        }, statusCode: StatusCodes.Status401Unauthorized);

        private static IResult ServerError() => Results.Json(new ResponseObjectError
        {
            Code = StatusCodes.Status500InternalServerError,
            Message = GenericErrors.InternalServerError
        }, statusCode: StatusCodes.Status500InternalServerError);

        private static string? GetCurrentUserId(ClaimsPrincipal claimsPrincipal)
        {
            return claimsPrincipal.FindFirstValue("userId")
                ?? claimsPrincipal.FindFirstValue(ClaimTypes.NameIdentifier);
        }
    }
}



