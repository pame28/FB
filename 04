CREATE View [dbo].[uvw_CuentasPagos]
As
	With Base As(
		--Select
		--	 NoCuenta						NoCuenta
		--	,IsNull(CantidadPagosMN, 0)		CantidadPagosMN
		--	,IsNull(CantidadPagosUSD, 0)	CantidadPagosUSD
		--	,IsNull(PagoVencidoML, 0)		PagoVencidoML
		--	,IsNull(PagoVencidoUSD, 0)		PagoVencidoUSD
		--	,Ms.EstadoTarjeta
		--	,Ms.EstadoCuenta
		--From
		--	MaestroSaldos Ms
		--Inner Join
		--	ETarjetas Tr
		--On
		--	Ms.NumeroTarjeta = Tr.NumeroTarjeta
		--Where 
		--	Ms.CategoriaTarjeta In('E', '0')
		--	And Tr.CategoriaTarjeta In('E', '0')
		--	And Tr.EstadoHabilitar = ''
		--Group by
		--	NoCuenta
		--	,CantidadPagosMN
		--	,CantidadPagosUSD
		--	,PagoVencidoML
		--	,PagoVencidoUSD
		--	,Ms.EstadoTarjeta
		--	,Ms.EstadoCuenta
	Select 
		 a.NoCuenta					NoCuenta
		,a.CantidadPagosMN			CantidadPagosMN
		,a.CantidadPagosUSD			CantidadPagosUSD
		,Max(a.PagoVencidoML)		PagoVencidoML
		,Max(a.PagoVencidoUSD)		PagoVencidoUSD
		,a.EstadoTarjeta			EstadoTarjeta
		,a.EstadoCuenta				EstadoCuenta
		,a.CategoriaTarjeta			TipoTarjeta
	From 
		(Select
			NoCuenta						NoCuenta
			,IsNull(CantidadPagosMN, 0)		CantidadPagosMN
			,IsNull(CantidadPagosUSD, 0)	CantidadPagosUSD
			,IsNull(PagoVencidoML, 0)		PagoVencidoML
			,IsNull(PagoVencidoUSD, 0)		PagoVencidoUSD
--			,Ms.EstadoTarjeta
			,Tr.EstadoTarjeta
			,Ms.EstadoCuenta
			,Ms.CategoriaTarjeta
		From
			MaestroSaldos Ms
		Inner Join
			ETarjetas Tr
		On
			Ms.NumeroTarjeta = Tr.NumeroTarjeta
		Where 
			Ms.CategoriaTarjeta ='E'
			And Tr.CategoriaTarjeta='E'
			And Tr.EstadoHabilitar IN ( '','I','*','R','U','A','B','E','D','H','G','K','J' )
		Group by
			NoCuenta
			,CantidadPagosMN
			,CantidadPagosUSD
			,PagoVencidoML
			,PagoVencidoUSD
			,Tr.EstadoTarjeta
			,Ms.EstadoCuenta
		,Ms.CategoriaTarjeta) a
	Group By
		 a.NoCuenta
		,a.CantidadPagosMN
		,a.CantidadPagosUSD
		,a.EstadoTarjeta
		,a.EstadoCuenta
		,a.CategoriaTarjeta
	), 
	Tarjetas20 As
	(
		Select * From Base	
		where EstadoTarjeta = 20 
	),
	Tarjetas25 As
	(
		Select * From Base A
		Where EstadoTarjeta = 25 
		And Not Exists (Select 1 From Tarjetas20 B where a.NoCuenta = b.NoCuenta)
	)

	Select * From Tarjetas20
		Union All 
	Select * From Tarjetas25




GO




