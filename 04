USE [BandejaVASA]
GO
CREATE VIEW [dbo].[uvw_SaldosVasa_v2]
AS
WITH base AS
(   -- IDÉNTICO al original
    SELECT
          'VASA' Origen
          ,a.Cif ,a.NoCuenta ,a.NumeroTarjeta ,a.NombreEmpresa ,a.Ciclo ,a.LimiteCredito
          ,a.DisponibleRetiroML ,a.DisponibleCompraML ,a.DisponibleRetiroUSD ,a.DisponibleCompraUSD
          ,a.FechaUltimaCompraML ,a.FechaUltimaCompraUSD ,a.FechaUltimoRetiroML ,a.FechaUltimoRetiroUSD
          ,a.FechaUltimoPagoML ,a.FechaUltimaPagoUSD ,a.FechaUltimoMovimiento ,a.FechaUltimoMantenimiento
          ,a.CantidadPagosMN ,a.CantidadPagosUSD ,a.PagosIngresadosML ,a.PagosIngresadosUSD
          ,a.FechaMaximaPago ,a.PagoContadoML ,a.PagoContadoUSD ,a.PagoMinimoML ,a.PagoMinimoUSD
          ,a.SaldoInicialML ,a.SaldoInicialUSD ,a.SaldoActualML ,a.SaldoActualUSD
          ,a.CiclosVencidosML ,a.CiclosVencidosUSD ,a.PagoVencidoML ,a.PagoVencidoUSD
          ,a.SaldoExtraML ,a.SaldoExtraUSD ,a.SaldoIntraML ,a.SaldoIntraUSD
          ,a.TasaFinanciacionML ,a.TasaFinanciacionUSD ,a.BinTarjeta ,a.FechaUltimaMora
          ,a.HistorialPagoML ,a.HistorialPagoUSD ,a.FechaPrimeraCompraUSD ,a.FechaPrimeraCompraML
          ,a.FechaAlta ,a.FechaActivacion ,a.FechaExpiracion ,a.FechaBaja
          ,a.EstadoTarjeta ,a.EstadoCuenta ,a.FechaUltActualizacionMora
          ,Right('0' + Cast(Isnull(a.DiasMoraMN30 ,0) As Varchar(2)) ,2) +
           Right('0' + Cast(Isnull(a.DiasMoraMN60 ,0) As Varchar(2)) ,2) +
           Right('0' + Cast(Isnull(a.DiasMoraMN90 ,0) As Varchar(2)) ,2) +
           Right('0' + Cast(Isnull(a.DiasMoraMN120 ,0) As Varchar(2)) ,2) +
           Right('0' + Cast(Isnull(a.DiasMoraMasMN120 ,0) As Varchar(2)) ,2)  HistorialMoraMN
          ,Right('0' + Cast(Isnull(a.DiasMoraME30 ,0) As Varchar(2)) ,2) +
           Right('0' + Cast(Isnull(a.DiasMoraME60 ,0) As Varchar(2)) ,2) +
           Right('0' + Cast(Isnull(a.DiasMoraME90 ,0) As Varchar(2)) ,2) +
           Right('0' + Cast(Isnull(a.DiasMoraME120 ,0) As Varchar(2)) ,2) +
           Right('0' + Cast(Isnull(a.DiasMoraMasME120 ,0) As Varchar(2)) ,2)  HistorialMoraUSD
          ,a.DiasMoraMN ,a.DiasMoraUSD ,t.TarjetaImprimir ,a.CategoriaTarjeta ,a.NoCuentaClaro
          ,t.BinTarjeta + 'XXXXXX' + t.TarjetaImprimir AS NumTarjetaTruncada
    FROM MaestroSaldos a WITH (NOLOCK)
    INNER JOIN ETarjetas t WITH (NOLOCK) ON a.NumeroTarjeta = t.NumeroTarjeta
    WHERE t.EstadoHabilitar IN ('','I','*','R','U','A','B','E','D','H','G','K','J')
),
m AS
(
    SELECT b.*,
        -- ¿La cuenta está en TarjetaNormales (titular, estado 20)?   (NoCuenta NULL nunca hacía match en el NOT EXISTS)
        CASE WHEN b.NoCuenta IS NULL THEN 0 ELSE MAX(CASE WHEN b.EstadoTarjeta = 20 AND b.CategoriaTarjeta = '0' THEN 1 ELSE 0 END) OVER (PARTITION BY b.NoCuenta) END AS EnNormales,
        -- ¿La cuenta está en TarjetaNormalesAdi (adicional, estado 20)?
        CASE WHEN b.NoCuenta IS NULL THEN 0 ELSE MAX(CASE WHEN b.EstadoTarjeta = 20 AND b.CategoriaTarjeta = '1' THEN 1 ELSE 0 END) OVER (PARTITION BY b.NoCuenta) END AS EnNormalesAdi,
        -- ¿Tiene tarjeta titular / adicional en estado 25?
        CASE WHEN b.NoCuenta IS NULL THEN 0 ELSE MAX(CASE WHEN b.EstadoTarjeta = 25 AND b.CategoriaTarjeta = '0' THEN 1 ELSE 0 END) OVER (PARTITION BY b.NoCuenta) END AS Tiene25,
        CASE WHEN b.NoCuenta IS NULL THEN 0 ELSE MAX(CASE WHEN b.EstadoTarjeta = 25 AND b.CategoriaTarjeta = '1' THEN 1 ELSE 0 END) OVER (PARTITION BY b.NoCuenta) END AS Tiene25Adi,
        -- Max(NumeroTarjeta) por cuenta dentro de cada grupo (estado + categoría), igual que los GROUP BY NoCuenta originales
        MAX(b.NumeroTarjeta) OVER (PARTITION BY b.NoCuenta, b.EstadoTarjeta, b.CategoriaTarjeta) AS MaxTarjeta
    FROM base b
)
SELECT Origen, Cif, NoCuenta, NumeroTarjeta, NombreEmpresa, Ciclo, LimiteCredito, DisponibleRetiroML, DisponibleCompraML,
       DisponibleRetiroUSD, DisponibleCompraUSD, FechaUltimaCompraML, FechaUltimaCompraUSD, FechaUltimoRetiroML, FechaUltimoRetiroUSD,
       FechaUltimoPagoML, FechaUltimaPagoUSD, FechaUltimoMovimiento, FechaUltimoMantenimiento, CantidadPagosMN, CantidadPagosUSD,
       PagosIngresadosML, PagosIngresadosUSD, FechaMaximaPago, PagoContadoML, PagoContadoUSD, PagoMinimoML, PagoMinimoUSD,
       SaldoInicialML, SaldoInicialUSD, SaldoActualML, SaldoActualUSD, CiclosVencidosML, CiclosVencidosUSD, PagoVencidoML,
       PagoVencidoUSD, SaldoExtraML, SaldoExtraUSD, SaldoIntraML, SaldoIntraUSD, TasaFinanciacionML, TasaFinanciacionUSD,
       BinTarjeta, FechaUltimaMora, HistorialPagoML, HistorialPagoUSD, FechaPrimeraCompraUSD, FechaPrimeraCompraML, FechaAlta,
       FechaActivacion, FechaExpiracion, FechaBaja, EstadoTarjeta, EstadoCuenta, FechaUltActualizacionMora, HistorialMoraMN,
       HistorialMoraUSD, DiasMoraMN, DiasMoraUSD, TarjetaImprimir, CategoriaTarjeta, NoCuentaClaro, NumTarjetaTruncada
FROM m
WHERE
       -- TarjetasNormalesTitular
       (EstadoTarjeta = 20 AND CategoriaTarjeta = '0' AND NumeroTarjeta = MaxTarjeta)
       -- TarjetasNormalesAdicional
    OR (EstadoTarjeta = 20 AND CategoriaTarjeta = '1' AND NumeroTarjeta = MaxTarjeta)
       -- TarjetasProblemaTitular
    OR (EstadoTarjeta = 25 AND CategoriaTarjeta = '0' AND EnNormales = 0 AND NumeroTarjeta = MaxTarjeta)
       -- TarjetasProblemasAdicionales
    OR (EstadoTarjeta = 25 AND CategoriaTarjeta = '1' AND EnNormalesAdi = 0 AND NumeroTarjeta = MaxTarjeta)
       -- TarjetaOrdenNoRenovar (el original une TODAS, no solo la máxima)
    OR (EstadoTarjeta = 22 AND CategoriaTarjeta = '0' AND EnNormales = 0)
       -- TarjetaOrdenNoRenovarAdi (el original la compara contra TarjetaNormales titular, se respeta)
    OR (EstadoTarjeta = 22 AND CategoriaTarjeta = '1' AND EnNormales = 0)
       -- TarjetasCerradasTitular
    OR (EstadoTarjeta = 29 AND CategoriaTarjeta = '0' AND EnNormales = 0 AND Tiene25 = 0 AND NumeroTarjeta = MaxTarjeta)
       -- TarjetasCerradasAdicional
    OR (EstadoTarjeta = 29 AND CategoriaTarjeta = '1' AND EnNormalesAdi = 0 AND Tiene25Adi = 0 AND NumeroTarjeta = MaxTarjeta);
GO