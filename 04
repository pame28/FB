using System;
using System.Collections.Generic;
using System.Globalization;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using dllwsDivideloTodoBXI.Models;
using dllwsDivideloTodoBXI.Models.Transactions;
using dllwsDivideloTodoBXI.TiposObjetos;
using System.Configuration;
using dllwsDivideloTodoBXI.Clases;

namespace dllwsDivideloTodoBXI.Services
{
    public class TransactionService : BaseApiService
    {

        private readonly string _endpointLogin;
        private readonly string _userLogin;
        private readonly string _passwordLogin;
        private readonly dllwsDivideloTodoBXI.DivideloTodoBXI _dllDividelo;

        public TransactionService(string baseUrl, string endpointLogin, string userLogin, string passwordLogin, string ignoreSsl, DivideloTodoBXI divideloTodoBXI) : base(baseUrl, bool.Parse(ignoreSsl)) 
        {
            _endpointLogin = endpointLogin;
            _userLogin = userLogin;
            _passwordLogin = passwordLogin;
            _dllDividelo = divideloTodoBXI;
        }

        public async Task<AutorizacionesResult> ObtenerTransacciones(TransactionRequest request, string endpointTransactions)
        {
            try
            {
                AutorizacionesResult Datos = new AutorizacionesResult();
                string token = await LoginAsync(_endpointLogin, _userLogin, _passwordLogin);
                ApiTransactionResponse response = await PostAsync<ApiTransactionResponse>(endpointTransactions, request);

                if (response.hasError)
                {
                    return Datos;
                }

                foreach (var mov in response.movimientos)
                {
                    decimal valor = decimal.Parse(mov.amount, new CultureInfo("en-US"));
                    string strImporte = valor.ToString();

                    Autorizaciones detalle = new Autorizaciones();
                    detalle.CampaniaCuotificacion = mov.installmentCampaign;
                    detalle.Cuotas = "0";
                    detalle.CUT = mov.receiptNumber;
                    detalle.FechaOrigen = mov.originDate;
                    detalle.importe = Double.Parse(strImporte);
                    detalle.Descripcion = mov.merchantName;
                    detalle.ModeloCuotificacion = mov.installmentModel;
                    detalle.Moneda = ParsearMoneda(mov.currency);
                    detalle.Referencia = mov.receiptNumber;
                    detalle.Periodos = "0";
                    detalle.Producto = mov.product;
                    detalle.Tarjeta = mov.card;
                    detalle.Movimientos_Id = Guid.NewGuid().ToString();
                    detalle.FechaOrigenSort = Convert.ToDateTime(detalle.FechaOrigen);
                    Datos.add(detalle);
                }

                return Datos;
            }
            catch(Exception ex)
            {
                return new AutorizacionesResult();
            }
           
        }


        public string ParsearMoneda(string monedaOrigen)
        {
            List<Monedas> monedas = _dllDividelo.obtenerMonedas();
            string monedaLocal = monedas.Where(m => m.iso_alfabetico == monedaOrigen)
                .Select(m => m.simbolo_local)
                .FirstOrDefault();

            return monedaLocal;
        }
    }
}





