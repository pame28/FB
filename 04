				.Replace("{FECHA_GENERACION}", "'" + _fechaGeneracion + "'")
				.Replace("{ESTADO_INICIAL}", "'" + parametros["EstadoInicial"] + "'")
				.Replace("{ARCHIVO_GENERADO}", "'" + parametros["ArchivoGenerado"] + "'");

			_sqlConsultaOrigen = parametros["ConsultaOrigen"]
				.Replace("{ARCHIVO_ORIGEN}", parametros["ArchiviOrigen"]);

			_sqlConsultaActualizar = parametros["ConsultaActualizar"]
				.Replace("{ARCHIVO_CONTROL}", parametros["ArchivoControl"])
				.Replace("{ESTADO_FINAL}", "'" + parametros["EstadoFinal"] + "'")
				.Replace("{FECHA_PROCESADO}", "'" + fecha + "'")
				.Replace("{HORA_PROCESADO}", "'" + hora + "'")
				.Replace("{USER}", "'" + parametros["Usuario"] + "'")
				.Replace("{FECHA_GENERACION}", "'" + _fechaGeneracion + "'")
