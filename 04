import { useCallback, useEffect, useMemo, useState } from "react";
import { AlertCircle, Filter, Info, Plus, Search, UserCog, UsersRound } from "lucide-react";
import { ConfirmDialog, useToast } from "../../../shared/components";
import { teamsService } from "../../../api/teamsService";
import { useCatalogs } from "../../../hooks/useCatalogs";
import { mapTeam, normalize } from "./leaders/teamUtils";
import { TeamCard } from "./leaders/TeamCard";
import { TeamWizardModal } from "./leaders/TeamWizardModal";
import { EditTeamModal } from "./leaders/EditTeamModal";
import { LeadersModal } from "./leaders/LeadersModal";
import { AddMembersModal } from "./leaders/AddMembersModal";
import { MoveMemberModal } from "./leaders/MoveMemberModal";
import { RemoveMemberModal } from "./leaders/RemoveMemberModal";
import pages from "../../Pages.module.css";
import t from "./leaders/Teams.module.css";

export const MantenimientoLiderPage = () => {
  const catalogs = useCatalogs();
  const toast = useToast();

  // Equipos
  const [teams, setTeams] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  // Filtros
  const [areaFilter, setAreaFilter] = useState("");
  const [search, setSearch] = useState("");

  // Modales
  const [wizardOpen, setWizardOpen] = useState(false);
  const [editTeam, setEditTeam] = useState(null);
  const [leadersTeam, setLeadersTeam] = useState(null);
  const [addTeam, setAddTeam] = useState(null);
  const [move, setMove] = useState(null);       // { team, member }
  const [removal, setRemoval] = useState(null); // { team, member }

  // Eliminar equipo
  const [toDelete, setToDelete] = useState(null);
  const [deleting, setDeleting] = useState(false);
  const [deleteError, setDeleteError] = useState("");

  /* ---------- Carga ---------- */
  const load = useCallback(async () => {
    setLoading(true);
    setError("");
    try {
      const data = await teamsService.list();
      setTeams(data.map(mapTeam));
    } catch (err) {
      setError(err.noAccess
        ? "No tienes permiso para ver los equipos."
        : "No se pudieron cargar los equipos. Intenta de nuevo.");
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => { load(); }, [load]);

  // Muestra el mensaje y recarga para que los cambios aparezcan de inmediato
  const done = (message) => {
    toast.success(message);
    load();
  };

  /* ---------- Áreas: catálogo + las que vienen en los equipos ---------- */
  const areaOptions = useMemo(() => {
    const map = new Map(catalogs.areas.map((a) => [Number(a.value), a.label]));
    teams.forEach((tm) => {
      if (tm.areaId != null && !map.has(tm.areaId)) map.set(tm.areaId, tm.areaName);
    });
    return [...map]
      .map(([value, label]) => ({ value, label }))
      .sort((a, b) => String(a.label).localeCompare(String(b.label), "es"));
  }, [catalogs.areas, teams]);

  /* ---------- Filtrado ---------- */
  const filtered = useMemo(() => {
    const q = normalize(search);
    return teams
      .filter((tm) => !areaFilter || tm.areaId === Number(areaFilter))
      .filter((tm) => !q || normalize(tm.name).includes(q) || tm.leaders.some((l) => normalize(l.name).includes(q)))
      .sort((a, b) => a.name.localeCompare(b.name, "es"));
  }, [teams, areaFilter, search]);

  const hasFilters = Boolean(areaFilter || search);
  const defaultAreaId = areaFilter || (areaOptions.length === 1 ? areaOptions[0].value : "");

  /* ---------- Eliminar ---------- */
  const openDelete = (team) => {
    setDeleteError("");
    setToDelete(team);
  };

  const confirmDelete = async () => {
    setDeleting(true);
    setDeleteError("");
    try {
      await teamsService.remove(toDelete.id);
      setToDelete(null);
      done("Equipo eliminado correctamente");
    } catch (err) {
      setDeleteError(err.noAccess
        ? "No tienes permiso para eliminar equipos."
        : err.response?.data?.message ?? "No se pudo eliminar el equipo. Intenta de nuevo.");
    } finally {
      setDeleting(false);
    }
  };

  /* ---------- Render ---------- */
  return (
    <>
      <header className={pages.pageHeader}>
        <div>
          <span className={pages.eyebrow}>Mantenimientos</span>
          <h1 className={pages.title}>Mantenimiento de líder</h1>
          <p className={pages.subtitle}>
            Crea y administra equipos de trabajo por área. Cada equipo tiene sus líderes asignados y sus propios miembros.
          </p>
        </div>

        <div className={pages.actions}>
          {/* ⚠️ Se habilita cuando existan los endpoints de Gestión de líderes */}
          <button type="button" className={`${pages.btn} ${pages.btnOutline}`} disabled
            title="Disponible cuando backend habilite los endpoints de líderes">
            <UserCog size={18} /> Gestión de líderes
          </button>
          <button type="button" className={`${pages.btn} ${pages.btnPrimary}`} onClick={() => setWizardOpen(true)}>
            <Plus size={18} /> Nuevo equipo
          </button>
        </div>
      </header>

      <div className={pages.banner}>
        <Info size={18} />
        <p>
          Los equipos se organizan por área. Los usuarios de Agencias solo aparecen en equipos de Agencias,
          y los de otras áreas solo ven usuarios de su misma área.
        </p>
      </div>

      {error && (
        <div className={`${pages.banner} ${pages.bannerError}`} role="alert">
          <AlertCircle size={18} />
          <p>
            {error}{" "}
            <button type="button" className={pages.linkBtn} style={{ padding: 0 }} onClick={load}>Reintentar</button>
          </p>
        </div>
      )}

      {/* ---------- Filtros ---------- */}
      <section className={pages.filterCard}>
        <h2 className={pages.filterCardTitle}><Filter size={16} /> Filtrar equipos</h2>
        <div className={t.filterRow}>
          <select className={`${pages.select} ${t.areaSelect}`} value={areaFilter}
            onChange={(e) => setAreaFilter(e.target.value)} aria-label="Filtrar por área">
            <option value="">Todas las áreas</option>
            {areaOptions.map((a) => <option key={a.value} value={a.value}>{a.label}</option>)}
          </select>

          <div className={t.search}>
            <Search size={16} />
            <input className={pages.input} placeholder="Buscar equipo por nombre o líder..."
              value={search} onChange={(e) => setSearch(e.target.value)} aria-label="Buscar equipos" />
          </div>

          {!loading && (
            <span className={pages.count}>
              {filtered.length} {filtered.length === 1 ? "equipo" : "equipos"}
            </span>
          )}
        </div>
      </section>

      {/* ---------- Tarjetas ---------- */}
      {loading ? (
        <div className={t.grid}>
          {Array.from({ length: 3 }, (_, i) => <div key={i} className={t.skeletonCard} />)}
        </div>
      ) : teams.length === 0 && !error ? (
        <div className={t.emptyState}>
          <UsersRound size={44} />
          <h3>No hay equipos registrados</h3>
          <p>Crea el primer equipo para empezar a organizar a los colaboradores de tu área.</p>
          <button type="button" className={`${pages.btn} ${pages.btnPrimary}`} onClick={() => setWizardOpen(true)}>
            <Plus size={18} /> Nuevo equipo
          </button>
        </div>
      ) : filtered.length === 0 && hasFilters ? (
        <div className={t.emptyState}>
          <Search size={40} />
          <h3>Ningún equipo coincide con los filtros</h3>
          <p>Prueba con otra área u otro nombre.</p>
          <button type="button" className={`${pages.btn} ${pages.btnOutline}`}
            onClick={() => { setAreaFilter(""); setSearch(""); }}>
            Limpiar filtros
          </button>
        </div>
      ) : (
        <div className={t.grid}>
          {filtered.map((team) => (
            <TeamCard
              key={team.id}
              team={team}
              onEdit={setEditTeam}
              onDelete={openDelete}
              onChangeLeaders={setLeadersTeam}
              onAddMembers={setAddTeam}
              onMoveMember={(tm, member) => setMove({ team: tm, member })}
              onRemoveMember={(tm, member) => setRemoval({ team: tm, member })}
            />
          ))}
        </div>
      )}

      {/* ---------- Modales ---------- */}
      <TeamWizardModal
        open={wizardOpen}
        areas={areaOptions}
        teams={teams}
        defaultAreaId={defaultAreaId}
        onClose={() => setWizardOpen(false)}
        onCreated={() => { setWizardOpen(false); done("Equipo creado correctamente"); }}
      />

      <EditTeamModal
        team={editTeam}
        teams={teams}
        onClose={() => setEditTeam(null)}
        onSaved={() => { setEditTeam(null); done("Equipo guardado correctamente"); }}
      />

      <LeadersModal
        team={leadersTeam}
        onClose={() => setLeadersTeam(null)}
        onSaved={() => { setLeadersTeam(null); done("Líder actualizado correctamente"); }}
      />

      <AddMembersModal
        team={addTeam}
        onClose={() => setAddTeam(null)}
        onSaved={() => { setAddTeam(null); done("Miembros agregados correctamente"); }}
      />

      <MoveMemberModal
        move={move}
        teams={teams}
        onClose={() => setMove(null)}
        onSaved={() => { setMove(null); done("Miembro trasladado correctamente"); }}
      />

      <RemoveMemberModal
        removal={removal}
        onClose={() => setRemoval(null)}
        onSaved={() => { setRemoval(null); done("Miembro removido correctamente"); }}
      />

      <ConfirmDialog
        open={Boolean(toDelete)}
        danger
        title="¿Eliminar equipo?"
        message={toDelete ? `Se eliminará "${toDelete.name}" y se desvincularán todos sus miembros. Esta acción no se puede deshacer.` : ""}
        detail={toDelete && toDelete.members.length > 0 && (
          <div className={t.warnBox} style={{ marginBottom: 0, textAlign: "left" }}>
            <Info size={16} />
            <p>
              {toDelete.members.length === 1 ? "El miembro" : `Los ${toDelete.members.length} miembros`} del equipo
              {toDelete.members.length === 1 ? " quedará" : " quedarán"} sin equipo asignado hasta que sean agregados a otro.
            </p>
          </div>
        )}
        confirmText={deleting ? "Eliminando..." : "Sí, eliminar equipo"}
        loading={deleting}
        error={deleteError}
        onConfirm={confirmDelete}
        onCancel={() => setToDelete(null)}
      />
    </>
  );
};








