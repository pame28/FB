using ApiCoaching.Constants;
using ApiCoaching.Dtos;
using ApiCoaching.Dtos.Coaching;
using ApiCoaching.Dtos.Services;
using ApiCoaching.Models;
using ApiCoaching.Repositories.Interfaces;
using ApiCoaching.Services;
using FluentValidation;
using System.Security.Claims;

namespace ApiCoaching.Endpoints
{
    public static class CoachingEndpoints
    {
        public static void MapCoachingEndpoints(this IEndpointRouteBuilder app)
        {
            var coachingGroup = app.MapGroup("/api/coaching")
                .WithTags("Coaching");

            coachingGroup.MapPost("calculate", CalculateCoachingAchievement)
                .WithName("CalculateCoachingAchievement")
                .WithSummary("Calcula el porcentaje alcanzado mediante una fórmula dinámica, sin guardar datos.")
                .RequireAuthorization()
                .Produces<ResponseObject<CoachingAchievementDto>>(StatusCodes.Status200OK)
                .Produces<ResponseObjectError>(StatusCodes.Status400BadRequest)
                .Produces<ResponseObjectError>(StatusCodes.Status401Unauthorized)
                .Produces<ResponseObjectError>(StatusCodes.Status500InternalServerError);

            coachingGroup.MapPost("assignments", CreateIndicatorAssignments)
                .WithName("CreateIndicatorAssignments")
                .WithSummary("Asigna múltiples indicadores a múltiples miembros de múltiples equipos.")
                .RequireAuthorization()
                .Produces<ResponseObject<List<long>>>(StatusCodes.Status201Created)
                .Produces<ResponseObjectError>(StatusCodes.Status400BadRequest)
                .Produces<ResponseObjectError>(StatusCodes.Status401Unauthorized)
                .Produces<ResponseObjectError>(StatusCodes.Status500InternalServerError);

            coachingGroup.MapPost("sessions/{sessionId:long}/results", SaveCoachingResults)
                .WithName("SaveCoachingResults")
                .WithSummary("Guarda los resultados de una sesión y su plan de acción, calculando el porcentaje alcanzado.")
                .RequireAuthorization()
                .Produces<ResponseObject<CoachingResultsDto>>(StatusCodes.Status201Created)
                .Produces<ResponseObjectError>(StatusCodes.Status400BadRequest)
                .Produces<ResponseObjectError>(StatusCodes.Status401Unauthorized)
                .Produces<ResponseObjectError>(StatusCodes.Status404NotFound)
                .Produces<ResponseObjectError>(StatusCodes.Status409Conflict)
                .Produces<ResponseObjectError>(StatusCodes.Status500InternalServerError);
        }

        private static async Task<IResult> CreateIndicatorAssignments(
            CreateIndicatorAssignmentsRequestDto request,
            IValidator<CreateIndicatorAssignmentsRequestDto> validator,
            ICoachingRepository repository,
            ClaimsPrincipal claimsPrincipal,
            ILoggerFactory loggerFactory)
        {
            var logger = loggerFactory.CreateLogger(typeof(CoachingEndpoints));
            var currentUserId = GetCurrentUserId(claimsPrincipal);

            try
            {
                if (string.IsNullOrWhiteSpace(currentUserId))
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = StatusCodes.Status401Unauthorized,
                        Message = GenericErrors.UnauthorizedUserMessage
                    }, statusCode: StatusCodes.Status401Unauthorized);
                }

                var validationResult = await validator.ValidateAsync(request);
                if (!validationResult.IsValid)
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = StatusCodes.Status400BadRequest,
                        Message = GenericErrors.RequestValidationErrorMessage,
                        Errors = validationResult.Errors
                            .ToDictionary(x => x.PropertyName, x => x.ErrorMessage)
                    }, statusCode: StatusCodes.Status400BadRequest);
                }

                var assignments = request.Teams
                    .SelectMany(team => team.Members.SelectMany(member =>
                    {
                        var session = new CoachingSession
                        {
                            TeamId = team.TeamId,
                            MemberUserId = member.MemberUserId,
                            CreatedAt = DateTime.Now,
                            CreatedBy = currentUserId
                        };

                        return member.Indicators.Select(indicator => new TeamMemberIndicatorAssignment
                        {
                            Session = session,
                            Weight = indicator.Weight,
                            TeamId = team.TeamId,
                            MemberUserId = member.MemberUserId,
                            IndicatorId = indicator.IndicatorId,
                            TargetValue = indicator.TargetValue,
                            TargetUnitId = indicator.TargetUnitId,
                            ValidFrom = indicator.ValidFrom,
                            ValidTo = indicator.ValidTo,
                            CreatedAt = DateTime.Now,
                            CreatedBy = currentUserId
                        });
                    }))
                    .ToList();

                var result = await repository.CreateIndicatorAssignmentsAsync(assignments);

                if (!result.Success)
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = StatusCodes.Status400BadRequest,
                        Message = result.ErrorMessage!
                    }, statusCode: StatusCodes.Status400BadRequest);
                }

                return Results.Created("/api/coaching/assignments", new ResponseObject<List<long>>
                {
                    Code = StatusCodes.Status201Created,
                    Message = "Asignaciones creadas correctamente.",
                    Data = [.. result.Assignments.Select(x => x.Id)]
                });
            }
            catch (Exception ex)
            {
                logger.LogError(ex, "CreateIndicatorAssignmentsError");

                return Results.Json(new ResponseObjectError
                {
                    Code = StatusCodes.Status500InternalServerError,
                    Message = GenericErrors.InternalServerError
                }, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        private static async Task<IResult> SaveCoachingResults(
            long sessionId,
            SaveCoachingResultsRequestDto request,
            IValidator<SaveCoachingResultsRequestDto> validator,
            ICoachingRepository repository,
            ClaimsPrincipal claimsPrincipal,
            ILoggerFactory loggerFactory)
        {
            var logger = loggerFactory.CreateLogger(typeof(CoachingEndpoints));
            var currentUserId = GetCurrentUserId(claimsPrincipal);

            try
            {
                if (string.IsNullOrWhiteSpace(currentUserId))
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = StatusCodes.Status401Unauthorized,
                        Message = GenericErrors.UnauthorizedUserMessage
                    }, statusCode: StatusCodes.Status401Unauthorized);
                }

                if (sessionId <= 0)
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = StatusCodes.Status400BadRequest,
                        Message = "El identificador de la sesión debe ser mayor que cero."
                    }, statusCode: StatusCodes.Status400BadRequest);
                }

                var validationResult = await validator.ValidateAsync(request);
                if (!validationResult.IsValid)
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = StatusCodes.Status400BadRequest,
                        Message = GenericErrors.RequestValidationErrorMessage,
                        Errors = validationResult.Errors
                            .GroupBy(error => error.PropertyName)
                            .ToDictionary(group => group.Key,
                                group => string.Join(" ", group.Select(error => error.ErrorMessage).Distinct()))
                    }, statusCode: StatusCodes.Status400BadRequest);
                }

                var result = await repository.SaveCoachingResultsAsync(sessionId, request, currentUserId);
                if (result.Status != SaveCoachingResultsStatus.Saved)
                {
                    var statusCode = result.Status switch
                    {
                        SaveCoachingResultsStatus.NotFound => StatusCodes.Status404NotFound,
                        SaveCoachingResultsStatus.AlreadyEvaluated => StatusCodes.Status409Conflict,
                        _ => StatusCodes.Status400BadRequest
                    };

                    return Results.Json(new ResponseObjectError
                    {
                        Code = statusCode,
                        Message = result.ErrorMessage!,
                        Errors = result.Errors
                    }, statusCode: statusCode);
                }

                return Results.Created($"/api/coaching/sessions/{sessionId}/results", new ResponseObject<CoachingResultsDto>
                {
                    Code = StatusCodes.Status201Created,
                    Message = "Resultados del coaching y plan de acción guardados correctamente.",
                    Data = result.Data
                });
            }
            catch (Exception exception)
            {
                logger.LogError(exception, "SaveCoachingResultsError");

                return Results.Json(new ResponseObjectError
                {
                    Code = StatusCodes.Status500InternalServerError,
                    Message = GenericErrors.InternalServerError
                }, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        private static async Task<IResult> CalculateCoachingAchievement(
            CalculateCoachingAchievementRequestDto request,
            IValidator<CalculateCoachingAchievementRequestDto> validator,
            ClaimsPrincipal claimsPrincipal,
            ILoggerFactory loggerFactory)
        {
            var logger = loggerFactory.CreateLogger(typeof(CoachingEndpoints));

            try
            {
                if (string.IsNullOrWhiteSpace(GetCurrentUserId(claimsPrincipal)))
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = StatusCodes.Status401Unauthorized,
                        Message = GenericErrors.UnauthorizedUserMessage
                    }, statusCode: StatusCodes.Status401Unauthorized);
                }

                var validationResult = await validator.ValidateAsync(request);
                if (!validationResult.IsValid)
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = StatusCodes.Status400BadRequest,
                        Message = GenericErrors.RequestValidationErrorMessage,
                        Errors = validationResult.Errors
                            .GroupBy(error => error.PropertyName)
                            .ToDictionary(group => group.Key,
                                group => string.Join(" ", group.Select(error => error.ErrorMessage).Distinct()))
                    }, statusCode: StatusCodes.Status400BadRequest);
                }

                if (!CoachingAchievementCalculator.TryCalculate(
                    request.AchievedValue!.Value,
                    request.TargetValue!.Value,
                    request.MinimumValue,
                    request.MaximumValue,
                    request.Rule,
                    request.Formula,
                    out var percentage,
                    out var errorMessage))
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = StatusCodes.Status400BadRequest,
                        Message = errorMessage!
                    }, statusCode: StatusCodes.Status400BadRequest);
                }

                return Results.Ok(new ResponseObject<CoachingAchievementDto>
                {
                    Code = StatusCodes.Status200OK,
                    Message = "Porcentaje alcanzado calculado correctamente.",
                    Data = new CoachingAchievementDto { AchievementPercentage = percentage }
                });
            }
            catch (Exception exception)
            {
                logger.LogError(exception, "CalculateCoachingAchievementError");

                return Results.Json(new ResponseObjectError
                {
                    Code = StatusCodes.Status500InternalServerError,
                    Message = GenericErrors.InternalServerError
                }, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        private static string? GetCurrentUserId(ClaimsPrincipal claimsPrincipal)
        {
            return claimsPrincipal.FindFirstValue("userId")
                ?? claimsPrincipal.FindFirstValue(ClaimTypes.NameIdentifier);
        }
    }
}




using ApiCoaching.Models;

namespace ApiCoaching.Services
{
    public static class CoachingAchievementCalculator
    {
        public static bool TryCalculate(
            decimal achievedValue,
            decimal targetValue,
            decimal minimumValue,
            decimal maximumValue,
            Rule rule,
            string? formula,
            out decimal percentage,
            out string? errorMessage)
        {
            percentage = 0m;
            errorMessage = null;

            if (!Enum.IsDefined(rule))
            {
                errorMessage = "La regla del indicador no es válida.";
                return false;
            }

            if (rule == Rule.InRangeIsBetter && minimumValue > maximumValue)
            {
                errorMessage = "El valor mínimo del indicador no puede superar el valor máximo.";
                return false;
            }

            if (!IndicatorFormulaEvaluator.TryEvaluate(formula, achievedValue, targetValue,
                minimumValue, maximumValue, out var calculated, out errorMessage))
            {
                return false;
            }

            calculated = decimal.Round(calculated, 2, MidpointRounding.AwayFromZero);
            if (calculated < -9_999_999.99m || calculated > 9_999_999.99m)
            {
                errorMessage = "El porcentaje alcanzado excede la precisión permitida de siete dígitos enteros y dos decimales.";
                return false;
            }

            percentage = calculated;
            return true;
        }
    }
}






using ApiCoaching.Data;
using ApiCoaching.Dtos.Coaching;
using ApiCoaching.Models;
using ApiCoaching.Repositories.Interfaces;
using ApiCoaching.Services;
using Microsoft.Data.SqlClient;
using Microsoft.EntityFrameworkCore;

namespace ApiCoaching.Repositories
{
    public class CoachingRepository(AppDbContext appDbContext) : ICoachingRepository
    {
        private readonly AppDbContext _dbContext = appDbContext;

        public async Task<Team?> GetTeamMembersByLeaderIdAsync(string userLeaderId)
        {
            return await _dbContext.Teams
                .Where(x => x.Leaders.Any(leader => leader.LeaderUserId == userLeaderId))
                .Include(x => x.Members)
                    .ThenInclude(x => x.User)
                        .ThenInclude(x => x.CompanyArea)
                .Include(x => x.Members)
                    .ThenInclude(x => x.User)
                        .ThenInclude(x => x.CompanyLocation)
                .Include(x => x.Members)
                    .ThenInclude(x => x.User)
                        .ThenInclude(x => x.CompanyPosition)
                .FirstOrDefaultAsync();
        }

        public async Task<List<MemberIndicatorAssignmentDto>> GetMemberIndicatorsAsync(string leaderUserId, string memberUserId)
        {
            var acceptedAssignments = _dbContext.TeamMembersIndicatorsAssignments
                .AsNoTracking()
                .Where(assignment => assignment.MemberUserId == memberUserId &&
                    assignment.Session.AcceptanceStatus == CoachingSessionAcceptanceStatus.Accepted &&
                    assignment.EvaluatedAt == null &&
                    assignment.TeamMember.Team.Leaders.Any(leader => leader.LeaderUserId == leaderUserId));

            return await acceptedAssignments
                .Where(assignment => assignment.CoachingSessionId == acceptedAssignments
                    .OrderBy(firstAssignment => firstAssignment.Id)
                    .Select(firstAssignment => firstAssignment.CoachingSessionId)
                    .FirstOrDefault())
                .OrderBy(assignment => assignment.TeamId)
                .ThenBy(assignment => assignment.Indicator.Name)
                .ThenBy(assignment => assignment.Id)
                .Select(assignment => new MemberIndicatorAssignmentDto
                {
                    AssignmentId = assignment.Id,
                    CoachingSessionId = assignment.CoachingSessionId,
                    MemberUserId = assignment.MemberUserId,
                    MemberFullName = string.IsNullOrWhiteSpace(assignment.TeamMember.User.FullName)
                        ? assignment.TeamMember.User.FirstName + " " + assignment.TeamMember.User.LastName
                        : assignment.TeamMember.User.FullName,
                    TeamId = assignment.TeamId,
                    TeamName = assignment.TeamMember.Team.Name,
                    IndicatorId = assignment.IndicatorId,
                    IndicatorName = assignment.Indicator.Name,
                    MinimunValue = assignment.Indicator.MinimunValue,
                    MaximunValue = assignment.Indicator.MaximunValue,
                    Formula = assignment.Indicator.Formula,
                    Weight = assignment.Weight,
                    Type = assignment.Indicator.Type,
                    Rule = assignment.Indicator.Rule,
                    Status = assignment.Indicator.Status,
                    TemplateId = assignment.Indicator.TemplateId,
                    PeriodId = assignment.Indicator.PeriodId,
                    TargetValue = assignment.TargetValue,
                    TargetUnitId = assignment.TargetUnitId,
                    TargetUnitName = assignment.TargetUnit.Name,
                    ValidFrom = assignment.ValidFrom,
                    ValidTo = assignment.ValidTo,
                    AcceptanceStatus = assignment.Session.AcceptanceStatus,
                    ReviewStatus = assignment.Session.ReviewStatus
                })
                .ToListAsync();
        }

        public async Task<CreateIndicatorAssignmentsResult> CreateIndicatorAssignmentsAsync(
            IEnumerable<TeamMemberIndicatorAssignment> assignments)
        {
            var assignmentList = assignments.ToList();

            var errorMessage = ValidateAssignments(assignmentList)
                ?? await ValidateTeamsAsync(assignmentList)
                ?? await ValidateMembersAsync(assignmentList)
                ?? await ValidateIndicatorsAsync(assignmentList)
                ?? await ValidateTargetUnitsAsync(assignmentList);

            if (errorMessage is not null)
            {
                return new(false, errorMessage, []);
            }

            var sessions = assignmentList
                .GroupBy(assignment => assignment.Session)
                .Select(group =>
                {
                    var session = group.Key;
                    session.IndicatorAssignments = group.ToList();
                    return session;
                })
                .ToList();

            await _dbContext.CoachingSessions.AddRangeAsync(sessions);
            await _dbContext.SaveChangesAsync();

            return new(true, null, assignmentList);
        }

        public async Task<SaveCoachingResultsResult> SaveCoachingResultsAsync(
            long sessionId,
            SaveCoachingResultsRequestDto request,
            string leaderUserId)
        {
            var session = await _dbContext.CoachingSessions
                .Include(x => x.IndicatorAssignments)
                    .ThenInclude(x => x.Indicator)
                .Include(x => x.ActionPlan)
                .FirstOrDefaultAsync(x => x.Id == sessionId &&
                    x.TeamMember.Team.Leaders.Any(leader => leader.LeaderUserId == leaderUserId));

            if (session is null)
            {
                return new(SaveCoachingResultsStatus.NotFound,
                    "La sesión de coaching no existe o no tienes acceso a ella.", null);
            }

            if (session.AcceptanceStatus != CoachingSessionAcceptanceStatus.Accepted)
            {
                return new(SaveCoachingResultsStatus.Invalid,
                    "El colaborador debe aceptar el inicio de la sesión de coaching antes de registrar resultados.", null);
            }

            if (session.ReviewStatus != CoachingSessionReviewStatus.NotSubmitted ||
                session.ActionPlan is not null || session.IndicatorAssignments.Any(x =>
                x.EvaluatedAt.HasValue || x.AchievedValue.HasValue || x.AchievementPercentage.HasValue))
            {
                return new(SaveCoachingResultsStatus.AlreadyEvaluated,
                    "La sesión de coaching ya tiene resultados o un plan de acción registrado.", null);
            }

            var assignments = session.IndicatorAssignments.ToDictionary(x => x.Id);
            var requestedIds = request.Results.Select(x => x.AssignmentId).ToHashSet();
            if (assignments.Count == 0 || requestedIds.Count != request.Results.Count ||
                !requestedIds.SetEquals(assignments.Keys))
            {
                return new(SaveCoachingResultsStatus.Invalid,
                    "Debes enviar exactamente una vez todas las asignaciones de la sesión, sin incluir asignaciones de otras sesiones.", null);
            }

            if (assignments.Values.Any(x => x.TeamId != session.TeamId ||
                !string.Equals(x.MemberUserId, session.MemberUserId, StringComparison.OrdinalIgnoreCase)))
            {
                return new(SaveCoachingResultsStatus.Invalid,
                    "Las asignaciones no corresponden al equipo y colaborador de la sesión.", null);
            }

            var results = new List<IndicatorResultDto>();
            var errors = new Dictionary<string, string>();
            for (var index = 0; index < request.Results.Count; index++)
            {
                var input = request.Results[index];
                if (!input.AchievedValue.HasValue)
                {
                    errors[$"Results[{index}].AchievedValue"] = "El resultado obtenido es obligatorio.";
                    continue;
                }

                var assignment = assignments[input.AssignmentId];
                var indicator = assignment.Indicator;
                if (!CoachingAchievementCalculator.TryCalculate(
                    input.AchievedValue.Value,
                    assignment.TargetValue,
                    indicator.MinimunValue,
                    indicator.MaximunValue,
                    indicator.Rule,
                    indicator.Formula,
                    out var percentage,
                    out var calculationError))
                {
                    errors[$"Results[{index}].AchievedValue"] =
                        $"Asignación {assignment.Id}: {calculationError}";
                    continue;
                }

                results.Add(new IndicatorResultDto
                {
                    AssignmentId = assignment.Id,
                    AchievedValue = input.AchievedValue.Value,
                    AchievementPercentage = percentage
                });
            }

            if (errors.Count > 0)
            {
                return new(SaveCoachingResultsStatus.Invalid,
                    "No se pudieron calcular los porcentajes alcanzados.", null, errors);
            }

            var evaluatedAt = DateTime.UtcNow;
            foreach (var result in results)
            {
                var assignment = assignments[result.AssignmentId];
                assignment.AchievedValue = result.AchievedValue;
                assignment.AchievementPercentage = result.AchievementPercentage;
                assignment.EvaluatedAt = evaluatedAt;
                assignment.LastModifiedAt = evaluatedAt;
                assignment.LastModifiedBy = leaderUserId;
            }

            var plan = new CoachingActionPlan
            {
                CoachingSessionId = session.Id,
                CreatedAt = evaluatedAt,
                CreatedBy = leaderUserId,
                Actions = request.ActionPlan.Actions.Select(action => new CoachingAction
                {
                    MeasurementType = action.MeasurementType,
                    CommitmentDate = action.CommitmentDate,
                    ImprovementOpportunity = action.ImprovementOpportunity.Trim(),
                    ActionDescription = action.ActionDescription.Trim(),
                    CreatedAt = evaluatedAt,
                    CreatedBy = leaderUserId
                }).ToList()
            };

            session.ActionPlan = plan;
            session.SubmitForReview();
            session.LastModifiedAt = evaluatedAt;
            session.LastModifiedBy = leaderUserId;

            try
            {
                await _dbContext.SaveChangesAsync();
            }
            catch (DbUpdateConcurrencyException)
            {
                return new(SaveCoachingResultsStatus.AlreadyEvaluated,
                    "El estado de la sesión cambió durante la operación. Actualiza los datos antes de continuar.", null);
            }
            catch (DbUpdateException exception) when (
                exception.InnerException is SqlException { Number: 2601 or 2627 })
            {
                return new(SaveCoachingResultsStatus.AlreadyEvaluated,
                    "Otra solicitud ya registró el plan de acción de esta sesión.", null);
            }

            return new(SaveCoachingResultsStatus.Saved, null, new CoachingResultsDto
            {
                CoachingSessionId = session.Id,
                AcceptanceStatus = session.AcceptanceStatus,
                ReviewStatus = session.ReviewStatus,
                EvaluatedAt = evaluatedAt,
                Results = results,
                ActionPlan = new CoachingActionPlanDto
                {
                    Id = plan.Id,
                    Actions = plan.Actions.Select(action => new CoachingActionDto
                    {
                        Id = action.Id,
                        MeasurementType = action.MeasurementType,
                        CommitmentDate = action.CommitmentDate,
                        ImprovementOpportunity = action.ImprovementOpportunity,
                        ActionDescription = action.ActionDescription
                    }).ToList()
                }
            });
        }

        private static string? ValidateAssignments(List<TeamMemberIndicatorAssignment> assignments)
        {
            if (assignments.Count == 0)
            {
                return "Debes enviar al menos una asignación.";
            }

            if (assignments.Any(x => x.Session is null))
            {
                return "Todas las asignaciones deben pertenecer a una sesión de coaching.";
            }

            if (assignments.Any(x => x.CoachingSessionId != 0 || x.Session.Id != 0))
            {
                return "Esta operación solo permite crear sesiones nuevas de coaching.";
            }

            if (assignments.Any(x => x.Weight <= 0m || x.Weight > 100m
                || decimal.Round(x.Weight, 2) != x.Weight))
            {
                return "Cada peso debe ser mayor que 0, menor o igual que 100 y tener como máximo dos decimales.";
            }

            foreach (var group in assignments.GroupBy(x => x.Session))
            {
                var errorMessage = ValidateSessionAssignments(group);
                if (errorMessage is not null)
                {
                    return errorMessage;
                }
            }

            return null;
        }

        private static string? ValidateSessionAssignments(IGrouping<CoachingSession, TeamMemberIndicatorAssignment> group)
        {
            var owner = group.Key;
            if (group.Any(x => x.TeamId != owner.TeamId
                || !string.Equals(x.MemberUserId, owner.MemberUserId, StringComparison.OrdinalIgnoreCase)))
            {
                return "Todas las asignaciones deben pertenecer al equipo y usuario de la sesión.";
            }

            if (group.Select(x => x.IndicatorId).Distinct().Count() != group.Count())
            {
                return "Un indicador no puede repetirse dentro de la misma sesión.";
            }

            return group.Sum(x => x.Weight) != 100m
                ? "Los pesos de cada sesión deben sumar exactamente 100 %."
                : null;
        }

        private async Task<string?> ValidateTeamsAsync(List<TeamMemberIndicatorAssignment> assignments)
        {
            var teamIds = assignments.Select(x => x.TeamId).Distinct().ToList();
            var existingTeamIds = await _dbContext.Teams
                .Where(x => teamIds.Contains(x.Id))
                .Select(x => x.Id)
                .ToListAsync();

            var missingTeamIds = teamIds.Except(existingTeamIds).ToList();
            return missingTeamIds.Count > 0
                ? $"Los siguientes equipos no existen: {string.Join(", ", missingTeamIds)}."
                : null;
        }

        private async Task<string?> ValidateMembersAsync(List<TeamMemberIndicatorAssignment> assignments)
        {
            var teamIds = assignments.Select(x => x.TeamId).Distinct().ToList();
            var memberUserIds = assignments
                .Select(x => x.MemberUserId)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            var existingMembers = await _dbContext.TeamsMembers
                .Where(x => teamIds.Contains(x.TeamId) && memberUserIds.Contains(x.MemberUserId))
                .Select(x => new { x.TeamId, x.MemberUserId })
                .ToListAsync();

            var membersByTeam = existingMembers.ToLookup(x => x.TeamId);
            var missingMembers = assignments
                .Where(assignment => !membersByTeam[assignment.TeamId].Any(member =>
                    string.Equals(member.MemberUserId, assignment.MemberUserId, StringComparison.OrdinalIgnoreCase)))
                .Select(x => $"{x.TeamId}/{x.MemberUserId}")
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            return missingMembers.Count > 0
                ? $"Los siguientes usuarios no pertenecen al equipo indicado (equipo/usuario): {string.Join(", ", missingMembers)}."
                : null;
        }

        private async Task<string?> ValidateIndicatorsAsync(List<TeamMemberIndicatorAssignment> assignments)
        {
            var indicatorIds = assignments
                .Select(x => x.IndicatorId)
                .Distinct()
                .ToList();

            var existingIndicatorIds = await _dbContext.Indicators
                .Where(x => indicatorIds.Contains(x.Id))
                .Select(x => x.Id)
                .ToListAsync();

            var missingIndicatorIds = indicatorIds
                .Except(existingIndicatorIds)
                .ToList();

            return missingIndicatorIds.Count > 0
                ? $"Los siguientes indicadores no existen: {string.Join(", ", missingIndicatorIds)}."
                : null;
        }

        private async Task<string?> ValidateTargetUnitsAsync(List<TeamMemberIndicatorAssignment> assignments)
        {
            var targetUnitIds = assignments
                .Select(x => x.TargetUnitId)
                .Distinct()
                .ToList();

            var activeUnitIds = await _dbContext.Units
                .Where(x => targetUnitIds.Contains(x.Id) && x.Status)
                .Select(x => x.Id)
                .ToListAsync();

            var invalidUnitIds = targetUnitIds.Except(activeUnitIds).ToList();
            return invalidUnitIds.Count > 0
                ? $"Las siguientes unidades no existen o están inactivas: {string.Join(", ", invalidUnitIds)}."
                : null;
        }

    }
}






using ApiCoaching.Dtos.Coaching;
using ApiCoaching.Models;

namespace ApiCoaching.Repositories.Interfaces
{
