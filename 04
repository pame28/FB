/* ---------------- Cálculo de notas ---------------- */
const round2 = (n) => Number(n.toFixed(2));
const num = (v) => {
    const n = parseFloat(v);
    return Number.isNaN(n) ? null : n;
};
const avg = (list) => (list.length ? round2(list.reduce((a, b) => a + b, 0) / list.length) : null);
const isFilled = (v) => v !== undefined && v !== null && String(v).trim() !== "";

// answers: { [indicatorId]: { [column]: valor, __obs: texto } }
// Devuelve notas por columna ("NA" | número | null) y la nota del criterio (número | null)
export const computeCriterion = (criterion, answers = {}) => {
    const cell = (ind, col) => answers[ind.id]?.[col];
    const colNotes = {};

    if (criterion.calc === "ratio") {
        const [prog, real] = criterion.indicators;
        criterion.columns.forEach((col) => {
            const p = cell(prog, col);
            const r = cell(real, col);
            if (p === "NA" || r === "NA") colNotes[col] = "NA";
            else if (num(p) > 0 && num(r) !== null) colNotes[col] = Math.min(100, round2((num(r) / num(p)) * 100));
            else colNotes[col] = null;
        });
    } else if (criterion.calc === "ce") {
        criterion.columns.forEach((col) => {
            const values = criterion.indicators.map((ind) => cell(ind, col));
            const ce = values.filter((v) => v === "CE").length;
            const nce = values.filter((v) => v === "NCE").length;
            if (ce + nce > 0) colNotes[col] = round2((ce / (ce + nce)) * 100);
            else colNotes[col] = values.some((v) => v === "NA") ? "NA" : null;
        });
    } else {
        const last = criterion.columns[criterion.columns.length - 1];
        const values = criterion.indicators.map((ind) => num(cell(ind, last))).filter((v) => v !== null);
        colNotes[last] = values.length ? Math.min(100, avg(values)) : null;
    }

    const numeric = Object.values(colNotes).filter((v) => typeof v === "number");
    return { colNotes, nota: avg(numeric) };
};

export const hasRating = (criterion, answers = {}) =>
    criterion.indicators.some((ind) => criterion.columns.some((col) => isFilled(answers[ind.id]?.[col])));

// Nota Final = Σ (Nota_Criterio × Peso / 100)
export const computeFinal = (format, answersByCriterion) => {
    const rows = format.criteria.map((c) => {
        const { colNotes, nota } = computeCriterion(c, answersByCriterion[c.id]);
        return { criterion: c, colNotes, nota, points: round2(((nota ?? 0) * c.weight) / 100) };
    });
    return { rows, total: round2(rows.reduce((s, r) => s + r.points, 0)) };
};


