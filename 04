USE [BandejaVASA_PRD]
GO
CREATE VIEW [dbo].[uvw_CuentasPagos_v2]
AS
WITH TarjetasEmpresariales AS
(
    SELECT NumeroTarjeta, NoUsuario, EstadoTarjeta, NumTarjetaTruncada
    FROM (
        SELECT et.NumeroTarjeta, et.NoUsuario, et.EstadoTarjeta,
               et.BinTarjeta + 'XXXXXX' + et.TarjetaImprimir AS NumTarjetaTruncada,
               ROW_NUMBER() OVER (PARTITION BY et.NoUsuario, et.EstadoTarjeta ORDER BY et.FechaFinVigencia DESC) AS fila
        FROM ETarjetas et WITH (NOLOCK)
        WHERE et.CategoriaTarjeta = 'E'
          AND et.EstadoTarjeta IN (20, 25)
    ) A
    WHERE fila = 1
),
Base AS
(
    SELECT  NoCuenta                         AS NoCuenta
           ,ISNULL(CantidadPagosMN, 0)       AS CantidadPagosMN
           ,ISNULL(CantidadPagosUSD, 0)      AS CantidadPagosUSD
           ,MAX(ISNULL(PagoVencidoML, 0))    AS PagoVencidoML
           ,MAX(ISNULL(PagoVencidoUSD, 0))   AS PagoVencidoUSD
           ,Tr.EstadoTarjeta                 AS EstadoTarjeta
           ,Ms.EstadoCuenta                  AS EstadoCuenta
           ,Ms.CategoriaTarjeta              AS TipoTarjeta
           ,Te.NumeroTarjeta                 AS NumeroTarjeta
           ,Te.NumTarjetaTruncada            AS NumTarjetaTruncada
    FROM MaestroSaldos Ms WITH (NOLOCK)
    INNER JOIN ETarjetas Tr WITH (NOLOCK)
        ON Ms.NumeroTarjeta = Tr.NumeroTarjeta
    INNER JOIN TarjetasEmpresariales Te
        ON Tr.NoUsuario = Te.NoUsuario AND Tr.EstadoTarjeta = Te.EstadoTarjeta
       AND Te.NumeroTarjeta = Tr.NumeroTarjeta
    WHERE Ms.CategoriaTarjeta = 'E'
      AND Tr.CategoriaTarjeta = 'E'
      AND Tr.EstadoHabilitar IN ('','I','*','R','U','A','B','E','D','H','G','K','J')
    GROUP BY NoCuenta, ISNULL(CantidadPagosMN, 0), ISNULL(CantidadPagosUSD, 0),
             Tr.EstadoTarjeta, Ms.EstadoCuenta, Ms.CategoriaTarjeta,
             Te.NumeroTarjeta, Te.NumTarjetaTruncada
),
m AS
(
    SELECT b.*,
           CASE WHEN b.NoCuenta IS NULL THEN 0
                ELSE MAX(CASE WHEN b.EstadoTarjeta = 20 THEN 1 ELSE 0 END) OVER (PARTITION BY b.NoCuenta)
           END AS Tiene20
    FROM Base b
)
SELECT NoCuenta, CantidadPagosMN, CantidadPagosUSD, PagoVencidoML, PagoVencidoUSD,
       EstadoTarjeta, EstadoCuenta, TipoTarjeta, NumeroTarjeta, NumTarjetaTruncada
FROM m
WHERE EstadoTarjeta = 20
   OR (EstadoTarjeta = 25 AND Tiene20 = 0);
GO