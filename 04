const plural = (n, one, many) => `${n} ${n === 1 ? one : many}`;
const teamMeta = (t) => `${t.area} · ${t.leader ? `Líder: ${t.leader}` : "Sin líder asignado"} · ${plural(t.members, "miembro", "miembros")}`;

export const ManageCertificationPage = () => {
    const toast = useToast();

    const [certifiers, setCertifiers] = useState(INITIAL_CERTIFIERS);
    const [teams, setTeams] = useState(INITIAL_TEAMS);
    const [filterArea, setFilterArea] = useState("todas");
    const [search, setSearch] = useState("");

    // Modal designar
    const [designateOpen, setDesignateOpen] = useState(false);
    const [step, setStep] = useState(1);
    const [formArea, setFormArea] = useState("");
    const [userSearch, setUserSearch] = useState("");
    const [selectedUserId, setSelectedUserId] = useState(null);
    const [selectedTeamIds, setSelectedTeamIds] = useState([]);

    // Modal quitar
    const [removeTarget, setRemoveTarget] = useState(null);

    const q = search.trim().toLowerCase();
    const filteredCertifiers = certifiers.filter(
        (c) =>
            (filterArea === "todas" || c.area === filterArea) &&
            (!q || c.name.toLowerCase().includes(q) || c.code.toLowerCase().includes(q))
    );

    const uq = userSearch.trim().toLowerCase();
    const areaUsers = MOCK_USERS.filter(
        (u) => u.area === formArea && (!uq || u.name.toLowerCase().includes(uq) || u.code.toLowerCase().includes(uq))
    );
    const areaTeams = teams.filter((t) => t.area === formArea);
    const selectedUser = MOCK_USERS.find((u) => u.id === selectedUserId) ?? null;
    const allTeamsSelected = areaTeams.length > 0 && areaTeams.every((t) => selectedTeamIds.includes(t.id));

    const openDesignate = () => {
        setStep(1);
        setFormArea("");
        setUserSearch("");
        setSelectedUserId(null);
        setSelectedTeamIds([]);
        setDesignateOpen(true);
    };

    const closeDesignate = () => setDesignateOpen(false);

    const handleAreaChange = (area) => {
        setFormArea(area);
        setSelectedUserId(null);
        setSelectedTeamIds([]);
    };

    const toggleTeam = (id) =>
        setSelectedTeamIds((prev) => (prev.includes(id) ? prev.filter((t) => t !== id) : [...prev, id]));

    const toggleAllTeams = () => setSelectedTeamIds(allTeamsSelected ? [] : areaTeams.map((t) => t.id));

    const handleConfirmDesignation = () => {
        const existing = certifiers.find((c) => c.code === selectedUser.code);
        const newTeamIds = selectedTeamIds.filter((id) => !existing?.teamIds.includes(id));

        setCertifiers((prev) =>
            existing
                ? prev.map((c) => (c.id === existing.id ? { ...c, teamIds: [...c.teamIds, ...newTeamIds] } : c))
                : [
                    ...prev,
                    {
                        id: Date.now(),
                        code: selectedUser.code,
                        name: selectedUser.name,
                        position: selectedUser.position,
                        area: selectedUser.area,
                        applied: 0,
                        status: "Activo",
                        teamIds: selectedTeamIds,
                    },
                ]
        );
        setTeams((prev) => prev.map((t) => (newTeamIds.includes(t.id) ? { ...t, certifiers: t.certifiers + 1 } : t)));
        closeDesignate();
        toast.success("Certificador designado correctamente");
    };

    const handleConfirmRemove = () => {
        setCertifiers((prev) => prev.filter((c) => c.id !== removeTarget.id));
        setTeams((prev) =>
            prev.map((t) => (removeTarget.teamIds.includes(t.id) ? { ...t, certifiers: Math.max(0, t.certifiers - 1) } : t))
        );
        setRemoveTarget(null);
        toast.success("Rol de certificador quitado correctamente");
    };

    const columns = [
        { key: "code", header: "Código", render: (r) => <span className={base.code}>{r.code}</span> },
        { key: "name", header: "Nombre", render: (r) => <span className={base.name}>{r.name}</span> },
        { key: "position", header: "Puesto" },
        { key: "area", header: "Área", render: (r) => <span className={base.chip}>{r.area}</span> },
        { key: "applied", header: "Certificaciones aplicadas", align: "center", render: (r) => <span className={ui.applied}>{r.applied}</span> },
        { key: "status", header: "Estado", render: (r) => <span className={base.statusActive}>{r.status}</span> },
        {
            key: "actions",
            header: "Acciones",
            align: "right",
            render: (r) => (
                <button
                    type="button"
                    className={ui.actionBtn}
                    onClick={() => setRemoveTarget(r)}
                    title="Quitar rol de certificador"
                    aria-label={`Quitar rol de certificador a ${r.name}`}
                >
                    <UserMinus size={16} />
                </button>
            ),
        },
    ];

    const canNext = step === 1 ? Boolean(formArea && selectedUserId) : selectedTeamIds.length > 0;

    const designateFooter = (
        <div className={ui.modalFooter}>
            {step === 1 ? (
                <button type="button" className={`${base.btn} ${base.btnOutline} ${base.btnSm}`} onClick={closeDesignate}>
                    Cancelar
                </button>
            ) : (
                <button type="button" className={`${base.btn} ${base.btnOutline} ${base.btnSm}`} onClick={() => setStep(step - 1)}>
                    <ChevronLeft size={15} /> Atrás
                </button>
            )}
            {step < 3 ? (
                <button type="button" className={`${base.btn} ${base.btnPrimary} ${base.btnSm}`} onClick={() => setStep(step + 1)} disabled={!canNext}>
                    Siguiente <ChevronRight size={15} />
                </button>
            ) : (
                <button type="button" className={`${base.btn} ${base.btnPrimary} ${base.btnSm}`} onClick={handleConfirmDesignation}>
                    <Check size={15} /> Confirmar designación
                </button>
            )}
        </div>
    );

    return (
        <>
            <header className={ui.headerRow}>
                <div>
