import { useCallback, useEffect, useState } from "react";
import { ChevronRight, ChevronLeft, Plus, Check, Info, Search, Save, X, TriangleAlert } from "lucide-react";
import styles from "../../Pages.module.css";
import ui from "./CollaboratorCoachingPage.module.css";
import { Modal } from "../../../shared/components/Modal";
import { useToast } from "../../../shared/components";
import { useDebounce } from "../../../hooks/useDebounce";
import { coachService } from "../../../api/coachService";
import { profileService } from "../../../api/profileService";

const STEPS = ["Seleccionar colaborador", "Registrar indicadores", "Plan de acción", "Aprobar"];
const MEASURE_TYPES = [
    { value: 1, label: "Cumplimiento" },
    { value: 2, label: "Comportamiento" },
    { value: 3, label: "Conocimiento" },
];

const round2 = (n) => Number(n.toFixed(2));

// Meta textual a partir de los límites que entrega el backend
const goalLabel = (ind) => {
    if (ind.minimumValue != null && ind.maximumValue != null) return `${ind.minimumValue} - ${ind.maximumValue}`;
    return `${ind.targetValue ?? "—"}`;
};

const todayISO = () => new Date().toLocaleDateString("en-CA");

const emptyAction = (commitDate = "") => ({ id: `${Date.now()}-${Math.random()}`, type: "", commitDate, opportunity: "", action: "" });

const isActionBlank = (a) => !a.type && !a.opportunity.trim() && !a.action.trim();
const isActionComplete = (a) => a.type && a.commitDate && a.opportunity.trim() && a.action.trim();

export const CollaboratorCoachingPage = () => {
    const toast = useToast();
    const [currentStep, setCurrentStep] = useState(1);
    const [filters, setFilters] = useState({ code: "", name: "" });
    const [appliedFilters, setAppliedFilters] = useState({ code: "", name: "" });
    const [collaborators, setCollaborators] = useState([]);
    const [selectedCollaborator, setSelectedCollaborator] = useState(null);
    const [indicators, setIndicators] = useState([]);
    const [indicatorValues, setIndicatorValues] = useState({});
    const [indicatorResults, setIndicatorResults] = useState({});
    const [actionPlan, setActionPlan] = useState(() => [emptyAction(todayISO())]);
    const [approvalStamp, setApprovalStamp] = useState(null);
    const [showApprovalConfirmModal, setShowApprovalConfirmModal] = useState(false);
    const [isApproved, setIsApproved] = useState(false);
    const [coachName, setCoachName] = useState("");

    useEffect(() => {
        profileService.get()
            .then((u) => setCoachName(u.fullName?.trim() || `${u.firstName} ${u.lastName}`))
            .catch(() => setCoachName(""));
    }, []);

    // Paso 1: colaboradores con asignaciones aprobadas en curso (GET ongoing-assignments)
    const loadAssignments = useCallback(async () => {
        try {
            const members = await coachService.ongoingAssignments({ name: appliedFilters.name, employeeCode: appliedFilters.code });
            setCollaborators(members);
        } catch (error) {
            toast.error(error.noAccess ? "No tienes permiso para ver tus colaboradores." : "No se pudieron cargar los colaboradores.");
        }
    }, [appliedFilters]);

    useEffect(() => { loadAssignments(); }, [loadAssignments]);

    // Paso 2: indicadores asignados al colaborador seleccionado (POST members/indicators)
    const loadIndicators = useCallback(async () => {
        if (!selectedCollaborator) return;
        try {
            const data = await coachService.memberIndicators(selectedCollaborator.id);
            setIndicators(data);
        } catch (error) {
            toast.error(error.noAccess ? "No tienes permiso para ver estos indicadores." : "No se pudieron cargar los indicadores.");
        }
    }, [selectedCollaborator]);

    useEffect(() => { loadIndicators(); }, [loadIndicators]);

    const sessionId = indicators[0]?.coachingSessionId ?? null;

    // El filtro por nombre/código ya se aplica en el backend (ongoingAssignments)
    const filteredCollaborators = collaborators;

    const results = indicators.map((ind) => {
        const result = indicatorResults[ind.assignmentId] ?? null;
        return { ...ind, result, points: result == null ? 0 : round2((result * ind.weight) / 100) };
    });
    const finalScore = round2(results.reduce((acc, r) => acc + r.points, 0));
    const registeredCount = results.filter((r) => r.result != null).length;
    const validActionsCount = actionPlan.filter(isActionComplete).length;

    // Previsualiza el % logrado con /api/coaching/calculate (debounced por indicador editado)
    const debouncedValues = useDebounce(indicatorValues, 400);
    useEffect(() => {
        indicators.forEach((ind) => {
            const raw = debouncedValues[ind.assignmentId];
            if (raw === undefined || raw === "") return;
            const achievedValue = parseFloat(raw);
            if (Number.isNaN(achievedValue)) return;
            coachService
                .calculate({
                    achievedValue,
                    targetValue: ind.targetValue,
                    minimumValue: ind.minimumValue,
                    maximumValue: ind.maximumValue,
                    rule: ind.rule,
                    formula: ind.formula,
                })
                .then((pct) => setIndicatorResults((prev) => ({ ...prev, [ind.assignmentId]: round2(pct) })))
                .catch(() => toast.error("No se pudo calcular el indicador."));
        });
    }, [debouncedValues, indicators]);

    const coachingDate = new Date().toLocaleDateString("es-ES");

    const handleSearch = () => setAppliedFilters(filters);

    const handleClearSearch = () => {
        setFilters({ code: "", name: "" });
        setAppliedFilters({ code: "", name: "" });
    };

    const handleSelectCollaborator = (collaborator) => {
        if (selectedCollaborator?.id !== collaborator.id) {
            setIndicatorValues({});
            setIndicatorResults({});
        }
        setSelectedCollaborator(collaborator);
    };

    const handleUpdateAction = (id, field, value) => {
        setActionPlan((prev) => prev.map((a) => (a.id === id ? { ...a, [field]: value } : a)));
    };

    const handleContinueToIndicators = () => {
        if (selectedCollaborator) setCurrentStep(2);
    };

    const handleContinueToActionPlan = () => {
        if (registeredCount < indicators.length) {
            toast.error("Completa el valor registrado de todos los indicadores");
            return;
        }
        setCurrentStep(3);
    };

    const handleContinueToApproval = () => {
        const filled = actionPlan.filter((a) => !isActionBlank(a));
        if (filled.some((a) => !isActionComplete(a))) {
            toast.error("Completa todos los campos de cada acción");
            return;
        }
        if (filled.length === 0) {
            toast.error("Agrega al menos una acción al plan");
            return;
        }
        setActionPlan(filled);
        setApprovalStamp(new Date().toLocaleString("es-ES"));
        setCurrentStep(4);
    };

    const handleConfirmApprove = async () => {
        try {
            await coachService.saveSessionResults(sessionId, {
                results: indicators.map((ind) => ({
                    assignmentId: ind.assignmentId,
                    achievedValue: parseFloat(indicatorValues[ind.assignmentId]),
                })),
                actions: actionPlan.map((a) => ({
                    measurementType: Number(a.type),
                    commitmentDate: a.commitDate,
                    improvementOpportunity: a.opportunity,
                    actionDescription: a.action,
                })),
            });
            setIsApproved(true);
            setShowApprovalConfirmModal(false);
            toast.success("Coaching aprobado correctamente");
        } catch (error) {
            toast.error(
                error.noAccess
                    ? "No tienes permiso para aprobar este coaching."
                    : error.response?.data?.message ?? "No se pudo guardar el proceso. Intenta de nuevo."
            );
        }
    };

    const handleSaveDraft = () => toast.success("Borrador guardado correctamente");

    const handleBack = () => setCurrentStep((s) => Math.max(1, s - 1));

    const initials = selectedCollaborator?.fullName.split(" ").map((n) => n[0]).join("");

    return (
        <>
            <header className={styles.pageHeader}>
                <div>
                    <h1 className={styles.title}>Coaching a colaborador</h1>
                    <p className={styles.subtitle}>
                        Registra el proceso de coaching, indicadores y plan de acción para tus colaboradores asignados.
                    </p>
                </div>
            </header>

            <div className={ui.page}>
                {/* Stepper */}
                <nav className={ui.stepper} aria-label="Progreso del coaching">
                    {STEPS.map((label, i) => {
                        const step = i + 1;
                        const state = step < currentStep ? "done" : step === currentStep ? "current" : "";
                        return (
                            <div key={label} style={{ display: "contents" }}>
                                <div className={`${ui.step} ${state ? ui[state] : ""}`} aria-current={step === currentStep ? "step" : undefined}>
                                    <span className={ui.stepCircle}>{step}</span>
                                    <span className={ui.stepLabel}>{label}</span>
                                </div>
                                {step < STEPS.length && <span className={`${ui.stepLine} ${step < currentStep ? ui.done : ""}`} />}
                            </div>
                        );
                    })}
                </nav>

                {/* Tarjeta del colaborador (pasos 2-4) */}
                {selectedCollaborator && currentStep > 1 && (
                    <div className={ui.collabCard}>
                        <div className={ui.avatar}>{initials}</div>
                        <div className={ui.collabInfo}>
                            <div className={ui.collabName}>{selectedCollaborator.fullName}</div>
                            <div className={ui.collabMeta}>
                                <span className={ui.chip}>{selectedCollaborator.companyArea}</span>
                                <span>{selectedCollaborator.companyPosition}</span>
                                <span>{selectedCollaborator.companyUbication}</span>
                            </div>
                        </div>
                        <div className={ui.collabDate}>
                            <span className={ui.collabDateLabel}>Fecha coaching</span>
                            <span className={ui.collabDateValue}>{coachingDate}</span>
                        </div>
                    </div>
                )}

                {/* PASO 1 */}
                {currentStep === 1 && (
                    <>
                        <div className={ui.infoBanner}>
                            <Info size={16} />
                            <span>Solo puedes ver y gestionar los colaboradores que tienes asignados como coach.</span>
                        </div>

                        <section className={ui.card}>
                            <div className={ui.cardHeader}>
                                <h2 className={ui.cardTitle}>Buscar colaborador</h2>
                            </div>
                            <div className={ui.cardBody}>
                                <form
                                    onSubmit={(e) => {
                                        e.preventDefault();
                                        handleSearch();
                                    }}
                                >
                                    <div className={ui.searchGrid}>
                                        <div className={ui.field}>
                                            <label className={ui.label} htmlFor="cc-code">Código</label>
                                            <div className={ui.inputIcon}>
                                                <Search size={16} />
                                                <input
                                                    id="cc-code"
                                                    type="text"
                                                    className={ui.input}
                                                    placeholder="Código del colaborador..."
                                                    value={filters.code}
                                                    onChange={(e) => setFilters({ ...filters, code: e.target.value })}
