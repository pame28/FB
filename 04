import { useCallback, useEffect, useState } from "react";
import { AlertCircle, Info, RefreshCw, TriangleAlert, UserRound } from "lucide-react";
import { Can, ConfirmDialog, useToast } from "../../../shared/components";
import { profileService } from "../../../api/profileService";
import { statusLabelFromValue } from "../../../api/usersService";
import { toTitleCase } from "../../../helpers/format";
import { isCashier, ubicationLabel } from "./userConstants";
import styles from "../../Pages.module.css";

const statusClass = (status) =>
  status === "Activo" ? styles.statusActive
    : status === "Inactivo" ? styles.statusInactive
      : styles.statusWarning;

// Campo de solo lectura: muestra el valor o "—" si viene vacío
function ReadOnlyField({ id, label, value, children }) {
  return (
    <div className={styles.field}>
      <label className={styles.label} htmlFor={id}>
        {label} <span className={styles.readOnlyTag}>SOLO LECTURA</span>
      </label>
      {children ?? <input id={id} className={styles.input} value={value || "—"} readOnly />}
    </div>
  );
}

function FieldSkeleton() {
  return (
    <div className={styles.field}>
      <span className={styles.labelSkeleton} />
      <span className={styles.fieldSkeleton} />
    </div>
  );
}

export const EditarPerfilPage = () => {
  const toast = useToast();

  const [profile, setProfile] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  const [syncOpen, setSyncOpen] = useState(false);
  const [syncing, setSyncing] = useState(false);
  const [syncError, setSyncError] = useState("");

  const loadProfile = useCallback(async () => {
    setLoading(true);
    setError("");
    try {
      setProfile(await profileService.get());
    } catch (err) {
      setError(err.noAccess
        ? "No tienes permiso para ver tu perfil."
        : "No se pudo cargar tu información. Intenta de nuevo.");
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => { loadProfile(); }, [loadProfile]);

  const openSync = () => {
    setSyncError("");
    setSyncOpen(true);
  };

  const handleSync = async () => {
    setSyncing(true);
    setSyncError("");
    try {
      await profileService.syncAs400();
      setSyncOpen(false);
      toast.success("Perfil sincronizado", "Tu información se actualizó desde AS400.");
      await loadProfile();
    } catch (err) {
      setSyncError(err.noAccess
        ? "No tienes permiso para sincronizar tu perfil."
        : err.response?.data?.message ?? "No se pudo sincronizar con AS400. Intenta de nuevo.");
    } finally {
      setSyncing(false);
    }
  };

  // Valores ya formateados para mostrar
  const status = profile ? statusLabelFromValue(profile.status) : "";
  const cashier = isCashier(profile);
  const name = profile
    ? toTitleCase(profile.fullName || `${profile.firstName ?? ""} ${profile.lastName ?? ""}`)
    : "";

  return (
    <>
      <header className={styles.pageHeader}>
        <div>
          <span className={styles.eyebrow}>Mantenimientos</span>
          <h1 className={styles.title}>Editar perfil</h1>
          <p className={styles.subtitle}>Consulta y actualiza tu propia información de perfil.</p>
        </div>

        <Can permission="edit.loggeduserinfo">
          <div className={styles.actions}>
            <button type="button" className={`${styles.btn} ${styles.btnOutline}`}
              onClick={openSync} disabled={loading || !profile}>
              <RefreshCw size={18} /> Sincronizar perfil
            </button>
          </div>
        </Can>
      </header>

      <div className={styles.banner}>
        <UserRound size={18} />
        <p>
          Solo puedes ver y modificar tu propia información. No es posible buscar ni seleccionar
          otros usuarios desde aquí.
        </p>
      </div>

      {error ? (
        <div className={`${styles.banner} ${styles.bannerError}`} role="alert">
          <AlertCircle size={18} />
          <p>
            {error}{" "}
            <button type="button" className={styles.linkBtn} style={{ padding: 0 }} onClick={loadProfile}>
              Reintentar
            </button>
          </p>
        </div>
      ) : (
        <section className={styles.card} style={{ marginTop: 0 }} aria-busy={loading}>
          <h2 className={styles.cardTitle}>Mi información</h2>

          <div className={styles.form}>
            {loading || !profile ? (
              Array.from({ length: 10 }, (_, i) => <FieldSkeleton key={i} />)
            ) : (
              <>
                <ReadOnlyField id="employeeCode" label="Código de empleado" value={profile.employeeCode} />
                <ReadOnlyField id="tellerCode" label="Código de cajero" value={profile.tellerCode} />

                <ReadOnlyField id="name" label="Nombre" value={name} />
                <ReadOnlyField id="position" label="Perfil del puesto" value={profile.companyPosition} />

                {/* ⚠️ /api/logged-user todavía no devuelve el coach asignado */}
                <ReadOnlyField id="coach" label="Coach asignado" value={profile.coachName ?? "Sin asignar"} />
                <ReadOnlyField id="zone" label="Zona" value={profile.companyLocation} />

                <ReadOnlyField id="branch" label="Agencia"
                  value={profile.companyBranch ? toTitleCase(profile.companyBranch) : ""} />
                <ReadOnlyField id="ubication" label="Ubicación"
                  value={cashier ? ubicationLabel(profile.employeeBranchUbication) : "No aplica (solo cajeros)"} />

                <ReadOnlyField id="email" label="Correo" value={profile.email} />
                <ReadOnlyField id="status" label="Estatus">
                  <div id="status" className={`${styles.input} ${styles.readOnlyBox}`}>
                    {status
                      ? <span className={`${styles.statusPlain} ${statusClass(status)}`}>{status}</span>
                      : "—"}
                  </div>
                </ReadOnlyField>
              </>
            )}
          </div>

          <div className={`${styles.banner} ${styles.bannerWarning}`} style={{ margin: "24px 0 0" }}>
            <TriangleAlert size={18} />
            <p>
              Todos los campos de este perfil son de <strong>solo lectura</strong>. Para actualizar tu
              información, usa el botón <strong>Sincronizar perfil</strong> para sincronizar con AS400.
            </p>
          </div>
        </section>
      )}

      <ConfirmDialog
        open={syncOpen}
        icon={RefreshCw}
        title="Sincronizar mi perfil"
        message="Se actualizará tu información con los datos registrados en AS400."
        detail={
          <div className={styles.noteBox}>
            <Info size={16} />
            <p>Se usará el cajero asociado a tu usuario de red. Los cambios se verán al terminar, sin cerrar sesión.</p>
          </div>
        }
        cancelText="Cancelar"
        confirmText={syncing ? "Sincronizando..." : <><RefreshCw size={16} /> Iniciar sincronización</>}
        loading={syncing}
        error={syncError}
        onConfirm={handleSync}
        onCancel={() => setSyncOpen(false)}
      />
    </>
  );
};






