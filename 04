                                        </div>
                                    </div>
                                    <span className={`${wt.weightStatus} ${weightOk ? "" : wt.incomplete}`}>
                                        {weightOk ? <><Check size={14} /> Completo</> : totalWeight > 100 ? `Sobran ${totalWeight - 100}%` : `Falta ${100 - totalWeight}%`}
                                    </span>
                                </div>
                            </div>
                        </section>

                        <section className={base.card}>
                            <div className={base.cardHeader}>
                                <h3 className={base.cardTitle}>Fórmula de la nota final</h3>
                            </div>
                            <div className={base.cardBody}>
                                <div className={base.infoBanner}>
                                    <Info size={16} />
                                    <span>Define cómo se combinarán los criterios para obtener el resultado total. El desarrollador usará esta descripción para implementar el cálculo automático.</span>
                                </div>

                                <div className={`${base.field} ${ui.finalBlock}`}>
