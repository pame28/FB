/* =========================================================
   Indicadores: catálogos, mapeos y armado del body
   ⚠️ Todo lo marcado con "Confirmar" depende del backend.
   ========================================================= */

const toKey = (text) =>
  String(text ?? "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().replace(/[^a-z0-9]/g, "");

export const normalize = (v) =>
  String(v ?? "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();

/** Confirmar: número de cada tipo (asumido: orden de la lista, desde 0) */
export const INDICATOR_TYPES = [
  { value: 0, label: "Numérico", tone: "number" },
  { value: 1, label: "Cualitativo", tone: "quality" },
  { value: 2, label: "Operativo", tone: "ops" },
  { value: 3, label: "Actitudinal", tone: "attitude" },
  { value: 4, label: "Ventas", tone: "sales" },
];

/** Confirmar: reglas disponibles y su número */
export const RULES = [
  { value: 0, label: "Mayor es mejor" },
  { value: 1, label: "Menor es mejor" },
];

/** Confirmar: Inactivo = 0, Activo = 1 */
export const INDICATOR_STATUS = { INACTIVE: 0, ACTIVE: 1 };

const findIn = (list, raw) => {
  if (raw === null || raw === undefined || raw === "") return null;
  if (typeof raw === "number" || /^\d+$/.test(String(raw))) return list.find((x) => x.value === Number(raw)) ?? null;
  return list.find((x) => toKey(x.label) === toKey(raw)) ?? null;
};

export const findIndicatorType = (raw) => findIn(INDICATOR_TYPES, raw);
export const findRule = (raw) => findIn(RULES, raw);

export const isActiveStatus = (raw) =>
  raw === INDICATOR_STATUS.ACTIVE || raw === true || /^activ/i.test(String(raw ?? "").trim());

export const indicatorCode = (id) => `IND-${String(id ?? "").padStart(3, "0")}`;
export const templateCode = (id) => `PLT-${String(id ?? "").padStart(2, "0")}`;

export const formatDate = (raw) => {
  if (!raw) return "—";
  const d = new Date(raw);
  return Number.isNaN(d.getTime()) ? "—" : d.toLocaleDateString("es-HN", { day: "2-digit", month: "2-digit", year: "numeric" });
};

/* ---------- Catálogos de verbos y unidades ---------- */
// Confirmar: nombre del campo de texto en /api/verbs y /api/units
export const mapCatalogItem = (x) => ({
  id: x.id,
  name: x.name ?? x.description ?? x.value ?? x.verb ?? x.unit ?? "",
  symbol: x.symbol ?? x.abbreviation ?? null,
});
export const unitLabel = (u) => (u ? (u.symbol && u.symbol !== u.name ? `${u.name} (${u.symbol})` : u.name) : "");

/* ---------- Campos de la plantilla ---------- */
/**
 * Qué control se muestra para cada marcador de la plantilla.
 * Confirmar: el verbo y la unidad se identifican por el nombre del marcador.
 */
export const fieldKind = (marker) => {
  const name = normalize(marker.value);
  if (name === "verbo") return "verb";
  if (name === "unidad") return "unit";
  switch (marker.type?.tone) {
    case "number":
    case "money": return "number";
    case "date": return "date";
    case "bool": return "bool";
    default: return "text";
  }
};

const MONEY_FORMAT = { 3: (v) => `${v}%`, 4: (v) => `$${v}`, 5: (v) => `€${v}`, 6: (v) => `L ${v}` };

/** Texto que aporta un campo a la frase. Devuelve "" si está vacío. */
export const fieldText = (marker, raw, { verbs, units, unitId }) => {
  const kind = fieldKind(marker);
  if (kind === "verb") return verbs.find((v) => String(v.id) === String(raw))?.name ?? "";
  if (kind === "unit") return units.find((u) => String(u.id) === String(unitId))?.symbol
    ?? units.find((u) => String(u.id) === String(unitId))?.name ?? "";

  const value = String(raw ?? "").trim();
  if (!value) return "";
  if (kind === "bool") return value === "true" ? "Sí" : "No";
  if (kind === "date") {
    const d = new Date(`${value}T00:00:00`);
    return Number.isNaN(d.getTime()) ? value : d.toLocaleDateString("es-HN", { day: "numeric", month: "long", year: "numeric" });
  }
  const fmt = MONEY_FORMAT[marker.type?.value];
  return fmt ? fmt(value) : value;
};

/** Valida un campo y devuelve el mensaje de error o "" */
export const fieldError = (marker, raw, unitId) => {
  const kind = fieldKind(marker);
  if (kind === "unit") return unitId ? "" : "Selecciona la unidad.";
  const value = String(raw ?? "").trim();
  if (!value) return kind === "verb" ? "Selecciona el verbo." : `Completa ${marker.value}.`;
  if (kind === "number") {
    const n = Number(value.replace(",", "."));
    if (Number.isNaN(n)) return "Debe ser un número.";
    if (marker.type?.value === 9 && !Number.isInteger(n)) return "Debe ser un número entero.";
  }
  return "";
};

/* ---------- Forma de cálculo ---------- */
export const EMPTY_CALC = { unitId: "", minimumValue: "", maximumValue: "", weight: "", rule: String(RULES[0].value), formula: "" };

const toNumber = (v) => Number(String(v).replace(",", "."));

export const validateCalc = (c) => {
  const e = {};
  if (!c.unitId) e.unitId = "Selecciona la unidad.";
  if (String(c.minimumValue).trim() === "") e.minimumValue = "Ingresa el valor mínimo.";
  else if (Number.isNaN(toNumber(c.minimumValue))) e.minimumValue = "Debe ser un número.";
  if (String(c.maximumValue).trim() === "") e.maximumValue = "Ingresa el valor máximo.";
  else if (Number.isNaN(toNumber(c.maximumValue))) e.maximumValue = "Debe ser un número.";
  if (!e.minimumValue && !e.maximumValue && toNumber(c.minimumValue) > toNumber(c.maximumValue)) {
    e.maximumValue = "El valor máximo debe ser mayor o igual al mínimo.";
  }
  if (String(c.weight).trim() !== "") {
    const w = toNumber(c.weight);
    if (Number.isNaN(w) || w < 0 || w > 100) e.weight = "Debe estar entre 0 y 100.";
  }
  if (c.rule === "") e.rule = "Selecciona la regla.";
  return e;
};

/* ---------- API → formulario ---------- */
export const mapIndicator = (x) => ({
  id: x.id,
  code: x.code ?? indicatorCode(x.id),
  name: x.name ?? "",
  type: findIndicatorType(x.type ?? x.indicatorType),
  active: isActiveStatus(x.status),
  templateId: x.templateId ?? x.template?.id ?? null,
  updatedAt: x.updatedAt ?? x.modifiedAt ?? x.lastModified ?? x.modifiedDate ?? x.updatedDate ?? x.createdAt ?? null,
  // Confirmar: campo que indica si una regla de negocio impide editarlo
  editable: x.canEdit ?? x.isEditable ?? x.editable ?? true,
  raw: x,
});

/** Detalle de GET /api/indicators/{id} → estado del formulario */
export const toFormState = (x, templateMarkers) => {
  const assignments = x.markerAssignments ?? x.markers ?? [];
  const byPos = new Map(assignments.map((a) => [a.position, a]));
  const values = {};
  templateMarkers.forEach((m) => {
    const a = byPos.get(m.position);
    if (!a) return;
    const kind = fieldKind(m);
    if (kind === "verb") values[m.position] = a.verbId != null ? String(a.verbId) : "";
    else if (kind !== "unit") values[m.position] = a.value ?? "";
  });
  const unitId = x.unitId ?? assignments.find((a) => a.unitId != null)?.unitId;
  return {
    type: findIndicatorType(x.type)?.value ?? "",
    templateId: x.templateId ?? x.template?.id ?? "",
    status: isActiveStatus(x.status) ? INDICATOR_STATUS.ACTIVE : INDICATOR_STATUS.INACTIVE,
    periodId: x.periodId ?? null,
    values,
    calc: {
      unitId: unitId != null ? String(unitId) : "",
      minimumValue: x.minimumValue ?? "",
      maximumValue: x.maximumValue ?? "",
      weight: x.weight ?? "",
      rule: String(findRule(x.rule)?.value ?? RULES[0].value),
      formula: x.formula ?? "",
    },
  };
};

/* ---------- Formulario → API ---------- */
/**
 * Confirmar: la unidad de la forma de cálculo se envía como unitId en cada asignación,
 * porque el body no tiene unitId a nivel del indicador.
 */
export const buildIndicatorBody = ({ name, type, templateId, status, periodId, values, calc, markers, verbs, units }) => ({
  name,
  minimumValue: toNumber(calc.minimumValue),
  maximumValue: toNumber(calc.maximumValue),
  periodId: periodId ?? null,
  formula: calc.formula.trim(),
  weight: String(calc.weight).trim() === "" ? 0 : toNumber(calc.weight),
  type: Number(type),
  rule: Number(calc.rule),
  status,
  templateId: Number(templateId),
  markerAssignments: markers.map((m) => {
    const kind = fieldKind(m);
    return {
      position: m.position,
      verbId: kind === "verb" ? Number(values[m.position]) : null,
      unitId: calc.unitId ? Number(calc.unitId) : null,
      value: fieldText(m, values[m.position], { verbs, units, unitId: calc.unitId }),
    };
  }),
});












