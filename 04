                using (SqlCommand cmd = new SqlCommand(parametros["RegistroProceso"], conn))
                {
                    cmd.CommandType = CommandType.StoredProcedure;
                    cmd.CommandTimeout = TimeoutSegundos;
                    cmd.Parameters.Add("@Proceso", SqlDbType.VarChar).Value = "EPosicionDiaria";
                    cmd.Parameters.Add("@EstadoProceso", SqlDbType.VarChar).Value = estadoProceso;
                    cmd.Parameters.Add("@Mensaje", SqlDbType.VarChar).Value = mensaje;
                    cmd.ExecuteNonQuery();
                }
