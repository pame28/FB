.teamName {
  margin: 14px 0 6px;
  font-size: 18px;
  font-weight: 800;
  letter-spacing: -0.01em;
  color: var(--bp-blue-expert);
}

/* Doble clase para que gane sobre .sectionHead sin importar el orden del archivo */
.sectionHead.leadersHead { margin: 0 0 8px; }







/* Se ve 1 líder; con 2 o más aparece la barra de desplazamiento */
.leaderList {
  --leader-row: 54px;
  max-height: var(--leader-row);
  overflow-y: auto;
  scrollbar-width: thin;
  scrollbar-color: #c3ccd9 transparent;
}
.leaderList > * {
  min-height: var(--leader-row);
  margin: 0;
  padding: 0;
}
.leaderList > * + * { border-top: 1px solid #e6ebf1; }