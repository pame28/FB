import { apiFeedbackAuthorized } from "./APIS";
import { endpointsAPI } from "./endpointApi";

const base = endpointsAPI.templates;

// Acepta las formas más comunes de respuesta paginada
const toPage = (result) => {
  if (Array.isArray(result)) return { items: result, total: result.length };
  const items = result?.items ?? result?.data ?? result?.records ?? result?.results ?? [];
  const total = result?.totalCount ?? result?.totalRecords ?? result?.totalItems ?? result?.total ?? items.length;
  return { items, total };
};

export const templatesService = {
  // body: { example, status, pageNumber, pageSize }  (null = sin filtro)
  filter: async (body) => {
    const { data } = await apiFeedbackAuthorized.post(`${base}/filter`, body);
    return toPage(data.data);
  },

  getById: async (id) => {
    const { data } = await apiFeedbackAuthorized.get(`${base}/${id}`);
    return data.data;
  },

  // body: { example, status, markers: [{ markerId, position }] }
  create: async (body) => {
    const { data } = await apiFeedbackAuthorized.post(base, body);
    return data.data;
  },

  update: async (id, body) => {
    const { data } = await apiFeedbackAuthorized.put(`${base}/${id}`, body);
    return data.data;
  },

  remove: async (id) => {
    await apiFeedbackAuthorized.delete(`${base}/${id}`);
  },

  activate: async (id) => {
    await apiFeedbackAuthorized.put(`${base}/${id}/activate`);
  },

  // Así está escrito en el backend: "desactivate"
  deactivate: async (id) => {
    await apiFeedbackAuthorized.put(`${base}/${id}/desactivate`);
  },
};














const TONE_CLASS = {
  text: m.toneText,
  number: m.toneNumber,
  money: m.toneMoney,
  date: m.toneDate,
  bool: m.toneBool,
};

/** Clase de color según el tipo de valor (mismos tonos que en Marcadores) */
export const toneClassOf = (type) => (type ? TONE_CLASS[type.tone] ?? m.toneNeutral : m.toneNeutral);













import { findMarkerType } from "../markers/markerTypes";

/** ⚠️ Confirmar con backend: se asume Inactiva = 0, Activa = 1 */
export const TEMPLATE_STATUS = { INACTIVE: 0, ACTIVE: 1 };

// La API devuelve "Activa" / "Inactiva" en el GET y espera número en el POST
export const isActiveStatus = (raw) =>
  raw === TEMPLATE_STATUS.ACTIVE || raw === true || /^activ/i.test(String(raw ?? "").trim());

export const mapTemplate = (t) => ({
  id: t.id,
  example: t.example ?? "",
  active: isActiveStatus(t.status),
  markers: [...(t.markers ?? [])]
    .sort((a, b) => (a.position ?? 0) - (b.position ?? 0))
    .map((x) => ({
      markerId: x.markerId,
      position: x.position,
      value: x.value ?? "",
      type: findMarkerType(x.valueType),
    })),
});

/** items: marcadores en el orden en que quedaron en el constructor */
export const buildTemplateBody = ({ example, active, items }) => ({
  example: example.trim(),
  status: active ? TEMPLATE_STATUS.ACTIVE : TEMPLATE_STATUS.INACTIVE,
  markers: items.map((it, i) => ({ markerId: it.markerId, position: i + 1 })),
});

// Compara textos sin tildes, mayúsculas ni espacios extra
export const normalize = (v) =>
  String(v ?? "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();












