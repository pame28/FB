    const [teams, setTeams] = useState([]);

    useEffect(() => {
        Promise.all([certificationService.mine(), certificationService.myTeams()])
            .then(([certs, teams]) => {
                setCertifications(certs.map(mapCertification));
                setTeams(teams);
            })
            .catch((error) => toast.error(error.noAccess ? "No tienes permiso para ver el historial." : "No se pudo cargar el historial de certificaciones."));
