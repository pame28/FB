using ApiCoaching.Services.Interfaces;
using System.IO.Compression;
using System.Reflection;
using System.Xml.Linq;

namespace ApiCoaching.Services
{
    public class ExcelExportService : IExcelExportService
    {
        private static readonly string XmlSegment = "http://schemas.openxmlformats.org/spreadsheetml/2006/main";

        public byte[] ConvertListToExcel<T>(IEnumerable<T> items, IReadOnlyDictionary<string, string>? columnMappings = null, string sheetName = "Sheet1")
        {
            var rows = BuildRows(items);
            var properties = rows.Count > 0 ? rows[0].Keys.ToList() : [];

            using var stream = new MemoryStream();
            using (var archive = new ZipArchive(stream, ZipArchiveMode.Create, leaveOpen: true))
            {
                WriteContentTypes(archive);
                WriteRels(archive);
                WriteWorkbook(archive, sheetName);
                WriteWorkbookRels(archive);
                WriteWorksheet(archive, rows, properties, columnMappings);
            }

            return stream.ToArray();
        }

        private static List<Dictionary<string, string>> BuildRows<T>(IEnumerable<T> items)
        {
            var rows = new List<Dictionary<string, string>>();

            if (items is null)
            {
                return rows;
            }

            var properties = typeof(T)
                .GetProperties(BindingFlags.Instance | BindingFlags.Public)
                .Where(p => p.CanRead)
                .ToArray();

            foreach (var item in items)
            {
                var row = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

                foreach (var property in properties)
                {
                    var value = property.GetValue(item);
                    row[property.Name] = value?.ToString() ?? string.Empty;
                }

                rows.Add(row);
            }

            return rows;
        }

        private static void WriteContentTypes(ZipArchive archive)
        {
            var entry = archive.CreateEntry("[Content_Types].xml");
            using var writer = new StreamWriter(entry.Open());
            writer.Write("""
                        <?xml version="1.0" encoding="UTF-8" standalone="yes"?>
                        <Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">
                          <Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>
                          <Default Extension="xml" ContentType="application/xml"/>
                          <Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/>
                          <Override PartName="/xl/worksheets/sheet1.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>
                        </Types>
                        """);
        }

        private static void WriteRels(ZipArchive archive)
        {
            var entry = archive.CreateEntry("_rels/.rels");
            using var writer = new StreamWriter(entry.Open());
            writer.Write("""
                        <?xml version="1.0" encoding="UTF-8" standalone="yes"?>
                        <Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">
                          <Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/>
                        </Relationships>
                        """);
        }

        private static void WriteWorkbook(ZipArchive archive, string sheetName)
        {
            var safeSheetName = string.IsNullOrWhiteSpace(sheetName) ? "Sheet1" : sheetName;
            var entry = archive.CreateEntry("xl/workbook.xml");
            using var writer = new StreamWriter(entry.Open());
            writer.Write($"""
                        <?xml version="1.0" encoding="UTF-8" standalone="yes"?>
                        <workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships">
                          <sheets>
                            <sheet name="{safeSheetName}" sheetId="1" r:id="rId1"/>
                          </sheets>
                        </workbook>
                        """);
        }

        private static void WriteWorkbookRels(ZipArchive archive)
        {
            var entry = archive.CreateEntry("xl/_rels/workbook.xml.rels");
            using var writer = new StreamWriter(entry.Open());
            writer.Write("""
                        <?xml version="1.0" encoding="UTF-8" standalone="yes"?>
                        <Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">
                          <Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet1.xml"/>
                        </Relationships>
                        """);
        }

        private static void WriteWorksheet(
            ZipArchive archive,
            List<Dictionary<string, string>> rows,
            List<string> properties,
            IReadOnlyDictionary<string, string>? columnMappings)
        {
            var entry = archive.CreateEntry("xl/worksheets/sheet1.xml");
            using var writer = new StreamWriter(entry.Open());

            var dimensionRef = properties.Count == 0
                ? "A1"
                : $"A1:{ColumnName(properties.Count)}{rows.Count + 1}";

            var xml = new XDocument(
                new XDeclaration("1.0", "UTF-8", "yes"),
                new XElement(XName.Get("worksheet", XmlSegment),
                    new XAttribute(XNamespace.Xmlns + "r", "http://schemas.openxmlformats.org/officeDocument/2006/relationships"),
                    new XElement(XName.Get("dimension", XmlSegment), new XAttribute("ref", dimensionRef)),
                    new XElement(XName.Get("sheetViews", XmlSegment),
                        new XElement(XName.Get("sheetView", XmlSegment),
                            new XAttribute("workbookViewId", 0))),
                    new XElement(XName.Get("sheetFormatPr", XmlSegment), new XAttribute("defaultRowHeight", 15)),
                    new XElement(XName.Get("sheetData", XmlSegment),
                        CreateHeaderRow(properties, columnMappings),
                        CreateDataRows(rows, properties))));

            xml.Save(writer);
        }

        private static XElement CreateHeaderRow(List<string> properties, IReadOnlyDictionary<string, string>? columnMappings)
        {
            var ns = XName.Get("row", XmlSegment);
            var cellName = XName.Get("c", XmlSegment);
            var inlineStringName = XName.Get("is", XmlSegment);
            var textName = XName.Get("t", XmlSegment);

            var row = new XElement(ns, new XAttribute("r", 1));

            for (var index = 0; index < properties.Count; index++)
            {
                var propertyName = properties[index];
                var header = columnMappings != null && columnMappings.TryGetValue(propertyName, out var mappedName)
                    ? mappedName
                    : propertyName;

                row.Add(new XElement(cellName,
                    new XAttribute("r", $"{ColumnName(index + 1)}1"),
                    new XAttribute("t", "inlineStr"),
                    new XElement(inlineStringName,
                        new XElement(textName, header))));
            }

            return row;
        }

        private static IEnumerable<XElement> CreateDataRows(List<Dictionary<string, string>> rows, List<string> properties)
        {
            var rowName = XName.Get("row", XmlSegment);
            var cellName = XName.Get("c", XmlSegment);
            var inlineStringName = XName.Get("is", XmlSegment);
            var textName = XName.Get("t", XmlSegment);

            for (var rowIndex = 0; rowIndex < rows.Count; rowIndex++)
            {
                var row = new XElement(rowName, new XAttribute("r", rowIndex + 2));
                var data = rows[rowIndex];

                for (var columnIndex = 0; columnIndex < properties.Count; columnIndex++)
                {
                    var propertyName = properties[columnIndex];
                    data.TryGetValue(propertyName, out var value);

                    row.Add(new XElement(cellName,
                        new XAttribute("r", $"{ColumnName(columnIndex + 1)}{rowIndex + 2}"),
                        new XAttribute("t", "inlineStr"),
                        new XElement(inlineStringName,
                            new XElement(textName, value ?? string.Empty))));
                }

                yield return row;
            }
        }

        private static string ColumnName(int index)
        {
            var dividend = index;
            var columnName = string.Empty;

            var stringBuilder = new System.Text.StringBuilder();
            while (dividend > 0)
            {
                var modulo = (dividend - 1) % 26;
                stringBuilder.Append(Convert.ToChar('A' + modulo) + columnName);
                dividend = (dividend - modulo) / 26;
            }

            return stringBuilder.ToString();
        }

    }
}




