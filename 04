		private bool ObtieneParametros()
		{
			ConnectionManager cm = Dts.Connections["DESCARGAINFO"];
			SqlConnection conn = null;

			try
			{
				conn = Adquirir<SqlConnection>(cm);

				using (SqlCommand cmd = new SqlCommand("usp_GetParametersByProcess", conn))
				{
					cmd.CommandType = CommandType.StoredProcedure;
					cmd.CommandTimeout = 120;
					cmd.Parameters.Add(new SqlParameter("@Proceso", NombreProceso));

					using (SqlDataReader reader = cmd.ExecuteReader())
					{
						while (reader.Read())
						{
							string idParametro = reader["IdParametro"].ToString();
							string valorParametro = reader["ValorParametro"].ToString();

							if (!parametros.ContainsKey(idParametro))
								parametros.Add(idParametro, valorParametro);
						}
					}
				}

				return true;
			}
			catch (Exception ex)
			{
				ErrorLog("Fallo obtener informacion desde usp_GetParametersByProcess", ex);
				return false;
			}
			finally
			{
				if (conn != null)
					cm.ReleaseConnection(conn);
			}
		}

		private bool ValidarParametros()
		{
			string[] requeridos =
			{
				"FechaProceso", "EstadoInicial", "EstadoFinal", "ArchivoControl", "ArchivoGenerado",
				"ArchiviOrigen", 
                "ConsultaEstado", "ConsultaOrigen", "ConsultaActualizar", "Usuario",
				"PreParseo", "PostParseo", "NombreArchivo", "ArchivoDestino","SegundosTimeoutSql"
				,"SegundosTimeoutAs400"
				,"TamanoLote"
				,"LogCadaFilas"
				,"LogDetallado"
				,"BulkTableLock"
			};

			List<string> faltantes = new List<string>();
			foreach (string clave in requeridos)
			{
				string valor;
				if (!parametros.TryGetValue(clave, out valor) || string.IsNullOrWhiteSpace(valor))
					faltantes.Add(clave);
			}

			if (faltantes.Count > 0)
			{
				Log(LogError, "Faltan parametros requeridos: " + string.Join(", ", faltantes));
				return false;
			}

			string sp;
			if (!parametros.TryGetValue("RegistroProceso", out sp) || string.IsNullOrWhiteSpace(sp))
				Dts.Events.FireWarning(0, NombreProceso, "Parametro RegistroProceso no definido: no se registrara en la BD.", "", 0);

			return true;
		}

		private void CargarConfiguracion()
		{
			_timeoutSql = ParamInt("SegundosTimeoutSql", 1800);
			_timeoutAs400 = ParamInt("SegundosTimeoutAs400", 1800);
			_tamanoLote = Math.Max(1, ParamInt("TamanoLote", 10000));
			_logCadaFilas = Math.Max(1, ParamInt("LogCadaFilas", 50000));
			_logDetallado = ParamBool("LogDetallado", true);
			_bulkTableLock = ParamBool("BulkTableLock", false);
			_larId = ParamInt("LarId", LarIdPorDefecto);
		}

		private int ParamInt(string clave, int porDefecto)
		{
			string texto;
			int valor;
			if (parametros.TryGetValue(clave, out texto) && int.TryParse(texto, out valor) && valor >= 0)
				return valor;
			return porDefecto;
		}

		private bool ParamBool(string clave, bool porDefecto)
		{
			string texto;
			if (!parametros.TryGetValue(clave, out texto) || string.IsNullOrWhiteSpace(texto))
				return porDefecto;

			texto = texto.Trim();
			return texto == "1" || texto.Equals("true", StringComparison.OrdinalIgnoreCase) || texto.Equals("S", StringComparison.OrdinalIgnoreCase);
		}

