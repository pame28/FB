import { useEffect, useState } from "react";
import { AlertCircle, ArrowLeftRight, Loader2 } from "lucide-react";
import { Modal } from "../../../../shared/components";
import { teamsService } from "../../../../api/teamsService";
import { MOVE_REASONS, initials, todayISO } from "./teamUtils";
import pages from "../../../Pages.module.css";
import t from "./Teams.module.css";

const FORM_ID = "move-member-form";
const EMPTY = () => ({ targetTeamId: "", reason: "", effectiveDate: todayISO() });

/** move = { team, member } */
export function MoveMemberModal({ move, teams, onClose, onSaved }) {
  const [values, setValues] = useState(EMPTY);
  const [errors, setErrors] = useState({});
  const [saving, setSaving] = useState(false);
  const [submitError, setSubmitError] = useState("");

  useEffect(() => {
    if (move) {
      setValues(EMPTY());
      setErrors({});
      setSubmitError("");
    }
  }, [move]);

  const targets = move
    ? teams.filter((tm) => tm.areaId === move.team.areaId && tm.id !== move.team.id)
    : [];

  const handleChange = (e) => {
    const { name, value } = e.target;
    setValues((v) => ({ ...v, [name]: value }));
    setErrors((er) => ({ ...er, [name]: undefined }));
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    const found = {};
    if (!values.targetTeamId) found.targetTeamId = "Selecciona el equipo destino.";
    if (!values.reason) found.reason = "Selecciona el motivo del traslado.";
    if (!values.effectiveDate) found.effectiveDate = "Selecciona la fecha efectiva.";
    setErrors(found);
    if (Object.keys(found).length > 0) return;

    setSaving(true);
    setSubmitError("");
    try {
      await teamsService.transferMember({
        sourceTeamId: move.team.id,
        targetTeamId: Number(values.targetTeamId),
        memberUserId: move.member.id,
        reason: values.reason,
        effectiveDate: values.effectiveDate,
      });
      onSaved();
    } catch (err) {
      setSubmitError(err.noAccess
        ? "No tienes permiso para trasladar miembros."
        : err.response?.data?.message ?? "No se pudo trasladar al miembro. Intenta de nuevo.");
    } finally {
      setSaving(false);
    }
  };

  const handleClose = () => { if (!saving) onClose(); };

  return (
    <Modal
      open={Boolean(move)}
      size="sm"
      title="Mover a otro equipo"
      onClose={handleClose}
      footer={
        <>
          <button type="button" className={`${pages.btn} ${pages.btnOutline}`} onClick={handleClose} disabled={saving}>Cancelar</button>
          <button type="submit" form={FORM_ID} className={`${pages.btn} ${pages.btnPrimary}`}
            disabled={saving || targets.length === 0}>
            {saving ? <Loader2 size={16} className={pages.spin} /> : <ArrowLeftRight size={16} />}
            {saving ? "Trasladando..." : "Confirmar traslado"}
          </button>
        </>
      }
    >
      {move && (
        <form id={FORM_ID} className={pages.form} style={{ gridTemplateColumns: "1fr" }} onSubmit={handleSubmit} noValidate>
          <div className={t.chipBox}>
            <span className={t.avatar}>{initials(move.member.name)}</span>
            <span className={t.personText}>
              <span className={t.personName}>{move.member.name}</span>
              <span className={t.personSub}>Equipo actual: {move.team.name}</span>
            </span>
          </div>

          {submitError && (
            <div className={`${pages.banner} ${pages.bannerError}`} role="alert" style={{ marginBottom: 0 }}>
              <AlertCircle size={18} />
              <p>{submitError}</p>
            </div>
          )}

          <div className={pages.field}>
            <label className={pages.label} htmlFor="move-target">
              Equipo destino<span className={pages.required}>*</span>
            </label>
            <select id="move-target" name="targetTeamId"
              className={`${pages.select} ${errors.targetTeamId ? pages.invalid : ""}`}
              value={values.targetTeamId} onChange={handleChange} disabled={targets.length === 0}>
              <option value="">{targets.length ? "— Selecciona el equipo destino —" : "No hay otros equipos en esta área"}</option>
              {targets.map((tm) => <option key={tm.id} value={tm.id}>{tm.name}</option>)}
            </select>
            {errors.targetTeamId
              ? <span className={pages.fieldError}>{errors.targetTeamId}</span>
              : <span className={pages.hint}>Solo se muestran equipos de la misma área.</span>}
          </div>

          <div className={pages.field}>
            <label className={pages.label} htmlFor="move-reason">
              Motivo<span className={pages.required}>*</span>
            </label>
            <select id="move-reason" name="reason"
              className={`${pages.select} ${errors.reason ? pages.invalid : ""}`}
              value={values.reason} onChange={handleChange}>
              <option value="">— Selecciona el motivo —</option>
              {MOVE_REASONS.map((r) => <option key={r} value={r}>{r}</option>)}
            </select>
            {errors.reason && <span className={pages.fieldError}>{errors.reason}</span>}
          </div>

          <div className={pages.field}>
            <label className={pages.label} htmlFor="move-date">
              Fecha efectiva<span className={pages.required}>*</span>
            </label>
            <input id="move-date" name="effectiveDate" type="date"
              className={`${pages.input} ${errors.effectiveDate ? pages.invalid : ""}`}
              value={values.effectiveDate} onChange={handleChange} />
            {errors.effectiveDate && <span className={pages.fieldError}>{errors.effectiveDate}</span>}
          </div>
        </form>
      )}
    </Modal>
  );
}












import { useEffect, useState } from "react";
import { AlertCircle, Loader2, TriangleAlert, UserMinus } from "lucide-react";
import { Modal } from "../../../../shared/components";
import { teamsService } from "../../../../api/teamsService";
import { initials } from "./teamUtils";
import pages from "../../../Pages.module.css";
import t from "./Teams.module.css";

const FORM_ID = "remove-member-form";

/** removal = { team, member } */
export function RemoveMemberModal({ removal, onClose, onSaved }) {
  const [reason, setReason] = useState("");
  const [error, setError] = useState("");
  const [saving, setSaving] = useState(false);
  const [submitError, setSubmitError] = useState("");

  useEffect(() => {
    if (removal) {
      setReason("");
      setError("");
      setSubmitError("");
    }
  }, [removal]);

  const handleSubmit = async (e) => {
    e.preventDefault();
    if (!reason.trim()) return setError("El motivo es obligatorio para remover al miembro.");

    setSaving(true);
    setSubmitError("");
    try {
      await teamsService.removeMember(removal.team.id, removal.member.id, reason.trim());
      onSaved();
    } catch (err) {
      setSubmitError(err.noAccess
        ? "No tienes permiso para remover miembros."
        : err.response?.data?.message ?? "No se pudo remover al miembro. Intenta de nuevo.");
    } finally {
      setSaving(false);
    }
  };

  const handleClose = () => { if (!saving) onClose(); };

  return (
    <Modal
      open={Boolean(removal)}
      size="sm"
      title="Remover del equipo"
      onClose={handleClose}
      footer={
        <>
          <button type="button" className={`${pages.btn} ${pages.btnOutline}`} onClick={handleClose} disabled={saving}>Cancelar</button>
          <button type="submit" form={FORM_ID} className={`${pages.btn} ${t.btnDanger}`} disabled={saving}>
            {saving ? <Loader2 size={16} className={pages.spin} /> : <UserMinus size={16} />}
            {saving ? "Removiendo..." : "Confirmar remoción"}
          </button>
        </>
      }
    >
      {removal && (
        <form id={FORM_ID} className={pages.form} style={{ gridTemplateColumns: "1fr" }} onSubmit={handleSubmit} noValidate>
          <div className={t.chipBox}>
            <span className={t.avatar}>{initials(removal.member.name)}</span>
            <span className={t.personText}>
              <span className={t.personName}>{removal.member.name}</span>
              <span className={t.personSub}>Equipo: {removal.team.name}</span>
            </span>
          </div>

          <div className={t.warnBox} style={{ marginBottom: 0 }}>
            <TriangleAlert size={16} />
            <p>El miembro quedará sin equipo asignado, pero no se eliminará del sistema.</p>
          </div>

          {submitError && (
            <div className={`${pages.banner} ${pages.bannerError}`} role="alert" style={{ marginBottom: 0 }}>
              <AlertCircle size={18} />
              <p>{submitError}</p>
            </div>
          )}

          <div className={pages.field}>
            <label className={pages.label} htmlFor="remove-reason">
              Motivo<span className={pages.required}>*</span>
            </label>
            <textarea id="remove-reason" className={`${pages.input} ${t.textarea} ${error ? pages.invalid : ""}`}
              placeholder="Describe el motivo de la remoción..." value={reason} maxLength={300} autoFocus
              onChange={(e) => { setReason(e.target.value); setError(""); }} aria-invalid={!!error} />
            {error && <span className={pages.fieldError}>{error}</span>}
          </div>
        </form>
      )}
    </Modal>
  );
}











