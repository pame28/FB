      <h3 className={t.teamName}>{team.name}</h3>

      {/* Líderes: etiqueta a la izquierda, botón a la derecha (igual que Miembros) */}
      <div className={`${t.sectionHead} ${t.leadersHead}`}>
        <span className={t.sectionLabel}>Líderes ({team.leaders.length})</span>
        <button type="button" className={`${t.cardBtn} ${t.cardBtnOutline}`} onClick={() => onChangeLeaders(team)}>
          <UserCog size={14} />
          {team.leaders.length ? "Cambiar líder" : "Asignar líder"}
        </button>
      </div>






