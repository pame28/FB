        public MensajeCuotificarCompraResult BXIRealizaCuotificacion(
        string strTarjeta
        , string strNoComprabante
        , int iCantidadCuotas
        , double dCuotaMensual
        , double dTasaAplicadaIntra
        , double dImporteTotal
            , string strMoneda)
        {
            AppLogger.Info($"Solicitud de Financiamiento: Tarjeta: {strTarjeta}; ReferenciaNo: {strNoComprabante}");
            DataSet dsResult = new DataSet();
            MensajeCuotificarCompraResult validatedData = new MensajeCuotificarCompraResult();

            //0. Verificar si es una transaccion de Rubro adecuado
            validatedData = verifyTransactionMCC(strTarjeta, strNoComprabante);
            if (validatedData != null)
                return validatedData;

            dsResult = this.RealizaCuotificacion(strTarjeta, strNoComprabante, dImporteTotal, iCantidadCuotas, strMoneda);

            MensajeCuotificarCompraResult Datos = new MensajeCuotificarCompraResult();

            if (dsResult.Tables.Count > 0)
            {
                string responseCode = dsResult.Tables[0].Rows[0]["ResponseCode"].ToString();
                string responseMessage = getResponseMessage(responseCode);

                MensajeCuotificarCompra Detalle = new MensajeCuotificarCompra();
                DataRow[] drFoundRow;
                drFoundRow = dsResult.Tables[0].Select($"ResponseCode = '00'");

                if (drFoundRow.Length > 0)
                {
                    Detalle.CodeResponse = responseCode;
                    Detalle.ResponseMessage = responseMessage;
                    Detalle.NumeroReferencia = drFoundRow[0]["ReferenceNumber"].ToString();
                    Detalle.NoTarjeta = strTarjeta;
                    Detalle.CUT = strNoComprabante;
                    Detalle.CantidadCuotas = iCantidadCuotas.ToString();
                    Detalle.Campania = "00";//Reemplazar
                    Detalle.Modelo = "0";//Reemplazar
                    Detalle.TasaAplicada = dTasaAplicadaIntra.ToString();
                    Detalle.ValorCuota = dCuotaMensual.ToString();
                    Detalle.LimiteAfectado = 0;//Reemplazar
                    Datos.add(Detalle);
                }
                else
                {
                    DataRow[] drRows;
                    drRows = dsResult.Tables[0].Select($"ResponseCode <> '00'");
                    if (drRows.Length > 0)
                    {
                        Detalle.CodeResponse = responseCode;
                        Detalle.ResponseMessage = responseMessage;
                        Detalle.NumeroReferencia = "0";
                        Detalle.NoTarjeta = strTarjeta;
                        Detalle.CUT = strNoComprabante;
                        Detalle.CantidadCuotas = "0";
                        Detalle.Campania = "00";
                        Detalle.Modelo = "0";
                        Detalle.TasaAplicada = "0";
                        Detalle.ValorCuota = "0";
                        Detalle.LimiteAfectado = 0;
                        Datos.add(Detalle);
                    }
                }
                //}
            }

            return Datos;
        }

        private MensajeCuotificarCompraResult verifyTransactionMCC(string strTarjeta, string strNoComprabante)
        {
            AppLogger.Debug($"Verificando MCC de Transaccion {strNoComprabante}");
            DataSet dsTrxWithMCC = new DataSet();
            SQL dllSQL = new SQL(this.strConexion);
            string codeResponse = "03";
            MensajeCuotificarCompraResult mensajeCompra = new MensajeCuotificarCompraResult();

            dsTrxWithMCC = dllSQL.sp_Select("usp_DTVerifyTransactionMCC"
                , new SqlParameter("@Equivalente", strTarjeta)
                , new SqlParameter("@nCUT", strNoComprabante));

            if (dsTrxWithMCC.Tables[0].Rows.Count <= 0)
            {
                AppLogger.Debug("Transaccion con Rubro no Permitido");
                MensajeCuotificarCompra dato = new MensajeCuotificarCompra();
                dato.CodeResponse = codeResponse;
                dato.ResponseMessage = getResponseMessage(codeResponse);
                dato.NumeroReferencia = "0";
                dato.NoTarjeta = strTarjeta;
                dato.CUT = strNoComprabante;
                dato.CantidadCuotas = "0";
                dato.Campania = "00";
                dato.Modelo = "0";
                dato.TasaAplicada = "0";
                dato.ValorCuota = "0";
                dato.LimiteAfectado = 0;

                mensajeCompra.add(dato);
                return mensajeCompra;
            }
            else
                return null;
        }

        private string getResponseMessage(string responseCode)
        {
            DataSet dsResult = new DataSet();
            try
            {
                SQL sql = new SQL(this.strConexion);

                dsResult = sql.sp_Select("usp_DTGetResponseMessage"
                    , new SqlParameter("@strCodigoRespuesta", responseCode));

                if (dsResult.Tables.Count > 0)
                {
                    string messageResponse = dsResult.Tables[0].Rows[0]["MensajeRespuesta"].ToString();
                    string responseDesc = dsResult.Tables[0].Rows[0]["DescripcionRespuesta"].ToString();
                    AppLogger.Info($"CodeResponse {responseCode}; ResponseDescription: {responseDesc}; MensajeRespuesta: {messageResponse}");
                    return messageResponse;
                }
                else
                {
                    AppLogger.Error($"No se pudo obtener Mensaje de respuesta para CodeResponse {responseCode}");
                    return string.Empty;
                }

            }
            catch (Exception ex)
            {
                AppLogger.Error($"Error al obtener Mensaje de respuesta para CodeResponse {responseCode}; Error: {ex.Message.ToString()}");
                return string.Empty;
            }
        }

