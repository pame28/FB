-- =============================================
ALTER PROCEDURE [dbo].[usp_CR_PROC_DEUDORES]
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;
	
	DECLARE @ID NUMERIC(18 ,0)
	DECLARE @Correlativo NUMERIC(4 ,0)
	DECLARE @IdentidadTemplate VARCHAR(9)
	
	
	--Limpiamos tabla de deudores
	TRUNCATE TABLE DEUDORES
	
	--Limpiamos tabla temporal
	TRUNCATE TABLE TMPDeudores
	
	INSERT INTO TMPDeudores
	SELECT *
	FROM   uvw_DEUDORES_PTM udp
	ORDER BY
	       udp.CLDOC ASC
	
	SELECT @ID = MIN(tp.ID)
	FROM   TMPDeudores tp
	
	SET @Correlativo = 1000
	SET @IdentidadTemplate = '111100000'
	DECLARE @CifCliente DECIMAL(18 ,0)
	DECLARE @deuTipoID CHAR(2)
	DECLARE @deuID CHAR(20)
	DECLARE @deuNombre CHAR(60)
	DECLARE @deuTipoPer CHAR(2)
	DECLARE @deuPersRela CHAR(1)
	DECLARE @deuTipoObli CHAR(1)
	DECLARE @deuCatCM CHAR(5)
	DECLARE @deuCatCs CHAR(5)
	DECLARE @deuCatVv CHAR(5)
	DECLARE @deuTotDeuda MONEY
	DECLARE @deuTipoDeu CHAR(1)
	DECLARE @deuCatMin CHAR(5)
	DECLARE @deuCatMax CHAR(5)
	DECLARE @deuGrupEco CHAR(5)
	DECLARE @deuSexo CHAR(1)
	DECLARE @deuPaisDomi CHAR(2)
	DECLARE @deuCIIU CHAR(4)
	DECLARE @deuPaisIdentificacion CHAR(2)
	DECLARE @deuFecNaci CHAR(8)
	DECLARE @CLTIPE AS CHAR(1)
	DECLARE @CLISEX AS CHAR(1)
	DECLARE @CLDOC AS NUMERIC(18 ,2)	
	DECLARE @TIPOSOC AS NUMERIC(3)
	DECLARE @CLGRECO AS CHAR(5)
	DECLARE @CLCTGR AS NUMERIC(3 ,0)
	DECLARE @CLTID AS CHAR(1)
	DECLARE @CLINO1 AS VARCHAR(15)
	DECLARE @CLINO2 AS VARCHAR(15)
	DECLARE @CLIAP1 AS VARCHAR(15)
	DECLARE @CLIAP2 AS VARCHAR(15)
	DECLARE @CLNOMB AS VARCHAR(60)
	
	WHILE (@ID IS NOT NULL)
	BEGIN
	    --PRINT 'Procesando: ID = ' + CAST(@ID AS VARCHAR) + ', CIF = ' + CAST(@CLDOC AS VARCHAR) 
	    
	    SELECT @CifCliente = d.CLDOC
	          ,@deuTipoID                 = ''
	          ,@deuID                     = d.CLNUID
	          ,@CLNOMB                    = d.CLNOMB
	          ,@deuTipoPer                = ''
	          ,@deuPersRela               = ''
	          ,@deuTipoObli               = ''
	          ,@deuCatCM                  = ''
	          ,@deuCatCs                  = ''
	          ,@deuCatVv                  = ''
	          ,@deuTotDeuda               = 0
	          ,@deuTipoDeu                = ''
	          ,@deuCatMin                 = ''
	          ,@deuCatMax                 = ''
	          ,@deuGrupEco                = d.CLGRECO
	          ,@deuSexo                   = d.CLISEX
	          ,@deuPaisDomi               = d.PaisOrigen
	          ,@deuFecNaci                = d.FECHA_NAC
	          ,@deuPaisIdentificacion     = 'HN'
	          ,@deuCIIU                   = ''
	          ,@CLTIPE                    = d.CLTIPE
	          ,@CLDOC                     = d.CLDOC
	          ,@CLISEX                    = d.CLISEX
	          ,@TIPOSOC                   = d.TIPOSOC
	          ,@CLCTGR                    = d.CLCTGR
	          ,@CLGRECO                   = d.CLGRECO
	          ,@CLTID                     = d.CLTID
	          ,@CLINO1                    = d.CLINO1
	          ,@CLINO2                    = d.CLINO2
	          ,@CLIAP1                    = d.CLIAP1
	          ,@CLIAP2                    = d.CLIAP2
	          ,@deuCIIU                   = d.CIIU
	           --,@PaisOrigen = d.PaisOrigen
	    FROM   TMPDeudores d
	    WHERE  d.ID = @ID
	    
	    SET @deuNombre = @CLNOMB
	    
	    --Tipo de identificacion
	    IF (@CLTID = 'C')
	    BEGIN
	        SET @deuTipoID = '03'
	        IF (LEN(@deuID) = 15 AND LEFT(@deuID ,1) = '0')
	        BEGIN
	            --Según lo solicitado por Luis padilla, la CNBS sugerio que se eliminara
	            --El cero inicial para los Carnets de Residencia
	            SET @deuID = RIGHT(RTRIM(@deuID) ,14)
	        END
	    END
	    ELSE
	    IF (@CLTID = 'P')
	    BEGIN
	        SET @deuTipoID = '04'
	        IF (LEN(@deuID) = 15 AND LEFT(@deuID ,1) = '0')
	        BEGIN
	            --Según lo solicitado por Luis padilla, la CNBS sugerio que se eliminara
	            --El cero inicial para los Pasaportes
	            SET @deuID = RIGHT(RTRIM(@deuID) ,14)
	        END
	    END
	    ELSE
	    IF (@CLTID = 'I')
	    BEGIN
	        SET @deuTipoID = '01'
	    END
	    ELSE
	    IF (@CLTID = 'R')
	    BEGIN
	        SET @deuTipoID = '06'
	        IF (LEN(@deuID) = 14)
	            SET @deuTipoID = '06'
	        ELSE
	            SET @deuTipoID = '02'
	    END
	    ELSE
	    BEGIN
	        SET @deuTipoID = '06'
	    END
	    
	    
	    IF (@CLTIPE = 'J') --Clientes Juridicos
	    BEGIN        
	        IF(@CLTID = 'M')
	        BEGIN
				IF (LEN(@deuID) = 14)
					SET @deuTipoID = '06'
				ELSE
					SET @deuTipoID = '02'
			END
	        
	        --Tipo de persona, reemplaza procedimiento usp_updateTipoPersonaJuridicos	
	        SELECT @deuTipoPer = ISNULL(MAX(lv.LvEquivalente) ,'07')
	        FROM   ListasValores lv
	        WHERE  lv.liId = 13
	               AND lv.lvValor = @TIPOSOC
	    END
	    ELSE
	    BEGIN
	        SELECT @deuTipoPer = '01'
      
	        IF(@CLTID = 'M')
	        BEGIN
				IF (LEN(@deuID) = 13)
					SET @deuTipoID = '01'
				ELSE
					SET @deuTipoID = '04'	
	        END
	        
	        
	        --Ajustamos nombre tal como lo solicita la CNBS
	        SET @deuNombre = @CLINO1 + ' ' + @CLINO2 + ' ' + @CLIAP1 + ' ' + @CLIAP2
	        SET @deuNombre = RTRIM(LTRIM(@deuNombre))
	        IF (@deuNombre = '')
	            SET @deuNombre = @CLNOMB
	    END
	    
	    /*******************************************
	     * Esta corrección fue solicitada por Luis padilla en la fecha 27/03/2015
	     *******************************************/
	    --Correccion temporal para los clientes juridicos  para colocar un CIIU valido    
	    IF (
	           @deuTipoPer NOT IN ('01')
	           AND @deuCIIU IN ('9820' ,'', '9999')
	       )
	    BEGIN
	        SET @deuCIIU = '4799'
	    END	      
	    --Correccion para el CIIU clientes naturales
	    IF (@deuTipoPer IN ('01') AND @deuCIIU IN ('', '9999'))
	    BEGIN
	        SET @deuCIIU = '9820'
	    END	      
	    
	    --Corrige CIIU que la comision reporta que no existe
	    IF(@deuCIIU = '1329')
			SET @deuCIIU = '1312'
		
			       
	    IF (@deuTipoPer IN ('01') AND @deuCIIU IS NULL)
	    BEGIN
	        SET @deuCIIU = '9820'
	    END	   
	    
	    IF (@deuTipoPer not IN ('01') AND @deuCIIU IS NULL)
	    BEGIN
	        SET @deuCIIU = '4690'
	    END	 
	    
	    SELECT @deuPersRela = ISNULL(MAX(lv.LvEquivalente) ,'')
	    FROM   ListasValores lv
	    WHERE  lv.liId = 14
	           AND lv.lvValor = @CLCTGR
	    
	    SET @deuGrupEco = @CLGRECO
	    
	    --Corrige el genero del deudor basado en el tipo de persona
	    IF (
	           @deuTipoPer IN ('01' ,'13' ,'14')
	           AND @deuSexo NOT IN ('M' ,'F')
	       )
	        SET @deuSexo = 'M'
	    
	    IF (
	           @deuTipoPer NOT IN ('01' ,'13' ,'14')
	           AND @deuSexo NOT IN ('Z')
	       )
	        SET @deuSexo = 'Z'
	    
	    EXECUTE [usp_DEUDORES_INSERT] 
	    --SELECT 
	    @CifCliente
	    ,@deuTipoID
	    ,@deuID
	    ,@deuNombre
	    ,@deuTipoPer
	    ,@deuPersRela
	    ,@deuTipoObli
	    ,@deuCatCM
	    ,@deuCatCs
	    ,@deuCatVv
	    ,@deuTotDeuda
	    ,@deuTipoDeu
	    ,@deuCatMin
	    ,@deuCatMax
	    ,@deuGrupEco
	    ,@deuSexo
	    ,@deuPaisDomi
	    ,@deuFecNaci
	    ,@deuCIIU
	    ,@deuPaisIdentificacion
	    
	    
	    SELECT @ID = MIN(d.ID)
	    FROM   TMPDeudores d
	    WHERE  d.ID > @ID
	END
END




