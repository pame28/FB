                                                            type="text"
                                                            className={base.input}
                                                            placeholder="Nombre del indicador..."
                                                            value={ind.name}
                                                            onChange={(e) => updateIndicator(c, ind.id, { name: e.target.value })}
                                                        />
                                                        <select
                                                            className={`${base.select} ${ui.typeSelect}`}
                                                            value={ind.type}
                                                            onChange={(e) => updateIndicator(c, ind.id, { type: e.target.value })}
                                                            aria-label="Tipo de indicador"
                                                        >
                                                            {INDICATOR_TYPES.map((t) => <option key={t} value={t}>{t}</option>)}
                                                        </select>
                                                        <label className={ui.naCheck}>
                                                            <input type="checkbox" checked={ind.na} onChange={(e) => updateIndicator(c, ind.id, { na: e.target.checked })} />
                                                            NA
                                                        </label>
                                                        <button
                                                            type="button"
                                                            className={ui.miniDelete}
                                                            onClick={() => updateCriterion(c.id, { indicators: c.indicators.filter((i) => i.id !== ind.id) })}
                                                            aria-label="Quitar indicador"
                                                        >
                                                            <X size={14} />
                                                        </button>
                                                    </div>
                                                ))}
                                            </div>
                                            <button
                                                type="button"
                                                className={`${base.btn} ${base.btnOutline} ${base.btnSm}`}
