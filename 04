                            <p className={base.modalText}>
                                Al aprobar confirmas que has revisado y aceptas el proceso de coaching registrado por tu coach. La aprobación quedará registrada con tu sesión activa.
                            </p>
                            <div className={ui.modalGrid}>
                                <div>
                                    <span className={base.statLabel}>Usuario que aprueba</span>
                                    <div className={base.statBox}>{p.memberFullName}</div>
                                </div>
                                <div>
                                    <span className={base.statLabel}>Fecha y hora</span>
                                    <div className={base.statBox}>{approveStamp}</div>
                                </div>
                            </div>
                            <div className={base.warningBanner}>
                                <TriangleAlert size={16} />
                                <span>Una vez aprobado el proceso quedará protegido. Cualquier modificación posterior invalidará esta aprobación.</span>
                            </div>
                        </>
                    ) : (
                        <div className={base.field}>
                            <label className={base.label} htmlFor="cq-reason">Motivo del rechazo</label>
                            <textarea
                                id="cq-reason"
                                className={base.textarea}
                                rows={4}
                                maxLength={500}
                                value={reason}
                                onChange={(e) => setReason(e.target.value)}
                            />
                        </div>
                    )}
                </Modal>
            </div>
        );
    }

    /* ===================== LISTADO ===================== */
    const count = (status) => processes.filter((p) => p.reviewStatus === status).length;

    return (
        <>
            <header className={styles.pageHeader}>
                <div>
                    <h1 className={styles.title}>Mis procesos de coaching</h1>
                    <p className={styles.subtitle}>Consulta el historial de tus procesos de coaching. Solo puedes ver tu propia información.</p>
                </div>
            </header>

            <div className={base.page}>
                <div className={base.infoBanner}>
                    <Info size={16} />
                    <span>
                        La información se muestra en modo <strong>solo lectura</strong>. No es posible modificar ningún dato desde esta sección.
                    </span>
                </div>

                <div className={ui.stats}>
                    <StatCard value={processes.length} label="Total procesos" />
                    <StatCard value={count("Pending")} label="Pend. aprobación" tone={ui.pending} />
                    <StatCard value={count("Approved")} label="Aprobados" tone={ui.approved} />
                </div>

                <section className={base.card}>
                    <div className={base.cardHeader}>
                        <h2 className={base.cardTitle}>Filtrar procesos</h2>
                    </div>
                    <div className={base.cardBody}>
                        <div className={ui.filterGrid}>
                            <div className={base.field}>
                                <label className={base.label} htmlFor="cq-year">Año</label>
                                <select id="cq-year" className={base.select} value={filters.year} onChange={(e) => setFilters({ ...filters, year: e.target.value })}>
                                    <option value="todos">Todos los años</option>
                                    {years.map((y) => <option key={y} value={y}>{y}</option>)}
                                </select>
                            </div>
                            <div className={base.field}>
                                <label className={base.label} htmlFor="cq-month">Mes</label>
                                <select id="cq-month" className={base.select} value={filters.month} onChange={(e) => setFilters({ ...filters, month: e.target.value })}>
                                    <option value="todos">Todos los meses</option>
                                    {MONTHS.map((m, i) => <option key={m} value={String(i)}>{m}</option>)}
                                </select>
                            </div>
                            <div className={base.field}>
                                <label className={base.label} htmlFor="cq-status">Estado</label>
                                <select id="cq-status" className={base.select} value={filters.status} onChange={(e) => setFilters({ ...filters, status: e.target.value })}>
                                    <option value="todos">Todos los estados</option>
                                    {Object.entries(STATUS_LABEL).map(([value, label]) => <option key={value} value={value}>{label}</option>)}
                                </select>
                            </div>
                        </div>
                    </div>
                </section>

                <div className={ui.list}>
                    {loading ? (
                        <div className={ui.empty}>Cargando procesos...</div>
                    ) : error ? (
                        <div className={ui.empty}>{error}</div>
                    ) : filtered.length === 0 ? (
                        <div className={ui.empty}>No hay procesos de coaching que coincidan con los filtros.</div>
                    ) : (
                        filtered.map((p) => (
                            <div
                                key={p.sessionId}
                                className={ui.row}
                                onClick={() => setSelectedId(p.sessionId)}
                                onKeyDown={(e) => e.target === e.currentTarget && onRowKey(e, () => setSelectedId(p.sessionId))}
                                tabIndex={0}
                                role="button"
                                aria-label={`Ver ${processTitle(p)}`}
                            >
                                <div className={ui.rowAvatar}>{getInitials(p.coachName)}</div>
                                <div className={ui.rowInfo}>
                                    <div className={ui.rowTitle}>{processTitle(p)}</div>
                                    <div className={ui.rowSub}>Coach: {p.coachName ?? "—"} · {p.indicators.length} indicadores evaluados</div>
                                </div>
                                <div className={ui.rowRight}>
                                    <span className={`${ui.pill} ${STATUS_PILL[p.reviewStatus]}`}>{STATUS_LABEL[p.reviewStatus]}</span>
                                    <span className={ui.rowDate}>{formatDate(p.submittedAt)}</span>
                                    <div className={ui.rowButtons}>
                                        <button
                                            type="button"
                                            className={`${base.btn} ${base.btnOutline} ${base.btnSm} ${ui.btnTeal}`}
                                            onClick={(e) => {
                                                e.stopPropagation();
                                                handleDownloadExcel(p);
                                            }}
                                        >
                                            <Download size={15} /> Excel
                                        </button>
                                        <button
                                            type="button"
                                            className={`${base.btn} ${base.btnOutline} ${base.btnSm} ${ui.btnTeal}`}
                                            disabled={!isApproved(p)}
                                            onClick={(e) => {
                                                e.stopPropagation();
                                                handleDownloadPDF(p);
                                            }}
                                        >
                                            <Download size={15} /> PDF
                                        </button>
                                    </div>
                                </div>
                            </div>
                        ))
                    )}
                </div>
            </div>
        </>
    );
};

