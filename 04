                             WHERE n.NoUsuario = TarAnt.NoUsuario)
                            
),
cte_MaxTarjetasProblemasF1
AS
(
	SELECT cte.NoUsuario, MAX(cte.NumeroTarjeta) NumeroTarjeta FROM cte_TarjetasProblemasF1 cte
	GROUP BY cte.NoUsuario
)


INSERT INTO TarjetasProblemasF1	
SELECT * FROM cte_TarjetasProblemasF1 A
WHERE EXISTS(SELECT 1 FROM cte_MaxTarjetasProblemasF1 B WHERE A.NumeroTarjeta = B.NumeroTarjeta) 

		  

TRUNCATE TABLE TarjetasCanceladas;

WITH cte_TarjetasCanceladas
AS
(
	  SELECT 'TarjetasCanceladas' Tipo, * 
      FROM   TarjetasAnteriores TarAnt
      WHERE  TarAnt.CategoriaTarjeta = '0'
             AND TarAnt.EstadoTarjeta = '29'
              AND NOT EXISTS(SELECT 1 FROM TarjetasCastigadas tc
                            WHERE tc.NoUsuario = TarAnt.NoUsuario)
             AND NOT EXISTS(SELECT TOP 1 p.NoUsuario FROM TarjetasPersonales p
                            WHERE p.NoUsuario = TarAnt.NoUsuario)
			 AND NOT EXISTS(SELECT TOP 1 p.NoUsuario FROM TarjetasProblemasF1 p
                            WHERE p.NoUsuario = TarAnt.NoUsuario)
			 AND NOT EXISTS(SELECT TOP 1 p.NoUsuario FROM TarjetasProblemasNC p
							WHERE p.NoUsuario = TarAnt.NoUsuario)
			 And NOT EXISTS (SELECT TOP 1 p.NoUsuario FROM TarjetaNoRenovar p	--2017 02 20 Ajuste por Cuenta con 2 TC
                    WHERE p.NoUsuario = TarAnt.NoUsuario)							                            
			 AND (TarAnt.SaldoActualML <> 0 OR TarAnt.SaldoActualUSD <> 0)
)
,cte_cte_TarjetasCanceladasMax
as
(
	SELECT NoUsuario, MAX(NumeroTarjeta) NumeroTarjeta  FROM cte_TarjetasCanceladas
	GROUP BY NoUsuario
)  

INSERT INTO TarjetasCanceladas
SELECT * FROM  cte_TarjetasCanceladas A
WHERE EXISTS ( SELECT * FROM cte_cte_TarjetasCanceladasMax B 
where A.NumeroTarjeta = B.NumeroTarjeta)




INSERT INTO MaestroExtras
  (
    NumeroCuenta
   ,NumeroTarjeta
   ,FechaOrigen
   ,NoCUT
  )
SELECT cp.NumeroCuenta
      ,cp.NumeroTarjeta
      ,cp.FechaOriginalCupon
      ,cp.CodigoTransaccion
FROM   CuotasPendientes cp
WHERE  EXISTS(
           SELECT *
           FROM   uvw_EXTRAS_VASA uev
           WHERE  uev.IdExtra IS NULL
                  AND uev.CodigoTransaccion = cp.CodigoTransaccion
       )   
ORDER BY cp.CodigoTransaccion ASC                                                   	


END


