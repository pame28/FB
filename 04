-- 1. ¿Cuántas filas nulas devuelve la vista y de qué tipo?
SELECT RELA_TIPR, COUNT(*) AS filas
FROM uvw_CobranzasRelacionesTC
WHERE RELA_IDEN IS NULL
GROUP BY RELA_TIPR;

-- 2. Cuentas en Saldos sin documento en ETarjetas
SELECT s.NoCuentaClaro, s.Cif
FROM uvw_SaldosVasa s
WHERE s.CategoriaTarjeta = '0'
  AND NOT EXISTS (SELECT 1 FROM ETarjetas et
                  WHERE et.NoCuentaClaro = s.NoCuentaClaro
                    AND et.NoDocumento IS NOT NULL);

-- 3. Empresariales sin cédula
SELECT No_Cliente, NoCuentaClaro
FROM uvw_CobranzasCuentas
WHERE No_Cedula IS NULL;