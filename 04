.pickItem:first-child { border-top: none; }
.pickItem:hover { background: #f8fafc; }
.pickItemOn { background: color-mix(in srgb, var(--bp-blue-digital) 8%, white); }
.pickItem .personText { flex: 1; }

.checkbox { width: 18px; height: 18px; flex-shrink: 0; accent-color: var(--bp-blue-expert); cursor: pointer; }

