CREATE VIEW [dbo].[uvw_CobranzasCuentas]
AS
	SELECT TOP 99.99999 PERCENT
		CAST(Usu.NoUsuario AS NVARCHAR(13))														No_Cuenta
		,CAST(Usu.NoClienteUnico AS NVARCHAR(15))												No_Cliente
		,CAST(Usu.RTN AS NVARCHAR(20))															No_Cedula
		,CAST(RTRIM(LTRIM(Usu.NombreUsuario)) + ' '	+ 
		 RTRIM(LTRIM(Usu.DenominacionCuenta)) AS NVARCHAR(81))									Nombre_Cliente
		,CAST(Usu.DomicilioParticular1 AS NVARCHAR(40))											Direccion_1
		,CAST(Usu.DomicilioParticular2 AS NVARCHAR(40))											Direccion_2
		,CAST(Usu.Telefono AS NVARCHAR(30))														Telefono_1
		,CAST('' AS NVARCHAR(30))																Telefono_2
		,CAST(LTRIM(RTRIM(Usu.UsuEmailUsuario)) + '@' + 
		 LTRIM(RTRIM(Usu.UsuEmailDominio)) AS NVARCHAR(61))										Correo
		,CAST(Usu.Cartera AS INT)																Ciclo
		,CAST(CASE WHEN 
			LEN(Usu.CodigoEmpresa) > 0 
		THEN
			'J'
		ELSE
			'N'
		END AS NVARCHAR(1))																		TipoPersoneria
		,CAST(Cc.EstadoCuenta AS INT)															Estado_Cuenta
		,Cast(Cc.EstadoTarjeta as Int)															Estado_Tarjeta
		,CONVERT(DATE, Usu.FechaAltaCuenta, 102)												Fecha_Alta
		,CAST(Usu.ImporteLimiteCompra AS MONEY)													Linea_Credito
		,CAST(Pos.DisponibleCompraML AS MONEY)													Disp_Compras_MN
		,CAST(Pos.DisponibleCompraML / Pm.TasaCambio AS MONEY)									Disp_Compras_ME
		,CONVERT(DATE, Pos.FechaUltimoPagoML, 102)												Fecha_Ult_Pago_MN
		,CONVERT(DATE, Pos.FechaUltimoPagoUSD, 102)												Fecha_Ult_Pago_ME
		,CONVERT(DATE, Usu.FechaProcesoABM, 102)												Fecha_Ult_Manto
		,CAST(Cc.CantidadPagosMN AS INT)														Cantidad_Pagos_MN
		,CAST(Cc.CantidadPagosUSD AS INT)														Cantidad_Pagos_ME
		,CAST(Pos.PagosIngresadosML AS MONEY)													Total_Monto_Pagos_MN
		,CAST(Pos.PagosIngresadosUSD AS MONEY)													Total_Monto_Pagos_ME
		,CAST(Pos.PagoMinimoUltimaLiquidacionML AS MONEY)										Pago_Minimo_MN
		,CAST(Pos.PagoMinimoUltimaLiquidacionUSD AS MONEY)										Pago_Minimo_ME
		,CAST(Pos.PagoContadoML AS MONEY)														Saldo_Inicial_MN
		,CAST(Pos.PagoContadoUSD AS MONEY)														Saldo_Inicial_ME
		,CAST(Pos.SaldoActualML AS MONEY)														Saldo_Actual_ML
		,CAST(Pos.SaldoActualUSD AS MONEY)														Saldo_Actual_ME
		,CAST(Pos.PeriodosImpagosActualML AS INT)												Ciclos_Vencidos_MN
		,CAST(Pos.PeriodosImpagosActualUSD AS INT)												Ciclos_Vencidos_ME
		,CAST(Cc.PagoVencidoML AS MONEY)														Pago_Vencido_ML
		,CAST(Cc.PagoVencidoUSD AS MONEY)														Pago_Vencido_ME
		,CAST(ISNULL(Se.SaldoExtraMN, 0) AS MONEY)												Saldo_Extra_MN
		,CAST(ISNULL(Se.SaldoExtraME, 0) AS MONEY)												Saldo_Extra_ME
		,CAST(ISNULL(Se.SaldoIntraMN, 0) AS MONEY)												Saldo_Intra_MN
		,CAST(ISNULL(Se.SaldoIntraME, 0) AS MONEY)												Saldo_Intra_ME
		,CAST(ISNULL(Mf.NombreFiador1 ,'') AS NVARCHAR(40))										Nombre_Fiador_1
		,CAST(ISNULL(Mf.NumCedulaFiador1 ,'') AS NVARCHAR(15))									Cedula_Fiador_1
		,CAST(ISNULL(Mf.Telefono1_1 ,'') AS NVARCHAR(30))										Telefono_1_Fiador_1
		,CAST(ISNULL(Mf.Telefono1_2 ,'') AS NVARCHAR(30))										Telefono_2_Fiador_1
		,CAST(ISNULL(Mf.DireccionFiador1 + ' ' + Mf.DireccionFiador1_2 ,'') AS NVARCHAR(81))	Direccion_Fiador_1
		,CAST(ISNULL(Mf.NombreFiador2 ,'') AS NVARCHAR(40))										Nombre_Fiador_2
		,CAST(ISNULL(Mf.NumCedulaFiador2 ,'') AS NVARCHAR(15))									Cedula_Fiador_2
		,CAST(ISNULL(Mf.Telefono2_1 ,'') AS NVARCHAR(30))										Telefono_1_Fiador_2
		,CAST(ISNULL(Mf.Telefono2_2 ,'') AS NVARCHAR(30))										Telefono_2_Fiador_2
		,CAST(ISNULL(Mf.DireccionFiador2 + ' ' + Mf.DireccionFiador2_2 ,'') AS NVARCHAR(81))	Direccion_Fiador_2
		,CAST(ISNULL(Mf.NombreFiador3 ,'') AS NVARCHAR(40))										Nombre_Fiador_3
		,CAST(ISNULL(Mf.NumCedulaFiador3 ,'') AS NVARCHAR(15))									Cedula_Fiador_3
		,CAST(ISNULL(Mf.Telefono3_1 ,'') AS NVARCHAR(30))										Telefono_1_Fiador_3
		,CAST(ISNULL(Mf.Telefono3_2 ,'') AS NVARCHAR(30))										Telefono_2_Fiador_3
		,CAST(ISNULL(Mf.DireccionFiador3 + ' ' + Mf.DireccionFiador3_2 ,'') AS NVARCHAR(81))	Direccion_Fiador_3
		,CAST(Pos.DiasMoraML AS INT)															DiasMoraMN
		,CAST(Pos.DiasMoraUSD AS INT)															DiasMoraUSD
		,CAST(CASE WHEN 
			Usu.CodigoPais = '340' 
		THEN
			'HONDUREÑA'
		ELSE
			'EXTRANJERA'
		END AS NVARCHAR(30))																	Nacionalidad
		,CAST('' AS NVARCHAR(3))																Oficial
		,CAST(Usu.NoCuentaClaro AS NVARCHAR(10))												NoCuentaClaro
		,CAST(CC.NumeroTarjeta AS NVARCHAR(16))												    NumeroTarjeta
		,CAST(CC.NumTarjetaTruncada AS NVARCHAR(20))											NumTarjetaTruncada
	FROM
		Parametros Pm,
		EUsuarios Usu
	INNER JOIN
		EPosicionDiaria Pos
	ON
		Usu.NoUsuario = Pos.NoUsuario
	INNER JOIN
		uvw_CuentasPagos Cc
	ON
		Usu.NoUsuario = Cc.NoCuenta
	LEFT JOIN
		uvw_SaldosExtras Se
	ON
		Se.NumeroCuenta = Usu.NoUsuario
	LEFT JOIN
		uvw_NombreFiadores Mf
	ON
		Mf.NoUsuario = Usu.NoUsuario
	WHERE 
		Pos.NumeroTarjeta = '0000000000000000'
		AND Cc.TipoTarjeta='E'
		AND Pos.ModeloLiquidacion != '900'
	ORDER BY 1 DESC
GO
