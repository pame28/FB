                                                />
                                            </div>
                                        </div>
                                        <div className={ui.field}>
                                            <label className={ui.label} htmlFor="cc-name">Nombre</label>
                                            <div className={ui.inputIcon}>
                                                <Search size={16} />
                                                <input
                                                    id="cc-name"
                                                    type="text"
                                                    className={ui.input}
                                                    placeholder="Nombre del colaborador..."
                                                    value={filters.name}
                                                    onChange={(e) => setFilters({ ...filters, name: e.target.value })}
                                                />
                                            </div>
                                        </div>
                                    </div>
                                    <div className={ui.searchActions}>
                                        <button type="submit" className={`${ui.btn} ${ui.btnPrimary} ${ui.btnSm}`}>
