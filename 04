.stepActive { color: var(--bp-blue-expert); }
.stepActive .stepDot { border-color: var(--bp-blue-expert); background: var(--bp-blue-expert); color: #fff; }
.stepDone { color: var(--bp-blue-fin); }
.stepDone .stepDot { border-color: var(--bp-blue-digital); background: var(--bp-blue-digital); color: #fff; }
.stepLine { flex: 1; min-width: 16px; height: 2px; border-radius: 2px; background: #e3e8ef; }
.stepLineDone { background: var(--bp-blue-digital); }

/* ---- Lista de selección ---- */
.pick { display: flex; flex-direction: column; gap: 10px; }
.pickList { overflow-y: auto; border: 1px solid #e6ebf1; border-radius: 12px; }

.pickItem {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 12px;
  border-top: 1px solid #f1f4f8;
