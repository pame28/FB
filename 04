CREATE View [dbo].[uvw_CuentasPagos_BK20261124]
As
  WITH TarjetasEmpresariales AS (
  SELECT NumeroTarjeta, NoUsuario, EstadoTarjeta,NumTarjetaTruncada  FROM (
  SELECT NumeroTarjeta, NoUsuario, EstadoTarjeta, FechaFinVigencia, Et.BinTarjeta + 'XXXXXX'+ Et.TarjetaImprimir AS NumTarjetaTruncada, ROW_NUMBER() OVER(PARTITION BY et.NoUsuario, ET.EstadoTarjeta ORDER BY et.FechaFinVigencia DESC) fila
  FROM ETarjetas et WITH(NOLOCK)
  WHERE ET.CategoriaTarjeta='E'
  ) A
  WHERE fila=1
  ),

   Base As(
  Select 
     a.NoCuenta          NoCuenta
    ,a.CantidadPagosMN      CantidadPagosMN
    ,a.CantidadPagosUSD      CantidadPagosUSD
    ,Max(a.PagoVencidoML)    PagoVencidoML
    ,Max(a.PagoVencidoUSD)    PagoVencidoUSD
    ,a.EstadoTarjeta      EstadoTarjeta
    ,a.EstadoCuenta        EstadoCuenta
    ,a.CategoriaTarjeta      TipoTarjeta
    ,a.NumeroTarjeta            NumeroTarjeta
    ,a.NumTarjetaTruncada       NumTarjetaTruncada
  From 
    (Select
      NoCuenta            NoCuenta
      ,IsNull(CantidadPagosMN, 0)    CantidadPagosMN
      ,IsNull(CantidadPagosUSD, 0)  CantidadPagosUSD
      ,IsNull(PagoVencidoML, 0)    PagoVencidoML
      ,IsNull(PagoVencidoUSD, 0)    PagoVencidoUSD
      ,Tr.EstadoTarjeta
      ,Ms.EstadoCuenta
      ,Ms.CategoriaTarjeta
      ,Te.NumeroTarjeta 
      ,Te.NumTarjetaTruncada
    From
      MaestroSaldos Ms WITH(NOLOCK)
    Inner Join
      ETarjetas Tr WITH(NOLOCK)
    On
      Ms.NumeroTarjeta = Tr.NumeroTarjeta
    INNER JOIN TarjetasEmpresariales Te WITH(NOLOCK)
    ON 
      TR.NoUsuario=Te.NoUsuario AND TR.EstadoTarjeta=Te.EstadoTarjeta AND
      Te.NumeroTarjeta = Tr.NumeroTarjeta
    Where 
      Ms.CategoriaTarjeta ='E'
      And Tr.CategoriaTarjeta='E'
      And Tr.EstadoHabilitar IN ( '','I','*','R','U','A','B','E','D','H','G','K','J' )
    Group by
      NoCuenta
      ,CantidadPagosMN
      ,CantidadPagosUSD
      ,PagoVencidoML
      ,PagoVencidoUSD
      ,Tr.EstadoTarjeta
      ,Ms.EstadoCuenta
    ,Ms.CategoriaTarjeta
    ,Te.NumeroTarjeta
    ,Te.NumTarjetaTruncada ) a
  Group By
     a.NoCuenta
    ,a.CantidadPagosMN
    ,a.CantidadPagosUSD
    ,a.EstadoTarjeta
    ,a.EstadoCuenta
    ,a.CategoriaTarjeta
    ,a.NumeroTarjeta
    ,a.NumTarjetaTruncada 
  ), 
  Tarjetas20 As
  (
    Select NoCuenta, CantidadPagosMN, CantidadPagosUSD ,PagoVencidoML ,PagoVencidoUSD ,EstadoTarjeta ,EstadoCuenta ,TipoTarjeta ,NumeroTarjeta ,NumTarjetaTruncada
    From Base WITH(NOLOCK)
    where EstadoTarjeta = 20 
  ),
  Tarjetas25 As
  (
    Select NoCuenta, CantidadPagosMN, CantidadPagosUSD ,PagoVencidoML ,PagoVencidoUSD ,EstadoTarjeta ,EstadoCuenta ,TipoTarjeta ,NumeroTarjeta ,NumTarjetaTruncada 
    From Base A WITH(NOLOCK)
    Where EstadoTarjeta = 25 
    And Not Exists (Select 1 From Tarjetas20 B where a.NoCuenta = b.NoCuenta)
  )

  Select NoCuenta, CantidadPagosMN, CantidadPagosUSD ,PagoVencidoML ,PagoVencidoUSD ,EstadoTarjeta ,EstadoCuenta ,TipoTarjeta ,NumeroTarjeta ,NumTarjetaTruncada
  From Tarjetas20 WITH(NOLOCK)
    Union All 
  Select NoCuenta, CantidadPagosMN, CantidadPagosUSD ,PagoVencidoML ,PagoVencidoUSD ,EstadoTarjeta ,EstadoCuenta ,TipoTarjeta ,NumeroTarjeta ,NumTarjetaTruncada
  From Tarjetas25 WITH(NOLOCK)

GO


 
