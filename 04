const sampleAnswers = (criteria, seed) => {
    const answers = {};
    criteria.forEach((c) => {
        answers[c.id] = {};
        c.indicators.forEach((ind, i) => {
            const row = {};
            if (c.calc === "ratio") {
                const programados = 10;
                c.columns.slice(0, 2).forEach((col, k) => {
                    row[col] = String(i === 0 ? programados : programados - ((seed + k + i) % 3));
                });
            } else if (c.calc === "ce") {
                c.columns.forEach((col, k) => {
                    row[col] = c.columns.length > 1 && k === 1 && i === 2 ? "NA" : (seed + i + k) % 4 === 0 ? "NCE" : "CE";
                });
            } else {
                c.columns.forEach((col, k) => { row[col] = String(85 + ((seed * 3 + i * 5 + k * 2) % 16)); });
            }
            if ((seed + i) % 3 === 0) row.__obs = "Se verificó con la documentación de la agencia.";
            answers[c.id][ind.id] = row;
        });
    });
    return answers;
};

