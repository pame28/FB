        public bool RealizarMovimiento()
        {
            Stopwatch reloj = Stopwatch.StartNew();
            long filas;

            // Lee del AS400 y carga a BANDEJAVASA por lotes (incluye PreParseo antes del primer lote)
            if (!CargarPosiciones(out filas))
                return false;

            if (!PostParseo())
                return false;

            if (!UpdateArchivoAS400())
                return false;

            reloj.Stop();
            RegistraProceso("E", $"Proceso ejecutado exitosamente: {filas} registros en {reloj.Elapsed.TotalSeconds:0} segundos");
            return true;
        }

        /// <summary>
        /// Lee el AS400 con un DataReader y va enviando lotes a SQL Server con SqlBulkCopy,
        /// sin cargar todo en memoria. Si no hay registros, no ejecuta PreParseo (igual que antes).
        /// Todo el insert va en una transacción: si algo falla, no quedan datos a medias.
        /// </summary>
        public bool CargarPosiciones(out long filas)
        {
            filas = 0;
            string etapa = "leer AS400";

            ConnectionManager cmOrigen = Dts.Connections["AS400"];
            ConnectionManager cmDestino = Dts.Connections["BANDEJAVASA"];
            OleDbConnection connOrigen = null;
            SqlConnection connDestino = null;
            SqlTransaction tran = null;

            try
            {
                connOrigen = cmOrigen.AcquireConnection(null) as OleDbConnection;
                if (connOrigen == null)
                    throw new InvalidOperationException("No se pudo obtener la conexión AS400 desde el Connection Manager.");

                using (IDbCommand cmd = connOrigen.CreateCommand())
                {
                    cmd.CommandText = sql_ConsultaOrigen;
                    cmd.CommandTimeout = TimeoutSegundos;

                    using (IDataReader reader = cmd.ExecuteReader())
                    {
                        if (!reader.Read())
                        {
                            RegistraProceso("F", $"No se encontraron registros en AS400 para el día {fecha_generacion}");
                            return false;
                        }

                        etapa = "preparseo";
                        if (!PreParseo())
                            return false;

                        etapa = "bulkInsert";
                        connDestino = cmDestino.AcquireConnection(null) as SqlConnection;
                        if (connDestino == null)
                            throw new InvalidOperationException("No se pudo obtener la conexión BANDEJAVASA desde el Connection Manager.");

                        tran = connDestino.BeginTransaction();

                        DataTable dt = CrearEstructura();
                        int lote = TamanoLote;
                        object[] origen = new object[reader.FieldCount];
                        object[] destino = new object[dt.Columns.Count];

                        using (SqlBulkCopy bulkCopy = new SqlBulkCopy(connDestino, SqlBulkCopyOptions.TableLock, tran))
                        {
                            bulkCopy.DestinationTableName = parametros["ArchivoDestino"];
                            bulkCopy.BulkCopyTimeout = TimeoutSegundos;
                            bulkCopy.BatchSize = 0; // cada WriteToServer va como un solo lote

                            do
                            {
                                filas++;
                                reader.GetValues(origen);
                                ConvertirFila(origen, destino, dt, filas);
                                dt.Rows.Add(destino);

                                if (dt.Rows.Count >= lote)
                                {
                                    bulkCopy.WriteToServer(dt);
                                    dt.Clear();
                                }
                            }
                            while (reader.Read());

                            if (dt.Rows.Count > 0)
                                bulkCopy.WriteToServer(dt);
                        }

                        tran.Commit();
                        tran = null;
                    }
                }

                return true;
            }
            catch (Exception ex)
            {
                if (tran != null)
                {
                    try { tran.Rollback(); } catch { }
                }

                RegistraProceso("F", $"Falló {etapa} {parametros["ArchivoDestino"]} (fila {filas}) con error {ex.Message}");
                return false;
            }
            finally
            {
                if (connDestino != null)
                    cmDestino.ReleaseConnection(connDestino);
                if (connOrigen != null)
                    cmOrigen.ReleaseConnection(connOrigen);
            }
        }

        /// <summary>
        /// Convierte una fila del AS400 al formato de la tabla destino.
        /// Mismas reglas que antes: TRIM, vacío = NULL, redondeos y valores fijos.
        /// </summary>
        private void ConvertirFila(object[] origen, object[] destino, DataTable dt, long fila)
        {
            for (int c = 0; c < destino.Length; c++)
            {
                // Columnas fijas
                if (c == COL_LARID) { destino[c] = LAR_ID; continue; }          // larId
                if (c == COL_PROCESADOR) { destino[c] = "LOCAL"; continue; }   // ProcesadorOrigen

                // Columnas 0..154 vienen en el mismo orden; 156..159 vienen corridas una posición
                int idxOrigen = c < COL_LARID ? c : c - 1;
                object valor = origen[idxOrigen];

                try
                {
                    destino[c] = ConvertirValor(valor, dt.Columns[c].DataType);
                }
                catch (Exception ex)
                {
                    throw new Exception($"Columna {dt.Columns[c].ColumnName}, valor '{valor}': {ex.Message}", ex);
                }
            }
        }

        private static object ConvertirValor(object valor, Type tipo)
        {
            if (valor == null || valor is DBNull)
                return DBNull.Value;

            if (tipo == typeof(string))
            {
                string s = (valor as string ?? Convert.ToString(valor, CultureInfo.InvariantCulture)).Trim();
                return s.Length == 0 ? (object)DBNull.Value : s;
            }

            if (tipo == typeof(DateTime))
            {
                if (valor is DateTime)
                    return valor;
                string s = Convert.ToString(valor, CultureInfo.InvariantCulture).Trim();
                if (s.Length == 0)
                    return DBNull.Value;
                return Convert.ToDateTime(s, CultureInfo.CurrentCulture);
            }

            decimal d = Convert.ToDecimal(valor, CultureInfo.InvariantCulture);

            if (tipo == typeof(short)) return Convert.ToInt16(d);
            if (tipo == typeof(byte)) return Convert.ToByte(d);
            if (tipo == typeof(int)) return Convert.ToInt32(d);
            return d; // decimal
        }

