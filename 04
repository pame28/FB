        public async Task<CoachingSessionExportDto?> GetSessionExportAsync(long sessionId, string userId)
        {
            // Lo puede ver el colaborador de la sesión o un líder (coach) del equipo.
            var session = await _dbContext.CoachingSessions
                .AsNoTracking()
                .AsSplitQuery()
                .Include(x => x.TeamMember).ThenInclude(x => x.Team)
                .Include(x => x.TeamMember).ThenInclude(x => x.User).ThenInclude(x => x.CompanyPosition)
                .Include(x => x.TeamMember).ThenInclude(x => x.User).ThenInclude(x => x.CompanyArea)
                .Include(x => x.TeamMember).ThenInclude(x => x.User).ThenInclude(x => x.CompanyLocation)
                .Include(x => x.TeamMember).ThenInclude(x => x.User).ThenInclude(x => x.CompanyBranch)
                .Include(x => x.IndicatorAssignments).ThenInclude(x => x.Indicator).ThenInclude(x => x.Period)
                .Include(x => x.IndicatorAssignments).ThenInclude(x => x.TargetUnit)
                .Include(x => x.ActionPlan!).ThenInclude(x => x.Actions)
                .FirstOrDefaultAsync(x => x.Id == sessionId &&
                    (x.MemberUserId == userId ||
                     x.TeamMember.Team.Leaders.Any(leader => leader.LeaderUserId == userId)));

            if (session is null) return null;

            // El coach es quien registró resultados y plan; si aún no hay plan, quien creó la sesión.
            var coachId = session.ActionPlan?.CreatedBy ?? session.CreatedBy;
            var names = await GetUserNamesAsync([coachId, session.MemberUserId]);
            var member = session.TeamMember.User;

            var indicators = session.IndicatorAssignments
                .OrderBy(a => a.Indicator.Type)
                .ThenBy(a => a.Indicator.Name)
                .Select(a =>
                {
                    var unit = a.TargetUnit?.Name;
                    var indicator = a.Indicator;
                    return new CoachingExportIndicatorDto
                    {
                        AssignmentId = a.Id,
                        Name = indicator.Name,
                        Type = indicator.Type,
                        TypeName = CoachingLabels.IndicatorTypeName(indicator.Type),
                        Weight = a.Weight,
                        GoalText = CoachingLabels.GoalText(indicator.Rule, a.TargetValue,
                            indicator.MinimunValue, indicator.MaximunValue, unit),
                        TargetValue = a.TargetValue,
                        UnitName = unit,
                        AchievedValue = a.AchievedValue,
                        ValueText = CoachingLabels.ValueText(a.AchievedValue, unit),
                        AchievementPercentage = a.AchievementPercentage,
                        Points = CoachingLabels.Points(a.AchievementPercentage, a.Weight),
                        Passed = CoachingLabels.Passed(indicator.Rule, a.AchievedValue, a.TargetValue,
                            indicator.MinimunValue, indicator.MaximunValue)
                    };
                })
                .ToList();

            var period = session.IndicatorAssignments
                .Select(a => a.Indicator.Period)
                .Where(p => p is not null)
                .OrderBy(p => p.StartDate)
                .FirstOrDefault();

            var collaboratorApproved = session.ReviewStatus == CoachingSessionReviewStatus.Approved
                && session.ReviewedAt.HasValue;

            return new CoachingSessionExportDto
            {
                SessionId = session.Id,
                Status = session.ReviewStatus,
                StatusName = CoachingLabels.ReviewStatusName(session.ReviewStatus),
                PeriodName = period?.Description,
                PeriodStart = period is null ? null : DateOnly.FromDateTime(period.StartDate),
                PeriodEnd = period is null ? null : DateOnly.FromDateTime(period.EndDate),
                CoachingDate = AsUtc(session.SubmittedAt),
                TeamName = session.TeamMember.Team?.Name,
                CoachName = names.GetValueOrDefault(coachId),

                Collaborator = new CoachingExportCollaboratorDto
                {
                    UserId = member.Id,
                    FullName = names.GetValueOrDefault(member.Id) ?? member.UserName,
                    EmployeeCode = member.EmployeeCode,
                    TellerCode = member.TellerCode,
                    Position = member.CompanyPosition?.Name,
                    Area = member.CompanyArea?.Name,
                    Location = member.CompanyLocation?.Name,
                    Branch = member.CompanyBranch?.Name,
                    Ubication = member.EmployeeBranchUbication?.ToString(),
                    StatusName = member.Status.ToString()
                },

                Indicators = indicators,
                FinalScore = indicators.Sum(i => i.Points),

                Actions = session.ActionPlan?.Actions
                    .OrderBy(x => x.CommitmentDate)
                    .Select(x => new CoachingExportActionDto
                    {
                        MeasurementType = x.MeasurementType,
                        MeasurementTypeName = CoachingLabels.MeasurementTypeName(x.MeasurementType),
                        CommitmentDate = DateOnly.FromDateTime(x.CommitmentDate),
                        ImprovementOpportunity = x.ImprovementOpportunity,
                        ActionDescription = x.ActionDescription
                    })
                    .ToList() ?? [],

                CoachApproval = session.SubmittedAt.HasValue
                    ? new CoachingExportApprovalDto { Name = names.GetValueOrDefault(coachId), At = AsUtc(session.SubmittedAt)!.Value }
                    : null,

                CollaboratorApproval = collaboratorApproved
                    ? new CoachingExportApprovalDto { Name = names.GetValueOrDefault(session.MemberUserId), At = AsUtc(session.ReviewedAt)!.Value }
                    : null,

                ReviewRejectionReason = session.ReviewRejectionReason
            };
        }

        /// <summary>
        /// SubmittedAt y ReviewedAt se guardan con DateTime.UtcNow, pero EF los lee sin "Kind".
        /// Se marcan como UTC para que el JSON salga con "Z" y el navegador muestre la hora local.
        /// </summary>
        private static DateTime? AsUtc(DateTime? value) =>
            value.HasValue ? DateTime.SpecifyKind(value.Value, DateTimeKind.Utc) : null;

        /// <summary>Id → nombre para mostrar (FullName o Nombre + Apellido).</summary>
        private async Task<Dictionary<string, string>> GetUserNamesAsync(IEnumerable<string?> userIds)
        {
            var ids = userIds
                .Where(id => !string.IsNullOrWhiteSpace(id))
                .Select(id => id!)
                .Distinct()
                .ToList();

            var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            if (ids.Count == 0) return result;

            var users = await _dbContext.Users
                .AsNoTracking()
                .Where(u => ids.Contains(u.Id))
                .Select(u => new { u.Id, Name = u.FullName ?? (u.FirstName + " " + u.LastName) })
                .ToListAsync();

            foreach (var u in users) result[u.Id] = u.Name;
            return result;
        }















