-- =============================================
-- Author:		Orlin Alvarado
-- Create date: 2014-12-15
-- Description:	Genera la información de tarjetas y las coloca en la tabla de operaciones
-- =============================================
ALTER PROCEDURE [dbo].[usp_CR_PROC_OPERACIONES_TC_VASA]
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;

	
	--Limpiamos tabla tempora
	TRUNCATE TABLE TMPTarjetasVASA
	

	
	--Insertamos los nuevos valores
	INSERT INTO TMPTarjetasVASA
	SELECT *
	FROM   uvw_TARJETAS_VASA ut
	WHERE ISNUMERIC(CIF) = 1
	

	--Variables para insertar en la tabla operaciones
	DECLARE @opeNum CHAR(16)
	       ,@opeMoneda SMALLINT
	       ,@CifCliente DECIMAL
	       ,@opeTipIns CHAR(2)
	       ,@opeCodIns CHAR(2)
	       ,@opeFecRep CHAR(8)
	       ,@opeFecOto CHAR(8)
	       ,@opeFecVen CHAR(8)
	       ,@opeSaldoVi MONEY
	       ,@opeSaldoMo MONEY
	       ,@opeSaldoVe MONEY
	       ,@opeSaldoCo MONEY
	       ,@opeSaldoEj MONEY
	       ,@opeSaldoCa MONEY
	       ,@opeGar CHAR(2)
	       ,@opeTipo CHAR(6)
	       ,@opeCateg CHAR(5)
	       ,@opeTipCred CHAR(1)
	       ,@opeMontoOt MONEY
	       ,@opeIntXcob MONEY
	       ,@opeIntSus MONEY
	       ,@opeValGar MONEY
	       ,@opeTasa SMALLMONEY
	       ,@opeForPago CHAR(2)
	       ,@opePerGra SMALLINT
	       ,@opeDiasMora SMALLINT
	       ,@opeCredEsp SMALLINT
	       ,@opeSalCXC MONEY
	       ,@opeRefin CHAR(1)
	       ,@opeMoraCap MONEY
	       ,@opeZona CHAR(2)
	       ,@opeMoraInt MONEY
	       ,@opeDepto CHAR(2)
	       ,@opeFdic CHAR(6)
	       ,@opeBrch SMALLINT
	       ,@opeStatus SMALLINT
	       ,@opeProducto INT
	       ,@opeOrigen SMALLINT
	       ,@opeEmpresa CHAR(1)
	       ,@OpeProductoByte CHAR(6)
	       ,@opeStatusByte NUMERIC
	       ,@opeFrecPagInt DECIMAL
	       ,@opeSector DECIMAL
	       ,@opeOficial INT
	       ,@opeInCong CHAR(1)
	       ,@opeGenDiv CHAR(2)
	       ,@opeRegion CHAR(1)
	       ,@opeRefinByte CHAR(1)
	       ,@opeVecesRefin NUMERIC(3 ,0)
	       ,@opeFecUltPagCapital CHAR(8)
		   ,@opeCAT SMALLMONEY
		   ,@opeMontoCuotaPagar MONEY
		   ,@opeTasaInteresMoratoria SMALLMONEY
		   ,@opeSaldoTotal MONEY
	
	
	
	--Campos para calculos      
	DECLARE @ID AS INT
	DECLARE @TipoCambio AS DECIMAL(6 ,4)
	DECLARE @TipoCambioOriginal AS DECIMAL(6 ,4)
	DECLARE @factor AS DECIMAL(6 ,4)

	DECLARE @Moneda AS varchar(2)
	DECLARE @LimiteCredito AS decimal(16,2)
	DECLARE @BinTarjeta AS varchar(6)
	DECLARE @Tasa AS decimal(7,4)
	DECLARE @SaldoActual AS decimal(16,2)
	DECLARE @InteresesSuspenso AS decimal(10,2)
	DECLARE @FechaAlta AS date
	DECLARE @FechaVencimiento AS date
	DECLARE @SaldoConsumido AS decimal(16,2)
	DECLARE @CapitalPagoMinimo AS decimal(16,2)
	DECLARE @SaldoIntra AS DECIMAL(16,2)
	DECLARE @ModeloLiquidacion AS SMALLINT
	DECLARE @GrupoAfinidad AS INT
	DECLARE @CodigoProducto AS VARCHAR(6)
	DECLARE @MonedaLimiteCompra AS VARCHAR(1)
	DECLARE @TRUNCAR AS BIT
	DECLARE @FechaUltimoPago AS DATETIME
	
	--Estable si se debe truncar al redondear
	SET @TRUNCAR = 1
	
	--Factor de cambio y fecha de Proceso
	SELECT @TipoCambio = g.genTasa
		  ,@TipoCambioOriginal = g.genTasa
	      ,@opeFecRep = CONVERT(VARCHAR(8) ,g.genFecha ,112)
	FROM   GENERALES g
	WHERE  g.genStatus = 1
	
	--Obtenemos el primer ID para realizar el Ciclo
	SELECT @ID = MIN(t.ID)
	FROM   TMPTarjetasVASA t
	
	SELECT @opeTipIns = p.parTipIns
	      ,@opeCodIns      = p.parCodIns
	      ,@opeForPago     = p.parFormPagoTC
	      ,@opeTipo		   = p.parTipoOpe
	FROM   PARAMETROS p
	--Recorremos todos los registros
	WHILE (@ID IS NOT NULL)
	BEGIN
	    --Obtenemos los datos de la tabla
	    SELECT @CifCliente = cast(t.CIF AS DECIMAL)
	          ,@opeNum               = t.NumeroTarjeta
	          ,@opeProducto          = 0
	          ,@opeEmpresa           = '1'
	          ,@opeGar               = '09'
	          ,@OpeProductoByte      = LEFT(t.BinTarjeta ,6)
	          ,@opeStatusByte        = 0
	          ,@opeFrecPagInt        = 0
	          ,@opeSector            = 0
	          ,@opeOficial           = 0
	          ,@opeInCong            = ''
	          ,@opeRegion            = 'U'
	          ,@opeRefinByte         = ' '
	          ,@opeTasa              = 0
	          ,@opeDepto             = '01'
	          ,@opeZona              = '01'
	          ,@opeGenDiv            = 'ZZ'
	          ,@opeFdic              = '140107'
	          ,@opeTipCred           = 2
	          ,@opeOrigen            = 1
	          ,@opeForPago           = '51'
	          ,@opeSaldoVi           = 0
	          ,@opeSaldoMo           = 0
	          ,@opeSaldoCo           = 0
	          ,@opeSaldoVe           = 0
	          ,@opeSaldoEj           = 0
	          ,@opeSalCXC            = 0
	          ,@opeSaldoCa           = 0
	          ,@opeIntXcob           = 0
	          ,@opeIntSus            = 0
	          ,@opeMoraCap           = 0
	          ,@opeMoraInt           = 0
	          ,@opeMontoOt           = 0
	          ,@opeDiasMora          = t.DiasMora
	          ,@opeCredEsp           = 0
	          ,@opeRefin             = ''
	          ,@opeCateg             = 'CFM'
	          ,@opeBrch              = 1
	          ,@opePerGra            = 0
	          ,@opeVecesRefin        = 0
	          ,@opeValGar            = 0
	          ,@Moneda =			t.Moneda
	          ,@Tasa = t.Tasa
	          ,@InteresesSuspenso	= t.InteresesSuspenso
	          ,@LimiteCredito		= t.LimiteCredito
	          ,@FechaAlta			= t.FechaAlta
	          ,@SaldoActual			= t.SaldoActual
	          ,@opeFecUltPagCapital		 = ''--Campos capturador 2015
			  ,@opeCAT					 = 0 --Campos capturador 2015
			  
			  ,@opeTasaInteresMoratoria  = 0 --Campos capturador 2015
			  ,@opeSaldoTotal			 = 0 --Campos capturador 2015
	          ,@FechaVencimiento     = t.FechaVencimiento
	          ,@FechaUltimoPago		 = '1900-01-01'
	          ,@SaldoIntra			 = t.SaldoIntra
	          ,@ModeloLiquidacion    = t.ModeloLiquidacion
	          ,@GrupoAfinidad        = t.GrupoAfinidad
	          ,@CodigoProducto       = t.CodigoProducto
	          ,@CapitalPagoMinimo	 = t.CapitalPagoMinimo
	          ,@opeMontoCuotaPagar	 = t.PagoMinimo
	          ,@MonedaLimiteCompra   = t.MonedaLimiteCompra
	    FROM   TMPTarjetasVASA t
	    WHERE  T.ID = @ID
	    
	    
	    IF(YEAR(@FechaUltimoPago) <> 1900)
	    	SET @opeFecUltPagCapital = CONVERT(VARCHAR(8), @FechaUltimoPago, 112)
	    
	    --SET @opeMontoCuotaPagar = @PagoMinimo 		
	    
	    --PRINT 'Procesando operacion: ID = ' + CAST(@ID AS VARCHAR(20)) +
	    --', NO = ' + @opeNum
	    --Moneda
	    SET @opeMoneda = CASE @Moneda
	                          WHEN 'HN' THEN 1
	                          ELSE 2
	                     END
	    
	    --Factor de cambio
	    IF (@opeMoneda = 2)
	    BEGIN
	    	SET @TipoCambio = @TipoCambioOriginal
	        SET @factor = @TipoCambio
	    END
	    ELSE
	        SET @factor = 1
	    
	    --Ajuste según requerimiento 148-2016 para evitar que se conviera el valor en lempiras
	    IF(@MonedaLimiteCompra = 'L')
	    BEGIN
	    	SET @factor = 1
	    	SET @TipoCambio = 1
	    END
			
	    
	    --Estado
	    IF (@ModeloLiquidacion IN ('900') OR @GrupoAfinidad IN(10,22))
	        SET @opeStatus = 2
	    ELSE
	        SET @opeStatus = 0
	    
	    
	    IF (@opeMoneda = 1)
	    BEGIN
	        SET @opeTasa = @Tasa
	        SET @opeIntSus = @InteresesSuspenso
	        SET @opeMontoOt = CAST(@LimiteCredito * @TipoCambio AS NUMERIC(18 ,2))
	    END
	    ELSE
	    BEGIN
	        SET @opeTasa = @Tasa
	        SET @opeIntSus = CAST(@InteresesSuspenso * @factor AS NUMERIC(18 ,2))
	        SET @opeMontoOt = CAST(@LimiteCredito * @TipoCambio AS NUMERIC(18 ,2))
	    END
	    
	    --Fecha de otorgado
	        SET @opeFecOto = CONVERT(VARCHAR(8), @FechaAlta, 112)
	    
	    
	    --Fecha de vencimiento
	        SET @opeFecVen = CONVERT(VARCHAR(8) ,@FechaVencimiento ,112)

	    --Corrige fecha de vencimiento para tarjetas castigadas
	    IF(@opeStatus = 2 AND @opeFecVen < @opeFecOto)
	    BEGIN
	    	SET @opeFecVen = CONVERT(VARCHAR(8),DATEADD(YEAR,2,@opeFecOto),112)
	    END
	    
	    --Tasa de Interes
	    --IF (@opeTasa < 1)
	        --SET @opeTasa = 1    --Se Comenta esta condicion a peticion del proceso de riesgos
	    
	    --Categoria
	    SELECT TOP 1 @opeCateg = ISNULL(MAX(lv.LvEquivalente) ,'I')
	    FROM   ListasValores lv
	    WHERE  lv.liId = 15
	           AND lv.lvValor = @opeTipCred
	           AND CAST(lv.lvValor3 AS INT) <= @opeDiasMora
	           AND CAST(lv.lvValor4 AS INT) >= @opeDiasMora
	    
	   SET @opeSaldoTotal = CAST(@SaldoActual * @factor AS NUMERIC(18,2)) + ROUND(@SaldoIntra * @factor ,2 ,1)
	   SET @CapitalPagoMinimo = CAST(@CapitalPagoMinimo * @factor AS NUMERIC(18,2))
	   --*****************************************************************
	    --Para validar que se reporte el saldo vencido
	    --******************************************************************
		  --  IF (@opeDiasMora < 90)
				--SET @opeSaldoVi = 	@opeSaldoTotal
		  --  ELSE
		  --  	SET @opeSaldoMo = @opeSaldoTotal
	    	
	    IF (@opeFecVen <= @opeFecRep)
	        SET @opeSaldoVe = @opeSaldoTotal
	    ELSE
	    IF (@opeDiasMora < 90)
		BEGIN
	        SET @opeSaldoVi = @opeSaldoTotal
			
			-- COLOCA VALOR PAGO MINIMO DE CAPITAL A OPERACIONES VIGENTES CON DIAS DE MORA
			IF @opeDiasMora > 0
			begin
				SET @opeMoraCap = @CapitalPagoMinimo	

				--Si el Capital en mora es mayor al saldo vigente se coloca el saldo vigente como capital en mora
				if @opeMoraCap > @opeSaldoVi
					set @opeMoraCap = @opeSaldoVi
			end
		END			
	    ELSE
	    	BEGIN
	    		SET @opeSaldoMo = @opeSaldoTotal
	    		SET @opeMoraCap = @CapitalPagoMinimo	

	    	END
		
		
		--VALIDACION PARA QUE SI LOS DIAS DE MORA SON MAYOR A 90 VALIDE QUE EL SALDO CAPITAL MORA NO SEA MAYOR AL SALDO CAPITAL 30/10/2019 --MARIO ESCOBAR
		if @opeMoraCap > @opeSaldoTotal
			set @opeMoraCap = @opeSaldoTotal

	    
	    --Reemplaza procedimiento usp_updateSaldoCapitalMora
		--SET @opeMoraCap = 0--CAST(@T1UMO1 * @factor AS NUMERIC(18 ,2))
	    
	    --Elimina el saldo en mora negativo
	    IF (@opeMoraCap < 0)
	        SET @opeMoraCap = 0
	    
	    --Reemplaza procedimiento usp_updateDiasMoraTarjetas    
	    IF (@opeMoraCap > 0 AND @opeDiasMora = 0)
	        SET @opeDiasMora = 1
	    
	    IF ((@opeSaldoVi + @opeSaldoMo + @opeSaldoVe) = 0)
	    BEGIN
	        SET @opeDiasMora = 0
	        SET @opeCateg = 'CFM'
	    END
	    
	    IF (@opeStatus = 2)
	    BEGIN
	        SET @opeSaldoCa = @opeSaldoVi + @opeSaldoMo + @opeSaldoVe
	        SET @opesaldove = 0
	        SET @opeSaldoVi = 0
	        SET @opeSaldoMo = 0
	        --SET @opeForPago = 'ZZ' --MODIFICADO 16/10/2019 SOLICITADO POR VICTORIA LARA
			SET @opeForPago = '51'
	        SET @opeMoraCap = 0
	    END
	    
	    --Dias Mora Tarjetas Vencidas
	    IF (@opeSaldoVe > 0 AND @opeDiasMora = 0)
	    BEGIN
	        SET @opeDiasMora = DATEDIFF(DAY ,@opeFecVen ,@opeFecRep)
	        IF (@opeDiasMora = 0)
	            SET @opeDiasMora = 1
	    END
	    
	    --Remplaza procedimiento usp_updateCodigoDestinoBPAlternativa
	    SELECT @opeFdic = ISNULL(lv.LvEquivalente ,'140107')
	    FROM   ListasValores lv
	    WHERE  lv.liId = 16
	           AND lv.lvValor = @CodigoProducto
	    
	    --Reemplaza procedimiento usp_updateInteresesPorCobrarNegativos
	    IF (@opeIntXcob < 0)
	    BEGIN
	        SET @opeIntXcob = 0
	    END 
	    
	    --Reemplaza procedimiento usp_updateInteresesSuspensoNegativos
	    IF (@opeIntSus < 0)
	        SET @opeIntSus = 0
	    
	    
	    IF (
	           @opeDiasMora > 0
	           AND @opeMoraInt = 0
	           AND @opeMoraCap = 0
	           AND @opeMoraInt > 0
	       )
	        SET @opeMoraInt = @opeIntXcob
	    
	    
	    
	    
	    --Reemplaza procedimiento usp_updateSaldoInteresesMora
	    IF (
	           @opeDiasMora > 0
	           AND @opeMoraInt = 0
	           AND @opeMoraCap = 0
	           AND @opeIntXcob > 0
	       )
	        SET @opeMoraInt = @opeIntXcob
	    
	    SET @opeStatusByte = CASE 
	                              WHEN @opeSaldoVi > 0 THEN 0
	                              WHEN @opeSaldoMo > 0 THEN 1
	                              WHEN @opeSaldoCa > 0 THEN 10
	                              ELSE 0
	                         END 
		
	    /*******************************************************************/
	    --Ajuste monto Cuota a Pagar
	    --Requerimiento 107-2016
	    --Fecha: 2016-08-26
	    
	    --Para las operaciones, Vencidas y Ejecución, se debe reportar el saldo
		IF(@opeSaldoVe > 0 OR @opeSaldoEj > 0)
		BEGIN
			SET @opeMontoCuotaPagar = @opeSaldoTotal
		END
		
		/*********************Fin requerimiento 107-2016***************************/
	    
	    /*******************************************************************/
	    --Ajuste monto Cuota a Pagar
	    --Requerimiento 165-2016
	    --Fecha: 2016-10-26
	    --Para las operaciones castigadas se debe reportar el saldo + interes en suspenso 165-2016
		IF(@opeSaldoCa > 0)
		BEGIN
			SET @opeMontoCuotaPagar = @opeSaldoTotal + @opeIntSus
			SET @opeEmpresa='3'--SI LA OPERACIONES TIENE SALDO CASTIGADO SE COLOCA EMPRESA 3 --30/10/2019 --MARIO ESCOBAR
		END
		/****************************************************/
	    if((select COUNT(*) from operaciones where opeNum = @opeNum and opeMoneda = @opeMoneda ) < 1)
		begin
			EXECUTE usp_OPERACIONES_INSERT
				@opeNum,
				@opeMoneda,
				@CifCliente,
				@opeTipIns,
				@opeCodIns,
				@opeFecRep,
				@opeFecOto,
				@opeFecVen,
				@opeSaldoVi,
				@opeSaldoMo,
				@opeSaldoVe,
				@opeSaldoCo,
				@opeSaldoEj,
				@opeSaldoCa,
				@opeGar,
				@opeTipo,
				@opeCateg,
				@opeTipCred,
				@opeMontoOt,
				@opeIntXcob,
				@opeIntSus,
				@opeValGar,
				@opeTasa,
				@opeForPago,
				@opePerGra,
				@opeDiasMora,
				@opeCredEsp,
				@opeSalCXC,
				@opeRefin,
				@opeMoraCap,
				@opeZona,
				@opeMoraInt,
				@opeDepto,
				@opeFdic,
				@opeBrch,
				@opeStatus,
				@opeProducto,
				@opeOrigen,
				@opeEmpresa,
				@OpeProductoByte,
				@opeStatusByte,
				@opeFrecPagInt,
				@opeSector,
				@opeOficial,
				@opeInCong,
				@opeGenDiv,
				@opeRegion,
				@opeRefinByte,
				@opeVecesRefin
			   ,@opeFecUltPagCapital
			   ,@opeCAT
			   ,@opeMontoCuotaPagar
			   ,@opeTasaInteresMoratoria
			   ,@opeSaldoTotal
	    end
	    
	    SELECT @ID = MIN(t.ID)
	    FROM   TMPTarjetasVASA t
	    WHERE  T.ID > @ID
	END
	
	
	
	--UPDATE operaciones
	--SET    opeDiasMora = oc.DiasMoraTotales
	--select * FROM   operaciones o
	--WHERE  o.opeStatus IN (2)
	--       AND o.opeTipo IN (130000)
	
END





