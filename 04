import { apiFeedbackAuthorized } from "./APIS";
import { endpointsAPI } from "./endpointApi";


export const USER_STATUS = { INACTIVO: 0, ACTIVO: 1 };

// Todas las opciones de estado.
// ⚠️ Confirmar con backend los valores 2, 3 y 4 (solo 0 y 1 están confirmados).
export const USER_STATUS_OPTIONS = [
  { value: 1, label: "Activo" },
  { value: 2, label: "De vacaciones" },
  { value: 3, label: "Maternidad" },
  { value: 4, label: "Incapacitado(a)" },
  { value: 0, label: "Inactivo" },
];

// "De Vacaciones" / "incapacitado" → valor numérico
const normalizeStatus = (text = "") => text.toLowerCase().replace("(a)", "").trim();
export const statusValueFromLabel = (label) =>
  USER_STATUS_OPTIONS.find((o) => normalizeStatus(o.label) === normalizeStatus(label))?.value ?? "";
export const statusLabelFromValue = (value) =>
  USER_STATUS_OPTIONS.find((o) => o.value === Number(value))?.label ?? "";

// Campos que acepta el filtro. null = ese filtro no se aplica.
const FILTER_FIELDS = [
  "search",
  "status",
  "employeeBranchUbication",
  "companyPositionId",
  "companyLocationId",
  "companyAreaId",
  "companyBranchId",
  "roleId",
  "pageNumber",
  "pageSize",
];

const toFilterRequest = (filters = {}) =>
  Object.fromEntries(
    FILTER_FIELDS.map((field) => {
      const value = filters[field];
      return [field, value === "" || value === undefined ? null : value];
    })
  );

export const coachService = {
  loggedUserTeams: async () => {
    const { data } = await apiFeedbackAuthorized.get(endpointsAPI.loggedUserTeams);
    return data.data;
  },


  loggedUserTeamsMembers: async (area, team, position) => {
    const { data } = await apiFeedbackAuthorized.get(`${endpointsAPI.loggedUserTeamMembers}?companyAreaId=${area}&teamId=${team}&companyPositionId=${position}`);
    console.log(data, area, team, position);
    return data.data;
  },


  indicatorsFilter: async (user) => {
    const { data } = await apiFeedbackAuthorized.post(endpointsAPI.users, user);
    return data.data;
  },

  update: async (id, user) => {
    const { data } = await apiFeedbackAuthorized.put(`${endpointsAPI.users}/${id}`, { id, ...user });
    return data.data;
  },

  remove: async (id) => {
    await apiFeedbackAuthorized.delete(`${endpointsAPI.users}/${id}`);
  },

  // pageNumber y pageSize en null → exporta todo lo filtrado
  exportExcel: (filters) =>
    apiFeedbackAuthorized.post(endpointsAPI.usersExportExcel, toFilterRequest(filters), { responseType: "blob" }),

  exportPdf: (filters) =>
    apiFeedbackAuthorized.post(endpointsAPI.usersExportPdf, toFilterRequest(filters), { responseType: "blob" }),

  syncAs400: async () => {
    const { data } = await apiFeedbackAuthorized.post(endpointsAPI.usersSyncAs400);
    return data;
  },

  // GET /api/users?status=&isLeader=  (los parámetros vacíos no se envían)
  list: async ({ status, isLeader } = {}) => {
    const { data } = await apiFeedbackAuthorized.get(endpointsAPI.users, { params: { status, isLeader } });
    return data.data ?? [];
  },

  // Activa o quita el rol de líder
  setLeader: async (id, isLeader) => {
    const { data } = await apiFeedbackAuthorized.put(`${endpointsAPI.users}/${id}/leader`, { isLeader });
    return data.data;
  },
 
  // GET /api/logged-user/coaching/members/ongoing-assignments?name=&employeeCode=
  // Respuesta viene agrupada por equipo; se aplana para la tabla de colaboradores
  ongoingAssignments: async ({ name, employeeCode } = {}) => {
    const { data } = await apiFeedbackAuthorized.get(endpointsAPI.coachingOngoingAssignments, {
      params: { name: name || null, employeeCode: employeeCode || null },
    });
    const teams = data.data ?? [];
    return teams.flatMap((t) => t.members.map((m) => ({ ...m, teamId: t.teamId, teamName: t.teamName })));
  },

  // POST /api/logged-user/coaching/members/indicators
  memberIndicators: async (memberUserId) => {
    const { data } = await apiFeedbackAuthorized.post(endpointsAPI.coachingMemberIndicators, { memberUserId });
    return data.data ?? [];
  },

  // POST /api/coaching/calculate - solo previsualiza, no persiste
  calculate: async ({ achievedValue, targetValue, minimumValue, maximumValue, rule, formula }) => {
    const { data } = await apiFeedbackAuthorized.post(endpointsAPI.coachingCalculate, {
      achievedValue, targetValue, minimumValue, maximumValue, rule, formula,
    });
    return data.data.achievementPercentage;
  },

  // POST /api/coaching/sessions/{sessionId}/results
  saveSessionResults: async (sessionId, { results, actions }) => {
    const { data } = await apiFeedbackAuthorized.post(
      `${endpointsAPI.coachingSessions}/${sessionId}/results`,
      { results, actionPlan: { actions } }
    );
    return data.data;
  },

  // POST /api/coaching/assignments - body: { teams: [{ teamId, members: [{ memberUserId, indicators: [{ indicatorId, weight, targetValue, targetUnitId, validFrom, validTo }] }] }] }
  createAssignments: async (teams) => {
    const { data } = await apiFeedbackAuthorized.post(endpointsAPI.coachAssignment, { teams });
    return data.data;
  },
};


