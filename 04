        private const int TIMEOUT_DEFAULT = 600;

        /// <summary>
        /// Timeout (en segundos) para comandos y bulk copy, leído del parámetro "TimeoutSegundos"
        /// (del proceso "DEstadoCuenta" o de "General"). Si no existe o no es válido, usa TIMEOUT_DEFAULT.
        /// </summary>
        public int TimeoutSegundos
        {
            get
            {
                string valor;
                int segundos;
                if (parametros.TryGetValue("TimeoutSegundos", out valor) &&
                    int.TryParse(valor, out segundos) && segundos >= 0)
                {
                    return segundos;
                }
                return TIMEOUT_DEFAULT;
            }
        }

        public void Main()
        {
            if (ObtieneParametros())
            {

                fecha_generacion = parametros["FechaProceso"];
                ParseaConsultas();
                var estado_proceso = ObtenerEstadoProceso();

                if (estado_proceso == null)
                {
                    Dts.TaskResult = (int)ScriptResults.Failure;
                    return;
                }

                if (estado_proceso != parametros["EstadoInicial"])
                {
                    if (RealizarReintento(estado_proceso))
                    {
                        Dts.TaskResult = (int)ScriptResults.Success;
                        return;
                    }
                    else
                    {
                        Dts.TaskResult = (int)ScriptResults.Failure;
                        return;
                    }
                }
                else
                {
                    if (RealizarMovimiento())
                    {
                        Dts.TaskResult = (int)ScriptResults.Success;
                        return;
                    }
                    else
                    {
                        Dts.TaskResult = (int)ScriptResults.Failure;
                        return;
                    }
                }
            }

            Dts.TaskResult = (int)ScriptResults.Failure;
        }

        public bool RealizarMovimiento()
        {
            List<DEstadoCuenta> resultado = ObtenerInfoAs400();

            // null = hubo error al leer AS400 (ya quedó registrado en el log).
            // Importante: sin esto, un error de lectura se trataba como "0 registros"
            // y el archivo se marcaba como procesado en AS400.
            if (resultado == null)
                return false;

            if (resultado.Count == 0)
            {
                RegistraProceso("F", $"No se encontraron registros en AS400 para el día {fecha_generacion}");
                UpdateArchivoAS400();
                return true;
            }

            if (!PreParseo())
                return false;

            DataTable data = ConvertirADataTable(resultado);
            if (data.Rows.Count == 0)
                return false;

            if (!EjecutarBulkInsertBandejaVasa(data))
                return false;

            if (!PostParseo())
                return false;

            if (!UpdateArchivoAS400())
                return false;

            RegistraProceso("E", $"Proceso ejecutado exitosamente");
            return true;
        }

        public bool ObtieneParametros()
        {
            ConnectionManager cm = Dts.Connections["DESCARGAINFO"];
            SqlConnection conn = null;

            try
            {
                conn = cm.AcquireConnection(null) as SqlConnection;
                if (conn == null)
                {
                    throw new InvalidOperationException("No se pudo obtener la conexión desde el Connection Manager.");
                }

                // Primero los del proceso (tienen prioridad) y luego los generales.
                // Si un parámetro existe en ambos, se queda el valor de "DEstadoCuenta".
                CargarParametrosProceso(conn, "DEstadoCuenta");
                CargarParametrosProceso(conn, "General");

                return true;
            }
            catch (Exception ex)
            {
                RegistraProceso("F", $"Falló obtener información desde usp_GetParametersByProcess con error {ex.Message}");

                return false;
            }
            finally
            {
                if (conn != null)
                    cm.ReleaseConnection(conn);
            }
        }

        private void CargarParametrosProceso(SqlConnection conn, string proceso)
        {
            using (SqlCommand cmd = new SqlCommand("usp_GetParametersByProcess", conn))
            {
                cmd.CommandType = CommandType.StoredProcedure;
                // Aquí TimeoutSegundos puede no estar cargado aún, así que usa TIMEOUT_DEFAULT
                cmd.CommandTimeout = TimeoutSegundos;
                cmd.Parameters.Add("@Proceso", SqlDbType.VarChar).Value = proceso;

                using (SqlDataReader reader = cmd.ExecuteReader())
                {
                    while (reader.Read())
                    {
                        string idParametro = reader["IdParametro"].ToString();
                        string valorParametro = reader["ValorParametro"].ToString();

                        if (!parametros.ContainsKey(idParametro))
                            parametros.Add(idParametro, valorParametro);
                    }
                }
            }
        }

        public void ParseaConsultas()
        {
            string hora = DateTime.Now.ToString("HHmmss");
            string fecha = DateTime.Now.ToString("yyyy-MM-dd");
            sql_ConsultaEstado = parametros["ConsultaEstado"]
                 .Replace("{ARCHIVO_CONTROL}", parametros["ArchivoControl"])
                 .Replace("{FECHA_GENERACION}", $"'{fecha_generacion}'")
                 .Replace("{ESTADO_INICIAL}", $"'{parametros["EstadoInicial"]}'")
                 .Replace("{ARCHIVO_GENERADO}", $"'{parametros["ArchivoGenerado"]}'");

            sql_ConsultaOrigen = parametros["ConsultaOrigen"]
                .Replace("{ARCHIVO_ORIGEN}", parametros["ArchiviOrigen"]);

            sql_ConsultaActualizar = parametros["ConsultaActualizar"]
                .Replace("{ARCHIVO_CONTROL}", parametros["ArchivoControl"])
                .Replace("{ESTADO_FINAL}", $"'{parametros["EstadoFinal"]}'")
                .Replace("{FECHA_PROCESADO}", $"'{fecha}'")
                .Replace("{HORA_PROCESADO}", $"'{hora}'")
                .Replace("{USER}", $"'{parametros["Usuario"]}'")
                .Replace("{FECHA_GENERACION}", $"'{fecha_generacion}'")
                .Replace("{ESTADO_INICIAL}", $"'{parametros["EstadoInicial"]}'")
                .Replace("{ARCHIVO_GENERADO}", $"'{parametros["ArchivoGenerado"]}'");
        }

        public string ObtenerEstadoProceso()
        {
            string estado_proceso = string.Empty;
            ConnectionManager cm = Dts.Connections["AS400"];
            OleDbConnection conn = null;

            try
            {
                conn = cm.AcquireConnection(null) as OleDbConnection;
                if (conn == null)
                {
                    throw new InvalidOperationException("No se pudo obtener la conexión desde el Connection Manager.");
                }


                using (IDbCommand cmd = conn.CreateCommand())
                {
                    cmd.CommandText = sql_ConsultaEstado;
                    cmd.CommandTimeout = TimeoutSegundos;
                    using (IDataReader reader = cmd.ExecuteReader())
                    {

                        if (reader.Read())
                        {
                            estado_proceso = reader.GetString(0);

                        }
                    }
                }
            }
            catch (Exception ex)
            {
                RegistraProceso("F", $"Falló obtener estado proceso:  {sql_ConsultaEstado}  | ERROR :  {ex.Message} ");
                return null;
            }
            finally
            {
                if (conn != null)
                    cm.ReleaseConnection(conn);
            }

            return estado_proceso;
        }

        public bool RealizarReintento(string estadoProceso)
        {
            int intentoActual = 0;
            var reintentos = ObtenerInfoReintentos();

            while (estadoProceso != "G" && intentoActual < reintentos.CantidadReintentos)
            {
                intentoActual++;
                System.Threading.Thread.Sleep(reintentos.MinutosReintentos * 60 * 1000);
                estadoProceso = ObtenerEstadoProceso();
            }

            if (estadoProceso == "G")
            {
                return RealizarMovimiento();
            }
            else
            {
                // Corregido: antes este mensaje se registraba cuando el estado SÍ llegaba a "G",
                // y cuando se agotaban los reintentos no se registraba nada.
                RegistraProceso("F", $"Falló reintentos {reintentos.CantidadReintentos} durante: {reintentos.MinutosReintentos} cada uno, no se actualizó estado G en AS400");

                return false;
            }
        }

        public Reintentos ObtenerInfoReintentos()
        {
            return new Reintentos
            {
                CantidadReintentos = int.Parse(parametros["CantidadReintentos"]),
                MinutosReintentos = int.Parse(parametros["MinutosReintentos"]),
            };
        }

        /// <summary>
        /// Devuelve la lista de detalles de estado de cuenta del AS400, o null si ocurrió un error al leer.
        /// </summary>
        public List<DEstadoCuenta> ObtenerInfoAs400()
        {
            List<DEstadoCuenta> hDetalleCuentas = new List<DEstadoCuenta>();
            ConnectionManager cm = Dts.Connections["AS400"];
            OleDbConnection conn = null;

            try
            {
                conn = cm.AcquireConnection(null) as OleDbConnection;
                if (conn == null)
                {
                    throw new InvalidOperationException("No se pudo obtener la conexión desde el Connection Manager.");
                }

                {
                    using (IDbCommand cmd = conn.CreateCommand())
                    {
                        cmd.CommandText = sql_ConsultaOrigen;
                        cmd.CommandTimeout = TimeoutSegundos;
                        using (IDataReader reader = cmd.ExecuteReader())
                        {
                            while (reader.Read())
                            {
                                DEstadoCuenta hEstado = new DEstadoCuenta();

                                hEstado.Origen = reader.GetString(0);
                                hEstado.FechaCarga = reader.GetString(1);
                                hEstado.CodigoEmisor = reader.GetString(2);
                                hEstado.EcDetalleNoCuenta = reader.GetString(3);
                                hEstado.FechaCorte = reader.GetString(4);
                                hEstado.EcDetalleNoTarjeta = reader.GetString(5);
                                hEstado.NombreThP = reader.GetString(6);
                                hEstado.EcDetalleEmisorMadre = reader.GetString(7);
                                hEstado.EcDetalleCuentaMadre = reader.GetString(8);
                                hEstado.NoAutorizacion = reader.GetString(9);
                                hEstado.FechaConsumo = reader.GetString(10);
                                hEstado.CodigoMov = reader.GetString(11);
                                hEstado.DescripcionMov = reader.GetString(12);
                                hEstado.MonedaMov = reader.GetString(13);
                                hEstado.MontoMov = reader.GetDecimal(14);
                                hEstado.TarjetaImprimir = reader.GetString(15);
                                hEstado.TasaEfectivaAnualEfMn = reader.GetDecimal(16);
                                hEstado.TasaEfectivaAnualEfMe = reader.GetDecimal(17);
                                hEstado.NoCuentaClaro = reader.GetString(18);
                                hEstado.Mcc = reader.GetString(19);
                                hEstado.ProcesadorOrigen = "LOCAL";

                                hDetalleCuentas.Add(hEstado);
                            }
                        }
                    }
                }

            }
            catch (Exception ex)
            {
                RegistraProceso("F", $"Falló obtener información desde {parametros["ArchiviOrigen"]} con error {ex.Message}");
                return null;

            }
            finally
            {
                if (conn != null)
                    cm.ReleaseConnection(conn);
            }

            return hDetalleCuentas;
        }

