CREATE VIEW [dbo].[uvw_NombreFiadores_v2]
AS
WITH cteListadoFiadores AS
(
    SELECT ROW_NUMBER() OVER (PARTITION BY C.NoUsuario ORDER BY C.NoUsuario) AS NoRow,
           C.NoUsuario, C.NombreApellido, C.NoDocumento,
           C.DomicilioParticular1, C.DomicilioParticular2, C.DomicilioParticular3,
           C.Telefono, C.TelefonoLaboral
    FROM dbo.EMaestroFiadores C
),
Fiadores AS
(   -- Un registro por usuario con sus 3 fiadores (mismo MAX/CASE del original)
    SELECT NoUsuario,
           MAX(CASE NoRow WHEN 1 THEN NombreApellido END)       AS NombreFiador1,
           MAX(CASE NoRow WHEN 1 THEN NoDocumento END)          AS NumCedulaFiador1,
           MAX(CASE NoRow WHEN 1 THEN DomicilioParticular1 END) AS DireccionFiador1,
           MAX(CASE NoRow WHEN 1 THEN DomicilioParticular2 END) AS DireccionFiador1_2,
           MAX(CASE NoRow WHEN 1 THEN DomicilioParticular3 END) AS DireccionFiador1_3,
           MAX(CASE NoRow WHEN 1 THEN Telefono END)             AS Telefono1_1,
           MAX(CASE NoRow WHEN 1 THEN TelefonoLaboral END)      AS Telefono1_2,
           MAX(CASE NoRow WHEN 2 THEN NombreApellido END)       AS NombreFiador2,
           MAX(CASE NoRow WHEN 2 THEN NoDocumento END)          AS NumCedulaFiador2,
           MAX(CASE NoRow WHEN 2 THEN DomicilioParticular1 END) AS DireccionFiador2,
           MAX(CASE NoRow WHEN 2 THEN DomicilioParticular2 END) AS DireccionFiador2_2,
           MAX(CASE NoRow WHEN 2 THEN DomicilioParticular3 END) AS DireccionFiador2_3,
           MAX(CASE NoRow WHEN 2 THEN Telefono END)             AS Telefono2_1,
           MAX(CASE NoRow WHEN 2 THEN TelefonoLaboral END)      AS Telefono2_2,
           MAX(CASE NoRow WHEN 3 THEN NombreApellido END)       AS NombreFiador3,
           MAX(CASE NoRow WHEN 3 THEN NoDocumento END)          AS NumCedulaFiador3,
           MAX(CASE NoRow WHEN 3 THEN DomicilioParticular1 END) AS DireccionFiador3,
           MAX(CASE NoRow WHEN 3 THEN DomicilioParticular2 END) AS DireccionFiador3_2,
           MAX(CASE NoRow WHEN 3 THEN DomicilioParticular3 END) AS DireccionFiador3_3,
           MAX(CASE NoRow WHEN 3 THEN Telefono END)             AS Telefono3_1,
           MAX(CASE NoRow WHEN 3 THEN TelefonoLaboral END)      AS Telefono3_2
    FROM cteListadoFiadores
    GROUP BY NoUsuario
),
Cuentas AS
(   -- Mismas combinaciones del GROUP BY Tar.NoUsuario, Tar.NoCuentaClaro original
    SELECT DISTINCT NoUsuario, NoCuentaClaro
    FROM ETarjetas
)
SELECT
     CAST('VASA' AS VARCHAR(4))                           AS Origen
    ,CAST(T.NoUsuario AS VARCHAR(13))                     AS NoUsuario
    ,CAST(ISNULL(F.NombreFiador1, '')      AS VARCHAR(40)) AS NombreFiador1
    ,CAST(ISNULL(F.NumCedulaFiador1, '')   AS VARCHAR(15)) AS NumCedulaFiador1
    ,CAST(ISNULL(F.DireccionFiador1, '')   AS VARCHAR(40)) AS DireccionFiador1
    ,CAST(ISNULL(F.DireccionFiador1_2, '') AS VARCHAR(40)) AS DireccionFiador1_2
    ,CAST(ISNULL(F.DireccionFiador1_3, '') AS VARCHAR(40)) AS DireccionFiador1_3
    ,CAST(ISNULL(F.Telefono1_1, '')        AS VARCHAR(30)) AS Telefono1_1
    ,CAST(ISNULL(F.Telefono1_2, '')        AS VARCHAR(30)) AS Telefono1_2
    ,CAST(ISNULL(F.NombreFiador2, '')      AS VARCHAR(40)) AS NombreFiador2
    ,CAST(ISNULL(F.NumCedulaFiador2, '')   AS VARCHAR(15)) AS NumCedulaFiador2
    ,CAST(ISNULL(F.DireccionFiador2, '')   AS VARCHAR(40)) AS DireccionFiador2
    ,CAST(ISNULL(F.DireccionFiador2_2, '') AS VARCHAR(40)) AS DireccionFiador2_2
    ,CAST(ISNULL(F.DireccionFiador2_3, '') AS VARCHAR(40)) AS DireccionFiador2_3
    ,CAST(ISNULL(F.Telefono2_1, '')        AS VARCHAR(30)) AS Telefono2_1
    ,CAST(ISNULL(F.Telefono2_2, '')        AS VARCHAR(30)) AS Telefono2_2
    ,CAST(ISNULL(F.NombreFiador3, '')      AS VARCHAR(40)) AS NombreFiador3
    ,CAST(ISNULL(F.NumCedulaFiador3, '')   AS VARCHAR(15)) AS NumCedulaFiador3
    ,CAST(ISNULL(F.DireccionFiador3, '')   AS VARCHAR(40)) AS DireccionFiador3
    ,CAST(ISNULL(F.DireccionFiador3_2, '') AS VARCHAR(40)) AS DireccionFiador3_2
    ,CAST(ISNULL(F.DireccionFiador3_3, '') AS VARCHAR(40)) AS DireccionFiador3_3
    ,CAST(ISNULL(F.Telefono3_1, '')        AS VARCHAR(30)) AS Telefono3_1
    ,CAST(ISNULL(F.Telefono3_2, '')        AS VARCHAR(30)) AS Telefono3_2
    ,CAST(T.NoCuentaClaro AS VARCHAR(10))                  AS NoCuentaClaro
FROM Fiadores F
INNER JOIN Cuentas T ON T.NoUsuario = F.NoUsuario;
GO















