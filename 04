import { useCallback, useEffect, useMemo, useState } from "react";
import { AlertCircle, Pencil, Plus, Search, Trash2 } from "lucide-react";
import { ConfirmDialog, Datatable, useToast } from "../../../../shared/components";
import { CatalogFormModal } from "./CatalogFormModal";
import { normalizeText } from "../../../../helpers/format";
import styles from "../../../Pages.module.css";

const PAGE_SIZE = 10;

const STATUS_FILTERS = [
  { value: "todos", label: "Todos los estados" },
  { value: "true", label: "Activos" },
  { value: "false", label: "Inactivos" },
];

const capitalize = (text) => text.charAt(0).toUpperCase() + text.slice(1);

// "2026-11-01T00:00:00" → "01/11/2026" (sin pasar por Date: no hay desfase de zona horaria)
const formatDate = (value) => String(value).slice(0, 10).split("-").reverse().join("/");

// Solo estos tipos participan en la búsqueda de texto
const SEARCHABLE = [undefined, "text", "number", "select"];

export function CatalogCrudPage({ config }) {
  const {
    title, subtitle, singular, plural, feminine, icon: Icon, service, fields,
    labelField = "name", sort, statusFilter, deleteHint,
  } = config;
  const e = feminine ? "a" : "o";
  const article = feminine ? "la" : "el";
  const labelOf = (it) => String(it?.[labelField] ?? "").trim();

  const toast = useToast();

  const [items, setItems] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  const [search, setSearch] = useState("");
  const [status, setStatus] = useState("todos");
  const [page, setPage] = useState(1);

  const [form, setForm] = useState({ open: false, item: null });

  const [toDelete, setToDelete] = useState(null);
  const [deleting, setDeleting] = useState(false);
  const [deleteError, setDeleteError] = useState("");

  /* ---------- Carga ---------- */
  const load = useCallback(async () => {
    setLoading(true);
    setError("");
    try {
      setItems(await service.list());
    } catch (err) {
      setError(err.noAccess
        ? `No tienes permiso para ver ${plural}.`
        : `No se pudo cargar el listado de ${plural}.`);
    } finally {
      setLoading(false);
    }
  }, [service, plural]);

  useEffect(() => { load(); }, [load]);

  /* ---------- Búsqueda, filtro, orden y paginación (en el navegador) ---------- */
  const filtered = useMemo(() => {
    const q = normalizeText(search);
    const searchable = fields.filter((f) => SEARCHABLE.includes(f.type));

    let list = q
      ? items.filter((it) =>
          String(it.id).includes(q) || searchable.some((f) => normalizeText(it[f.name]).includes(q)))
      : items;

    if (statusFilter && status !== "todos") {
      list = list.filter((it) => String(it.status) === status);
    }

    const byLabel = (a, b) => String(a[labelField] ?? "").localeCompare(String(b[labelField] ?? ""), "es");
    return [...list].sort(sort ?? byLabel);
  }, [items, search, status, statusFilter, fields, labelField, sort]);

  const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
  const currentPage = Math.min(page, totalPages);
  const rows = filtered.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);

  /* ---------- Acciones ---------- */
  const handleSaved = (item, isEdit) => {
    setForm({ open: false, item: null });
    toast.success(
      `${capitalize(singular)} ${isEdit ? "actualizad" : "cread"}${e}`,
      `"${labelOf(item)}" se ${isEdit ? "actualizó" : "agregó"} correctamente.`
    );
    load();
  };

  const openDelete = (item) => {
    setDeleteError("");
    setToDelete(item);
  };

  const confirmDelete = async () => {
    setDeleting(true);
    setDeleteError("");
    try {
      await service.remove(toDelete.id);
      toast.success(`${capitalize(singular)} eliminad${e}`, `"${labelOf(toDelete)}" se eliminó correctamente.`);
      setToDelete(null);
      load();
    } catch (err) {
      setDeleteError(err.noAccess
        ? `No tienes permiso para eliminar ${plural}.`
        : err.response?.data?.message
          ?? deleteHint
          ?? `No se pudo eliminar. Es posible que ${article} ${singular} esté asignad${e} a uno o más usuarios.`);
    } finally {
      setDeleting(false);
    }
  };

  /* ---------- Columnas ---------- */
  const dash = <span className={styles.muted}>—</span>;

  const renderValue = (f, it) => {
    const value = it[f.name];
    if (value === null || value === undefined || value === "") return dash;
    switch (f.type) {
      case "number":
        return <span className={styles.mono}>{value}</span>;
      case "date":
        return <span className={styles.mono}>{formatDate(value)}</span>;
      case "boolean":
        return value
          ? <span className={`${styles.tag} ${styles.tagTeal}`}>Activo</span>
          : <span className={`${styles.tag} ${styles.tagNeutral}`}>Inactivo</span>;
      case "select": {
        const label = f.options.find((o) => o.value === value)?.label ?? value;
        return <span className={`${styles.tag} ${styles.tagBlue}`}>{label}</span>;
      }
      default:
        return f.name === labelField ? <span className={styles.cellMain}>{value}</span> : value;
    }
  };

  const columns = [
    {
      key: "id",
      header: "ID",
      width: 80,
      render: (it) => <span className={styles.mono}>{it.id}</span>,
    },
    ...fields.map((f) => ({
      key: f.name,
      header: f.label,
      width: f.width,
      render: (it) => renderValue(f, it),
    })),
    {
      key: "actions",
      header: "Acciones",
      align: "right",
      width: 120,
      render: (it) => (
        <div className={styles.rowActions}>
          <button type="button" className={styles.iconBtn} title="Editar"
            aria-label={`Editar ${labelOf(it)}`} onClick={() => setForm({ open: true, item: it })}>
            <Pencil size={16} />
          </button>
          <button type="button" className={`${styles.iconBtn} ${styles.iconBtnDanger}`} title="Eliminar"
            aria-label={`Eliminar ${labelOf(it)}`} onClick={() => openDelete(it)}>
            <Trash2 size={16} />
          </button>
        </div>
      ),
    },
  ];

  const hasFilters = Boolean(search) || status !== "todos";

  return (
    <>
      <header className={styles.pageHeader}>
        <div style={{ display: "flex", alignItems: "center", gap: 16 }}>
          <div className={styles.headerIcon}>
            <Icon size={26} />
          </div>
          <div>
            <span className={styles.eyebrow}>Administración</span>
            <h1 className={styles.title}>{title}</h1>
            <p className={styles.subtitle}>{subtitle}</p>
          </div>
        </div>

        <div className={styles.actions}>
          <button type="button" className={`${styles.btn} ${styles.btnPrimary}`}
            onClick={() => setForm({ open: true, item: null })}>
            <Plus size={18} /> Nuev{e} {singular}
          </button>
        </div>
      </header>

      {error && (
        <div className={`${styles.banner} ${styles.bannerError}`} role="alert">
          <AlertCircle size={18} />
          <p>
            {error}{" "}
            <button type="button" className={styles.linkBtn} style={{ padding: 0 }} onClick={load}>
              Reintentar
            </button>
          </p>
        </div>
      )}

      <section className={styles.panel}>
        <div className={styles.toolbar}>
          <label className={styles.search}>
            <Search size={16} />
            <input className={styles.input} placeholder={`Buscar ${plural}...`} value={search}
              onChange={(ev) => { setSearch(ev.target.value); setPage(1); }}
              aria-label={`Buscar ${plural}`} />
          </label>

          {statusFilter && (
            <select className={styles.select} style={{ width: "auto" }} value={status}
              onChange={(ev) => { setStatus(ev.target.value); setPage(1); }}
              aria-label="Filtrar por estado">
              {STATUS_FILTERS.map((o) => <option key={o.value} value={o.value}>{o.label}</option>)}
            </select>
          )}

          {!loading && (
            <span className={styles.count}>
              {filtered.length} {filtered.length === 1 ? singular : plural}
            </span>
          )}
        </div>

        <Datatable
          columns={columns}
          rows={rows}
          loading={loading}
          emptyMessage={hasFilters
            ? (search ? `No hay resultados para "${search}".` : `No hay ${plural} con ese estado.`)
            : `Aún no hay ${plural} registrad${e}s.`}
          pagination={{
            page: currentPage,
            pageSize: PAGE_SIZE,
            totalCount: filtered.length,
            totalPages,
            onPageChange: setPage,
          }}
        />
      </section>

      <CatalogFormModal
        open={form.open}
        item={form.item}
        items={items}
        config={config}
        onClose={() => setForm({ open: false, item: null })}
        onSaved={handleSaved}
      />

      <ConfirmDialog
        open={Boolean(toDelete)}
        danger
        title={`¿Eliminar ${singular}?`}
        message="Esta acción no se puede deshacer."
        detail={toDelete && (
          <div className={styles.personChip}>
            <div className={styles.personAvatar}><Icon size={18} /></div>
            <div className={styles.personInfo}>
              <span className={styles.personName}>{labelOf(toDelete)}</span>
              {toDelete.code != null && <span className={styles.personMeta}>Código: {toDelete.code}</span>}
              {toDelete.startDate && (
                <span className={styles.personMeta}>
                  {formatDate(toDelete.startDate)} – {formatDate(toDelete.endDate)}
                </span>
              )}
            </div>
          </div>
        )}
        confirmText={deleting ? "Eliminando..." : "Sí, eliminar"}
        loading={deleting}
        error={deleteError}
        onConfirm={confirmDelete}
        onCancel={() => setToDelete(null)}
      />
    </>
  );
}


















import { useEffect, useState } from "react";
import { AlertCircle, Loader2 } from "lucide-react";
import { Modal } from "../../../../shared/components";
import { normalizeText } from "../../../../helpers/format";
import styles from "../../../Pages.module.css";

const FORM_ID = "catalog-form";
const DATE_RE = /^\d{4}-\d{2}-\d{2}$/;

// "Name" (backend) → "name" (formulario)
const mapApiErrors = (errors = {}) =>
  Object.fromEntries(
    Object.entries(errors).map(([key, msg]) => [key.charAt(0).toLowerCase() + key.slice(1), msg])
  );

// Valor del registro → valor del input
const toValue = (f, item) => {
  const raw = item?.[f.name];
  if (f.type === "date") return raw ? String(raw).slice(0, 10) : "";          // "2026-11-01T00:00:00" → "2026-11-01"
  if (f.type === "boolean") return String(raw ?? f.defaultValue ?? true);     // true → "true"
  return raw ?? f.defaultValue ?? "";
};

const toValues = (fields, item) => Object.fromEntries(fields.map((f) => [f.name, toValue(f, item)]));

const validate = (fields, values, items, currentId, extraValidate) => {
  const errors = {};

  fields.forEach((f) => {
    const value = String(values[f.name] ?? "").trim();

    if (f.required && !value) {
      errors[f.name] = `${f.label} es obligatorio.`;
      return;
    }

    if (f.type === "number" && value && (!Number.isInteger(Number(value)) || Number(value) < 0)) {
      errors[f.name] = `${f.label} debe ser un número entero positivo.`;
      return;
    }

    if (f.type === "date" && value && !DATE_RE.test(value)) {
      errors[f.name] = `${f.label} no es una fecha válida.`;
      return;
    }

    // Duplicados: compara sin tildes ni mayúsculas y excluye el registro que se está editando
    if (f.unique && value) {
      const duplicate = items.find(
        (it) => it.id !== currentId && normalizeText(it[f.name]) === normalizeText(value)
      );
      if (duplicate) errors[f.name] = `Ya existe un registro con ese ${f.label.toLowerCase()} (ID ${duplicate.id}).`;
    }
  });

  // Validaciones entre campos definidas en la configuración (solo si cada campo ya es válido)
  if (extraValidate && Object.keys(errors).length === 0) {
    Object.assign(errors, extraValidate(values, items, currentId));
  }

  return errors;
};

// Valores del formulario → body para la API
const toBody = (fields, values) =>
  Object.fromEntries(
    fields.map((f) => {
      const raw = values[f.name];
      if (f.type === "number") return [f.name, raw === "" || raw === null ? null : Number(raw)];
      if (f.type === "select") return [f.name, raw];
      if (f.type === "boolean") return [f.name, raw === "true"];
      if (f.type === "date") return [f.name, raw || null];                     // "yyyy-mm-dd", sin hora
      return [f.name, String(raw ?? "").trim()];
    })
  );

export function CatalogFormModal({ open, item, items = [], config, onClose, onSaved }) {
  const { singular, plural, feminine, fields, service, validate: extraValidate } = config;
  const isEdit = Boolean(item);
  const e = feminine ? "a" : "o";

  const [values, setValues] = useState({});
  const [errors, setErrors] = useState({});
  const [saving, setSaving] = useState(false);
  const [submitError, setSubmitError] = useState("");

  useEffect(() => {
    if (open) {
      setValues(toValues(fields, item));
      setErrors({});
      setSubmitError("");
    }
  }, [open, item, fields]);

  const handleChange = (ev) => {
    const { name, value } = ev.target;
    setValues((v) => ({ ...v, [name]: value }));
    setErrors((err) => ({ ...err, [name]: undefined }));
  };

  const handleSubmit = async (ev) => {
    ev.preventDefault();
    const found = validate(fields, values, items, item?.id, extraValidate);
    setErrors(found);
    if (Object.keys(found).length > 0) return;

    setSaving(true);
    setSubmitError("");
    const body = toBody(fields, values);

    try {
      const saved = isEdit ? await service.update(item.id, body) : await service.create(body);
      onSaved(saved && typeof saved === "object" ? saved : { ...item, ...body }, isEdit);
    } catch (err) {
      const data = err.response?.data;
      if (data?.errors) setErrors(mapApiErrors(data.errors));
      setSubmitError(
        err.noAccess
          ? `No tienes permiso para ${isEdit ? "editar" : "crear"} ${plural}.`
          : data?.message ?? "No se pudo guardar. Intenta de nuevo."
      );
    } finally {
      setSaving(false);
    }
  };

  const handleClose = () => { if (!saving) onClose(); };

  const renderInput = (f, index) => {
    const common = {
      id: `catalog-${f.name}`,
      name: f.name,
      value: values[f.name] ?? "",
      onChange: handleChange,
      "aria-invalid": !!errors[f.name],
      autoFocus: index === 0,
    };
    const invalid = errors[f.name] ? styles.invalid : "";

    if (f.type === "select") {
      return (
        <select {...common} className={`${styles.select} ${invalid}`}>
          <option value="">Selecciona una opción</option>
          {f.options.map((o) => <option key={o.value} value={o.value}>{o.label}</option>)}
        </select>
      );
    }

    if (f.type === "boolean") {
      return (
        <select {...common} className={`${styles.select} ${invalid}`}>
          <option value="true">Activo</option>
          <option value="false">Inactivo</option>
        </select>
      );
    }

    if (f.type === "date") {
      return <input {...common} type="date" className={`${styles.input} ${invalid}`} />;
    }

    return (
      <input
        {...common}
        type={f.type === "number" ? "number" : "text"}
        min={f.type === "number" ? 0 : undefined}
        inputMode={f.type === "number" ? "numeric" : undefined}
        className={`${styles.input} ${invalid}`}
        placeholder={f.placeholder}
        autoComplete="off"
      />
    );
  };

  return (
    <Modal
      open={open}
      size="sm"
      title={isEdit ? `Editar ${singular}` : `Nuev${e} ${singular}`}
      onClose={handleClose}
      footer={
        <>
          <button type="button" className={`${styles.btn} ${styles.btnOutline}`} onClick={handleClose} disabled={saving}>
            Cancelar
          </button>
          <button type="submit" form={FORM_ID} className={`${styles.btn} ${styles.btnPrimary}`} disabled={saving}>
            {saving && <Loader2 size={18} className={styles.spin} />}
            {saving ? "Guardando..." : isEdit ? "Guardar cambios" : "Guardar"}
          </button>
        </>
      }
    >
      <form id={FORM_ID} className={styles.form} style={{ gridTemplateColumns: "1fr" }} onSubmit={handleSubmit} noValidate>
        {submitError && (
          <div className={`${styles.banner} ${styles.bannerError}`} role="alert" style={{ marginBottom: 0 }}>
            <AlertCircle size={18} />
            <p>{submitError}</p>
          </div>
        )}

        {isEdit && (
          <div className={styles.field}>
            <label className={styles.label} htmlFor="catalog-id">
              ID <span className={styles.readOnlyTag}>SOLO LECTURA</span>
            </label>
            <input id="catalog-id" className={styles.input} value={item.id} readOnly />
          </div>
        )}

        {fields.map((f, index) => (
          <div key={f.name} className={styles.field}>
            <label className={styles.label} htmlFor={`catalog-${f.name}`}>
              {f.label}
              {f.required && <span className={styles.required}>*</span>}
            </label>
            {renderInput(f, index)}
            {errors[f.name] && <span className={styles.fieldError}>{errors[f.name]}</span>}
          </div>
        ))}
      </form>
    </Modal>
  );
}















