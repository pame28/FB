-- =============================================
-- Author:		Orlin Alvarado
-- Create date: 2014-05-27
-- Description:	Genera la información de tarjetas y las coloca en la tabla de operaciones
-- =============================================
ALTER PROCEDURE [dbo].[usp_CR_PROC_OPERACIONES_EXTRAS_VASA]
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;
	
	--Limpiar tabla operaciones
	--DELETE FROM operaciones
	--WHERE opeTipo = '130100'
	
	--TRUNCATE TABLE operaciones --Temporalmente para certificar
	
	--Limpiamos tabla tempora
	TRUNCATE TABLE TMPExtrasVASA
	
	--Insertamos los nuevos valores
	INSERT INTO TMPExtrasVASA
	SELECT * FROM uvw_EXTRAS_VASA uev
	WHERE uev.Tipo = 'E'

	
	--Variables para insertar en la tabla operaciones
	DECLARE @opeNum CHAR(16)
	       ,@opeMoneda SMALLINT
	       ,@CifCliente DECIMAL
	       ,@opeTipIns CHAR(2)
	       ,@opeCodIns CHAR(2)
	       ,@opeFecRep CHAR(8)
	       ,@opeFecOto CHAR(8)
	       ,@opeFecVen CHAR(8)
	       ,@opeSaldoVi MONEY
	       ,@opeSaldoMo MONEY
	       ,@opeSaldoVe MONEY
	       ,@opeSaldoCo MONEY
	       ,@opeSaldoEj MONEY
	       ,@opeSaldoCa MONEY
	       ,@opeGar CHAR(2)
	       ,@opeTipo CHAR(6)
