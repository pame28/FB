        public static Boolean ExecuteCommand(string _Command)
        {
            Boolean blnRespuesta = false;
            try
            {

                //Indicamos que deseamos inicializar el proceso cmd.exe junto a un comando de arranque. 
                //(/C, le indicamos al proceso cmd que deseamos que cuando termine la tarea asignada se cierre el proceso).
                //Para mas informacion consulte la ayuda de la consola con cmd.exe /? 
                System.Diagnostics.ProcessStartInfo procStartInfo = new System.Diagnostics.ProcessStartInfo("cmd", "/c " + _Command);
                // Indicamos que la salida del proceso se redireccione en un Stream
                procStartInfo.RedirectStandardOutput = true;
                procStartInfo.UseShellExecute = false;
                //Indica que el proceso no despliegue una pantalla negra (El proceso se ejecuta en background)
                procStartInfo.CreateNoWindow = false;
                //Inicializa el proceso
                System.Diagnostics.Process proc = new System.Diagnostics.Process();
                proc.StartInfo = procStartInfo;
                proc.Start();
                //Consigue la salida de la Consola(Stream) y devuelve una cadena de texto
                string result = proc.StandardOutput.ReadToEnd();
                //Muestra en pantalla la salida del Comando
                Console.WriteLine(result);

                if (result != string.Empty)
                {
                    throw new Exception("Ocurrio un error desencriptando el archivo. ExitCode = " + result);
                }
                else

                {
                    blnRespuesta = true;
                }
            }
            catch (Exception ex)
            {
                AppLogger.Error($"Error al ejecutar comando: {ex.Message}");
            }
            return blnRespuesta;
        }

        public Boolean GeneraArchivoPEM(string strTarjeta)
        {
            //DataSet dsVasa = new DataSet();
            Boolean blnResultado = true;
            AppLogger.Debug($"Generando Archivo tarjeta: {strTarjeta}");
            try
            {
                SQL sql = new SQL(this.strConexion);
                DataSet dsInfoBDD = new DataSet();
                dsInfoBDD = sql.sp_Select("usp_DTGetTextFile", new SqlParameter("@Equivalencia", strTarjeta));
                AppLogger.Debug($"Datos Archivos:  {dsInfoBDD.GetXml()}");
                //if (sql.iHayError == 1)
                //{
                //    LogMessageToFile($"Error al consultar tarjeta: {sql.LastException.Message}", 1);
                //}

                if (dsInfoBDD.Tables[0].Rows.Count > 0)
                {

                    #region Información Base de datos

                    string strRutaArchivoTexto = dsInfoBDD.Tables[0].Rows[0]["strRutaArchivosTEXT"].ToString();
                    string strRutaTextoNombre = strRutaArchivoTexto + strTarjeta + ".txt";
                    string strContenidoText = dsInfoBDD.Tables[0].Rows[0]["Datos"].ToString();
                    string strComando1 = dsInfoBDD.Tables[0].Rows[0]["strComando1"].ToString();
                    string strComando2 = dsInfoBDD.Tables[0].Rows[0]["strComando2"].ToString();
                    string strSGNCompleto = dsInfoBDD.Tables[0].Rows[0]["strSGNCompleto"].ToString();
                    #endregion

                    #region paso #1 Guardo el archivo de texto

                    if (File.Exists(strRutaTextoNombre))
                    {
                        File.Delete(strRutaTextoNombre);
                    }
                    using (StreamWriter mylogs = File.AppendText(strRutaTextoNombre))//se crea el archivo
                    {
                        mylogs.WriteLine(strContenidoText);
                        mylogs.Close();
                    }

                    #endregion

                    #region paso #2 gerera el archivo token SGN

                    if (!Directory.Exists(strSGNCompleto))
                    {
                        Directory.CreateDirectory(strSGNCompleto);
                    }

                    if (File.Exists(strSGNCompleto + "\\" + strTarjeta + ".sgn"))
                    {
                        File.Delete(strSGNCompleto + "\\" + strTarjeta + ".sgn");
                    }
                    //LogMessageToFile($"Ejecuta comando 1: {strComando1}",1);
                    if (ExecuteCommand(strComando1))
                    {
                        #region paso #3 gerera el archivo token pem

                        if (File.Exists(strSGNCompleto + "\\" + strTarjeta + ".pem"))
                        {
                            File.Delete(strSGNCompleto + "\\" + strTarjeta + ".pem");
                        }
                        //LogMessageToFile($"Ejecuta comando 2: {strComando2}", 1);
                        if (ExecuteCommand(strComando2))
                        {
                            File.Delete(strSGNCompleto + "\\" + strTarjeta + ".sgn");
                            strRutaArchivoALeer = strSGNCompleto + "\\" + strTarjeta + ".pem";
                            strCardNumber = dsInfoBDD.Tables[2].Rows[0]["CardNumber"].ToString();
                            //Finalizó el proceso
                        }
                        else
                        {
                            AppLogger.Error("Ejecución de Comando 2 incorrecta");
                            blnResultado = false;
                        }
                        #endregion
                    }
                    else
                    {
                        AppLogger.Error("Ejecución de Comando 1 incorrecta");
                        blnResultado = false;
                    }


                    #endregion

                    AppLogger.Info($"Archivos de consulta para Tarjeta: {strTarjeta} Generados.");
                }
            }
            catch (Exception ex)
            {
                blnResultado = false;
                AppLogger.Error($"Error al generar el archivo .PEM tarjeta: {strTarjeta}, error: {ex.Message}");
            }
            return blnResultado;
        }

        public static void LogMessageToFile2(string msg, int trx)
        {
            System.IO.StreamWriter sw = System.IO.File.AppendText(
                GetTempPath2(trx) + string.Format("LOGDTBXI{0}.txt", DateTime.Today.Date.ToString("yyyyMMdd")));
            try
            {
                string logLine = System.String.Format(
                    "[{0}]: [{1}] {2}.", System.DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"), activityid, msg);
                sw.WriteLine(logLine);
            }
            finally
            {
                sw.Close();
            }
        }

        public static string GetTempPath2(int transaccion)
        {
            string path = strRutaLogs;
            //string path = System.Environment.GetEnvironmentVariable("TEMP");
            if (!path.EndsWith("\\")) path += "\\";
            switch (transaccion)
            {
                case 1:
                    path = path + "WebServices\\";
                    break;
                default:
                    path = path + "Logs\\";
                    break;
            }
            return path;
        }

