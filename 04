        /// <summary>
        /// Crea un usuario, valida la solicitud, comprueba entidades relacionadas y devuelve el resultado HTTP de la
        /// operación.
        /// </summary>
        /// <remarks>Devuelve errores de validación cuando la solicitud es inválida y registra cualquier
        /// excepción no controlada.</remarks>
        /// <param name="request">Datos necesarios para crear el usuario.</param>
        /// <param name="serviceProvider">Proveedor de servicios usado para resolver los repositorios requeridos.</param>
        /// <param name="validator">Validador de la solicitud de creación de usuario.</param>
        /// <param name="loggerFactory">Fábrica de registros usada para crear el registrador de la operación.</param>
        /// <returns>Una tarea que representa la operación asincrónica y contiene un <see cref="IResult"/> con 201 (creado), 400
        /// (solicitud no válida), 409 (conflicto) o 500 (error interno).</returns>
        private static async Task<IResult> Create(
            CreateUserRequestDto request,
            IValidator<CreateUserRequestDto> validator,
            IServiceProvider serviceProvider,
            ClaimsPrincipal claimsPrincipal,
            ILoggerFactory loggerFactory)
        {
            var logger = loggerFactory.CreateLogger(typeof(UserEndpoints));
            var currentUserId = GetCurrentUserId(claimsPrincipal);

            try
            {
                logger.LogInformation(JsonConvert.SerializeObject(request));

                if (string.IsNullOrWhiteSpace(currentUserId))
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = 401,
                        Message = GenericErrors.UnauthorizedUserMessage
                    }, statusCode: StatusCodes.Status401Unauthorized);
                }

                var validationResult = await validator.ValidateAsync(request);


                if (!validationResult.IsValid)
                {

                    return Results.Json(new ResponseObjectError
                    {
                        Code = 400,
                        Message = "Error en la validación del request.",
                        Errors = validationResult.Errors.ToDictionary(e => e.PropertyName, e => e.ErrorMessage)
                    }, statusCode: StatusCodes.Status400BadRequest);
                }

                var usersRepository = serviceProvider.GetRequiredService<IUsersRepository>();

                if (await usersRepository.ExistsByUserName(request.UserName))
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = 409,
                        Message = "Ya existe un usuario con el mismo nombre de usuario."
                    }, statusCode: StatusCodes.Status409Conflict);
                }

                var rolesRepository = serviceProvider.GetRequiredService<IRolesRepository>();

                var roleExists = await rolesRepository.ExistsById(request.RoleId);

                if (!roleExists)
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = 400,
                        Message = "El rol especificado no existe."
                    }, statusCode: StatusCodes.Status400BadRequest);
                }

                var companyDepartmentsRepository = serviceProvider.GetRequiredService<ICompanyAreasRepository>();

                var departmentExists = await companyDepartmentsRepository.ExistsById(request.CompanyAreaId);

                if (!departmentExists)
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = 400,
                        Message = "El área especificada no existe."
                    }, statusCode: StatusCodes.Status400BadRequest);
                }

                var companyPositionsRepository = serviceProvider.GetRequiredService<ICompanyPositionsRepository>();
                var companyLocationsRepository = serviceProvider.GetRequiredService<ICompanyLocationsRepository>();
                var companyBranchesRepository = serviceProvider.GetRequiredService<ICompanyBranchesRepository>();

                var companyPosition = await companyPositionsRepository.GetById(request.CompanyPositionId);
                if (companyPosition == null)
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = 400,
                        Message = "El puesto especificado no existe."
                    }, statusCode: StatusCodes.Status400BadRequest);
                }

                var companyLocation = await companyLocationsRepository.GetById(request.CompanyLocationId);
                if (companyLocation == null)
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = 400,
                        Message = "La ubicación especificada no existe."
                    }, statusCode: StatusCodes.Status400BadRequest);
                }

                CompanyBranch? companyBranch = null;
                if (request.CompanyBranchId.HasValue)
                {
                    companyBranch = await companyBranchesRepository.GetById(request.CompanyBranchId.Value);
                    if (companyBranch == null)
                    {
                        return Results.Json(new ResponseObjectError
                        {
                            Code = 400,
                            Message = "La agencia especificada no existe."
                        }, statusCode: StatusCodes.Status400BadRequest);
                    }
                }

                var user = new User
                {
                    FirstName = request.FirstName,
                    LastName = request.LastName,
                    UserName = request.UserName,
                    Email = request.Email,
                    Status = request.Status,
                    EmployeeBranchUbication = request.EmployeeBranchUbication,
                    TellerCode = request.TellerCode,
                    CompanyPositionId = companyPosition.Id,
                    CompanyLocationId = companyLocation.Id,
                    CompanyBranchId = companyBranch?.Id,
                    CompanyAreaId = request.CompanyAreaId,
                    RoleId = request.RoleId
                };

                await usersRepository.Create(user);

                var modelLogsRepository = serviceProvider.GetRequiredService<IModelLogsRepository>();

                await modelLogsRepository.CreateLog(new ModelLog
                {
                    OperationType = OperationType.Create,
                    ModelName = nameof(User),
                    OperationDate = DateTime.Now,
                    EndpointFunction = nameof(Create),
                    JsonModel = JsonConvert.SerializeObject(request),
                    UserId = currentUserId
                });

                var createdUser = await usersRepository.GetByIdWithRoleAndPermissions(user.Id);

                var response = new ResponseObject<UserDto>
                {
                    Code = 201,
                    Message = "Usuario creado correctamente.",
                    Data = MapUser(createdUser ?? user)
                };

                return Results.Created($"/api/users/{user.Id}", response);
            }
            catch (Exception ex)
            {
                logger.LogError(ex, "CreateUserError");
                return Results.Json(new ResponseObjectError
                {
                    Code = 500,
                    Message = GenericErrors.InternalServerError
                }, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

