		#region Acceso a AS400 / SQL Server
		private string ObtenerEstadoProceso()
		{
			ConnectionManager cm = Dts.Connections["AS400"];
			OleDbConnection conn = null;

			try
			{
				conn = Adquirir<OleDbConnection>(cm);

				using (IDbCommand cmd = conn.CreateCommand())
				{
					cmd.CommandText = _sqlConsultaEstado;
					cmd.CommandTimeout = _timeoutAs400;

					string estado = string.Empty;
					using (IDataReader reader = cmd.ExecuteReader())
					{
						while (reader.Read())
							estado = Convert.ToString(reader.GetValue(0)).Trim();
					}
					return estado;
				}
			}
			catch (Exception ex)
			{
				ErrorLog("Fallo obtener estado proceso. Consulta: " + _sqlConsultaEstado, ex);
				return null;
			}
			finally
			{
				if (conn != null)
					cm.ReleaseConnection(conn);
			}
		}

		/// <summary>Ejecuta el SP PreParseo o PostParseo</summary>
		private bool EjecutarSpConArchivo(string claveParametro)
		{
			Stopwatch sw = Stopwatch.StartNew();
			ConnectionManager cm = Dts.Connections["BANDEJAVASA"];
			SqlConnection conn = null;

			try
			{
				Info("Inicia " + claveParametro + " (" + parametros[claveParametro] + ") @Archivo=" + parametros["NombreArchivo"]);

				conn = Adquirir<SqlConnection>(cm);

				using (SqlCommand cmd = new SqlCommand(parametros[claveParametro], conn))
				{
					cmd.CommandType = CommandType.StoredProcedure;
					cmd.CommandTimeout = _timeoutSql;
					cmd.Parameters.Add(new SqlParameter("@Archivo", parametros["NombreArchivo"]));
					cmd.ExecuteNonQuery();
				}

				Info("Finaliza " + claveParametro + " en " + Fmt(sw));
				return true;
			}
			catch (Exception ex)
			{
				ErrorLog("Fallo " + claveParametro + " " + parametros["NombreArchivo"] + " (tras " + Fmt(sw) + ")", ex);
				return false;
			}
			finally
			{
				if (conn != null)
					cm.ReleaseConnection(conn);
			}
		}

		private bool UpdateArchivoAS400()
		{
			Stopwatch sw = Stopwatch.StartNew();
			ConnectionManager cm = Dts.Connections["AS400"];
			OleDbConnection conn = null;

			try
			{
				Info("Actualizando estado del archivo de control en AS400: " + parametros["ArchivoControl"]);

				conn = Adquirir<OleDbConnection>(cm);

				using (IDbCommand cmd = conn.CreateCommand())
				{
					cmd.CommandText = _sqlConsultaActualizar;
					cmd.CommandTimeout = _timeoutAs400;
					int filas = cmd.ExecuteNonQuery();

					if (filas == 0)
					{
						Log(LogError, "La actualizacion de estado en AS400 no afecto registros: " + parametros["ArchivoControl"]);
						return false;
					}

					Info("Estado actualizado en AS400 (" + filas + " fila(s)) en " + Fmt(sw));
				}

				return true;
			}
			catch (Exception ex)
			{
				ErrorLog("Fallo actualizar estado archivo: " + parametros["ArchivoControl"], ex);
				return false;
			}
			finally
			{
				if (conn != null)
					cm.ReleaseConnection(conn);
			}
		}

		private static T Adquirir<T>(ConnectionManager cm) where T : class
		{
			T conexion = cm.AcquireConnection(null) as T;
			if (conexion == null)
				throw new InvalidOperationException("No se pudo obtener la conexion '" + cm.Name + "' desde el Connection Manager.");
			return conexion;
		}
