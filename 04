            {
                CertificationStatus? parsed = null;
                if (!string.IsNullOrWhiteSpace(status))
                {
                    if (!Enum.TryParse<CertificationStatus>(status, true, out var value) || !Enum.IsDefined(value))
                    {
                        return Error(400, "El estado indicado no es v\u00e1lido. Use Pending, Approved o Rejected.");
                    }

                    parsed = value;
                }

                return Ok(await repository.GetCertificationsAsync(null, areaId, teamId, certifierId, parsed, search));
            });

        private static Task<IResult> GetBreakdown(long id, ICertificationsRepository repository, ILoggerFactory loggerFactory) =>
            Execute(loggerFactory, "GetCertificationBreakdownError", async () =>
                await repository.GetBreakdownAsync(id) is { } breakdown
                    ? Ok(breakdown)
                    : Error(404, "No se encontró la certificación."));

        private static Task<IResult> Resolve(
            long id, bool approve, ICertificationsRepository repository, ClaimsPrincipal claimsPrincipal, ILoggerFactory loggerFactory) =>
            WithUser(claimsPrincipal, loggerFactory, "ResolveCertificationError", async userId =>
                Mutation(await repository.ResolveAsync(id, approve, userId), 200,
                    approve ? "Certificaci\u00f3n aprobada correctamente." : "Certificaci\u00f3n marcada como no aprobada."));

        private static IResult Ok<T>(T data) =>
            Results.Ok(new ResponseObject<T> { Code = 200, Message = "OK", Data = data });

        private static IResult Mutation(CertificationOperationResult result, int successCode, string successMessage)
        {
            if (result.Status == CertificationOperationStatus.Done)
            {
                return Results.Json(new ResponseObject<object>
                {
                    Code = successCode,
                    Message = successMessage,
                    Data = new { id = result.Id }
                }, statusCode: successCode);
            }

            return Error(result.Status switch
            {
                CertificationOperationStatus.NotFound => 404,
                CertificationOperationStatus.Forbidden => 403,
                CertificationOperationStatus.Invalid when result.Message?.Contains("pendiente") == true => 409,
                _ => 400
            }, result.Message!);
        }

        private static async Task<IResult> WithUser(
            ClaimsPrincipal claimsPrincipal, ILoggerFactory loggerFactory, string errorName, Func<string, Task<IResult>> action)
        {
            var userId = claimsPrincipal.FindFirstValue("userId") ?? claimsPrincipal.FindFirstValue(ClaimTypes.NameIdentifier);
            if (string.IsNullOrWhiteSpace(userId))
            {
                return Error(401, GenericErrors.UnauthorizedUserMessage);
            }

            return await Execute(loggerFactory, errorName, () => action(userId));
        }

        private static async Task<IResult> Execute(ILoggerFactory loggerFactory, string errorName, Func<Task<IResult>> action)
        {
            try
            {
                return await action();
            }
            catch (Exception ex)
            {
                loggerFactory.CreateLogger(typeof(CertificationsEndpoints)).LogError(ex, errorName);
                return Error(500, GenericErrors.InternalServerError);
            }
        }

        private static IResult Error(int code, string message) =>
            Results.Json(new ResponseObjectError { Code = code, Message = message }, statusCode: code);
    }
