                </div>

                <button
                    type="button"
                    className={`${base.btn} ${base.btnOutline} ${ui.btnTeal}`}
                    disabled={busy !== null}
                    onClick={() => exportHistory({
                        title: "Historial de certificaciones",
                        rows,
                        filters: historyFilters({
                            team: teamId === "todos" ? null : TEAMS.find((t) => String(t.id) === teamId)?.name,
                            certifier,
                            status,
                            search,
                        }),
                    })}
                >
                    <Download size={16} /> Exportar Excel
                </button>
            </header>

            <div className={base.page}>
                <div className={base.infoBanner}>
                    <Info size={16} />
                    <span>Puedes consultar el historial completo de los equipos que te han sido asignados, incluyendo certificaciones realizadas por otros certificadores. La información es de solo lectura.</span>
                </div>

                <section className={ui.filterCard}>
                    <div className={ui.filterTitle}><Filter size={16} /> Filtrar historial</div>
                    <div className={ui.filterRow}>
                        <select className={`${base.select} ${ui.filterSelect}`} value={teamId} onChange={(e) => setTeamId(e.target.value)} aria-label="Filtrar por equipo">
                            <option value="todos">Todos mis equipos</option>
                            {teams.map((t) => <option key={t.id} value={t.id}>{t.name}</option>)}
                        </select>
                        <select className={`${base.select} ${ui.filterSelect}`} value={certifier} onChange={(e) => setCertifier(e.target.value)} aria-label="Filtrar por certificador">
                            <option value="todos">Todos los certificadores</option>
                            {certifiers.map((c) => <option key={c} value={c}>{c}</option>)}
                        </select>
                        <select className={`${base.select} ${ui.filterSelect}`} value={status} onChange={(e) => setStatus(e.target.value)} aria-label="Filtrar por estado">
                            <option value="todos">Todos los estados</option>
                            {Object.values(STATUS).map((s) => <option key={s} value={s}>{s}</option>)}
                        </select>
                        <div className={`${base.inputIcon} ${ui.filterSearch}`}>
                            <Search size={16} />
                            <input type="text" className={base.input} placeholder="Buscar por líder..." value={search} onChange={(e) => setSearch(e.target.value)} aria-label="Buscar por líder" />
