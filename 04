/* =====================================================================
   3) sp_RegistraProceso: se modifica UNA sola vez.
      Despues, para reprocesar solo se cambian parametros.
   ===================================================================== */
ALTER PROCEDURE [dbo].[sp_RegistraProceso]
  @Proceso NVARCHAR(100),
  @EstadoProceso NVARCHAR(5),
  @Mensaje NVARCHAR(500)
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @ModoReproceso BIT = 0;
    DECLARE @Fecha VARCHAR(10);

    IF EXISTS (SELECT 1 FROM ParametrosDescargaTablas
               WHERE Proceso = 'General' AND IdParametro = 'ModoReproceso'
                 AND LTRIM(RTRIM(ValorParametro)) = 'true')
        SET @ModoReproceso = 1;

    IF @ModoReproceso = 1
    BEGIN
        -- La fecha sale del parametro FechaReproceso (yyyy-MM-dd), ya no del -1 fijo
        SELECT @Fecha = CONVERT(VARCHAR(10), TRY_CONVERT(DATE, LTRIM(RTRIM(ValorParametro)), 23), 23)
        FROM ParametrosDescargaTablas
        WHERE Proceso = 'General' AND IdParametro = 'FechaReproceso';

        -- Sin fecha valida: igual que antes, en reproceso no se registra nada
        IF @Fecha IS NULL
            RETURN;

        SET @Mensaje = LEFT(N'[REPROCESO] ' + @Mensaje, 500);
    END
    ELSE
        SET @Fecha = CONVERT(VARCHAR(10), GETDATE() - 1, 23); -- YYYY-MM-DD (igual que antes)

    -- Registrar proceso en ParametrosEjecucionDescarga
    IF NOT EXISTS (SELECT 1 FROM ParametrosEjecucionDescarga
                   WHERE Proceso = @Proceso AND FechaProceso = @Fecha)
    BEGIN
        INSERT INTO ParametrosEjecucionDescarga (Proceso, FechaProceso, EstadoProceso, Mensaje)
        VALUES (@Proceso, @Fecha, @EstadoProceso, @Mensaje);
    END
    ELSE IF @EstadoProceso IN ('E', 'F')
    BEGIN
        -- Los mensajes informativos (I) no pisan el registro; el estado final (E/F) si
        UPDATE ParametrosEjecucionDescarga
        SET EstadoProceso = @EstadoProceso,
            Mensaje       = @Mensaje
        WHERE Proceso = @Proceso AND FechaProceso = @Fecha;
    END

    -- La FechaProceso general solo se mueve en ejecucion normal, nunca en reproceso
    IF @ModoReproceso = 0
       AND NOT EXISTS (SELECT 1 FROM ParametrosDescargaTablas
                       WHERE Proceso = 'General' AND IdParametro = 'FechaProceso' AND ValorParametro = @Fecha)
    BEGIN
        UPDATE ParametrosDescargaTablas
        SET ValorParametro = @Fecha
        WHERE Proceso = 'General' AND IdParametro = 'FechaProceso';
    END
END
GO

