/* =========================================================
   Reporte de Proceso de Coaching (Excel y PDF).
   Convierte un proceso de coaching en el formato de exportDocument().
   Cuando exista la API, solo hay que ajustar los nombres de campos aquí.
   ========================================================= */

const MONTHS = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];

const APPROVED = "aprobado";
const statusTone = (value) => (String(value).toLowerCase() === APPROVED ? "green" : "amber");
const employeeTone = (value) => (String(value).toLowerCase() === "activo" ? "green" : "grey");

/**
 * @param {object} p             Proceso de coaching
 * @param {object} options
 *   collaborator  Datos del colaborador (si el proceso no los trae)
 *   generatedBy   Nombre de quien descarga el reporte
 */
export const buildCoachingReport = (p, { collaborator = {}, generatedBy } = {}) => {
  // Datos del colaborador: primero lo que traiga el proceso, luego lo recibido
  const c = { ...collaborator, ...(p.collaborator ?? {}) };
  const period = p.period ?? `${MONTHS[p.month] ?? ""} ${p.year ?? ""}`.trim();

  const approvals = [
    p.coachApproval && { role: "Coach", name: p.coachApproval.name, date: p.coachApproval.date, result: "Firmado digitalmente" },
    {
      role: "Colaborador",
      name: p.collaboratorApproval?.name ?? c.name,
      date: p.collaboratorApproval?.date ?? "",
      result: p.collaboratorApproval ? "Firmado digitalmente" : "Pendiente",
    },
  ].filter(Boolean);

  return {
    title: "Reporte de Proceso de Coaching",
    fileName: `coaching_${period}`,
    sheetName: `Coaching ${period}`,
    generatedBy,
    highlights: [
      { label: "Colaborador", value: c.name },
      { label: "Código", value: c.employeeCode },
      { label: "Período", value: period },
      { label: "Estado", value: p.status, tone: statusTone(p.status) },
    ],
    sections: [
      {
        type: "fields",
        title: "Datos del colaborador",
        fields: [
          { label: "Nombre completo", value: c.name },
          { label: "Código de empleado", value: c.employeeCode },
          { label: "Puesto", value: c.position ?? p.position },
          { label: "Código de cajero", value: c.tellerCode },
          { label: "Área", value: c.area ?? p.area },
          { label: "Ubicación", value: c.ubication },
          { label: "Agencia / Zona", value: c.location ?? p.location },
          { label: "Estatus", value: c.status, tone: c.status ? employeeTone(c.status) : undefined },
        ],
      },
      {
        type: "fields",
        title: "Datos del proceso de coaching",
        fields: [
          { label: "Coach asignado", value: p.coachName },
          { label: "Fecha de inicio", value: p.startDate },
          { label: "Período", value: period },
          { label: "Fecha de fin", value: p.endDate },
          { label: "Fecha del coaching", value: p.date },
          { label: "Estado del proceso", value: p.status, tone: statusTone(p.status) },
        ],
      },
      {
        type: "table",
        title: "Indicadores evaluados",
        empty: "No hay indicadores evaluados.",
        rows: p.indicators ?? [],
        columns: [
          { header: "Indicador", key: "name", pdfWidth: "*" },
          { header: "Meta", key: "goal", align: "center", pdfWidth: 80 },
          { header: "Valor registrado", value: (i) => i.value ?? i.result, align: "center", pdfWidth: 80 },
          {
            header: "Resultado",
            value: (i) => (i.passed ? "Cumple" : "No cumple"),
            tone: (v) => (v === "Cumple" ? "green" : "red"),
            pdfWidth: 70,
          },
        ],
      },
      {
        type: "blocks",
        title: "Plan de acción",
        empty: "No hay acciones registradas.",
        rows: p.actionPlan ?? [],
        itemTitle: (_, i) => `Acción #${i + 1}`,
        columns: [
          { header: "Tipo de medición", key: "type" },
          { header: "Fecha compromiso", key: "commitDate" },
          { header: "Oportunidad de mejora", key: "opportunity" },
          { header: "Acción a realizar", key: "action" },
        ],
      },
      {
        type: "table",
        title: "Aprobaciones digitales",
        rows: approvals,
        columns: [
          { header: "Rol", key: "role", pdfWidth: 70 },
          { header: "Nombre", key: "name" },
          { header: "Fecha y hora", key: "date", align: "center", pdfWidth: 100 },
          { header: "Resultado", key: "result", tone: (v) => (v === "Pendiente" ? "amber" : "green"), pdfWidth: 100 },
        ],
      },
    ],
  };
};





