import { useEffect, useState } from "react";
import { ChevronRight, ChevronLeft, Check, Info, Clock, AlertCircle, Search } from "lucide-react";
import styles from "../../Pages.module.css";
import base from "./CollaboratorCoachingPage.module.css";
import ui from "./AssignmentCoachingPage.module.css";
import { Modal } from "../../../shared/components/Modal";
import { useToast } from "../../../shared/components";
import { useCatalogs } from "../../../hooks/useCatalogs";
import { useDebounce } from "../../../hooks/useDebounce";
import { coachService } from "../../../api/coachService";
import { indicatorsService } from "../../../api/indicatorsService";
import { usePeriods, periodDates, periodLabel, periodName } from "../../../hooks/usePeriods";


const STEPS = ["Seleccionar equipo", "Seleccionar indicadores", "Definir vigencia", "Confirmar y enviar"];
const EMPTY_FILTERS = { area: "", team: "", position: "", search: "" };



const plural = (n, one, many) => `${n} ${n === 1 ? one : many}`;
const sameMember = (a, b) => a.id === b.id && a.teamId === b.teamId;
const formatDate = (iso) => (iso ? iso.split("-").reverse().join("/") : "—");

export const AssignmentCoachingPage = () => {
    const catalogs = useCatalogs();
    const toast = useToast();
    const { activePeriods, findById } = usePeriods();
    const [currentStep, setCurrentStep] = useState(1);

    // Step 1: Seleccionar equipo
    const [filters, setFilters] = useState(EMPTY_FILTERS);
    const [appliedFilters, setAppliedFilters] = useState(EMPTY_FILTERS);
    const [selectedCollaborators, setSelectedCollaborators] = useState([]);
    const [filteredCollaborators, setfilteredCollaborators] = useState([]);
    const [filteredIndicators, setfilteredIndicators] = useState([]);



    // Step 2: Seleccionar indicadores
    const [indicatorSearch, setIndicatorSearch] = useState("");
    const [selectedIndicators, setSelectedIndicators] = useState([]);
    const [indicatorWeights, setIndicatorWeights] = useState({});

    // Step 3: Definir vigencia y metas
    const [periodId, setPeriodId] = useState("");
    const [vigencyStartDate, setVigencyStartDate] = useState("");
    const [vigencyEndDate, setVigencyEndDate] = useState("");
    const [teams, setTeams] = useState([]);

    const [indicatorsMeta, setIndicatorsMeta] = useState({});

    // Step 4: Summary
    const [showConfirmModal, setShowConfirmModal] = useState(false);


    // Recarga los colaboradores al aplicar filtros y descarta de la selección los que ya no aparecen
    useEffect(() => {
        let cancelled = false;
        coachService.loggedUserTeamsMembers(appliedFilters)
            .then((members) => {
                if (cancelled) return;
                setfilteredCollaborators(members);
                setSelectedCollaborators((prev) => prev.filter((s) => members.some((m) => sameMember(m, s))));
            })
            .catch((error) => {
                if (!cancelled) toast.error(error.noAccess ? "No tienes permiso para consultar tus equipos." : "No se pudieron cargar los colaboradores.");
            });
        return () => { cancelled = true; };
    }, [appliedFilters]);

    // Solo indicadores activos con su unidad de medida; la búsqueda por nombre se resuelve en el backend
    const debouncedIndicatorSearch = useDebounce(indicatorSearch, 400);
    useEffect(() => {
        let cancelled = false;
        indicatorsService.assignable(debouncedIndicatorSearch)
            .then((indicators) => { if (!cancelled) setfilteredIndicators(indicators); })
            .catch(() => { if (!cancelled) toast.error("No se pudieron cargar los indicadores."); });
        return () => { cancelled = true; };
    }, [debouncedIndicatorSearch]);

    useEffect(() => {
        coachService.loggedUserTeams().then(setTeams).catch(() => toast.error("No se pudieron cargar los equipos."));
    }, []);

    const groupedByTeam = Object.values(
        filteredCollaborators.reduce((groups, c) => {
            (groups[c.teamId] ||= { teamId: c.teamId, teamName: c.teamName, members: [] }).members.push(c);
            return groups;
        }, {})
    );

    const getTeamSelectedCount = (teamId) => selectedCollaborators.filter((c) => c.teamId === teamId).length;
    const isCollaboratorSelected = (collaborator) => selectedCollaborators.some((c) => sameMember(c, collaborator));

    const totalWeight = Object.values(indicatorWeights).reduce((sum, w) => sum + (parseInt(w) || 0), 0);
    const isWeightValid = totalWeight === 100 && selectedIndicators.length > 0;

    // const filteredIndicators = filterIndicators.filter((ind) =>
    //     ind.name.toLowerCase().includes(indicatorSearch.trim().toLowerCase())
    // );

    // Paso 1
    const handleSearch = () => setAppliedFilters(filters);

    const handleClearFilters = () => {
        setFilters(EMPTY_FILTERS);
        setAppliedFilters(EMPTY_FILTERS);
        setSelectedCollaborators([]);
    };

    const handleSelectCollaborator = (collaborator) => {
        setSelectedCollaborators((prev) =>
            prev.some((c) => sameMember(c, collaborator)) ? prev.filter((c) => !sameMember(c, collaborator)) : [...prev, collaborator]
        );
    };

    const handleSelectTeamCollaborators = (teamId) => {
        const teamCollaborators = filteredCollaborators.filter((c) => c.teamId === teamId);
        const allSelected = teamCollaborators.length > 0 && getTeamSelectedCount(teamId) === teamCollaborators.length;

        if (allSelected) {
            setSelectedCollaborators(selectedCollaborators.filter((c) => c.teamId !== teamId));
        } else {
            const next = [...selectedCollaborators];
            teamCollaborators.forEach((c) => {
                if (!next.some((s) => sameMember(s, c))) next.push(c);
            });
            setSelectedCollaborators(next);
        }
    };

    const handleContinueToIndicators = () => {
        if (selectedCollaborators.length === 0) {
            toast.error("Por favor selecciona al menos un colaborador");
            return;
        }
        setCurrentStep(2);
    };

    // Paso 2
    const handleToggleIndicator = (indicatorId) => {
        if (selectedIndicators.some((i) => i.id === indicatorId)) {
            setSelectedIndicators(selectedIndicators.filter((i) => i.id !== indicatorId));
            const { [indicatorId]: _removed, ...rest } = indicatorWeights;
            setIndicatorWeights(rest);
        } else {
            setSelectedIndicators([...selectedIndicators, filteredIndicators.find((i) => i.id === indicatorId)]);
        }
    };

    const handleWeightChange = (indicatorId, value) => {
        const weight = parseInt(value) || 0;
        if (weight >= 0 && weight <= 100) {
            setIndicatorWeights({ ...indicatorWeights, [indicatorId]: weight });
        }
    };

    const handleContinueToVigency = () => {
        if (selectedIndicators.length === 0) {
            toast.error("Por favor selecciona al menos un indicador");
            return;
        }
        if (!isWeightValid) {
            toast.error("La suma de los pesos debe ser exactamente 100%");
            return;
        }
        setCurrentStep(3);
    };

    // Paso 3
    // Al elegir un período, la vigencia toma sus fechas (se pueden ajustar dentro del período)
    const selectedPeriod = findById(periodId);
    const handlePeriodChange = (id) => {
        setPeriodId(id);
        const { start, end } = periodDates(findById(id));
        setVigencyStartDate(start);
        setVigencyEndDate(end);
    };

    const handleMetaChange = (indicatorId, field, value) => {
        setIndicatorsMeta({
            ...indicatorsMeta,
            [indicatorId]: { ...indicatorsMeta[indicatorId], [field]: value },
        });
    };

    const handleContinueToApproval = () => {
        if (!periodId) {
            toast.error("Selecciona el período de la asignación");
            return;
        }
        if (!vigencyStartDate || !vigencyEndDate) {
            toast.error("Por favor ingresa las fechas de vigencia");
            return;
        }
        if (vigencyEndDate < vigencyStartDate) {
            toast.error("La fecha fin de vigencia no puede ser anterior a la fecha inicio");
            return;
        }
        const { start, end } = periodDates(selectedPeriod);
        if (vigencyStartDate < start || vigencyEndDate > end) {
            toast.error(`La vigencia debe estar dentro del período ${periodLabel(selectedPeriod)}`);
            return;
        }
        if (selectedIndicators.some((ind) => !indicatorsMeta[ind.id]?.meta)) {
            toast.error("Por favor completa la meta de todos los indicadores");
            return;
        }


        setCurrentStep(4);
    };

    // Paso 4
    const handleResetFlow = () => {
        setCurrentStep(1);
        setSelectedCollaborators([]);
        setSelectedIndicators([]);
        setIndicatorWeights({});
        setPeriodId("");
        setVigencyStartDate("");
        setVigencyEndDate("");
        setIndicatorsMeta({});
        setIndicatorSearch("");
        setFilters(EMPTY_FILTERS);
        setAppliedFilters(EMPTY_FILTERS);
    };

    const handleConfirmAndSend = async () => {
        // Fechas sin hora ("yyyy-mm-dd"): así no hay desfase de zona horaria
        const validFrom = vigencyStartDate;
        const validTo = vigencyEndDate;
        const indicatorsPayload = selectedIndicators.map((ind) => ({
            indicatorId: ind.id,
            weight: indicatorWeights[ind.id] ?? 0,
            targetValue: Number(indicatorsMeta[ind.id]?.meta) || 0,
            targetUnitId: ind.targetUnitId ?? null,
            validFrom,
            validTo,
        }));

        // Agrupa los colaboradores seleccionados por equipo, como lo exige el backend
        const teamsPayload = Object.values(
            selectedCollaborators.reduce((acc, c) => {
                (acc[c.teamId] ??= { teamId: c.teamId, members: [] }).members.push({ memberUserId: c.id, indicators: indicatorsPayload });
                return acc;
            }, {})
        );

        try {
            await coachService.createAssignments(teamsPayload);
            setShowConfirmModal(false);
            toast.success("Solicitud enviada - indicadores en estado Pendiente de aceptación");
            handleResetFlow();
        } catch (error) {
            toast.error(
                error.noAccess
                    ? "No tienes permiso para asignar indicadores."
                    : error.response?.data?.message ?? "No se pudo enviar la solicitud. Intenta de nuevo."
            );
        }
    };

    const handleBack = () => setCurrentStep((s) => Math.max(1, s - 1));

    const onRowKey = (e, fn) => {
        if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            fn();
        }
    };

    return (
        <>
            <header className={styles.pageHeader}>
                <div>
                    <h1 className={styles.title}>Asignación de indicadores</h1>
                    <p className={styles.subtitle}>
                        Asigna indicadores a colaboradores y solicita su aceptación para habilitarlos en el proceso de coaching.
                    </p>
                </div>
            </header>

            <div className={base.page}>
                {/* Stepper */}
                <nav className={base.stepper} aria-label="Progreso de la asignación">
                    {STEPS.map((label, i) => {
                        const step = i + 1;
                        const state = step < currentStep ? "done" : step === currentStep ? "current" : "";
                        return (
                            <div key={label} style={{ display: "contents" }}>
                                <div className={`${base.step} ${state ? base[state] : ""}`} aria-current={step === currentStep ? "step" : undefined}>
                                    <span className={base.stepCircle}>{step}</span>
                                    <span className={base.stepLabel}>{label}</span>
                                </div>
                                {step < STEPS.length && <span className={`${base.stepLine} ${step < currentStep ? base.done : ""}`} />}
                            </div>
                        );
                    })}
                </nav>

                {/* PASO 1 */}
                {currentStep === 1 && (
                    <>
                        <div className={base.infoBanner}>
                            <Info size={16} />
                            <span>
                                Selecciona el equipo de trabajo al que deseas asignar indicadores. Solo se muestran los equipos que tienes asignados como coach. Los miembros del equipo aparecerán para selección individual.
                            </span>
                        </div>

                        <section className={base.card}>
                            <div className={base.cardHeader}>
                                <h2 className={base.cardTitle}>Filtrar equipo</h2>
                            </div>
                            <div className={base.cardBody}>
                                <form
                                    onSubmit={(e) => {
                                        e.preventDefault();
                                        handleSearch();
                                    }}
                                >
                                    <div className={ui.filterGrid}>
                                        <div className={base.field}>
                                            <label className={base.label} htmlFor="as-area">Área</label>
                                            <select id="as-area" className={base.select} value={filters.area} onChange={(e) => setFilters({ ...filters, area: e.target.value })}>
                                                <option value="">Todas las áreas</option>
                                                {catalogs.areas.map((a) => <option key={a.value} value={a.value}>{a.label}</option>)}
                                            </select>
                                        </div>
                                        <div className={base.field}>
                                            <label className={base.label} htmlFor="as-team">Equipo</label>
                                            <select id="as-team" className={base.select} value={filters.team} onChange={(e) => setFilters({ ...filters, team: e.target.value })}>
                                                <option value="">Todos mis equipos</option>
                                                {/* {Object.keys(MOCK_TEAMS).map((t) => <option key={t} value={t}>{t}</option>)} */}
                                                {teams.map((a) => <option key={a.id} value={a.id}>{a.name}</option>)}

                                            </select>
                                        </div>
                                        <div className={base.field}>
                                            <label className={base.label} htmlFor="as-position">Perfil de puesto</label>
                                            <select id="as-position" className={base.select} value={filters.position} onChange={(e) => setFilters({ ...filters, position: e.target.value })}>
                                                <option value="">Todos los perfiles</option>
                                                {/* {MOCK_POSITIONS.map((p) => <option key={p} value={p}>{p}</option>)} */}
                                                {catalogs.positions.map((a) => <option key={a.value} value={a.value}>{a.label}</option>)}

                                            </select>
                                        </div>
                                    </div>

                                    <div className={`${base.field} ${ui.searchRow}`}>
                                        <label className={base.label} htmlFor="as-search">Buscar</label>
                                        <div className={base.inputIcon}>
                                            <Search size={16} />
                                            <input
                                                id="as-search"
                                                type="text"
                                                className={base.input}
                                                placeholder="Código o nombre del colaborador..."
                                                value={filters.search}
                                                onChange={(e) => setFilters({ ...filters, search: e.target.value })}
                                            />
                                        </div>
                                    </div>

                                    <div className={base.searchActions}>
                                        <button type="submit" className={`${base.btn} ${base.btnPrimary} ${base.btnSm}`}>Buscar</button>
                                        <button type="button" className={`${base.btn} ${base.btnOutline} ${base.btnSm}`} onClick={handleClearFilters}>Limpiar</button>
                                    </div>
                                </form>
                            </div>
                        </section>

                        <span className={ui.selectionInfo}>
                            {selectedCollaborators.length} de {plural(filteredCollaborators.length, "colaborador", "colaboradores")} {selectedCollaborators.length === 1 ? "seleccionado" : "seleccionados"}
                        </span>

                        {filteredCollaborators.length > 0 ? (
                            <div className={ui.groups}>
                                {groupedByTeam.map((team) => {
                                    const members = team.members;
                                    const selectedCount = getTeamSelectedCount(team.teamId);
                                    const allSelected = selectedCount === members.length;

                                    return (
                                        <section key={team.teamId} className={ui.group}>
                                            <div className={ui.groupHeader}>
                                                <div>
                                                    <div className={ui.groupName}>{team.teamName}</div>
                                                    <div className={ui.groupMeta}>
                                                        {plural(members.length, "miembro activo", "miembros activos")}
                                                    </div>
                                                </div>
                                                <div className={ui.groupRight}>
                                                    <label className={ui.selectAll} htmlFor={`selectTeam-${team.teamId}`}>
                                                        <input
                                                            id={`selectTeam-${team.teamId}`}
                                                            type="checkbox"
                                                            className={ui.checkbox}
                                                            checked={allSelected}
                                                            onChange={() => handleSelectTeamCollaborators(team.teamId)}
                                                        />
                                                        Seleccionar todos
                                                    </label>
                                                    <span className={ui.groupCounter}>{plural(selectedCount, "seleccionado", "seleccionados")}</span>
                                                </div>
                                            </div>

                                            <div className={base.tableScroll}>
                                                <table className={base.table}>
                                                    <thead>
                                                        <tr>
                                                            <th className={ui.checkCell} />
                                                            <th>Código</th>
                                                            <th>Nombre</th>
                                                            <th>Puesto</th>
                                                            <th>Área</th>
                                                            <th>Ubicación</th>
                                                            <th>Estado</th>
                                                            <th>Indicadores activos</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        {members.map((c) => {
                                                            const selected = isCollaboratorSelected(c);
                                                            return (
                                                                <tr
                                                                    key={`${c.teamId}-${c.id}`}
                                                                    className={selected ? base.selected : ""}
                                                                    onClick={() => handleSelectCollaborator(c)}
                                                                    onKeyDown={(e) => onRowKey(e, () => handleSelectCollaborator(c))}
                                                                    tabIndex={0}
                                                                    aria-selected={selected}
                                                                >
                                                                    <td className={ui.checkCell}>
                                                                        <input
                                                                            type="checkbox"
                                                                            className={ui.checkbox}
                                                                            checked={selected}
                                                                            onChange={() => handleSelectCollaborator(c)}
                                                                            onClick={(e) => e.stopPropagation()}
                                                                            aria-label={`Seleccionar a ${c.fullName}`}
                                                                        />
                                                                    </td>
                                                                    <td className={base.code}>{c.employeeId || '-----'}</td>
                                                                    <td className={base.name}>{c.fullName}</td>
                                                                    <td>{c.companyPosition}</td>
                                                                    <td><span className={base.chip}>{c.companyArea}</span></td>
                                                                    <td className={base.muted}>{c.companyLocation}</td>
                                                                    <td><span className={base.statusActive}>{c.status}</span></td>
                                                                    <td className={base.muted}>
                                                                        {c.totalIndicators === 0 ? "Sin indicadores" : plural(c.totalIndicators, "indicador", "indicadores")}
                                                                    </td>
                                                                </tr>
                                                            );
                                                        })}
                                                    </tbody>
                                                </table>
                                            </div>
                                        </section>
                                    );
                                })}
                            </div>
                        ) : (
                            <div className={base.emptyState}>No se encontraron colaboradores con los filtros aplicados</div>
                        )}

                        <div className={base.actions}>
                            <button
                                type="button"
                                className={`${base.btn} ${base.btnPrimary}`}
                                onClick={handleContinueToIndicators}
                                disabled={selectedCollaborators.length === 0}
                            >
                                Siguiente — Seleccionar indicadores <ChevronRight size={16} />
                            </button>
                        </div>
                    </>
                )}

                {/* PASO 2 */}
                {currentStep === 2 && (
                    <>
                        <div className={base.infoBanner}>
                            <Info size={16} />
                            <span>
                                Solo se muestran indicadores activos configurados para el perfil de puesto de los colaboradores seleccionados. Define el peso (%) de cada indicador — la suma debe ser exactamente 100%.
                            </span>
                        </div>

                        <section className={base.card}>
                            <div className={base.cardHeader}>
                                <h2 className={base.cardTitle}>Indicadores disponibles</h2>
                                <span className={ui.indicatorsHint}>
                                    Filtrados para {plural(selectedCollaborators.length, "colaborador seleccionado", "colaboradores seleccionados")}
                                    {appliedFilters.area && <> · Área: <strong>{catalogs.areas.find((a) => String(a.value) === String(appliedFilters.area))?.label}</strong></>}
                                    {appliedFilters.team && <> · Equipo: <strong>{teams.find((t) => String(t.id) === String(appliedFilters.team))?.name}</strong></>}
                                    {appliedFilters.position && <> · Perfil: <strong>{catalogs.positions.find((p) => String(p.value) === String(appliedFilters.position))?.label}</strong></>}
                                </span>
                            </div>
                            <div className={base.cardBody}>
                                <div className={base.inputIcon}>
                                    <Search size={16} />
                                    <input
                                        type="text"
                                        className={base.input}
                                        placeholder="Buscar indicador..."
                                        value={indicatorSearch}
                                        onChange={(e) => setIndicatorSearch(e.target.value)}
                                    />
                                </div>

                                <div className={ui.indicatorsHead}>
                                    <span />
                                    <span>Indicador</span>
                                    <span className={ui.colCenter}>Tipo de valor</span>
                                    <span className={ui.colCenter}>Peso (%)</span>
                                </div>

                                <div className={ui.indicatorsList}>
                                    {filteredIndicators.map((ind) => {
                                        const isSelected = selectedIndicators.some((i) => i.id === ind.id);
                                        return (
                                            <div
                                                key={ind.id}
                                                className={`${ui.indicatorRow} ${isSelected ? ui.selected : ""}`}
                                                onClick={() => handleToggleIndicator(ind.id)}
                                                onKeyDown={(e) => onRowKey(e, () => handleToggleIndicator(ind.id))}
                                                tabIndex={0}
                                                role="checkbox"
                                                aria-checked={isSelected}
                                            >
                                                <input
                                                    type="checkbox"
                                                    className={ui.checkbox}
                                                    checked={isSelected}
                                                    onChange={() => handleToggleIndicator(ind.id)}
                                                    onClick={(e) => e.stopPropagation()}
                                                    tabIndex={-1}
                                                    aria-label={`Seleccionar ${ind.name}`}
                                                />
                                                <div>
                                                    <div className={ui.indicatorRowName}>{ind.name}</div>
                                                    {/* <div className={ui.indicatorRowSub}>Familia: Atención al cliente</div> */}
                                                </div>
                                                <div className={ui.typeCell}>
                                                    <span className={ui.valueTypePill}>{ind.typeName}</span>
                                                </div>
                                                <div className={`${ui.weightField} ${isSelected ? "" : ui.disabled}`} onClick={(e) => e.stopPropagation()}>
                                                    <input
                                                        type="number"
                                                        min="0"
                                                        max="100"
                                                        value={isSelected ? indicatorWeights[ind.id] ?? 0 : 0}
                                                        // value={ind.weight}
                                                        disabled={!isSelected}
                                                        onChange={(e) => handleWeightChange(ind.id, e.target.value)}
                                                        aria-label={`Peso de ${ind.name}`}
                                                    />
                                                    <span>%</span>
                                                </div>
                                            </div>
                                        );
                                    })}
                                </div>

                                <div className={ui.weightSummary}>
                                    <div className={ui.weightBar}>
                                        <div className={ui.weightTop}>
                                            <span>Peso total asignado</span>
                                            <strong>{totalWeight}%</strong>
                                        </div>
                                        <div className={ui.weightTrack}>
                                            <div
                                                className={`${ui.weightFill} ${isWeightValid ? "" : ui.incomplete}`}
                                                style={{ width: `${Math.min(totalWeight, 100)}%` }}
                                            />
                                        </div>
                                    </div>
                                    <span className={`${ui.weightStatus} ${isWeightValid ? "" : ui.incomplete}`}>
                                        {isWeightValid ? (
                                            <><Check size={14} /> Completo</>
                                        ) : (
                                            <><AlertCircle size={14} /> {totalWeight > 100 ? `Sobran ${totalWeight - 100}%` : `Falta ${100 - totalWeight}%`}</>
                                        )}
                                    </span>
                                </div>
                            </div>
                        </section>

                        <div className={`${base.actions} ${base.actionsSplit}`}>
                            <button type="button" className={`${base.btn} ${base.btnOutline} ${base.btnSm}`} onClick={handleBack}>
                                <ChevronLeft size={15} /> Volver
                            </button>
                            <button type="button" className={`${base.btn} ${base.btnPrimary}`} onClick={handleContinueToVigency} disabled={!isWeightValid}>
                                Siguiente — Definir vigencia <ChevronRight size={16} />
                            </button>
                        </div>
                    </>
                )}

                {/* PASO 3 */}
                {currentStep === 3 && (
                    <>
                        <section className={base.card}>
                            <div className={base.cardHeader}>
                                <h2 className={base.cardTitle}>Periodo de vigencia y metas</h2>
                            </div>
                            <div className={base.cardBody}>
                                <div className={base.field}>
                                    <label className={base.label} htmlFor="as-period">Período *</label>
                                    <select id="as-period" className={base.select} value={periodId} onChange={(e) => handlePeriodChange(e.target.value)}>
                                        <option value="">{activePeriods.length === 0 ? "No hay períodos activos" : "Selecciona el período"}</option>
                                        {activePeriods.map((p) => <option key={p.id} value={p.id}>{periodLabel(p)}</option>)}
                                    </select>
                                </div>

                                <div className={ui.dateGrid}>
                                    <div className={base.field}>
                                        <label className={base.label} htmlFor="as-start">Fecha inicio vigencia *</label>
                                        <input id="as-start" type="date" className={base.input} value={vigencyStartDate}
                                            min={periodDates(selectedPeriod).start || undefined} max={periodDates(selectedPeriod).end || undefined}
                                            disabled={!periodId} onChange={(e) => setVigencyStartDate(e.target.value)} />
                                    </div>
                                    <div className={base.field}>
                                        <label className={base.label} htmlFor="as-end">Fecha fin vigencia *</label>
                                        <input id="as-end" type="date" className={base.input} value={vigencyEndDate}
                                            min={vigencyStartDate || periodDates(selectedPeriod).start || undefined} max={periodDates(selectedPeriod).end || undefined}
                                            disabled={!periodId} onChange={(e) => setVigencyEndDate(e.target.value)} />
                                    </div>
                                </div>

                                <div className={ui.divider}>Meta por indicador seleccionado</div>

                                <div className={ui.metaList}>
                                    {selectedIndicators.map((ind) => {
                                        const meta = indicatorsMeta[ind.id] || {};
                                        return (
                                            <div key={ind.id} className={ui.metaCard}>
                                                <div className={ui.metaHead}>
                                                    <h3 className={ui.metaName}>{ind.name}</h3>
                                                    <div className={ui.metaHeadRight}>
                                                        <span className={ui.valueTypePill}>{ind.typeName}</span>
                                                        <span className={ui.metaWeight}>Peso: {indicatorWeights[ind.id]}%</span>
                                                    </div>
                                                </div>
                                                <div className={ui.metaGrid}>
                                                    <div className={base.field}>
                                                        <label className={base.label} htmlFor={`as-meta-${ind.id}`}>Meta *</label>
                                                        <input
                                                            id={`as-meta-${ind.id}`}
                                                            type="number"
                                                            className={base.input}
                                                            placeholder="Ej. 95"
                                                            value={meta.meta || ""}
                                                            onChange={(e) => handleMetaChange(ind.id, "meta", e.target.value)}
                                                        />
                                                    </div>
                                                    <div className={base.field}>
                                                        <label className={base.label} htmlFor={`as-unit-${ind.id}`}>Unidad de medida</label>
                                                        <input
                                                            id={`as-unit-${ind.id}`}
                                                            className={base.input}
                                                            value={ind.targetUnitName ?? "Sin unidad"}
                                                            disabled
                                                        />
                                                    </div>
                                                </div>
                                                <div className={ui.metaHelp}>Valor numérico objetivo</div>
                                            </div>
                                        );
                                    })}
                                </div>
                            </div>
                        </section>

                        <div className={`${base.actions} ${base.actionsSplit}`}>
                            <button type="button" className={`${base.btn} ${base.btnOutline} ${base.btnSm}`} onClick={handleBack}>
                                <ChevronLeft size={15} /> Volver
                            </button>
                            <button type="button" className={`${base.btn} ${base.btnPrimary}`} onClick={handleContinueToApproval}>
                                Siguiente — Confirmar y enviar <ChevronRight size={16} />
                            </button>
                        </div>
                    </>
                )}

                {/* PASO 4 */}
                {currentStep === 4 && (
                    <>
                        <div className={ui.successBanner}>
                            <Clock size={16} />
                            <span>
                                Revisa el resumen antes de confirmar. Al enviar, los indicadores pasarán a estado <strong>Pendiente de aceptación</strong> y los colaboradores recibirán una notificación.
                            </span>
                        </div>

                        <section className={base.card}>
                            <div className={base.cardHeader}>
                                <h2 className={base.cardTitle}>Resumen de asignación</h2>
                            </div>
                            <div className={base.cardBody}>
                                <div className={base.statsGrid}>
                                    <div>
                                        <span className={base.statLabel}>Equipo</span>
                                        <div className={base.statBox}>{Array.from(new Set(selectedCollaborators.map((c) => c.teamName))).join(", ")}</div>
                                    </div>
                                    <div>
                                        <span className={base.statLabel}>Colaboradores seleccionados</span>
                                        <div className={base.statBox}>{plural(selectedCollaborators.length, "usuario", "usuarios")}</div>
                                    </div>
                                    <div>
                                        <span className={base.statLabel}>Periodo de vigencia</span>
                                        <div className={base.statBox}>
                                            {periodName(selectedPeriod)} · {formatDate(vigencyStartDate)} — {formatDate(vigencyEndDate)}
                                        </div>
                                    </div>
                                </div>

                                <div className={ui.divider}>Indicadores y pesos confirmados</div>

                                <div className={ui.reviewList}>
                                    {selectedIndicators.map((ind) => (
                                        <div key={ind.id} className={ui.reviewRow}>
                                            <Check size={16} className={ui.reviewCheck} />
                                            <div className={ui.reviewInfo}>
                                                <div className={ui.reviewName}>{ind.name}</div>
                                                <div className={ui.reviewSub}>
                                                    {ind.typeName} · Meta: {indicatorsMeta[ind.id]?.meta || "-"} {ind.targetUnitName ?? ""}
                                                </div>
                                            </div>
                                            <div className={ui.reviewRight}>
                                                <span className={ui.reviewWeight}>{indicatorWeights[ind.id]}%</span>
                                                <span className={ui.pendingPill}>Pendiente de aceptación</span>
                                            </div>
                                        </div>
                                    ))}
                                </div>

                                <div className={ui.totalBox}>
                                    <span>Peso total asignado</span>
                                    <strong>{totalWeight}%</strong>
                                    <Check size={18} />
                                </div>
                            </div>
                        </section>

                        <div className={`${base.actions} ${base.actionsSplit}`}>
                            <button type="button" className={`${base.btn} ${base.btnOutline} ${base.btnSm}`} onClick={handleBack}>
                                <ChevronLeft size={15} /> Volver
                            </button>
                            <button type="button" className={`${base.btn} ${base.btnPrimary}`} onClick={() => setShowConfirmModal(true)}>
                                <Check size={16} /> Confirmar y enviar solicitud
                            </button>
                        </div>
                    </>
                )}
            </div>

            <Modal
                open={showConfirmModal}
                title="Confirmar asignación de indicadores"
                onClose={() => setShowConfirmModal(false)}
                footer={
                    <div className={base.modalFooter}>
                        <button type="button" className={`${base.btn} ${base.btnOutline}`} onClick={() => setShowConfirmModal(false)}>
                            Cancelar
                        </button>
                        <button type="button" className={`${base.btn} ${base.btnPrimary}`} onClick={handleConfirmAndSend}>
                            Sí, enviar solicitud
                        </button>
                    </div>
                }
            >
                <p className={base.modalText}>
                    ¿Confirmas el envío de esta asignación de indicadores a {plural(selectedCollaborators.length, "colaborador", "colaboradores")}?
                </p>
                <p className={ui.modalNote}>
                    Una vez enviados, los indicadores quedarán en estado <strong>Pendiente de aceptación</strong> y los colaboradores recibirán una notificación para que los acepten.
                </p>
            </Modal>
        </>
    );
};






