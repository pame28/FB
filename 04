import { ArrowLeftRight, Pencil, Plus, Trash2, UserCheck, Users, UserX, X } from "lucide-react";
import { initials, statusTone, userSubtitle } from "./teamUtils";
import t from "./Teams.module.css";

const plural = (n, one, many) => `${n} ${n === 1 ? one : many}`;

export function TeamCard({ team, onEdit, onDelete, onChangeLeaders, onAddMembers, onMoveMember, onRemoveMember }) {
  const leaderCount = team.leaders.length;
  const memberCount = team.members.length;

  return (
    <article className={t.card} aria-label={team.name}>
      {/* ---------- Encabezado ---------- */}
      <header className={t.cardHead}>
        {team.areaName ? <span className={t.areaTag}>{team.areaName}</span> : <span />}
        <div className={t.cardActions}>
          <button type="button" className={t.iconBtn} title="Editar equipo"
            aria-label={`Editar ${team.name}`} onClick={() => onEdit(team)}>
            <Pencil size={15} />
          </button>
          <button type="button" className={`${t.iconBtn} ${t.iconBtnDanger}`} title="Eliminar equipo"
            aria-label={`Eliminar ${team.name}`} onClick={() => onDelete(team)}>
            <Trash2 size={15} />
          </button>
        </div>
      </header>

      <h3 className={t.teamName}>{team.name}</h3>
      <p className={t.teamMeta}>
        {plural(leaderCount, "líder", "líderes")} · {plural(memberCount, "miembro", "miembros")}
      </p>

      {/* ---------- Líderes ---------- */}
      <section className={t.leaderPanel} aria-label="Líderes del equipo">
        <div className={t.panelHead}>
          <span className={t.panelLabel}><UserCheck size={14} /> Líderes</span>
          <button type="button" className={t.pillBtn} onClick={() => onChangeLeaders(team)}>
            {leaderCount ? "Cambiar" : "Asignar"}
          </button>
        </div>

        {leaderCount === 0 ? (
          <div className={t.noLeader}>
            <UserX size={16} /> Este equipo aún no tiene líder
          </div>
        ) : (
          <ul className={t.leaderList}>
            {team.leaders.map((l) => (
              <li key={l.id} className={t.leaderItem}>
                <span className={t.leaderAvatar}>{initials(l.name)}</span>
                <span className={t.personText}>
                  <span className={t.personName}>{l.name}</span>
                  {l.position && <span className={t.personSub}>{l.position}</span>}
                </span>
              </li>
            ))}
          </ul>
        )}
      </section>

      {/* ---------- Miembros ---------- */}
      <div className={t.sectionHead}>
        <span className={t.sectionLabel}><Users size={14} /> Miembros ({memberCount})</span>
        <button type="button" className={t.addBtn} onClick={() => onAddMembers(team)}>
          <Plus size={14} strokeWidth={2.6} /> Agregar
        </button>
      </div>

      {memberCount === 0 ? (
        <div className={t.emptyMembers}>
          <Users size={22} />
          <span>Este equipo aún no tiene miembros.</span>
        </div>
      ) : (
        <ul className={t.memberList}>
          {team.members.map((m) => {
            const sub = userSubtitle(m);
            return (
              <li key={m.id} className={t.member}>
                <div className={t.person}>
                  <span className={t.avatar}>{initials(m.name)}</span>
                  <span className={t.personText}>
                    <span className={t.personName}>{m.name}</span>
                    {sub && <span className={t.personSub}>{sub}</span>}
                  </span>
                </div>
                <div className={t.memberTools}>
                  {m.status && <span className={`${t.status} ${t[statusTone(m.status)]}`}>{m.status}</span>}
                  <button type="button" className={`${t.iconBtn} ${t.iconBtnSm}`} title="Mover a otro equipo"
                    aria-label={`Mover a ${m.name} a otro equipo`} onClick={() => onMoveMember(team, m)}>
                    <ArrowLeftRight size={14} />
                  </button>
                  <button type="button" className={`${t.iconBtn} ${t.iconBtnSm} ${t.iconBtnDanger}`} title="Remover del equipo"
                    aria-label={`Remover a ${m.name} del equipo`} onClick={() => onRemoveMember(team, m)}>
                    <X size={14} />
                  </button>
                </div>
              </li>
            );
          })}
        </ul>
      )}
    </article>
  );
}












