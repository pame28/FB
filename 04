        public bool ObtieneParametros()
        {
            ConnectionManager cm = Dts.Connections["DESCARGAINFO"];
            SqlConnection conn = null;

            try
            {
                conn = cm.AcquireConnection(null) as SqlConnection;
                if (conn == null)
                    throw new InvalidOperationException("No se pudo obtener la conexión desde el Connection Manager.");

                CargarParametrosProceso(conn, "EPosicionDiaria");
                CargarParametrosProceso(conn, "General");
                return true;
            }
            catch (Exception ex)
            {
                RegistraProceso("F", $"Falló obtener información desde usp_GetParametersByProcess con error {ex.Message}");
                return false;
            }
            finally
            {
                if (conn != null)
                    cm.ReleaseConnection(conn);
            }
        }

        private void CargarParametrosProceso(SqlConnection conn, string proceso)
        {
            using (SqlCommand cmd = new SqlCommand("usp_GetParametersByProcess", conn))
            {
                cmd.CommandType = CommandType.StoredProcedure;
                cmd.CommandTimeout = TimeoutSegundos;
                cmd.Parameters.Add("@Proceso", SqlDbType.VarChar).Value = proceso;

                using (SqlDataReader reader = cmd.ExecuteReader())
                {
                    while (reader.Read())
                    {
                        string idParametro = reader["IdParametro"].ToString();
                        string valorParametro = reader["ValorParametro"].ToString();

                        if (!parametros.ContainsKey(idParametro))
                            parametros.Add(idParametro, valorParametro);
                    }
                }
            }
        }

        public void ParseaConsultas()
        {
            string hora = DateTime.Now.ToString("HHmmss");
            string fecha = DateTime.Now.ToString("yyyy-MM-dd");
            sql_ConsultaEstado = parametros["ConsultaEstado"]
                 .Replace("{ARCHIVO_CONTROL}", parametros["ArchivoControl"])
                 .Replace("{FECHA_GENERACION}", $"'{fecha_generacion}'")
                 .Replace("{ESTADO_INICIAL}", $"'{parametros["EstadoInicial"]}'")
                 .Replace("{ARCHIVO_GENERADO}", $"'{parametros["ArchivoGenerado"]}'");

            sql_ConsultaOrigen = parametros["ConsultaOrigen"]
                .Replace("{ARCHIVO_ORIGEN}", parametros["ArchiviOrigen"]);

            sql_ConsultaActualizar = parametros["ConsultaActualizar"]
                .Replace("{ARCHIVO_CONTROL}", parametros["ArchivoControl"])
                .Replace("{ESTADO_FINAL}", $"'{parametros["EstadoFinal"]}'")
                .Replace("{FECHA_PROCESADO}", $"'{fecha}'")
                .Replace("{HORA_PROCESADO}", $"'{hora}'")
                .Replace("{USER}", $"'{parametros["Usuario"]}'")
                .Replace("{FECHA_GENERACION}", $"'{fecha_generacion}'")
                .Replace("{ESTADO_INICIAL}", $"'{parametros["EstadoInicial"]}'")
                .Replace("{ARCHIVO_GENERADO}", $"'{parametros["ArchivoGenerado"]}'");
        }

        public string ObtenerEstadoProceso()
        {
            string estado_proceso = string.Empty;
            ConnectionManager cm = Dts.Connections["AS400"];
            OleDbConnection conn = null;

            try
            {
                conn = cm.AcquireConnection(null) as OleDbConnection;
                if (conn == null)
                    throw new InvalidOperationException("No se pudo obtener la conexión desde el Connection Manager.");

                using (IDbCommand cmd = conn.CreateCommand())
                {
                    cmd.CommandText = sql_ConsultaEstado;
                    cmd.CommandTimeout = TimeoutSegundos;
                    using (IDataReader reader = cmd.ExecuteReader())
                    {
                        while (reader.Read())
                            estado_proceso = reader.GetString(0);
                    }
                }
            }
            catch (Exception ex)
            {
                RegistraProceso("F", $"Falló obtener estado proceso {sql_ConsultaEstado} con error {ex.Message}");
                return null;
            }
            finally
            {
                if (conn != null)
                    cm.ReleaseConnection(conn);
            }

            return estado_proceso;
        }

        public bool RealizarReintento(string estadoProceso)
        {
            int intentoActual = 0;
            var reintentos = ObtenerInfoReintentos();

            while (estadoProceso != "G" && intentoActual < reintentos.CantidadReintentos)
            {
                intentoActual++;
                System.Threading.Thread.Sleep(reintentos.MinutosReintentos * 60 * 1000);
                estadoProceso = ObtenerEstadoProceso();
            }

            if (estadoProceso == "G")
                return RealizarMovimiento();

            // (Corregido antes: este mensaje solo se registra cuando de verdad se agotan los reintentos)
            RegistraProceso("F", $"Falló reintentos {reintentos.CantidadReintentos} durante: {reintentos.MinutosReintentos} cada uno, no se actualizó estado G en AS400");
            return false;
        }

        public Reintentos ObtenerInfoReintentos()
        {
            return new Reintentos
            {
                CantidadReintentos = int.Parse(parametros["CantidadReintentos"]),
                MinutosReintentos = int.Parse(parametros["MinutosReintentos"]),
            };
        }

