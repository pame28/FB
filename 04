        public DataTable ConvertirADataTable(List<Financiamiento> financiamientos)
        {

            try
            {
                DataTable dt = new DataTable();

                dt.Columns.Add("NumeroCuenta", typeof(string));
                dt.Columns.Add("GrupoMovimientos", typeof(string));
                dt.Columns.Add("CodigoOperacion", typeof(string));
                dt.Columns.Add("NoCutRelacionado", typeof(string));
                dt.Columns.Add("MonedaMovimiento", typeof(string));
                dt.Columns.Add("Importe", typeof(decimal));
                dt.Columns.Add("ImporteTotalPlan", typeof(decimal));
                dt.Columns.Add("InteresCuotaLiquida", typeof(decimal));
                dt.Columns.Add("PlanCuotaCapitalPend", typeof(decimal));
                dt.Columns.Add("PlanCuotaInteresPend", typeof(decimal));
                dt.Columns.Add("PlanExtraTasa", typeof(decimal));
                dt.Columns.Add("NoCuotaLiquidada", typeof(byte));       
                dt.Columns.Add("CantidadCuotasPlan", typeof(byte));     
                dt.Columns.Add("NombreTarjeta", typeof(string));
                dt.Columns.Add("EsIntra", typeof(bool));               
                dt.Columns.Add("EsExtra", typeof(bool));              
                dt.Columns.Add("FechaCierre", typeof(DateTime));      
                dt.Columns.Add("FechaOtorgamiento", typeof(DateTime));  
                dt.Columns.Add("ProcesadorOrigen", typeof(string));

                bool esIntra;
                bool esExtra;
                foreach (var h in financiamientos)
                {
                    esIntra = h.EsIntra == "1";
                    esExtra = h.EsExtra == "1";
                    dt.Rows.Add(
                        LimpiarEspacios(h.NumeroCuenta),
                        LimpiarEspacios(h.GrupoMovimientos),
                        LimpiarEspacios(h.CodigoOperacion),
                        LimpiarEspacios(h.NoCutRelacionado),
                        LimpiarEspacios(h.MonedaMovimiento),
                        h.Importe,
                        h.ImporteTotalPlan,
                        h.InteresCuotaLiquida,
                        h.PlanCuotaCapitalPend,
                        h.PlanCuotaInteresPend,
                        h.PlanExtraTasa,
                        h.NoCuotaLiquidada,
                        h.CantidadCuotasPlan,
                        LimpiarEspacios(h.NombreTarjeta),
                        esIntra,
                        esExtra,
                        h.FechaCierre,
                        h.FechaOtorgamiento,
                        LimpiarEspacios(h.ProcesadorOrigen)
                    );
                }
                return dt;
            }

            catch (Exception ex)
            {
                RegistraProceso("F", $"Falló proceso de conversión DataTable {parametros["ArchivoDestino"]} con error {ex.Message.ToString()}");

                return new DataTable();
            }
        }

        public bool EjecutarBulkInsertBandejaVasa(DataTable tableCuentas)
