.detailHead { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
.detailTitle { margin: 0; font-size: 19px; font-weight: 800; color: var(--bp-blue-expert); }
.detailDesc { margin: 2px 0 0; font-size: 13.5px; color: #8592a3; }
.activeCount { flex-shrink: 0; padding-top: 4px; font-size: 12.5px; font-weight: 700; color: #8592a3; }

/* ---- Pestañas de módulos ---- */
.tabs {
  display: flex;
  gap: 4px;
  margin-top: 16px;
  border-bottom: 1px solid #e6ebf1;
  overflow-x: auto;
  scrollbar-width: thin;
}

.tab {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 14px;
  border: none;
  background: none;
  font: inherit;
  font-size: 13.5px;
  font-weight: 700;
  white-space: nowrap;
  color: #8592a3;
  cursor: pointer;
}
.tab:hover { color: var(--bp-blue-expert); }
.tabActive { color: var(--bp-blue-expert); }
.tabActive::after {
  content: "";
  position: absolute;
  left: 10px;
  right: 10px;
  bottom: -1px;
  height: 3px;
  border-radius: 3px 3px 0 0;
  background: var(--bp-yellow-opt);
}
