export { exportReport } from "./exportReport";




import { loadReportConfig } from "./reportConfig";
import { buildFileName } from "./reportFormat";

const saveBlob = (blob, fileName) => {
  const url = URL.createObjectURL(blob);
  const link = document.createElement("a");
  link.href = url;
  link.download = fileName;
  document.body.appendChild(link);
  link.click();
  link.remove();
  setTimeout(() => URL.revokeObjectURL(url), 1000);
};

/**
 * Genera y descarga un reporte en Excel o PDF.
 * Las librerías se cargan solo aquí, al exportar, para no hacer más pesada la app.
 *
 * @param {"excel" | "pdf"} format
 * @param {object} report
 *   title       Título del reporte
 *   subtitle    (opcional) Texto bajo el título
 *   fileName    (opcional) Nombre base del archivo; por defecto, el título
 *   columns     [{ header, key | value(row), type, width, pdfWidth, tone(valor), align, empty }]
 *   rows        Datos
 *   filters     [{ label, value }]  Filtros aplicados (con nombres, no IDs)
 *   summary     [{ label, value, tone }]  Datos extra para la ficha (ej. activos / inactivos)
 *   generatedBy Nombre de quien genera el reporte
 */
export const exportReport = async (format, report) => {
  const config = await loadReportConfig();
  const generatedAt = new Date();
  const data = { ...report, generatedAt };
  const baseName = buildFileName(report.fileName ?? report.title, generatedAt);

  if (format === "excel") {
    const { buildExcel } = await import("./excelReport");
    saveBlob(await buildExcel(config, data), `${baseName}.xlsx`);
  } else {
    const { buildPdf } = await import("./pdfReport");
    saveBlob(await buildPdf(config, data), `${baseName}.pdf`);
  }
};









/* =========================================================
   Configuración del encabezado de los reportes.
   Se lee de public/report-config.json cuando se exporta:
   para cambiar el logo, colores o textos NO se toca código.
   ========================================================= */

const BASE = import.meta.env.BASE_URL ?? "/";

// Valores por defecto si el JSON no existe o le falta algún campo
const DEFAULTS = {
  logo: null,
  organization: "",
  system: "eCoaching",
  primaryColor: "#003964",
  accentColor: "#FFC000",
  pageSize: "LETTER",
  showFilters: true,
  showGeneratedBy: true,
  footerText: "",
};

const resolveUrl = (path) => (/^(https?:)?\/\//.test(path) || path.startsWith("/") ? path : `${BASE}${path}`);

const blobToDataUrl = (blob) =>
  new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => resolve(reader.result);
    reader.onerror = reject;
    reader.readAsDataURL(blob);
  });

const imageSize = (src) =>
  new Promise((resolve) => {
    const img = new Image();
    img.onload = () => resolve({ width: img.naturalWidth, height: img.naturalHeight });
    img.onerror = () => resolve({ width: 0, height: 0 });
    img.src = src;
  });

/** Descarga el logo y lo deja listo para Excel y PDF (solo PNG o JPG) */
const loadLogo = async (path) => {
  if (!path) return null;
  try {
    const res = await fetch(resolveUrl(path), { cache: "no-cache" });
    if (!res.ok) return null;
    const blob = await res.blob();
    const extension = { "image/png": "png", "image/jpeg": "jpeg", "image/jpg": "jpeg" }[blob.type];
    if (!extension) {
      console.warn(`[reportes] El logo debe ser PNG o JPG (se recibió ${blob.type || "un tipo desconocido"}).`);
      return null;
    }
    const dataUrl = await blobToDataUrl(blob);
    const { width, height } = await imageSize(dataUrl);
    return { dataUrl, extension, width, height };
  } catch {
    return null;
  }
};

let cache = null;

/** Configuración + logo. Se descarga una vez y se reutiliza mientras la página esté abierta. */
export const loadReportConfig = () => {
  if (!cache) {
    cache = (async () => {
      let config = DEFAULTS;
      try {
        const res = await fetch(`${BASE}report-config.json`, { cache: "no-cache" });
        if (res.ok) config = { ...DEFAULTS, ...(await res.json()) };
      } catch {
        // Sin JSON: se usan los valores por defecto
      }
      return { ...config, logo: await loadLogo(config.logo) };
    })();
  }
  return cache;
};












/* =========================================================
   Formatos y colores compartidos por Excel y PDF.
   Tipos de columna: text | number | integer | money | percent | date | datetime
   ========================================================= */

/** Colores de las etiquetas (estado, etc.). bg = fondo, fg = texto */
export const TONES = {
  green: { bg: "#DCFCE7", fg: "#166534" },
  red: { bg: "#FEE2E2", fg: "#991B1B" },
  blue: { bg: "#E0E7FF", fg: "#2E4EB9" },
  teal: { bg: "#D5F1F4", fg: "#137A85" },
  pink: { bg: "#F7E1EB", fg: "#B0466F" },
  amber: { bg: "#FFF4D6", fg: "#8A5A00" },
  grey: { bg: "#EEF1F5", fg: "#5B6B80" },
};

/** Valor crudo de una celda: column.value(row) o row[column.key] */
export const cellValue = (column, row) =>
  typeof column.value === "function" ? column.value(row) : row?.[column.key];

/** Color de etiqueta de una celda, si la columna lo define (column.tone(valor) → "green") */
export const cellTone = (column, raw) => {
  if (typeof column.tone !== "function" || raw === null || raw === undefined || raw === "") return null;
  return TONES[column.tone(raw)] ?? null;
};

const toDate = (v) => {
  if (v === null || v === undefined || v === "") return null;
  const d = v instanceof Date ? v : new Date(v);
  return Number.isNaN(d.getTime()) ? null : d;
};

const toNumber = (v) => {
  if (v === null || v === undefined || v === "") return null;
  const n = typeof v === "number" ? v : Number(String(v).replace(/,/g, ""));
  return Number.isNaN(n) ? null : n;
};

/** Valor tipado para Excel (número, fecha o texto) */
export const excelValue = (column, raw) => {
  switch (column.type) {
    case "number":
    case "integer":
    case "money":
    case "percent": return toNumber(raw) ?? (raw ?? "");
    case "date":
    case "datetime": return toDate(raw) ?? (raw ?? "");
    default: return raw === null || raw === undefined ? "" : String(raw);
  }
};

/** Formato de número de Excel según el tipo */
export const excelNumFmt = (column) => {
  const currency = column.currency ? `"${column.currency} "` : "";
  return {
    number: "#,##0.00",
    integer: "#,##0",
    money: `${currency}#,##0.00`,
    percent: '0.00"%"', // el valor ya viene en porcentaje (85 = 85%)
    date: "dd/mm/yyyy",
    datetime: "dd/mm/yyyy hh:mm",
  }[column.type];
};

const nf = (decimals) =>
  new Intl.NumberFormat("es-HN", { minimumFractionDigits: decimals, maximumFractionDigits: decimals });

/** Texto ya formateado (PDF) */
export const displayValue = (column, raw) => {
  if (raw === null || raw === undefined || raw === "") return column.empty ?? "—";
  switch (column.type) {
    case "number": { const n = toNumber(raw); return n === null ? String(raw) : nf(2).format(n); }
    case "integer": { const n = toNumber(raw); return n === null ? String(raw) : nf(0).format(n); }
    case "money": {
      const n = toNumber(raw);
      return n === null ? String(raw) : `${column.currency ? `${column.currency} ` : ""}${nf(2).format(n)}`;
    }
    case "percent": { const n = toNumber(raw); return n === null ? String(raw) : `${nf(2).format(n)}%`; }
    case "date": { const d = toDate(raw); return d ? formatDate(d) : String(raw); }
    case "datetime": { const d = toDate(raw); return d ? formatDateTime(d) : String(raw); }
    default: return String(raw);
  }
};

/** Alineación por defecto: números a la derecha, fechas y etiquetas al centro */
export const columnAlign = (column) =>
  column.align ?? (["number", "integer", "money", "percent"].includes(column.type)
    ? "right"
    : ["date", "datetime"].includes(column.type) || column.tone ? "center" : "left");

const pad = (n) => String(n).padStart(2, "0");

export const formatDate = (d) => `${pad(d.getDate())}/${pad(d.getMonth() + 1)}/${d.getFullYear()}`;

export const formatDateTime = (d) => {
  const h = d.getHours();
  return `${formatDate(d)} ${pad(h % 12 || 12)}:${pad(d.getMinutes())} ${h < 12 ? "a. m." : "p. m."}`;
};

/** "Reporte de usuarios" → "reporte-de-usuarios_2026-11-24_0930" */
export const buildFileName = (name, date) => {
  const slug = String(name || "reporte")
    .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
    .toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
  return `${slug}_${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}_${pad(date.getHours())}${pad(date.getMinutes())}`;
};















import ExcelJS from "exceljs";
import { cellTone, cellValue, columnAlign, excelNumFmt, excelValue, formatDateTime } from "./reportFormat";

const argb = (hex) => `FF${String(hex).replace("#", "").toUpperCase()}`;
const solid = (hex) => ({ type: "pattern", pattern: "solid", fgColor: { argb: argb(hex) } });

const GREY = "#6B7A8F";
const LIGHT = "#F4F8FD";
const LINE = "#E6EBF1";
const LOGO_HEIGHT = 44; // px

// Ancho automático: el texto más largo de la columna (entre 10 y 45 caracteres)
const autoWidth = (column, rows) => {
  const lengths = rows.slice(0, 500).map((r) => String(cellValue(column, r) ?? "").length);
  return Math.min(45, Math.max(10, column.header.length + 3, ...lengths.map((l) => l + 3)));
};

/**
 * Arma el Excel y devuelve un Blob.
 * Estructura: logo · franja · título · ficha (fecha, usuario, totales, filtros) · tabla
 */
export const buildExcel = async (config, report) => {
  const { title, subtitle, columns, rows, filters = [], summary = [], generatedBy, generatedAt } = report;

  const workbook = new ExcelJS.Workbook();
  workbook.creator = config.system;
  workbook.created = generatedAt;

  const sheet = workbook.addWorksheet((report.sheetName ?? title).slice(0, 31), {
    pageSetup: {
      paperSize: config.pageSize === "A4" ? 9 : 1,
      orientation: columns.length > 5 ? "landscape" : "portrait",
      fitToPage: true,
      fitToWidth: 1,
      fitToHeight: 0,
      margins: { left: 0.4, right: 0.4, top: 0.5, bottom: 0.5, header: 0.2, footer: 0.2 },
    },
    headerFooter: { oddFooter: `&L&8${config.footerText ?? ""}&R&8Página &P de &N` },
  });

  const lastCol = Math.max(columns.length, 4);
  sheet.columns = Array.from({ length: lastCol }, (_, i) =>
    ({ width: columns[i] ? columns[i].width ?? autoWidth(columns[i], rows) : 12 }));

  let r = 1;
  const mergeRow = (row, from = 1, to = lastCol) => { if (to > from) sheet.mergeCells(row, from, row, to); };
  const fillRow = (row, hex) => { for (let c = 1; c <= lastCol; c++) sheet.getCell(row, c).fill = solid(hex); };

  /* ---------- Logo y organización ---------- */
  sheet.getRow(r).height = LOGO_HEIGHT * 0.8;
  mergeRow(r);
  const brand = sheet.getCell(r, 1);
  brand.value = {
    richText: [
      { text: `${config.organization ?? ""}\n`, font: { bold: true, size: 11, color: { argb: argb(config.primaryColor) } } },
      { text: config.system ?? "", font: { size: 9, color: { argb: argb(GREY) } } },
    ],
  };
  brand.alignment = { horizontal: "right", vertical: "middle", wrapText: true };

  if (config.logo) {
    const imageId = workbook.addImage({ base64: config.logo.dataUrl, extension: config.logo.extension });
    const ratio = config.logo.height ? config.logo.width / config.logo.height : 3;
    sheet.addImage(imageId, { tl: { col: 0.15, row: 0.12 }, ext: { width: LOGO_HEIGHT * ratio, height: LOGO_HEIGHT } });
  }
  r++;

  /* ---------- Franja de marca ---------- */
  sheet.getRow(r).height = 4;
  fillRow(r, config.accentColor);
  r++;
  sheet.getRow(r).height = 8;
  r++;

  /* ---------- Título ---------- */
  sheet.getRow(r).height = 28;
  mergeRow(r);
  Object.assign(sheet.getCell(r, 1), {
    value: title,
    font: { size: 18, bold: true, color: { argb: argb(config.primaryColor) } },
    alignment: { vertical: "middle" },
  });
  r++;

  if (subtitle) {
    mergeRow(r);
    Object.assign(sheet.getCell(r, 1), { value: subtitle, font: { size: 10, color: { argb: argb(GREY) } } });
    r++;
  }
  sheet.getRow(r).height = 8;
  r++;

  /* ---------- Ficha del reporte ---------- */
  const facts = [
    { label: "Generado el", value: formatDateTime(generatedAt) },
    ...(config.showGeneratedBy && generatedBy ? [{ label: "Generado por", value: generatedBy }] : []),
    { label: "Total de registros", value: String(rows.length) },
    ...summary.map((s) => ({ label: s.label, value: String(s.value) })),
  ];
  const boxStart = r;

  // Etiqueta y valor en pares de columnas (2 datos por fila)
  const perRow = 2;
  const span = Math.max(1, Math.floor(lastCol / (perRow * 2)));
  for (let i = 0; i < facts.length; i += perRow) {
    sheet.getRow(r).height = 18;
    facts.slice(i, i + perRow).forEach((fact, j) => {
      const labelCol = 1 + j * span * 2;
      const valueCol = labelCol + span;
      const valueEnd = j === perRow - 1 ? lastCol : valueCol + span - 1;
      mergeRow(r, labelCol, valueCol - 1);
      mergeRow(r, valueCol, valueEnd);
      Object.assign(sheet.getCell(r, labelCol), {
        value: fact.label.toUpperCase(),
        font: { size: 8, bold: true, color: { argb: argb(GREY) } },
        alignment: { vertical: "middle", indent: 1 },
      });
      Object.assign(sheet.getCell(r, valueCol), {
        value: fact.value,
        font: { size: 10, bold: true, color: { argb: argb(config.primaryColor) } },
        alignment: { vertical: "middle" },
      });
    });
    r++;
  }

  if (config.showFilters) {
    sheet.getRow(r).height = 30;
    mergeRow(r, 1, span);
    mergeRow(r, span + 1, lastCol);
    Object.assign(sheet.getCell(r, 1), {
      value: "FILTROS",
      font: { size: 8, bold: true, color: { argb: argb(GREY) } },
      alignment: { vertical: "middle", indent: 1 },
    });
    Object.assign(sheet.getCell(r, span + 1), {
      value: filters.length ? filters.map((f) => `${f.label}: ${f.value}`).join("   ·   ") : "Sin filtros (todos los registros)",
      font: { size: 10, color: { argb: argb("#3D4B5C") } },
      alignment: { vertical: "middle", wrapText: true },
    });
    r++;
  }

  for (let row = boxStart; row < r; row++) fillRow(row, LIGHT);
  for (let c = 1; c <= lastCol; c++) {
    sheet.getCell(boxStart, c).border = { top: { style: "thin", color: { argb: argb("#D6E6F6") } } };
    sheet.getCell(r - 1, c).border = { bottom: { style: "thin", color: { argb: argb("#D6E6F6") } } };
  }
  sheet.getRow(r).height = 10;
  r++;

  /* ---------- Tabla ---------- */
  const headerRow = r;
  const head = sheet.getRow(headerRow);
  head.height = 24;
  columns.forEach((c, i) => {
    Object.assign(head.getCell(i + 1), {
      value: c.header,
      font: { bold: true, size: 10, color: { argb: "FFFFFFFF" } },
      fill: solid(config.primaryColor),
      alignment: { vertical: "middle", horizontal: columnAlign(c), wrapText: true },
    });
  });
  r++;

  const border = { bottom: { style: "thin", color: { argb: argb(LINE) } } };
  rows.forEach((row, index) => {
    const excelRow = sheet.getRow(r);
    columns.forEach((c, i) => {
      const raw = cellValue(c, row);
      const cell = excelRow.getCell(i + 1);
      cell.value = excelValue(c, raw);
      const fmt = excelNumFmt(c);
      if (fmt) cell.numFmt = fmt;
      cell.alignment = { vertical: "middle", horizontal: columnAlign(c), wrapText: Boolean(c.wrap) };
      cell.border = border;
      cell.font = { size: 10 };
      const tone = cellTone(c, raw);
      if (tone) {
        cell.fill = solid(tone.bg);
        cell.font = { size: 10, bold: true, color: { argb: argb(tone.fg) } };
      } else if (index % 2 === 1) {
        cell.fill = solid("#F8FAFC");
      }
    });
    r++;
  });

  if (rows.length === 0) {
    mergeRow(r);
    Object.assign(sheet.getCell(r, 1), {
      value: "No hay registros para los filtros seleccionados.",
      font: { italic: true, color: { argb: argb(GREY) } },
      alignment: { horizontal: "center" },
    });
  }

  // Encabezado fijo al hacer scroll, filtros de Excel y encabezado repetido al imprimir
  sheet.views = [{ state: "frozen", ySplit: headerRow, showGridLines: false }];
  if (rows.length > 0) sheet.autoFilter = { from: { row: headerRow, column: 1 }, to: { row: headerRow, column: columns.length } };
  sheet.pageSetup.printTitlesRow = `${headerRow}:${headerRow}`;

  const buffer = await workbook.xlsx.writeBuffer();
  return new Blob([buffer], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" });
};












import pdfMake from "pdfmake/build/pdfmake";
