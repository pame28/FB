        /// <summary>
        /// Realiza la sincronización de usuarios desde el AS400 y devuelve la respuesta HTTP correspondiente.
        /// </summary>
        /// <param name="coachingCajerosService"></param>
        /// <param name="usersRepository"></param>
        /// <param name="modelLogsRepository"></param>
        /// <param name="claimsPrincipal"></param>
        /// <param name="loggerFactory"></param>
        /// <returns></returns>
        private static async Task<IResult> SyncUsersAs400(
            IUsersTellersAs400Service coachingCajerosService,
            IUsersRepository usersRepository,
            IModelLogsRepository modelLogsRepository,
            ClaimsPrincipal claimsPrincipal,
            ILoggerFactory loggerFactory)
        {
            var logger = loggerFactory.CreateLogger(typeof(UserEndpoints));
            var currentUserId = GetCurrentUserId(claimsPrincipal);

            try
            {
                if (string.IsNullOrWhiteSpace(currentUserId))
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = 401,
                        Message = GenericErrors.UnauthorizedUserMessage
                    }, statusCode: StatusCodes.Status401Unauthorized);
                }

                var cajeros = await coachingCajerosService.ObtenerCajerosAsync();
                var syncResult = await usersRepository.SyncAs400Users(cajeros);

                await modelLogsRepository.CreateLog(new ModelLog
                {
                    OperationType = OperationType.Update,
                    ModelName = nameof(User),
                    EndpointFunction = nameof(SyncUsersAs400),
                    OperationDate = DateTime.Now,
                    JsonModel = JsonConvert.SerializeObject(new
                    {
                        syncResult.Total,
                        syncResult.Created,
                        syncResult.Updated
                    }),
                    UserId = currentUserId
                });

                return Results.Ok(new ResponseObject<SyncUsersAs400ResultDto>
                {
                    Code = 200,
                    Message = "Sincronización realizada exitosamente.",
                    Data = syncResult
                });
            }
            catch (Exception ex)
            {
                logger.LogError(ex, "SyncUsersAs400Error");
                return Results.Json(new ResponseObjectError
                {
                    Code = 500,
                    Message = GenericErrors.InternalServerError
                }, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

