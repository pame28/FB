		#region Transformacion de filas
		/// <summary>
		/// Mapea una fila de AS400 (104 columnas) a la fila destino (106 columnas):
		/// inserta larId en la posicion 96 y ProcesadorOrigen al final. 
		/// </summary>
		private void LlenarFila(object[] origen, object[] destino, Type[] tipos, string[] nombres)
		{
			for (int i = 0; i < PosicionLarId; i++)
				destino[i] = Convertir(origen[i], tipos[i], nombres[i]);

			destino[PosicionLarId] = _larId;

			for (int i = PosicionLarId; i < ColumnasOrigen; i++)
				destino[i + 1] = Convertir(origen[i], tipos[i + 1], nombres[i + 1]);

			destino[ColumnasDestino - 1] = ProcesadorOrigen;
		}

		/// <summary>
		/// Conversion tipada. Los numericos de AS400 llegan como decimal (ej. 0.00) y NO se pasan por texto,
		/// porque "0.00" no se puede convertir a Int32/Int16/Byte. 
		/// </summary>
		private static object Convertir(object valor, Type destino, string columna)
		{
			if (valor == null || valor == DBNull.Value)
				return DBNull.Value;

			if (!(valor is string))
			{
				if (destino == typeof(decimal))
					return Convert.ToDecimal(valor);

				if (destino == typeof(int) || destino == typeof(short) || destino == typeof(byte))
				{
					decimal d = Convert.ToDecimal(valor);
					//if (d != decimal.Truncate(d))
					//	throw new InvalidCastException("El valor " + d + " tiene decimales pero la columna '" + columna +
					//								   "' es " + destino.Name + ". Revise el tipo de la columna destino.");
					return Convert.ChangeType(d, destino);
				}
			}

			return valor;
		}

		// Trim; vacio -> NULL. Los no-string se pasan como texto y el DataTable los convierte.
		private static object Limpiar(object valor)
		{
			if (valor == null || valor == DBNull.Value)
				return DBNull.Value;

			string texto = (valor as string ?? valor.ToString()).Trim();
			return texto.Length == 0 ? (object)DBNull.Value : texto;
		}

		private static readonly Type S = typeof(string);
		private static readonly Type I16 = typeof(short);
		private static readonly Type I32 = typeof(int);
		private static readonly Type U8 = typeof(byte);
		private static readonly Type DEC = typeof(decimal);
		private static readonly Type FEC = typeof(DateTime);

		private static void Col(DataTable dt, string nombre, Type tipo)
		{
			dt.Columns.Add(nombre, tipo);
		}

		// El orden de las columnas debe coincidir con el de la tabla destino (SqlBulkCopy mapea por posicion).
		private static DataTable CrearTablaLote()
		{
			DataTable dt = new DataTable();
			Col(dt, "NumeroTarjeta", S);
			Col(dt, "NumeroTarjetaRes", S);
			Col(dt, "LongitudNoTarjeta", S);
			Col(dt, "NoPlasticoGenerado", I32);
			Col(dt, "CodigoBanco", I16);
			Col(dt, "CodigoCasa", I16);
			Col(dt, "NoUsuario", S);
			Col(dt, "NombreCliente", S);
			Col(dt, "NombreTarjetaImprimir", S);
			Col(dt, "CodigoProducto", S);
			Col(dt, "Cartera", I16);
			Col(dt, "ModeloLiquidacion", I16);
			Col(dt, "GrupoAfinidad", I32);
