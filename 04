SELECT CodigoCore, COUNT(DISTINCT NumeroTarjeta) AS TarjetasDistintas
FROM CuotasPendientes_mig
GROUP BY CodigoCore
HAVING COUNT(DISTINCT NumeroTarjeta) > 1;

