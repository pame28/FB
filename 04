const GREY = "#6B7A8F";
const LIGHT = "#F4F8FD";
const LINE = "#E6EBF1";
const MARGIN_X = 36;

/** Definición del documento (pdfmake). Encabezado y pie se repiten en cada página. */
export const buildPdfDefinition = (config, report) => {
  const { title, subtitle, columns, rows, filters = [], summary = [], generatedBy, generatedAt } = report;
  const landscape = report.orientation ? report.orientation === "landscape" : columns.length > 5;

  /* ---------- Encabezado de cada página ---------- */
  const header = (currentPage, pageCount, pageSize) => ({
    margin: [MARGIN_X, 18, MARGIN_X, 0],
    stack: [
      {
        columns: [
          config.logo ? { image: config.logo.dataUrl, fit: [130, 34], width: "auto" } : { text: "", width: "auto" },
          {
            width: "*",
            alignment: "right",
            margin: [0, 4, 0, 0],
            stack: [
              { text: config.organization ?? "", bold: true, fontSize: 10, color: config.primaryColor },
              { text: config.system ?? "", fontSize: 8, color: GREY, margin: [0, 1, 0, 0] },
            ],
          },
        ],
      },
      {
        margin: [0, 8, 0, 0],
        canvas: [{ type: "rect", x: 0, y: 0, w: pageSize.width - MARGIN_X * 2, h: 3, color: config.accentColor }],
      },
    ],
  });

  /* ---------- Pie de cada página ---------- */
  const footer = (currentPage, pageCount, pageSize) => ({
    margin: [MARGIN_X, 10, MARGIN_X, 0],
    stack: [
      { canvas: [{ type: "line", x1: 0, y1: 0, x2: pageSize.width - MARGIN_X * 2, y2: 0, lineWidth: 0.6, lineColor: LINE }] },
      {
        margin: [0, 6, 0, 0],
        fontSize: 7.5,
        color: "#A3ADBB",
        columns: [
          { text: config.footerText ?? "", width: "*" },
          { text: title, width: "*", alignment: "center" },
          { text: `Página ${currentPage} de ${pageCount}`, width: "*", alignment: "right", color: GREY },
        ],
      },
    ],
  });

  /* ---------- Ficha: fecha, usuario y totales ---------- */
  const facts = [
    { label: "Generado el", value: formatDateTime(generatedAt) },
    ...(config.showGeneratedBy && generatedBy ? [{ label: "Generado por", value: generatedBy }] : []),
    { label: "Total de registros", value: String(rows.length) },
    ...summary.map((s) => ({ label: s.label, value: String(s.value), tone: s.tone })),
  ];

  const factCard = (f) => ({
    fillColor: LIGHT,
    margin: [8, 7, 8, 7],
    stack: [
      { text: f.label.toUpperCase(), fontSize: 6.5, bold: true, color: GREY, characterSpacing: 0.4 },
      { text: f.value, fontSize: 9.5, bold: true, color: f.tone ? f.tone.fg : config.primaryColor, margin: [0, 3, 0, 0] },
    ],
  });

  const content = [
    { text: title, fontSize: 18, bold: true, color: config.primaryColor },
    ...(subtitle ? [{ text: subtitle, fontSize: 9, color: GREY, margin: [0, 2, 0, 0] }] : []),
    {
      margin: [0, 12, 0, 0],
      table: { widths: facts.map((f, i) => (i === 0 ? 118 : "*")), body: [facts.map(factCard)] },
      layout: {
        hLineWidth: () => 0,
        vLineWidth: (i, node) => (i === 0 || i === node.table.widths.length ? 0 : 5),
        vLineColor: () => "#FFFFFF",
        paddingLeft: () => 0,
        paddingRight: () => 0,
        paddingTop: () => 0,
        paddingBottom: () => 0,
      },
    },
  ];

  /* ---------- Filtros aplicados ---------- */
  if (config.showFilters) {
    content.push({
      margin: [0, 8, 0, 0],
      fontSize: 8,
      lineHeight: 1.4,
      text: [
        { text: "FILTROS   ", bold: true, color: GREY, fontSize: 6.5, characterSpacing: 0.4 },
        ...(filters.length
          ? filters.flatMap((f) => [
              { text: `  ${f.label}: `, color: GREY, background: "#E8F1FB" },
              { text: `${f.value}  `, bold: true, color: config.primaryColor, background: "#E8F1FB" },
              { text: "   " },
            ])
          : [{ text: "Sin filtros (todos los registros)", color: GREY, italics: true }]),
      ],
    });
  }

  /* ---------- Tabla ---------- */
  const headerCells = columns.map((c) => ({
    text: c.header,
    bold: true,
    color: "#FFFFFF",
    fontSize: 7.5,
    alignment: columnAlign(c),
  }));

  const bodyRows = rows.map((row) =>
    columns.map((c) => {
      const raw = cellValue(c, row);
      const tone = cellTone(c, raw);
      const text = displayValue(c, raw);
      return tone
        ? { text: ` ${text} `, bold: true, color: tone.fg, background: tone.bg, alignment: columnAlign(c), fontSize: 7 }
        : { text, alignment: columnAlign(c), color: text === "—" ? "#A3ADBB" : undefined };
    })
  );

  content.push(
    rows.length > 0
      ? {
          margin: [0, 12, 0, 0],
          table: {
            headerRows: 1, // el encabezado de la tabla se repite en cada página
            dontBreakRows: true,
            widths: columns.map((c) => c.pdfWidth ?? "*"),
            body: [headerCells, ...bodyRows],
          },
          layout: {
            fillColor: (i) => (i === 0 ? config.primaryColor : i % 2 === 0 ? "#F8FAFC" : null),
            hLineWidth: (i, node) => (i === 0 || i === node.table.body.length ? 0 : 0.5),
            vLineWidth: () => 0,
            hLineColor: () => LINE,
            paddingTop: (i) => (i === 0 ? 6 : 4),
            paddingBottom: (i) => (i === 0 ? 6 : 4),
            paddingLeft: () => 5,
            paddingRight: () => 5,
          },
        }
      : {
          margin: [0, 24, 0, 0],
          text: "No hay registros para los filtros seleccionados.",
          alignment: "center",
          italics: true,
          color: GREY,
        }
  );

  return {
    pageSize: config.pageSize ?? "LETTER",
    pageOrientation: landscape ? "landscape" : "portrait",
    pageMargins: [MARGIN_X, 78, MARGIN_X, 44],
    info: { title, author: config.organization, creator: config.system },
    header,
    footer,
    content,
    defaultStyle: { fontSize: 7.5, color: "#22303F" },
  };
};

/** Devuelve el PDF como Blob */
export const buildPdf = (config, report) => pdfMake.createPdf(buildPdfDefinition(config, report)).getBlob();
















import { toTitleCase } from "../../../../helpers/format";
import { statusLabelFromValue } from "../../../../api/usersService";

/* =========================================================
   Reporte de usuarios: columnas, filtros y resumen.
   Lo usa exportReport() para Excel y PDF.
   ========================================================= */

// Color de la etiqueta de estado
const STATUS_TONES = {
  "activo": "green",
  "inactivo": "red",
  "de vacaciones": "pink",
  "maternidad": "teal",
  "incapacitado(a)": "blue",
};
const statusTone = (value) => STATUS_TONES[String(value).toLowerCase()] ?? "grey";

const title = (v) => (v ? toTitleCase(v) : "");

/** Columnas (mismo orden que tenía el reporte del backend) */
export const userReportColumns = [
  { header: "Nombre", value: (u) => title(u.firstName) },
  { header: "Apellido", value: (u) => title(u.lastName) },
  { header: "Usuario de red", key: "userName" },
  { header: "Correo electrónico", key: "email", pdfWidth: 124 },
  { header: "Estado", key: "status", tone: statusTone, pdfWidth: 58 },
  { header: "Código de cajero", key: "tellerCode", align: "center", pdfWidth: 40 },
  { header: "Puesto", key: "companyPosition", wrap: true },
  { header: "Agencia / Zona", key: "companyLocation" },
  { header: "Nombre de agencia", value: (u) => title(u.companyBranch) },
  { header: "Área", key: "companyArea" },
  { header: "Rol asignado", key: "role" },
];

/** Filtros aplicados con sus nombres (no los IDs) */
export const userReportFilters = (filters, catalogs) => {
  const labelOf = (list, value) => list.find((x) => String(x.value) === String(value))?.label ?? value;
  const result = [];
  if (filters.search?.trim()) result.push({ label: "Búsqueda", value: filters.search.trim() });
  if (filters.roleId !== "") result.push({ label: "Rol", value: labelOf(catalogs.roles, filters.roleId) });
  if (filters.companyAreaId !== "") result.push({ label: "Área", value: labelOf(catalogs.areas, filters.companyAreaId) });
  if (filters.companyPositionId !== "") result.push({ label: "Puesto", value: labelOf(catalogs.positions, filters.companyPositionId) });
  if (filters.status !== "") result.push({ label: "Estado", value: statusLabelFromValue(filters.status) });
  return result;
};

/** Datos extra para la ficha del encabezado */
export const userReportSummary = (rows) => {
  const count = (status) => rows.filter((u) => String(u.status).toLowerCase() === status).length;
  const active = count("activo");
  const inactive = count("inactivo");
  return [
    { label: "Activos", value: active, tone: { fg: "#166534" } },
    { label: "Inactivos", value: inactive, tone: { fg: "#991B1B" } },
    { label: "Otros estados", value: rows.length - active - inactive },
  ];
};












