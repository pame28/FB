    }
    setDownloadingId(coaching.id);
    try {
        const data = await coachService.exportSession(coaching.id);
        const fileName = coachingFileName(data);
        await exportPdf(
            buildCoachingFormatPdf(data, { generatedBy: displayName(user) || data.coachName }),
