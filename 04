using ApiCoaching.Models;
using System.Globalization;

namespace ApiCoaching.Constants
{
    /// <summary>
    /// Textos y reglas de presentación de coaching. Un solo lugar para que
    /// Consulta (colaborador) e Historial (coach) muestren lo mismo.
    /// </summary>
    public static class CoachingLabels
    {
        private static readonly CultureInfo Es = CultureInfo.GetCultureInfo("es-HN");

        public static string IndicatorTypeName(IndicatorType type) => type switch
        {
            IndicatorType.Numeric => "Numérico",
            IndicatorType.Qualitative => "Cualitativo",
            IndicatorType.Operational => "Operativo",
            IndicatorType.Attitudinal => "Actitudinal",
            IndicatorType.Sales => "Ventas",
            _ => type.ToString()
        };

        public static string MeasurementTypeName(MeasurementType type) => type switch
        {
            MeasurementType.Compliance => "Cumplimiento",
            MeasurementType.Behavior => "Comportamiento",
            MeasurementType.Knowledge => "Conocimiento",
            _ => type.ToString()
        };

        /// <summary>Estado visible del proceso (solo aplica a sesiones aceptadas).</summary>
        public static string ReviewStatusName(CoachingSessionReviewStatus status) => status switch
        {
            CoachingSessionReviewStatus.NotSubmitted => "En proceso",
            CoachingSessionReviewStatus.Pending => "Pendiente de aprobación",
            CoachingSessionReviewStatus.Approved => "Aprobado",
            CoachingSessionReviewStatus.Rejected => "Rechazado",
            _ => status.ToString()
        };

        /// <summary>Meta en texto según la regla: "≥ 85 %", "≤ 4 min", "80 – 100 %".</summary>
        public static string GoalText(Rule rule, decimal target, decimal min, decimal max, string? unit)
        {
            var u = string.IsNullOrWhiteSpace(unit) ? string.Empty : $" {unit.Trim()}";
            return rule switch
            {
                Rule.HigherIsBetter => $"≥ {Num(target)}{u}",
                Rule.LowerIsBetter => $"≤ {Num(target)}{u}",
                Rule.InRangeIsBetter => $"{Num(min)} – {Num(max)}{u}",
                _ => $"{Num(target)}{u}"
            };
        }

        /// <summary>Valor registrado en texto: "3.2 min", "92 %". Null si aún no se registró.</summary>
        public static string? ValueText(decimal? achieved, string? unit) =>
            achieved.HasValue
                ? $"{Num(achieved.Value)}{(string.IsNullOrWhiteSpace(unit) ? string.Empty : $" {unit.Trim()}")}"
                : null;

        /// <summary>¿El valor registrado cumple la meta según la regla del indicador?</summary>
        public static bool? Passed(Rule rule, decimal? achieved, decimal target, decimal min, decimal max)
        {
            if (!achieved.HasValue) return null;
            var v = achieved.Value;
            return rule switch
            {
                Rule.HigherIsBetter => v >= target,
                Rule.LowerIsBetter => v <= target,
                Rule.InRangeIsBetter => v >= min && v <= max,
                _ => null
            };
        }

        /// <summary>Puntos que aporta un indicador: % alcanzado × peso / 100.</summary>
        public static decimal Points(decimal? achievementPercentage, decimal weight) =>
            decimal.Round((achievementPercentage ?? 0m) * weight / 100m, 2, MidpointRounding.AwayFromZero);

        private static string Num(decimal value) => value.ToString("0.##", Es);
    }
}















