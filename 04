            userGroup.MapPost("filter/export", ExportFiltered)
                .WithName("ExportFilteredUsers")
                .WithSummary("Devuelve todos los usuarios filtrados, sin paginar, para que el frontend genere los reportes.")
                .RequireAuthorization($"{AuthorizationPolicies.CruUsers}|{AuthorizationPolicies.ReadUsers}")
                .Produces<ResponseObject<List<UserExportRowDto>>>(StatusCodes.Status200OK)
                .Produces<ResponseObjectError>(StatusCodes.Status500InternalServerError);




        /// <summary>
        /// Devuelve todos los usuarios que cumplen el filtro (sin paginar).
        /// El frontend arma con estos datos los reportes en Excel y PDF.
        /// </summary>
        private static async Task<IResult> ExportFiltered(
            UserFilterRequestDto filter,
            IUsersRepository usersRepository,
            ILoggerFactory loggerFactory)
        {
            var logger = loggerFactory.CreateLogger(typeof(UserEndpoints));

            try
            {
                logger.LogInformation(JsonConvert.SerializeObject(filter));

                var users = await usersRepository.GetFilteredUsers(filter);

                return Results.Ok(new ResponseObject<List<UserExportRowDto>>
                {
                    Code = 200,
                    Message = "OK",
                    Data = [.. users.Select(MapExportUser)]
                });
            }
            catch (Exception ex)
            {
                logger.LogError(ex, "ExportFilteredUsersError");
                return Results.Json(new ResponseObjectError
                {
                    Code = 500,
                    Message = GenericErrors.InternalServerError
                }, statusCode: StatusCodes.Status500InternalServerError);
            }
        }