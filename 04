import { useCallback, useEffect, useState } from "react";
import { Download, Check, X, Info, ChevronLeft, TriangleAlert, Clock } from "lucide-react";
import { Modal, useToast } from "../../../shared/components";
import { coachService } from "../../../api/coachService";
import { useAuthStore } from "../../../hooks/useAuthStore";
import { exportDocument } from "../../../shared/reports";
import { displayName } from "../../../helpers/format";
import { buildCoachingReport } from "./coachingReport";
import styles from "../../Pages.module.css";
import base from "../coach/CollaboratorCoachingPage.module.css";
import ui from "./ConsultaCoachingPage.module.css";

const STATUS_LABEL = { Pending: "Pendiente de aprobación", Approved: "Aprobado", Rejected: "Rechazado" };
const STATUS_PILL = { Pending: ui.pillPending, Approved: ui.pillApproved, Rejected: ui.pillRejected };
const MEASUREMENT_LABEL = { 1: "Cumplimiento", 2: "Comportamiento", 3: "Conocimiento" };
const RULE_SYMBOL = { HigherIsBetter: "≥", LowerIsBetter: "≤" };

const MONTHS = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];

const formatDate = (value) => (value ? new Date(value).toLocaleDateString("es-ES") : "—");
const formatDateTime = (value) => (value ? new Date(value).toLocaleString("es-ES") : "—");
const formatNumber = (n) => Number(n).toLocaleString("es-ES", { maximumFractionDigits: 2 });

const goalText = (ind) =>
    ind.ruleName === "InRangeIsBetter"
        ? `${formatNumber(ind.minimunValue)} – ${formatNumber(ind.maximunValue)} ${ind.targetUnitName}`
        : `${RULE_SYMBOL[ind.ruleName] ?? ""} ${formatNumber(ind.targetValue)} ${ind.targetUnitName}`.trim();

const getInitials = (name = "") =>
    name.split(" ").filter(Boolean).map((n) => n[0]).join("").toUpperCase().slice(0, 2);

const periodOf = (p) => {
    const d = new Date(p.startDate);
    return { year: String(d.getFullYear()), month: d.getMonth() };
};

const processTitle = (p) => {
    const { year, month } = periodOf(p);
    return `Coaching — ${MONTHS[month]} ${year}`;
};

function StatCard({ value, label, tone }) {
    return (
        <div className={`${ui.statCard} ${tone ?? ""}`}>
            <div className={ui.statValue}>{value}</div>
            <div className={ui.statLabel}>{label}</div>
        </div>
    );
}

export const ConsultaCoachingPage = () => {
    const toast = useToast();
    const { user } = useAuthStore();
    const [exporting, setExporting] = useState(null); // "excel-2", "pdf-2"... o null
    const [processes, setProcesses] = useState([]);
    const [loading, setLoading] = useState(true);
    const [error, setError] = useState("");
    const [selectedId, setSelectedId] = useState(null);
    const [filters, setFilters] = useState({ year: "todos", month: "todos", status: "todos" });
    const [modal, setModal] = useState(null); // "approve" | "reject" | null
    const [reason, setReason] = useState("");
    const [saving, setSaving] = useState(false);
    const [approveStamp, setApproveStamp] = useState("");

    const load = useCallback(async () => {
        setLoading(true);
        setError("");
        try {
            setProcesses(await coachService.myProcesses());
        } catch (err) {
            setError(err.noAccess ? "No tienes permiso para consultar tus procesos." : "No se pudieron cargar los procesos de coaching.");
        } finally {
            setLoading(false);
        }
    }, []);

    useEffect(() => {
        load();
    }, [load]);

    const selected = processes.find((p) => p.sessionId === selectedId) ?? null;
    const years = [...new Set(processes.map((p) => periodOf(p).year))].sort().reverse();

    const filtered = processes.filter((p) => {
        const { year, month } = periodOf(p);
        return (
            (filters.year === "todos" || year === filters.year) &&
            (filters.month === "todos" || String(month) === filters.month) &&
            (filters.status === "todos" || p.reviewStatus === filters.status)
        );
    });

    const isApproved = (p) => p.reviewStatus === "Approved";

    const download = async (type, p) => {
        const label = type === "excel" ? "Excel" : "PDF";
        setExporting(`${type}-${p.sessionId}`);
        try {
            const data = await coachService.exportSession(p.sessionId);
            await exportDocument(type, buildCoachingReport(data, { generatedBy: displayName(user) || p.memberFullName }));
            toast.success(`${label} generado`, processTitle(p));
        } catch (err) {
            console.error(err);
            toast.error(`No se pudo generar el ${label}`, "Intenta de nuevo en unos momentos.");
        } finally {
            setExporting(null);
        }
    };

    const handleDownloadExcel = (p) => download("excel", p);
    const handleDownloadPDF = (p) => download("pdf", p);

    const closeModal = () => {
        setModal(null);
        setReason("");
    };

    const handleConfirm = async () => {
        if (modal === "reject" && !reason.trim()) {
            toast.warning("Debes indicar el motivo del rechazo");
            return;
        }
        setSaving(true);
        try {
            if (modal === "approve") {
                await coachService.approveProcess(selectedId);
                toast.success("Coaching aprobado correctamente");
            } else {
                await coachService.rejectProcess(selectedId, reason.trim());
                toast.success("Coaching rechazado correctamente");
            }
            closeModal();
            await load();
        } catch (err) {
            toast.error("No se pudo registrar la respuesta", err.response?.data?.message ?? "Intenta nuevamente.");
        } finally {
            setSaving(false);
        }
    };

    const onRowKey = (e, fn) => {
        if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            fn();
        }
    };

    /* ===================== DETALLE ===================== */
    if (selected) {
        const p = selected;
        const approved = isApproved(p);
        const pending = p.reviewStatus === "Pending";

        return (
            <div className={base.page}>
                <div className={ui.topBar}>
                    <button type="button" className={`${base.btn} ${base.btnOutline} ${base.btnSm}`} onClick={() => setSelectedId(null)}>
                        <ChevronLeft size={15} /> Volver al listado
                    </button>
                    <div className={ui.topActions}>
                        <button type="button" className={`${base.btn} ${base.btnOutline} ${base.btnSm} ${ui.btnTeal}`} onClick={() => handleDownloadExcel(p)}>
                            <Download size={15} /> Excel
                        </button>
                        {approved && (
                            <button type="button" className={`${base.btn} ${base.btnOutline} ${base.btnSm} ${ui.btnTeal}`} onClick={() => handleDownloadPDF(p)}>
                                <Download size={15} /> Descargar PDF
                            </button>
                        )}
                        {pending && (
                            <>
                                <button type="button" className={`${base.btn} ${base.btnOutline} ${base.btnSm}`} onClick={() => setModal("reject")}>
                                    <X size={15} /> Rechazar
                                </button>
                                <button type="button" className={`${base.btn} ${base.btnPrimary} ${base.btnSm}`} onClick={() => {
                                    setApproveStamp(new Date().toLocaleString("es-ES"));
                                    setModal("approve");
                                }}>
                                    <Check size={15} /> Aprobar coaching
                                </button>
                            </>
                        )}
                    </div>
                </div>

                <div>
                    <h1 className={ui.detailTitle}>{processTitle(p)}</h1>
                    <p className={ui.detailSub}>Información en modo solo lectura. No es posible modificar datos desde esta sección.</p>
                </div>

                <section className={ui.hero}>
                    <div className={ui.heroAvatar}>{getInitials(p.coachName)}</div>
                    <div className={ui.heroInfo}>
                        <div className={ui.heroName}>Coach: {p.coachName ?? "—"}</div>
                        <div className={ui.heroMeta}>{[p.position, p.area, p.location].filter(Boolean).join(" · ")}</div>
                    </div>
                    <div className={ui.heroField}>
                        <span className={ui.heroLabel}>Estado</span>
                        <span className={`${ui.pill} ${STATUS_PILL[p.reviewStatus]}`}>{STATUS_LABEL[p.reviewStatus]}</span>
                    </div>
                    <div className={ui.heroField}>
                        <span className={ui.heroLabel}>Fecha de inicio</span>
                        <span className={ui.heroValue}>{formatDate(p.startDate)}</span>
                    </div>
                    <div className={ui.heroField}>
                        <span className={ui.heroLabel}>Fecha de fin</span>
                        <span className={ui.heroValue}>{formatDate(p.endDate)}</span>
                    </div>
                </section>

                {pending && (
                    <div className={ui.warning}>
                        <TriangleAlert size={16} />
                        <span>
                            Este proceso está <strong>Pendiente de tu aprobación</strong>. Revisa los indicadores y el plan de acción, luego presiona <strong>Aprobar coaching</strong> para confirmar.
                        </span>
                    </div>
                )}

                {p.reviewStatus === "Rejected" && (
                    <div className={ui.warning}>
                        <TriangleAlert size={16} />
                        <span>Rechazaste este proceso el {formatDate(p.reviewedAt)}. Motivo: {p.reviewRejectionReason}</span>
                    </div>
                )}

                <section className={base.card}>
                    <div className={base.cardHeader}>
                        <h2 className={base.cardTitle}>Indicadores evaluados</h2>
                    </div>
                    <div className={base.cardBody}>
                        <div className={ui.indicatorList}>
                            {p.indicators.map((ind) => (
                                <div key={ind.assignmentId} className={ui.indicatorItem}>
                                    <span>{ind.indicatorName}</span>
                                    <div className={ui.indicatorRight}>
                                        <span className={`${ui.result} ${ind.passed ? ui.pass : ui.fail}`}>
                                            {ind.achievedValue != null ? `${formatNumber(ind.achievedValue)} ${ind.targetUnitName}` : "—"}
                                            {ind.achievementPercentage != null && ` (${formatNumber(ind.achievementPercentage)}%)`}
                                            {ind.passed ? <Check size={12} /> : <X size={12} />}
                                        </span>
                                        <span className={ui.goal}>Meta: {goalText(ind)}</span>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>
                </section>

                <section className={base.card}>
                    <div className={base.cardHeader}>
                        <h2 className={base.cardTitle}>Plan de acción</h2>
                    </div>
                    <div className={base.cardBody}>
                        {p.actions.length === 0 && <div className={ui.fieldValue}>Sin acciones registradas.</div>}
                        {p.actions.map((a, idx) => (
                            <div key={a.id} className={ui.actionBox}>
                                <span className={ui.actionNumber}>Acción #{idx + 1}</span>
                                <div className={ui.actionGrid}>
                                    <div>
                                        <span className={ui.fieldLabel}>Tipo de medición</span>
                                        <div className={ui.fieldValue}>{MEASUREMENT_LABEL[a.measurementType] ?? "—"}</div>
                                    </div>
                                    <div>
                                        <span className={ui.fieldLabel}>Fecha compromiso</span>
                                        <div className={ui.fieldValue}>{formatDate(a.commitmentDate)}</div>
                                    </div>
                                    <div>
                                        <span className={ui.fieldLabel}>Oportunidad de mejora</span>
                                        <div className={ui.fieldValue}>{a.improvementOpportunity}</div>
                                    </div>
                                    <div>
                                        <span className={ui.fieldLabel}>Acción a realizar</span>
                                        <div className={ui.fieldValue}>{a.actionDescription}</div>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                </section>

                <section className={base.card}>
                    <div className={base.cardHeader}>
                        <h2 className={base.cardTitle}>Aprobaciones digitales</h2>
                    </div>
                    <div className={base.cardBody}>
                        <div className={ui.approvalList}>
                            <div className={`${ui.approvalItem} ${ui.done}`}>
                                <Check size={15} />
                                <div>
                                    <span className={ui.approvalName}>Coach — {p.coachName ?? "—"}</span>
                                    <span className={ui.approvalDate}>{formatDateTime(p.submittedAt)}</span>
                                </div>
                            </div>
                            {approved ? (
                                <div className={`${ui.approvalItem} ${ui.done}`}>
                                    <Check size={15} />
                                    <div>
                                        <span className={ui.approvalName}>Colaborador — {p.memberFullName}</span>
                                        <span className={ui.approvalDate}>{formatDateTime(p.reviewedAt)}</span>
                                    </div>
                                </div>
                            ) : (
                                <div className={`${ui.approvalItem} ${ui.waiting}`}>
                                    <Clock size={15} />
                                    <div>
                                        <span className={ui.approvalName}>Colaborador — {p.memberFullName}</span>
                                        <span className={ui.approvalDate}>{pending ? "Pendiente de aprobación" : "Rechazado"}</span>
                                    </div>
                                </div>
                            )}
                        </div>
                    </div>
                    {approved && (
                        <div className={ui.cardFooter}>
                            <button type="button" className={`${base.btn} ${base.btnOutline} ${base.btnSm} ${ui.btnTeal}`} onClick={() => handleDownloadPDF(p)}>
                                <Download size={15} /> Descargar PDF
                            </button>
                        </div>
                    )}
                </section>

                <Modal
                    open={modal !== null}
                    title={modal === "approve" ? "Aprobar coaching" : "Rechazar coaching"}
                    onClose={closeModal}
                    footer={
                        <div className={ui.modalFooter}>
                            <button type="button" className={`${base.btn} ${base.btnOutline} ${base.btnSm}`} onClick={closeModal} disabled={saving}>
                                Cancelar
                            </button>
                            <button type="button" className={`${base.btn} ${base.btnPrimary} ${base.btnSm}`} onClick={handleConfirm} disabled={saving}>
                                {modal === "approve" ? <><Check size={15} /> Sí, aprobar coaching</> : <><X size={15} /> Sí, rechazar</>}
                            </button>
                        </div>
                    }
                >
                    {modal === "approve" ? (
                        <>
                            <p className={base.modalText}>
                                Al aprobar confirmas que has revisado y aceptas el proceso de coaching registrado por tu coach. La aprobación quedará registrada con tu sesión activa.
                            </p>
                            <div className={ui.modalGrid}>
                                <div>
                                    <span className={base.statLabel}>Usuario que aprueba</span>
                                    <div className={base.statBox}>{p.memberFullName}</div>
                                </div>
                                <div>
                                    <span className={base.statLabel}>Fecha y hora</span>
                                    <div className={base.statBox}>{approveStamp}</div>
                                </div>
                            </div>
                            <div className={base.warningBanner}>
                                <TriangleAlert size={16} />
                                <span>Una vez aprobado el proceso quedará protegido. Cualquier modificación posterior invalidará esta aprobación.</span>
                            </div>
                        </>
                    ) : (
                        <div className={base.field}>
                            <label className={base.label} htmlFor="cq-reason">Motivo del rechazo</label>
                            <textarea
                                id="cq-reason"
                                className={base.textarea}
                                rows={4}
                                maxLength={500}
                                value={reason}
                                onChange={(e) => setReason(e.target.value)}
                            />
                        </div>
                    )}
                </Modal>
            </div>
        );
    }

    /* ===================== LISTADO ===================== */
    const count = (status) => processes.filter((p) => p.reviewStatus === status).length;

    return (
        <>
            <header className={styles.pageHeader}>
                <div>
                    <h1 className={styles.title}>Mis procesos de coaching</h1>
                    <p className={styles.subtitle}>Consulta el historial de tus procesos de coaching. Solo puedes ver tu propia información.</p>
                </div>
            </header>

            <div className={base.page}>
                <div className={base.infoBanner}>
                    <Info size={16} />
                    <span>
                        La información se muestra en modo <strong>solo lectura</strong>. No es posible modificar ningún dato desde esta sección.
                    </span>
                </div>

                <div className={ui.stats}>
                    <StatCard value={processes.length} label="Total procesos" />
                    <StatCard value={count("Pending")} label="Pend. aprobación" tone={ui.pending} />
                    <StatCard value={count("Approved")} label="Aprobados" tone={ui.approved} />
                </div>

                <section className={base.card}>
                    <div className={base.cardHeader}>
                        <h2 className={base.cardTitle}>Filtrar procesos</h2>
                    </div>
                    <div className={base.cardBody}>
                        <div className={ui.filterGrid}>
                            <div className={base.field}>
                                <label className={base.label} htmlFor="cq-year">Año</label>
                                <select id="cq-year" className={base.select} value={filters.year} onChange={(e) => setFilters({ ...filters, year: e.target.value })}>
                                    <option value="todos">Todos los años</option>
                                    {years.map((y) => <option key={y} value={y}>{y}</option>)}
                                </select>
                            </div>
                            <div className={base.field}>
                                <label className={base.label} htmlFor="cq-month">Mes</label>
                                <select id="cq-month" className={base.select} value={filters.month} onChange={(e) => setFilters({ ...filters, month: e.target.value })}>
                                    <option value="todos">Todos los meses</option>
                                    {MONTHS.map((m, i) => <option key={m} value={String(i)}>{m}</option>)}
                                </select>
                            </div>
                            <div className={base.field}>
                                <label className={base.label} htmlFor="cq-status">Estado</label>
                                <select id="cq-status" className={base.select} value={filters.status} onChange={(e) => setFilters({ ...filters, status: e.target.value })}>
                                    <option value="todos">Todos los estados</option>
                                    {Object.entries(STATUS_LABEL).map(([value, label]) => <option key={value} value={value}>{label}</option>)}
                                </select>
                            </div>
                        </div>
                    </div>
                </section>

                <div className={ui.list}>
                    {loading ? (
                        <div className={ui.empty}>Cargando procesos...</div>
                    ) : error ? (
                        <div className={ui.empty}>{error}</div>
                    ) : filtered.length === 0 ? (
                        <div className={ui.empty}>No hay procesos de coaching que coincidan con los filtros.</div>
                    ) : (
                        filtered.map((p) => (
                            <div
                                key={p.sessionId}
                                className={ui.row}
                                onClick={() => setSelectedId(p.sessionId)}
                                onKeyDown={(e) => e.target === e.currentTarget && onRowKey(e, () => setSelectedId(p.sessionId))}
                                tabIndex={0}
                                role="button"
                                aria-label={`Ver ${processTitle(p)}`}
                            >
                                <div className={ui.rowAvatar}>{getInitials(p.coachName)}</div>
                                <div className={ui.rowInfo}>
                                    <div className={ui.rowTitle}>{processTitle(p)}</div>
                                    <div className={ui.rowSub}>Coach: {p.coachName ?? "—"} · {p.indicators.length} indicadores evaluados</div>
                                </div>
                                <div className={ui.rowRight}>
                                    <span className={`${ui.pill} ${STATUS_PILL[p.reviewStatus]}`}>{STATUS_LABEL[p.reviewStatus]}</span>
                                    <span className={ui.rowDate}>{formatDate(p.submittedAt)}</span>
                                    <div className={ui.rowButtons}>
                                        <button
                                            type="button"
                                            className={`${base.btn} ${base.btnOutline} ${base.btnSm} ${ui.btnTeal}`}
                                            onClick={(e) => {
                                                e.stopPropagation();
                                                handleDownloadExcel(p);
                                            }}
                                        >
                                            <Download size={15} /> Excel
                                        </button>
                                        <button
                                            type="button"
                                            className={`${base.btn} ${base.btnOutline} ${base.btnSm} ${ui.btnTeal}`}
                                            disabled={!isApproved(p)}
                                            onClick={(e) => {
                                                e.stopPropagation();
                                                handleDownloadPDF(p);
                                            }}
                                        >
                                            <Download size={15} /> PDF
                                        </button>
                                    </div>
                                </div>
                            </div>
                        ))
                    )}
                </div>
            </div>
        </>
    );
};










