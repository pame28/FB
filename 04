using System;
using System.Collections.Generic;
using System.Diagnostics;
using System.Globalization;
using System.Linq;
using System.Net;
using System.Text;
using System.Threading.Tasks;
using dllwsDivideloTodoBXI.Models;
using dllwsDivideloTodoBXI.Models.Transactions;
using dllwsDivideloTodoBXI.TiposObjetos;
using dllwsDivideloTodoBXI.Clases;
using Log4NetLogger;

namespace dllwsDivideloTodoBXI.Services
{
    public class TransactionService : BaseApiService
    {
        private readonly string _endpointLogin;
        private readonly string _userLogin;
        private readonly string _passwordLogin;
        private readonly string _baseUrl;
        private readonly dllwsDivideloTodoBXI.DivideloTodoBXI _dllDividelo;

        public TransactionService(string baseUrl, string endpointLogin, string userLogin, string passwordLogin, string ignoreSsl, DivideloTodoBXI divideloTodoBXI)
            : base(baseUrl, bool.Parse(ignoreSsl))
        {
            _baseUrl = baseUrl;
            _endpointLogin = endpointLogin;
            _userLogin = userLogin;
            _passwordLogin = passwordLogin;
            _dllDividelo = divideloTodoBXI;

            AppLogger.Info($"[TransactionService] Creado. BaseUrl='{baseUrl}'; EndpointLogin='{endpointLogin}'; Usuario='{userLogin}'; IgnoreSsl='{ignoreSsl}'; TLS actual={ServicePointManager.SecurityProtocol}");
        }

        public async Task<AutorizacionesResult> ObtenerTransacciones(TransactionRequest request, string endpointTransactions)
        {
            // Id corto para poder seguir UNA petición en el log
            string traceId = Guid.NewGuid().ToString("N").Substring(0, 8);
            Stopwatch sw = Stopwatch.StartNew();
            string paso = "INICIO";
            AutorizacionesResult Datos = new AutorizacionesResult();

            try
            {
                AppLogger.Info($"[{traceId}] ObtenerTransacciones INICIO. Equivalente='{request?.equivalente}'; Endpoint='{endpointTransactions}'; TLS={ServicePointManager.SecurityProtocol}");

                // ---------- 1. Login al gateway ----------
                paso = "LOGIN_GATEWAY";
                AppLogger.Info($"[{traceId}] Llamando login gateway: '{_baseUrl}' + '{_endpointLogin}'");

                string token = await LoginAsync(_endpointLogin, _userLogin, _passwordLogin);

                AppLogger.Info($"[{traceId}] Login respondió en {sw.ElapsedMilliseconds} ms. Token: {(string.IsNullOrEmpty(token) ? "VACÍO/NULL" : "OK (len=" + token.Length + ")")}");
                if (string.IsNullOrEmpty(token))
                {
                    AppLogger.Error($"[{traceId}] Login no devolvió token, se corta el flujo.");
                    return Datos;
                }

                // ---------- 2. Consumo del microservicio ----------
                paso = "POST_TRANSACCIONES";
                AppLogger.Info($"[{traceId}] Llamando microservicio: '{_baseUrl}' + '{endpointTransactions}'");

                ApiTransactionResponse response = await PostAsync<ApiTransactionResponse>(endpointTransactions, request);

                AppLogger.Info($"[{traceId}] Microservicio respondió en {sw.ElapsedMilliseconds} ms. response null={response == null}");

                if (response == null)
                {
                    AppLogger.Error($"[{traceId}] La respuesta del microservicio vino NULL (¿error de deserialización?).");
                    return Datos;
                }

                AppLogger.Info($"[{traceId}] hasError={response.hasError}; movimientos={(response.movimientos == null ? "NULL" : response.movimientos.Count().ToString())}");

                if (response.hasError)
                {
                    AppLogger.Error($"[{traceId}] El microservicio devolvió hasError=true.");
                    return Datos;
                }

                if (response.movimientos == null)
                {
                    AppLogger.Error($"[{traceId}] movimientos vino NULL.");
                    return Datos;
                }

                // ---------- 3. Mapeo ----------
                int i = 0;
                foreach (var mov in response.movimientos)
                {
                    i++;
                    paso = $"MAPEO_MOV_{i} (receipt={mov?.receiptNumber}; amount='{mov?.amount}'; originDate='{mov?.originDate}'; currency='{mov?.currency}')";

                    decimal valor = decimal.Parse(mov.amount, new CultureInfo("en-US"));
                    string strImporte = valor.ToString();

                    Autorizaciones detalle = new Autorizaciones();
                    detalle.CampaniaCuotificacion = mov.installmentCampaign;
                    detalle.Cuotas = "0";
                    detalle.CUT = mov.receiptNumber;
                    detalle.FechaOrigen = mov.originDate;
                    detalle.importe = Double.Parse(strImporte);
                    detalle.Descripcion = mov.merchantName;
                    detalle.ModeloCuotificacion = mov.installmentModel;
                    detalle.Moneda = ParsearMoneda(mov.currency);
                    detalle.Referencia = mov.receiptNumber;
                    detalle.Periodos = "0";
                    detalle.Producto = mov.product;
                    detalle.Tarjeta = mov.card;
                    detalle.Movimientos_Id = Guid.NewGuid().ToString();
                    detalle.FechaOrigenSort = Convert.ToDateTime(detalle.FechaOrigen);
                    Datos.add(detalle);
                }

                AppLogger.Info($"[{traceId}] ObtenerTransacciones FIN OK. {i} movimientos mapeados en {sw.ElapsedMilliseconds} ms.");
                return Datos;
            }
            catch (Exception ex)
            {
                // ANTES: catch vacío -> el error desaparecía sin dejar rastro.
                // ex.ToString() incluye InnerException y stack trace; ahí está la causa real
                // (HttpRequestException solo dice "An error occurred while sending the request").
                AppLogger.Error($"[{traceId}] ERROR en paso '{paso}' a los {sw.ElapsedMilliseconds} ms. {DetalleWebException(ex)}{Environment.NewLine}{ex}");
                return new AutorizacionesResult();
            }
        }

        public string ParsearMoneda(string monedaOrigen)
        {
            List<Monedas> monedas = _dllDividelo.obtenerMonedas();
            string monedaLocal = monedas.Where(m => m.iso_alfabetico == monedaOrigen)
                .Select(m => m.simbolo_local)
                .FirstOrDefault();

            if (monedaLocal == null)
                AppLogger.Error($"[TransactionService] No se encontró simbolo_local para la moneda '{monedaOrigen}'");

            return monedaLocal;
        }

        /// <summary>
        /// Busca un WebException en la cadena de excepciones y devuelve su Status
        /// (NameResolutionFailure, ConnectFailure, TrustFailure, SecureChannelFailure, Timeout, ProxyNameResolutionFailure...).
        /// </summary>
        public static string DetalleWebException(Exception ex)
        {
            Exception actual = ex;
            while (actual != null)
            {
                WebException wex = actual as WebException;
                if (wex != null)
                    return $"WebException.Status={wex.Status}.";
                actual = actual.InnerException;
            }
            return string.Empty;
        }
    }
}