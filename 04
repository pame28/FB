      <h3 className={t.teamName} title={team.name}>{team.name}</h3>




      <ul className={t.memberList}>
        {team.members.map((m) => {
          const sub = userSubtitle(m);
          return (
            <li key={m.id} className={t.member}>
              <div className={t.person}>
                <span className={t.avatar}>{initials(m.name)}</span>
                <span className={t.personText}>
                  <span className={t.personName}>{m.name}</span>
                  {sub && <span className={t.personSub}>{sub}</span>}
                </span>
              </div>
              <div className={t.memberTools}>
                {m.status && <span className={`${t.status} ${t[statusTone(m.status)]}`}>{m.status}</span>}
                <button type="button" className={`${t.iconBtn} ${t.iconBtnSm}`} title="Mover a otro equipo"
                  aria-label={`Mover a ${m.name} a otro equipo`} onClick={() => onMoveMember(team, m)}>
                  <ArrowLeftRight size={14} />
                </button>
                <button type="button" className={`${t.iconBtn} ${t.iconBtnSm} ${t.iconBtnDanger}`} title="Remover del equipo"
                  aria-label={`Remover a ${m.name} del equipo`} onClick={() => onRemoveMember(team, m)}>
                  <X size={14} />
                </button>
              </div>
            </li>
          );
        })}

        {/* Casillas para completar 3 filas: todas las tarjetas miden lo mismo */}
        {Array.from({ length: Math.max(0, 3 - team.members.length) }, (_, i) => (
          <li key={`slot-${i}`} className={t.slotItem}>
            <button
              type="button"
              className={t.memberSlot}
              onClick={() => onAddMembers(team)}
              tabIndex={i === 0 ? 0 : -1}
              aria-label="Agregar miembro"
            >
              <span className={t.slotIcon}><Plus size={14} strokeWidth={2.4} /></span>
              {i === 0 && (team.members.length === 0 ? "Sin miembros · agrega el primero" : "Agregar miembro")}
            </button>
          </li>
        ))}
      </ul>















