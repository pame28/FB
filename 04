private void AgregarFiadores(object[] origen, object[] destino, DataTable lote)
{
    int orden = 0;   // se reinicia por cliente

    for (int f = 0; f < CantidadFiadores; f++)
    {
        int b = OrgPrimerFiador + f * OrgCamposPorFiador;
        string nombre = Texto(origen[b]).Trim();

        if (!IncluirFiadoresSinNombre && nombre.Length == 0)
            continue;   // fiador vacio: no se inserta

        orden++;

        for (int c = 0; c < ColumnasDestino; c++)
            destino[c] = DBNull.Value;

        destino[DesNoUsuario] = Texto(origen[OrgNoUsuario]);
        destino[DesOrdenFiador] = orden.ToString(CultureInfo.InvariantCulture);
        destino[DesNombreApellido] = nombre;
        destino[DesNoDocumento] = Texto(origen[b + 1]);
        destino[DesFechaProceso] = _fechaCarga;
        destino[DesDomicilioParticular1] = Texto(origen[b + 2]);
        destino[DesDomicilioParticular2] = Texto(origen[b + 3]);
        destino[DesDomicilioParticular3] = Texto(origen[b + 4]);
        destino[DesTelefono] = Texto(origen[b + 5]);
        destino[DesTelefonoLaboral] = Texto(origen[b + 6]);
        destino[DesNoCuentaClaro] = Texto(origen[OrgNoCuentaClaro]);
        destino[DesLarId] = _larId;
        destino[ColumnasDestino - 1] = ProcesadorOrigen;

        lote.Rows.Add(destino);
    }
}