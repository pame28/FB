	       ,@opeOrigen SMALLINT
	       ,@opeEmpresa CHAR(1)
	       ,@OpeProductoByte CHAR(6)
	       ,@opeStatusByte NUMERIC
	       ,@opeFrecPagInt DECIMAL
	       ,@opeSector DECIMAL
	       ,@opeOficial INT
