CREATE VIEW [dbo].[uvw_CuentasPagos_v2]
AS
WITH Base AS
(
    SELECT  NoCuenta
           ,ISNULL(CantidadPagosMN, 0)      AS CantidadPagosMN
           ,ISNULL(CantidadPagosUSD, 0)     AS CantidadPagosUSD
           ,MAX(ISNULL(PagoVencidoML, 0))   AS PagoVencidoML
           ,MAX(ISNULL(PagoVencidoUSD, 0))  AS PagoVencidoUSD
           ,Tr.EstadoTarjeta                AS EstadoTarjeta
           ,Ms.EstadoCuenta                 AS EstadoCuenta
           ,Ms.CategoriaTarjeta             AS TipoTarjeta
    FROM MaestroSaldos Ms
    INNER JOIN ETarjetas Tr ON Ms.NumeroTarjeta = Tr.NumeroTarjeta
    WHERE Ms.CategoriaTarjeta = 'E'
      AND Tr.CategoriaTarjeta = 'E'
      AND Tr.EstadoHabilitar IN ('','I','*','R','U','A','B','E','D','H','G','K','J')
      AND Tr.EstadoTarjeta IN (20, 25)          -- el resultado solo usa estos dos estados
    GROUP BY NoCuenta
            ,ISNULL(CantidadPagosMN, 0)
            ,ISNULL(CantidadPagosUSD, 0)
            ,Tr.EstadoTarjeta
            ,Ms.EstadoCuenta
            ,Ms.CategoriaTarjeta
),
m AS
(
    SELECT b.*,
           CASE WHEN b.NoCuenta IS NULL THEN 0
                ELSE MAX(CASE WHEN b.EstadoTarjeta = 20 THEN 1 ELSE 0 END) OVER (PARTITION BY b.NoCuenta)
           END AS Tiene20
    FROM Base b
)
SELECT NoCuenta, CantidadPagosMN, CantidadPagosUSD, PagoVencidoML, PagoVencidoUSD,
       EstadoTarjeta, EstadoCuenta, TipoTarjeta
FROM m
WHERE EstadoTarjeta = 20
   OR (EstadoTarjeta = 25 AND Tiene20 = 0);
GO