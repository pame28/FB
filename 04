];

export function ApproveCertificationModal({ cert, onClose }) {
    const toast = useToast();
    const [result, setResult] = useState("");

    const handleClose = () => {
        setResult("");
        onClose();
    };

    const handleConfirm = () => {
        if (!result) {
            toast.error("Selecciona el resultado de la certificación");
            return;
        }
        if (result === "review") {
            toast.info("La certificación continúa pendiente de revisión adicional");
        } else {
            resolveCertification(cert.id, result === "approved" ? STATUS.approved : STATUS.rejected, CURRENT_CERTIFIER);
            toast.success(result === "approved" ? "Certificación aprobada correctamente" : "Certificación marcada como no aprobada");
        }
        handleClose();
    };

    return (
        <Modal
            open={Boolean(cert)}
            title="Aprobar certificación"
            onClose={handleClose}
            size="sm"
            footer={
                <div className={ui.modalFooter}>
                    <button type="button" className={`${base.btn} ${base.btnOutline} ${base.btnSm}`} onClick={handleClose}>
                        Cancelar
                    </button>
