-- PASO 1: ¿Qué fechas existen en reservas (GDROP44F)?
SELECT GDRANO44, GDRMES44, GDRDIA44, COUNT(*) 
FROM BPDAT.GDROP44F
GROUP BY GDRANO44, GDRMES44, GDRDIA44
ORDER BY 1 DESC, 2 DESC, 3 DESC
FETCH FIRST 10 ROWS ONLY;

-- PASO 2: ¿Cómo queda la fecha armada como texto? (los corchetes muestran espacios)
SELECT DISTINCT '[' || GDRANO44 || '-' || LPAD(GDRMES44, 2, 0) || '-' || LPAD(GDRDIA44, 2, 0) || ']'
FROM BPDAT.GDROP44F
WHERE GDRANO44 = 2026 AND GDRMES44 = 11;

-- PASO 3: ¿Qué fechas existen en cartera (GDROPR1F)?
SELECT GDRANO01, GDRMES01, GDRDIA01, COUNT(*) 
FROM BPDAT.GDROPR1F
GROUP BY GDRANO01, GDRMES01, GDRDIA01
ORDER BY 1 DESC, 2 DESC, 3 DESC
FETCH FIRST 10 ROWS ONLY;

-- PASO 4: ¿Cruzan reservas y cartera ese día?
SELECT COUNT(*)
FROM BPDAT.GDROP44F RES
INNER JOIN BPDAT.GDROPR1F O
   ON RES.GDRNUM44 = O.GDRNUM01 AND RES.GDRMON44 = O.GDRMON01
  AND RES.GDRANO44 = O.GDRANO01 AND RES.GDRMES44 = O.GDRMES01 AND RES.GDRDIA44 = O.GDRDIA01
WHERE RES.GDRANO44 = 2026 AND RES.GDRMES44 = 11 AND RES.GDRDIA44 = 19;

-- PASO 5: ¿Cómo viene la empresa y el castigado en esa fecha?
SELECT '[' || O.GDREMP01 || ']' AS EMPRESA, O.GDRSCA01 = 0 AS NO_CASTIGADO, COUNT(*)
FROM BPDAT.GDROPR1F O
WHERE O.GDRANO01 = 2026 AND O.GDRMES01 = 11 AND O.GDRDIA01 = 19
GROUP BY '[' || O.GDREMP01 || ']', O.GDRSCA01 = 0;