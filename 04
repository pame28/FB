/**
 * Configuración de cada catálogo.
 * fields: campos del formulario y columnas de la tabla.
 *   type: "text" (por defecto) | "number" | "select" | "date" | "boolean"
 *   required: obligatorio
 *   unique: no permite valores repetidos (ignora tildes y mayúsculas)
 *   options: solo para "select" → [{ value, label }]
 *   defaultValue: valor inicial al crear (p. ej. true para "boolean")
 * feminine: para los textos ("Nueva área" / "Nuevo puesto").
 *
 * Opcionales:
 *   labelField: campo que identifica al registro en mensajes y en la tabla (por defecto "name")
 *   sort: (a, b) => número, orden del listado (por defecto alfabético por labelField)
 *   statusFilter: muestra el filtro Activos / Inactivos (usa el campo "status")
 *   validate: (values, items, currentId) => { campo: "mensaje" } validaciones entre campos
 *   deleteHint: mensaje cuando el backend no permite eliminar
 */

/* ---------- Períodos: validaciones entre campos ---------- */
const dmy = (iso) => (iso ? String(iso).slice(0, 10).split("-").reverse().join("/") : "");

const validatePeriod = (values, items, currentId) => {
  const errors = {};
  const { startDate: start, endDate: end } = values;
  if (!start || !end) return errors;

  // Las fechas vienen como "yyyy-mm-dd": se pueden comparar como texto
  if (end < start) {
    errors.endDate = "La fecha fin no puede ser anterior a la fecha inicio.";
    return errors;
  }

  // Un período activo no puede traslaparse con otro período activo
  if (values.status === "true") {
    const overlap = items.find(
      (p) =>
        p.id !== currentId &&
        p.status === true &&
        start <= String(p.endDate).slice(0, 10) &&
        end >= String(p.startDate).slice(0, 10)
    );
    if (overlap) {
      errors.startDate = `Se traslapa con el período activo "${overlap.description?.trim()}" (${dmy(overlap.startDate)} – ${dmy(overlap.endDate)}).`;
    }
  }

  return errors;
};

