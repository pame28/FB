        private static async Task<IResult> ExportSession(
            long sessionId,
            ICoachingRepository repository,
            ClaimsPrincipal claimsPrincipal,
            ILoggerFactory loggerFactory)
        {
            var logger = loggerFactory.CreateLogger(typeof(CoachingEndpoints));
            var currentUserId = GetCurrentUserId(claimsPrincipal);

            try
            {
                if (string.IsNullOrWhiteSpace(currentUserId))
                {
                    return Unauthorized();
                }

                var data = await repository.GetSessionExportAsync(sessionId, currentUserId);
                if (data is null)
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = StatusCodes.Status404NotFound,
                        Message = "La sesión de coaching no existe o no tienes acceso a ella."
                    }, statusCode: StatusCodes.Status404NotFound);
                }

                return Results.Ok(new ResponseObject<CoachingSessionExportDto>
                {
                    Code = StatusCodes.Status200OK,
                    Message = "OK",
                    Data = data
                });
            }
            catch (Exception exception)
            {
                logger.LogError(exception, "ExportCoachingSessionError");
                return ServerError();
            }
        }












/* =========================================================
   Datos de reportes de coaching.
   Convierte la respuesta de GET /api/coaching/sessions/{id}/export
   al modelo que usan los dos reportes:
     - coachingFormatReport.js  (PDF "Formato de Coaching" del coach)
     - consulta/coachingReport.js (PDF y Excel de Consulta)
   Un solo lugar: si cambia la API, solo se ajusta aquí.
   ========================================================= */
import { formatDateTime } from "../../../shared/reports/reportFormat";

// "2026-11-01" (DateOnly) → "01/11/2026", sin desfase de zona horaria
const dmy = (value) => {
  if (!value) return "—";
  const [y, m, d] = String(value).slice(0, 10).split("-");
  return d ? `${d}/${m}/${y}` : String(value);
};

// Fecha UTC del backend ("...Z") → "25/11/2026 01:17 p. m." en hora local
const localDateTime = (value) => (value ? formatDateTime(new Date(value)) : "—");

const slug = (text) =>
  String(text ?? "")
    .normalize("NFD").replace(/[̀-ͯ]/g, "")
    .replace(/[^a-zA-Z0-9]+/g, "_").replace(/^_|_$/g, "");

const approval = (a) => (a ? { name: a.name ?? "—", date: localDateTime(a.at) } : null);

/** Respuesta de /export → modelo común de los reportes */
export const toCoachingReportData = (dto) => {
  const col = dto.collaborator ?? {};

  return {
    collaboratorName: col.fullName,
    collaboratorCode: col.employeeCode,
    tellerCode: col.tellerCode,
    position: col.position,
    area: col.area,
    location: col.location ?? col.branch,
    ubication: col.ubication,
    employeeStatus: col.statusName,

    coachName: dto.coachName,
    teamName: dto.teamName,
    date: dto.coachingDate ? dmy(new Date(dto.coachingDate).toLocaleDateString("en-CA")) : "—",
    period: dto.periodName ?? "—",
    periodStart: dmy(dto.periodStart),
    periodEnd: dmy(dto.periodEnd),
    status: dto.statusName,
    approvedAt: dto.collaboratorApproval ? localDateTime(dto.collaboratorApproval.at) : null,
    rejectionReason: dto.reviewRejectionReason,

    indicators: (dto.indicators ?? []).map((i) => ({
      name: i.name,
      type: i.typeName ?? "Sin tipo",
      weight: Number(i.weight ?? 0),
      goal: i.goalText ?? "—",
      value: i.valueText ?? "—",
      achievement: i.achievementPercentage,
      passed: i.passed, // true | false | null (sin registrar)
      points: Number(i.points ?? 0),
    })),
    total: Number(dto.finalScore ?? 0),

    actions: (dto.actions ?? []).map((a) => ({
      measurementType: a.measurementTypeName ?? "—",
      commitDate: dmy(a.commitmentDate),
      opportunity: a.improvementOpportunity,
      action: a.actionDescription,
    })),

    coachApproval: approval(dto.coachApproval),
    collaboratorApproval: approval(dto.collaboratorApproval),
  };
};

/** Coaching_[NombreColaborador]_[Periodo].pdf */
export const coachingFileName = (dto) =>
  `Coaching_${slug(dto.collaborator?.fullName)}_${slug(dto.periodName)}.pdf`;
















/* =========================================================
   Reporte de Proceso de Coaching de Consulta (Excel y PDF).
   Recibe la respuesta de GET /api/coaching/sessions/{id}/export
   y la convierte al formato de exportDocument().
   ========================================================= */
import { toCoachingReportData } from "../coach/coachingExportData";

const statusTone = (value) => {
  const v = String(value).toLowerCase();
  if (v === "aprobado") return "green";
  if (v === "rechazado") return "red";
  return "amber";
};

const employeeTone = (value) => (String(value).toLowerCase() === "activo" ? "green" : "grey");

const resultTone = (value) => ({ Pendiente: "amber", Rechazado: "red" }[value] ?? "green");

/**
 * @param {object} dto     Respuesta de /export
 * @param {object} options
 *   generatedBy   Nombre de quien descarga el reporte
 */
export const buildCoachingReport = (dto, { generatedBy } = {}) => {
  const r = toCoachingReportData(dto);
  const rejected = r.status === "Rechazado";

  const approvals = [
    {
      role: "Coach",
      name: r.coachApproval?.name ?? r.coachName,
      date: r.coachApproval?.date ?? "",
      result: r.coachApproval ? "Firmado digitalmente" : "Pendiente",
    },
    {
      role: "Colaborador",
      name: r.collaboratorApproval?.name ?? r.collaboratorName,
      date: r.collaboratorApproval?.date ?? "",
      result: r.collaboratorApproval ? "Firmado digitalmente" : rejected ? "Rechazado" : "Pendiente",
    },
  ];

  return {
    title: "Reporte de Proceso de Coaching",
    fileName: `coaching_${r.period}`,
    sheetName: `Coaching ${r.period}`,
    generatedBy,
    highlights: [
      { label: "Colaborador", value: r.collaboratorName },
      { label: "Código", value: r.collaboratorCode },
      { label: "Período", value: r.period },
      { label: "Estado", value: r.status, tone: statusTone(r.status) },
    ],
    sections: [
      {
        type: "fields",
        title: "Datos del colaborador",
        fields: [
          { label: "Nombre completo", value: r.collaboratorName },
          { label: "Código de empleado", value: r.collaboratorCode },
          { label: "Puesto", value: r.position },
          { label: "Código de cajero", value: r.tellerCode },
          { label: "Área", value: r.area },
          { label: "Ubicación", value: r.ubication },
          { label: "Agencia / Zona", value: r.location },
          { label: "Estatus", value: r.employeeStatus, tone: r.employeeStatus ? employeeTone(r.employeeStatus) : undefined },
        ],
      },
      {
        type: "fields",
        title: "Datos del proceso de coaching",
        fields: [
          { label: "Coach asignado", value: r.coachName },
          { label: "Fecha de inicio", value: r.periodStart },
          { label: "Período", value: r.period },
          { label: "Fecha de fin", value: r.periodEnd },
          { label: "Fecha del coaching", value: r.date },
          { label: "Estado del proceso", value: r.status, tone: statusTone(r.status) },
          ...(rejected && r.rejectionReason ? [{ label: "Motivo del rechazo", value: r.rejectionReason }] : []),
        ],
      },
      {
        type: "table",
        title: "Indicadores evaluados",
        empty: "No hay indicadores evaluados.",
        rows: r.indicators,
        columns: [
          { header: "Indicador", key: "name", pdfWidth: "*" },
          { header: "Meta", key: "goal", align: "center", pdfWidth: 80 },
          { header: "Valor registrado", key: "value", align: "center", pdfWidth: 80 },
          {
            header: "Resultado",
            value: (i) => (i.passed == null ? "—" : i.passed ? "Cumple" : "No cumple"),
            tone: (v) => (v === "Cumple" ? "green" : v === "No cumple" ? "red" : undefined),
            pdfWidth: 70,
          },
        ],
      },
      {
        type: "blocks",
        title: "Plan de acción",
        empty: "No hay acciones registradas.",
        rows: r.actions,
        itemTitle: (_, i) => `Acción #${i + 1}`,
        columns: [
          { header: "Tipo de medición", key: "measurementType" },
          { header: "Fecha compromiso", key: "commitDate" },
          { header: "Oportunidad de mejora", key: "opportunity" },
          { header: "Acción a realizar", key: "action" },
        ],
      },
      {
        type: "table",
        title: "Aprobaciones digitales",
        rows: approvals,
        columns: [
          { header: "Rol", key: "role", pdfWidth: 70 },
          { header: "Nombre", key: "name" },
          { header: "Fecha y hora", key: "date", align: "center", pdfWidth: 100 },
          { header: "Resultado", key: "result", tone: resultTone, pdfWidth: 100 },
        ],
      },
    ],
  };
};








