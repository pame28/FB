  // Exporta TODOS los usuarios filtrados (no solo la página actual)
  const handleExport = async (type) => {
    const label = type === "excel" ? "Excel" : "PDF";
    setExporting(type);
    try {
      const exportRequest = { ...request, pageNumber: 1, pageSize: Math.max(result.totalCount, 1) };
      const response = type === "excel"
        ? await usersService.exportExcel(exportRequest)
        : await usersService.exportPdf(exportRequest);
      downloadBlob(response, type === "excel" ? "usuarios.xlsx" : "usuarios.pdf");
      toast.success(`${label} generado`, `Se exportaron ${result.totalCount} usuarios.`);
    } catch (err) {
      const apiMessage = await readBlobError(err);
      toast.error(
        `No se pudo exportar a ${label}`,
        err.noAccess ? "No tienes permiso para exportar usuarios." : apiMessage ?? "Intenta de nuevo en unos momentos."
      );
    } finally {
      setExporting(null);
    }
  };








