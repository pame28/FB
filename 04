const cloneDraft = (f) => ({
    name: f.name, area: f.area, team: f.team,
    criteria: f.criteria.map((c) => ({ ...c, columns: [...c.columns], indicators: c.indicators.map((i) => ({ ...i })), newColumn: "" })),
    finalFormula: f.finalFormula, minScore: f.minScore,
});

const today = () => new Date().toLocaleDateString("es-ES", { day: "2-digit", month: "2-digit", year: "numeric" });

export const FormatCertificationPage = () => {
    const toast = useToast();

    const [formats, setFormats] = useState(INITIAL_FORMATS);
    const [newModalOpen, setNewModalOpen] = useState(false);
    const [deleteTarget, setDeleteTarget] = useState(null);

    // Constructor: null | "new" | "edit"
    const [mode, setMode] = useState(null);
    const [editingId, setEditingId] = useState(null);
    const [draft, setDraft] = useState(null);
    const builderRef = useRef(null);

    useEffect(() => {
        if (mode) builderRef.current?.scrollIntoView({ behavior: "smooth", block: "start" });
    }, [mode, editingId]);

    const totalWeight = draft ? draft.criteria.reduce((s, c) => s + (parseInt(c.weight) || 0), 0) : 0;
    const weightOk = totalWeight === 100;

    const setField = (field, value) => setDraft((d) => ({ ...d, [field]: value }));

    const updateCriterion = (id, patch) =>
        setDraft((d) => ({ ...d, criteria: d.criteria.map((c) => (c.id === id ? { ...c, ...patch } : c)) }));

    const addCriterion = () =>
        setDraft((d) => ({
            ...d,
            criteria: [...d.criteria, { id: uid(), name: "", weight: 0, description: "", columns: [], newColumn: "", indicators: [], formula: "" }],
        }));

    const removeCriterion = (id) => setDraft((d) => ({ ...d, criteria: d.criteria.filter((c) => c.id !== id) }));

    const addColumn = (c) => {
        const value = c.newColumn.trim();
        if (!value || c.columns.includes(value)) return;
        updateCriterion(c.id, { columns: [...c.columns, value], newColumn: "" });
    };

    const updateIndicator = (c, indId, patch) =>
        updateCriterion(c.id, { indicators: c.indicators.map((i) => (i.id === indId ? { ...i, ...patch } : i)) });

    const handleWeight = (c, value) => {
        const n = parseInt(value) || 0;
        if (n >= 0 && n <= 100) updateCriterion(c.id, { weight: n });
    };

    const startNew = () => {
        setNewModalOpen(false);
        setEditingId(null);
        setDraft(createTemplateDraft());
        setMode("new");
    };

    const startEdit = (format) => {
        setEditingId(format.id);
        setDraft(cloneDraft(format));
        setMode("edit");
    };

    const closeBuilder = () => {
        setMode(null);
        setEditingId(null);
        setDraft(null);
    };

    const handleSave = () => {
        if (!draft.name.trim() || !draft.area || !draft.team) {
            toast.error("Completa el nombre y el área del formato");
            return;
        }
        if (draft.criteria.length === 0 || draft.criteria.some((c) => !c.name.trim())) {
            toast.error("Cada criterio debe tener un nombre");
            return;
        }
        if (!weightOk) {
            toast.error("Los pesos de los criterios deben sumar 100%");
            return;
        }
        if (!draft.finalFormula.trim()) {
            toast.error("Describe cómo se calcula la nota final");
            return;
        }

        const payload = {
            name: draft.name.trim(), area: draft.area, team: draft.team,
            criteria: draft.criteria.map(({ newColumn, ...c }) => c),
            finalFormula: draft.finalFormula, minScore: draft.minScore,
        };

        // Solo un formato activo por equipo: se desactivan los demás del mismo equipo
        setFormats((prev) => {
            const others = prev.map((f) => (f.id !== editingId && f.team === payload.team ? { ...f, status: "Inactivo" } : f));
            if (editingId) return others.map((f) => (f.id === editingId ? { ...f, ...payload, status: "Activo" } : f));
            return [...others, { id: Date.now(), ...payload, createdBy: CURRENT_USER, date: today(), status: "Activo" }];
        });
        closeBuilder();
        toast.success("Formato guardado correctamente");
    };

    const handleConfirmDelete = () => {
        setFormats((prev) => prev.filter((f) => f.id !== deleteTarget.id));
        if (editingId === deleteTarget.id) closeBuilder();
        setDeleteTarget(null);
        toast.success("Formato eliminado correctamente");
    };

    const columns = [
        { key: "name", header: "Nombre del formato", render: (r) => <span className={ui.formatName}>{r.name}</span> },
        { key: "area", header: "Área", render: (r) => <span className={base.chip}>{r.area}</span> },
        { key: "team", header: "Equipo", render: (r) => <span className={ui.formatName}>{r.team}</span> },
        { key: "sections", header: "Secciones", align: "center", render: (r) => <span className={ui.center}>{r.criteria.length}</span> },
        { key: "createdBy", header: "Creado por", render: (r) => <span className={ui.muted}>{r.createdBy}</span> },
        { key: "date", header: "Fecha", render: (r) => <span className={ui.mutedLight}>{r.date}</span> },
        {
            key: "status", header: "Estado",
            render: (r) => <span className={r.status === "Activo" ? base.statusActive : ui.statusInactive}>{r.status}</span>,
        },
        {
            key: "actions", header: "Acciones", align: "right",
            render: (r) => (
                <div className={ui.rowActions}>
                    <button type="button" className={`${ui.iconBtn} ${ui.editBtn}`} onClick={() => startEdit(r)} title="Editar formato" aria-label={`Editar ${r.name}`}>
                        <SquarePen size={16} />
                    </button>
                    <button type="button" className={`${ui.iconBtn} ${ui.deleteBtn}`} onClick={() => setDeleteTarget(r)} title="Eliminar formato" aria-label={`Eliminar ${r.name}`}>
                        <Trash2 size={16} />
                    </button>
                </div>
            ),
        },
    ];

    return (
        <>
            <header className={ui.headerRow}>
                <div>
                    <h1 className={styles.title}>Formato de certificación</h1>
                    <p className={styles.subtitle}>Crea y edita el formato que se usará al aplicar certificaciones a los equipos. Solo puede existir un formato activo por equipo.</p>
                </div>
                <button type="button" className={`${base.btn} ${base.btnPrimary}`} onClick={() => setNewModalOpen(true)}>
                    <Plus size={16} /> Nuevo formato
                </button>
            </header>

            <div className={base.page}>
                <div className={base.infoBanner}>
                    <Info size={16} />
                    <span>Cada equipo puede tener únicamente un formato activo a la vez. Cualquier administrador puede editar el formato. Al crear uno nuevo para un equipo que ya tiene formato activo, el anterior se desactiva automáticamente.</span>
                </div>

                <section className={ui.tableCard}>
                    <Datatable columns={columns} rows={formats} rowKey="id" emptyMessage="No hay formatos de certificación." />
                </section>

                {draft && (
                    <div ref={builderRef} className={base.page}>
                        <h2 className={ui.builderTitle}>{mode === "edit" ? "Editar formato de certificación" : "Nuevo formato de certificación"}</h2>

                        <section className={base.card}>
                            <div className={base.cardHeader}>
                                <h3 className={base.cardTitle}>Datos generales</h3>
                            </div>
                            <div className={base.cardBody}>
                                <div className={ui.generalGrid}>
                                    <div className={base.field}>
                                        <label className={base.label} htmlFor="fc-name">Nombre del formato *</label>
                                        <input
                                            id="fc-name"
                                            type="text"
                                            className={base.input}
                                            placeholder="Ej. Revisión Interna Agencias v4"
                                            value={draft.name}
                                            onChange={(e) => setField("name", e.target.value)}
                                        />
                                    </div>
                                    <div className={base.field}>
                                        <label className={base.label} htmlFor="fc-area">Área *</label>
                                        <select
                                            id="fc-area"
                                            className={base.select}
                                            value={draft.area}
                                            onChange={(e) => setDraft((d) => ({ ...d, area: e.target.value, team: "" }))}
                                        >
                                            <option value="">— Selecciona —</option>
                                            {AREAS.map((a) => <option key={a} value={a}>{a}</option>)}
                                        </select>
                                    </div>
                                    <div className={base.field}>
                                        <label className={base.label} htmlFor="fc-team">Equipo *</label>
                                        <select
                                            id="fc-team"
                                            className={base.select}
                                            value={draft.team}
                                            onChange={(e) => setField("team", e.target.value)}
                                            disabled={!draft.area}
                                        >
                                            <option value="">{draft.area ? "— Selecciona —" : "— Selecciona el área primero —"}</option>
                                            {(TEAMS_BY_AREA[draft.area] ?? []).map((t) => <option key={t} value={t}>{t}</option>)}
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section className={base.card}>
                            <div className={base.cardHeader}>
                                <h3 className={base.cardTitle}>Criterios de evaluación</h3>
                                <button type="button" className={`${base.btn} ${base.btnOutline} ${base.btnSm}`} onClick={addCriterion}>
                                    <Plus size={15} /> Agregar criterio
                                </button>
                            </div>
                            <div className={base.cardBody}>
                                <div className={base.infoBanner}>
                                    <Info size={16} />
                                    <span>Para cada criterio define cuánto vale (%) y cómo se calcula su resultado. Los pesos deben sumar 100%.</span>
                                </div>

                                <div className={ui.criteriaList}>
                                    {draft.criteria.map((c, idx) => (
                                        <div key={c.id} className={ui.criterion}>
                                            <div className={ui.criterionHead}>
                                                <span className={ui.criterionNumber}>{idx + 1}</span>
                                                <input
                                                    type="text"
                                                    className={`${base.input} ${ui.criterionName}`}
                                                    placeholder="Nombre del criterio..."
                                                    value={c.name}
                                                    onChange={(e) => updateCriterion(c.id, { name: e.target.value })}
                                                    aria-label={`Nombre del criterio ${idx + 1}`}
                                                />
                                                <label className={ui.weightBox}>
                                                    <span>Peso</span>
                                                    <input type="number" min="0" max="100" value={c.weight} onChange={(e) => handleWeight(c, e.target.value)} />
                                                    <span>%</span>
                                                </label>
                                                <button type="button" className={ui.miniDelete} onClick={() => removeCriterion(c.id)} aria-label={`Quitar criterio ${idx + 1}`}>
                                                    <X size={14} />
                                                </button>
                                            </div>

                                            <span className={ui.sectionLabel}>Descripción / instrucción para el certificador</span>
                                            <textarea
                                                className={base.textarea}
                                                value={c.description}
                                                onChange={(e) => updateCriterion(c.id, { description: e.target.value })}
                                            />

                                            <span className={ui.sectionLabel}>Columnas de evaluación</span>
                                            <div className={ui.chips}>
                                                {c.columns.map((col) => (
                                                    <span key={col} className={ui.chipCol}>
                                                        {col}
                                                        <button type="button" onClick={() => updateCriterion(c.id, { columns: c.columns.filter((x) => x !== col) })} aria-label={`Quitar columna ${col}`}>
                                                            <X size={11} />
                                                        </button>
                                                    </span>
                                                ))}
                                            </div>
                                            <div className={ui.addRow}>
                                                <input
                                                    type="text"
                                                    className={base.input}
                                                    placeholder="Nueva columna..."
                                                    value={c.newColumn}
                                                    onChange={(e) => updateCriterion(c.id, { newColumn: e.target.value })}
                                                    onKeyDown={(e) => {
                                                        if (e.key === "Enter") {
                                                            e.preventDefault();
                                                            addColumn(c);
                                                        }
                                                    }}
                                                />
                                                <button type="button" className={`${base.btn} ${base.btnOutline} ${base.btnSm}`} onClick={() => addColumn(c)}>
                                                    Agregar
                                                </button>
                                            </div>

                                            <span className={ui.sectionLabel}>Indicadores / filas</span>
                                            <div className={ui.indicatorRows}>
                                                {c.indicators.map((ind) => (
                                                    <div key={ind.id} className={ui.indicatorRow}>
