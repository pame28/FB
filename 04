import { ChevronLeft, ChevronRight } from "lucide-react";
import s from "./Pagination.module.css";

// [1, "…", 4, 5, 6, "…", 12]
const pageList = (page, totalPages) => {
  if (totalPages <= 7) return Array.from({ length: totalPages }, (_, i) => i + 1);
  const pages = [...new Set([1, totalPages, page - 1, page, page + 1])]
    .filter((p) => p >= 1 && p <= totalPages)
    .sort((a, b) => a - b);
  return pages.flatMap((p, i) => (i > 0 && p - pages[i - 1] > 1 ? ["…", p] : [p]));
};

/**
 * Pie de tabla con rango, filas por página y páginas.
 * page empieza en 1.
 */
export const Pagination = ({ page, pageSize, total, onPageChange, onPageSizeChange, pageSizes = [10, 20, 50] }) => {
  if (!total) return null;

  const totalPages = Math.max(1, Math.ceil(total / pageSize));
  const from = (page - 1) * pageSize + 1;
  const to = Math.min(page * pageSize, total);

  return (
    <div className={s.footer}>
      <span>
        Mostrando <strong>{from}–{to}</strong> de <strong>{total}</strong>
      </span>

      <div className={s.right}>
        {onPageSizeChange && (
          <label className={s.size}>
            Filas
            <select value={pageSize} onChange={(e) => onPageSizeChange(Number(e.target.value))}>
              {pageSizes.map((n) => <option key={n} value={n}>{n}</option>)}
            </select>
          </label>
        )}

        <nav className={s.pager} aria-label="Paginación">
          <button type="button" className={s.btn} disabled={page <= 1}
            onClick={() => onPageChange(page - 1)} aria-label="Página anterior">
            <ChevronLeft size={16} />
          </button>
          {pageList(page, totalPages).map((p, i) =>
            p === "…" ? (
              <span key={`gap-${i}`} className={s.gap}>…</span>
            ) : (
              <button key={p} type="button" className={`${s.btn} ${p === page ? s.btnOn : ""}`}
                aria-current={p === page ? "page" : undefined} onClick={() => onPageChange(p)}>
                {p}
              </button>
            )
          )}
          <button type="button" className={s.btn} disabled={page >= totalPages}
            onClick={() => onPageChange(page + 1)} aria-label="Página siguiente">
            <ChevronRight size={16} />
          </button>
        </nav>
      </div>
    </div>
  );
};














