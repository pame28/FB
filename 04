		private void Info(string mensaje)
		{
			Log(LogInfo, mensaje);
		}

		private void ErrorLog(string contexto, Exception ex)
		{
			Log(LogError, contexto + ": " + ex.GetType().Name + " - " + ex.Message);
		}

		/// <summary>
		/// Escribe siempre en los eventos de SSIS (visibles en SSISDB / consola) y, segun el estado,
		/// en la tabla de log de la BD mediante el SP RegistroProceso.
		/// </summary>
		private void Log(string estado, string mensaje)
		{
			string texto = "[" + Fmt(_swTotal) + "] " + mensaje;
			bool fireAgain = true;

			if (estado == LogError)
			{
				_ultimoError = mensaje;
				Dts.Events.FireWarning(0, NombreProceso, "ERROR: " + texto, "", 0);
			}
			else
			{
				Dts.Events.FireInformation(0, NombreProceso, texto, "", 0, ref fireAgain);
			}

			if (estado == LogInfo && !_logDetallado)
				return;

			EscribirLogBd(estado, texto);
		}

		private void EscribirLogBd(string estado, string mensaje)
		{
			string sp;
			if (!parametros.TryGetValue("RegistroProceso", out sp) || string.IsNullOrWhiteSpace(sp))
				return;

			if (mensaje.Length > MaxLongitudMensaje)
				mensaje = mensaje.Substring(0, MaxLongitudMensaje - 3) + "...";

			ConnectionManager cm = Dts.Connections["DESCARGAINFO"];
			SqlConnection conn = null;

			try
			{
				conn = Adquirir<SqlConnection>(cm);

				using (SqlCommand cmd = new SqlCommand(sp, conn))
				{
					cmd.CommandType = CommandType.StoredProcedure;
					cmd.CommandTimeout = 60;
					cmd.Parameters.Add(new SqlParameter("@Proceso", NombreProceso));
					cmd.Parameters.Add(new SqlParameter("@EstadoProceso", estado));
					cmd.Parameters.Add(new SqlParameter("@Mensaje", mensaje));
					cmd.ExecuteNonQuery();
				}
			}
			catch (Exception ex)
			{
				Dts.Events.FireWarning(0, NombreProceso, "No se pudo registrar en la BD: " + ex.Message, "", 0);
			}
			finally
			{
				if (conn != null)
					cm.ReleaseConnection(conn);
			}
		}
