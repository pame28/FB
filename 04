		public void Main()
		{
			bool ok = false;

			try
			{
				ok = Ejecutar();
			}
			catch (Exception ex)
			{
				ErrorLog("Error no controlado en el script", ex);
			}

			if (!ok)
			{
				Dts.Events.FireError(0, NombreProceso, _ultimoError ?? "El proceso termino con error.", "", 0);
			}

			Dts.TaskResult = (int)(ok ? ScriptResults.Success : ScriptResults.Failure);
		}

		private bool Ejecutar()
		{
			if (!ObtieneParametros())
				return false;

			if (!ValidarParametros())
				return false;

			CargarConfiguracion();

			if (!DeterminarFechaProceso())
				return false;

			ParseaConsultas();

			Info("Inicio proceso" + (_modoReproceso ? " (MODO REPROCESO)" : "") + ". FechaProceso=" + _fechaGeneracion +
				 ", Archivo=" + parametros["NombreArchivo"] + ", TamanoLote=" + _tamanoLote +
				 ", TimeoutSql=" + _timeoutSql + "s, TimeoutAs400=" + _timeoutAs400 + "s");

			string estadoProceso = ObtenerEstadoProceso();
			if (estadoProceso == null)
				return false;

			Info("Estado en AS400: '" + estadoProceso + "' (inicial esperado: '" + parametros["EstadoInicial"] + "')");

			// En reproceso el archivo de control puede estar ya en estado final (la fecha ya se habia procesado).
			// Se recarga la informacion pero no se vuelve a actualizar el estado en AS400.
			if (_modoReproceso && estadoProceso == parametros["EstadoFinal"])
			{
				Info("REPROCESO: el archivo de control ya esta en estado final '" + estadoProceso +
					 "'. Se recargara el contenido actual de " + parametros["ArchiviOrigen"] + " sin actualizar AS400.");
				_omitirUpdateAs400 = true;
				return RealizarMovimiento();
			}

			if (estadoProceso != parametros["EstadoInicial"])
				return RealizarReintento(estadoProceso);

			return RealizarMovimiento();
		}

		/// <summary>
		/// Define la fecha a procesar. Normal: parametro FechaProceso.
		/// Reproceso: ModoReproceso = true y FechaReproceso = yyyy-MM-dd (parametros en BD, sin tocar SPs).
		/// </summary>
		private bool DeterminarFechaProceso()
		{
			_modoReproceso = ParamBool("ModoReproceso", false);

			if (!_modoReproceso)
			{
				_fechaGeneracion = parametros["FechaProceso"].Trim();
				return true;
			}

			string texto;
			DateTime fecha;
			parametros.TryGetValue("FechaReproceso", out texto);
			texto = (texto ?? string.Empty).Trim();

			// Sin FechaReproceso: mecanismo manual existente (se modifico General.FechaProceso a mano).
			if (texto.Length == 0)
			{
				_fechaGeneracion = parametros["FechaProceso"].Trim();
				Dts.Events.FireWarning(0, NombreProceso, "ModoReproceso activo sin FechaReproceso: se usa FechaProceso=" +
					_fechaGeneracion + " (el SP de registro no guardara bitacora en este modo).", "", 0);
				return true;
			}

			if (!DateTime.TryParseExact(texto, FormatoFecha, CultureInfo.InvariantCulture, DateTimeStyles.None, out fecha))
			{
				Log(LogError, "ModoReproceso activo pero FechaReproceso no es valida (valor: '" + texto + "', formato esperado " + FormatoFecha + ").");
				return false;
			}

			if (fecha.Date > DateTime.Today)
			{
				Log(LogError, "FechaReproceso " + fecha.ToString(FormatoFecha) + " no puede ser mayor a la fecha actual.");
				return false;
			}

			_fechaGeneracion = fecha.ToString(FormatoFecha);
			Info("MODO REPROCESO activo. Se reprocesara la fecha " + _fechaGeneracion +
				 " (FechaProceso normal: " + parametros["FechaProceso"] + ")");
			return true;
		}

		#region Flujo principal
		private bool RealizarMovimiento()
		{
			if (!ExtraerYCargar())
				return false;

			if (_sinRegistros)
			{
				// Comportamiento anterior de ECuotasPendientes: sin datos se marca el archivo en AS400 y termina OK.
				if (!_omitirUpdateAs400 && !UpdateArchivoAS400())
					return false;

				Log(LogExito, "Proceso finalizado sin registros en AS400 para el dia " + _fechaGeneracion);
				return true;
			}

			if (!EjecutarSpConArchivo("PostParseo"))
				return false;

			if (_omitirUpdateAs400)
				Info("REPROCESO: se omite la actualizacion de estado en AS400.");
			else if (!UpdateArchivoAS400())
				return false;

			Log(LogExito, (_modoReproceso ? "Reproceso " + _fechaGeneracion + " ejecutado exitosamente" : "Proceso ejecutado exitosamente") +
						  ". Filas cargadas: " + _filasInsertadas.ToString("N0"));
			return true;
		}

		/// <summary>
		/// Lee de AS400 e inserta en SQL Server por lotes con SqlBulkCopy.
		/// </summary>
		private bool ExtraerYCargar()
		{
			Stopwatch sw = Stopwatch.StartNew();
			_fase = "conectando a AS400";
			_filasLeidas = 0;
			_filasInsertadas = 0;
			_sinRegistros = false;

			ConnectionManager cmAs400 = Dts.Connections["AS400"];
			OleDbConnection connAs400 = null;

			try
			{
				connAs400 = Adquirir<OleDbConnection>(cmAs400);

				using (IDbCommand cmd = connAs400.CreateCommand())
				{
					cmd.CommandText = _sqlConsultaOrigen;
					cmd.CommandTimeout = _timeoutAs400;

					_fase = "ejecutando consulta de origen en AS400";
					Info("Ejecutando consulta de origen en AS400: " + parametros["ArchiviOrigen"]);

					using (IDataReader reader = cmd.ExecuteReader())
					{
						if (reader.FieldCount < ColumnasOrigen)
							throw new InvalidOperationException("La consulta de origen devolvio " + reader.FieldCount +
								" columnas y se esperaban " + ColumnasOrigen + ".");

						// Se lee la primera fila ANTES del PreParseo: si AS400 no trae datos no se limpia la tabla destino.
						_fase = "leyendo primer registro de AS400";
						if (!reader.Read())
						{
							if (_sinRegistrosEsExito)
							{
								Info("No se encontraron registros en AS400 para el dia " + _fechaGeneracion + " (SinRegistrosEsExito=true)");
								_sinRegistros = true;
								return true;
							}

							Log(LogError, "No se encontraron registros en AS400 para el dia " + _fechaGeneracion);
							return false;
						}

						Info("AS400 respondio el primer registro en " + Fmt(sw));

						if (!EjecutarSpConArchivo("PreParseo"))
							return false;

						CargarLotes(reader);
					}
				}

				Info("Extraccion y carga finalizadas: " + _filasInsertadas.ToString("N0") + " filas en " + Fmt(sw));
				return true;
			}
			catch (Exception ex)
			{
				ErrorLog("Fallo " + _fase + " (filas leidas=" + _filasLeidas.ToString("N0") +
						 ", insertadas=" + _filasInsertadas.ToString("N0") + ", transcurrido " + Fmt(sw) + ")", ex);
				return false;
			}
			finally
			{
				if (connAs400 != null)
					cmAs400.ReleaseConnection(connAs400);
			}
		}

		private void CargarLotes(IDataReader reader)
		{
			Stopwatch swCarga = Stopwatch.StartNew();
			ConnectionManager cmSql = Dts.Connections["BANDEJAVASA"];
			SqlConnection connSql = null;

			DataTable lote = CrearTablaLote();
			object[] buffer = new object[reader.FieldCount];
			object[] fila = new object[ColumnasDestino];
			Type[] tipos = new Type[ColumnasDestino];
			string[] nombres = new string[ColumnasDestino];
			for (int c = 0; c < ColumnasDestino; c++)
			{
				tipos[c] = lote.Columns[c].DataType;
				nombres[c] = lote.Columns[c].ColumnName;
			}
			long proximoLog = _logCadaFilas;

			try
			{
				_fase = "conectando a SQL Server (BANDEJAVASA)";
				connSql = Adquirir<SqlConnection>(cmSql);

				SqlBulkCopyOptions opciones = _bulkTableLock ? SqlBulkCopyOptions.TableLock : SqlBulkCopyOptions.Default;

				using (SqlBulkCopy bulk = new SqlBulkCopy(connSql, opciones, null))
				{
					bulk.DestinationTableName = parametros["ArchivoDestino"];
					bulk.BulkCopyTimeout = _timeoutSql;

					Info("Iniciando bulk insert hacia " + parametros["ArchivoDestino"]);

					do
					{
						_fase = "leyendo AS400";
						long t0 = Stopwatch.GetTimestamp();
						reader.GetValues(buffer);
						long t1 = Stopwatch.GetTimestamp();

						_fase = "convirtiendo fila " + (_filasLeidas + 1).ToString("N0");
						LlenarFila(buffer, fila, tipos, nombres);
						lote.Rows.Add(fila);

						_ticksLectura += t1 - t0;
						_ticksConversion += Stopwatch.GetTimestamp() - t1;
						_filasLeidas++;

						if (lote.Rows.Count >= _tamanoLote)
						{
							EscribirLote(bulk, lote);

							if (_filasInsertadas >= proximoLog)
							{
								Info("Avance: " + _filasInsertadas.ToString("N0") + " filas insertadas en " + Fmt(swCarga) +
									 " | " + ResumenTiempos());
								proximoLog += _logCadaFilas;
							}
						}

						_fase = "leyendo AS400";
					}
					while (LeerFila(reader));

					if (lote.Rows.Count > 0)
						EscribirLote(bulk, lote);
				}

				double segundos = Math.Max(1.0, swCarga.Elapsed.TotalSeconds);
				Info("Bulk insert terminado: " + _filasInsertadas.ToString("N0") + " filas en " + Fmt(swCarga) +
					 " (~" + ((long)(_filasInsertadas / segundos)).ToString("N0") + " filas/seg) | " + ResumenTiempos());
			}
			finally
			{
				if (connSql != null)
					cmSql.ReleaseConnection(connSql);
			}
		}

		private void EscribirLote(SqlBulkCopy bulk, DataTable lote)
		{
			_fase = "bulk insert";
			int filas = lote.Rows.Count;

			long t0 = Stopwatch.GetTimestamp();
			bulk.WriteToServer(lote);
			_ticksBulk += Stopwatch.GetTimestamp() - t0;

			_filasInsertadas += filas;
			lote.Clear();
		}

		// Read() con medicion de tiempo (cuanto espera el script a que AS400 entregue la siguiente fila).
		private bool LeerFila(IDataReader reader)
		{
			long t0 = Stopwatch.GetTimestamp();
			bool hayFila = reader.Read();
			_ticksLectura += Stopwatch.GetTimestamp() - t0;
			return hayFila;
		}

		private string ResumenTiempos()
		{
			return "lectura AS400=" + FmtTicks(_ticksLectura) + ", conversion=" + FmtTicks(_ticksConversion) +
				   ", bulk SQL=" + FmtTicks(_ticksBulk);
		}

		private static string FmtTicks(long ticks)
		{
			return TimeSpan.FromSeconds(ticks / (double)Stopwatch.Frequency).ToString(@"hh\:mm\:ss");
		}

		/// <summary>
		/// Espera mientras el AS400 coloca la informacion del archivo si este no ha sido generado a la hora de ejecucion del proceso
		/// </summary>
		private bool RealizarReintento(string estadoProceso)
		{
			int cantidad = ParamInt("CantidadReintentos", 0);
			int minutos = ParamInt("MinutosReintentos", 1);
			int intento = 0;

			while (estadoProceso != EstadoGenerado && intento < cantidad)
			{
				intento++;
				Info("Estado '" + estadoProceso + "' distinto de '" + EstadoGenerado + "'. Reintento " + intento + "/" + cantidad +
					 ", esperando " + minutos + " min.");

				Thread.Sleep(TimeSpan.FromMinutes(minutos));
				estadoProceso = ObtenerEstadoProceso();
				if (estadoProceso == null)
					return false;
			}

			if (estadoProceso == EstadoGenerado)
			{
				Info("Estado '" + EstadoGenerado + "' detectado tras " + intento + " reintento(s). Iniciando movimiento.");
				return RealizarMovimiento();
			}

			Log(LogError, "Fallo reintentos: " + cantidad + " intentos de " + minutos + " min c/u, no se actualizo estado " +
						  EstadoGenerado + " en AS400 (ultimo estado: '" + estadoProceso + "')");
			return false;
		}
