// Agrega a cada página (y subpágina) su ruta completa, ej: "/mantenimientos/lider/gestion-lideres"
export const MODULES = RAW_MODULES.map((m) => ({
  ...m,
  pages: m.pages.map((p) => {
    const fullPath = `${m.path}/${p.path}`;
    return {
      ...p,
      fullPath,
      children: (p.children ?? []).map((c) => ({ ...c, fullPath: `${fullPath}/${c.path}` })),
    };
  }),
}));

