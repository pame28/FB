import { useEffect, useState } from "react";
import { apiFeedbackAuthorized } from "../api/APIS";
import { endpointsAPI } from "../api/endpointApi";

const fetchList = async (endpoint, name, mapItem) => {
  try {
    const { data } = await apiFeedbackAuthorized.get(endpoint);
    const list = Array.isArray(data.data) ? data.data : data.data?.items ?? [];
    return { items: list.map(mapItem), warning: null };
  } catch (error) {
    return {
      items: [],
      warning: error.noAccess
        ? `No tienes acceso al catálogo de ${name}.`
        : `No se pudo cargar el catálogo de ${name}.`,
    };
  }
};

const byLabel = (a, b) => String(a.label).localeCompare(String(b.label), "es");

export const useCatalogs = () => {
  const [catalogs, setCatalogs] = useState({ roles: [], areas: [], positions: [], warnings: [] });

  useEffect(() => {
    let cancelled = false;

    Promise.all([
      fetchList(endpointsAPI.roles, "roles", (r) => ({
        value: r.id,
        label: r.roleName ?? r.name,
        description: r.roleDescription ?? r.description,
        modules: (r.modules ?? []).map((m) => ({
          id: m.id,
          name: m.moduleName,
          pages: (m.pages ?? []).map((p) => ({
            id: p.id,
            name: p.pageName,
            permissions: (p.permissions ?? []).map((x) => x.permissionName),
          })),
        })),
      })),
      fetchList(endpointsAPI.companyAreas, "áreas", (a) => ({
        value: a.id,
        label: a.name,
        description: a.description ?? "",
      })),
      fetchList(endpointsAPI.companyPositions, "puestos", (p) => ({
        value: p.id,
        label: p.name,
      })),
    ]).then(([roles, areas, positions]) => {
      if (cancelled) return;
      setCatalogs({
        roles: roles.items,
        areas: areas.items.sort(byLabel),
        positions: positions.items.sort(byLabel),
        warnings: [roles.warning, areas.warning, positions.warning].filter(Boolean),
      });
    });

    return () => { cancelled = true; };
  }, []);

  return catalogs;
};









