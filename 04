Create View [dbo].[uvw_SaldosExtras]
As
	Select 
		NumeroCuenta
		,Sum( Case When GrupoMovimientos = 'EXF' And MonedaLiquidar = '340' Then PlanCuotaCapitalPend Else 0 End) SaldoExtraMN
		,Sum( Case When GrupoMovimientos = 'EXF' And MonedaLiquidar = '840' Then PlanCuotaCapitalPend Else 0 End) SaldoExtraME
		,Sum( Case When GrupoMovimientos In('CCT', 'INT') And MonedaLiquidar = '340' Then PlanCuotaCapitalPend Else 0 End) SaldoIntraMN
		,Sum( Case When GrupoMovimientos In('CCT', 'INT') And MonedaLiquidar = '840' Then PlanCuotaCapitalPend Else 0 End) SaldoIntraME
	From
		CuotasPendientes
	Group By
		NumeroCuenta
GO





