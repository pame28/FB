                row.Add(new XElement(cellName,
                    new XAttribute("r", $"{ColumnName(index + 1)}1"),
                    new XAttribute("t", "inlineStr"),
                    new XElement(inlineStringName,
                        new XElement(textName, header))));
            }

            return row;
        }

        private static IEnumerable<XElement> CreateDataRows(List<Dictionary<string, string>> rows, List<string> properties)
        {
            var rowName = XName.Get("row", XmlSegment);
            var cellName = XName.Get("c", XmlSegment);
            var inlineStringName = XName.Get("is", XmlSegment);
            var textName = XName.Get("t", XmlSegment);

            for (var rowIndex = 0; rowIndex < rows.Count; rowIndex++)
            {
                var row = new XElement(rowName, new XAttribute("r", rowIndex + 2));
                var data = rows[rowIndex];

                for (var columnIndex = 0; columnIndex < properties.Count; columnIndex++)
                {
                    var propertyName = properties[columnIndex];
                    data.TryGetValue(propertyName, out var value);

                    row.Add(new XElement(cellName,
                        new XAttribute("r", $"{ColumnName(columnIndex + 1)}{rowIndex + 2}"),
                        new XAttribute("t", "inlineStr"),
                        new XElement(inlineStringName,
                            new XElement(textName, value ?? string.Empty))));
                }

                yield return row;
            }
        }

        private static string ColumnName(int index)
        {
            var dividend = index;
            var columnName = string.Empty;

            var stringBuilder = new System.Text.StringBuilder();
            while (dividend > 0)
            {
                var modulo = (dividend - 1) % 26;
                stringBuilder.Append(Convert.ToChar('A' + modulo) + columnName);
                dividend = (dividend - modulo) / 26;
            }

            return stringBuilder.ToString();
        }

    }
}




