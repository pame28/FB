using ApiCoaching.Models;
using ApiCoaching.Models.SpResults;
using Microsoft.EntityFrameworkCore;

namespace ApiCoaching.Data
{
    public class AppDbContext(DbContextOptions<AppDbContext> options) : DbContext(options)
    {
        public DbSet<User> Users { get; set; }
        public DbSet<Team> Teams { get; set; }
        public DbSet<TeamLeader> TeamsLeaders { get; set; }
        public DbSet<TeamMember> TeamsMembers { get; set; }
        public DbSet<CompanyPosition> CompanyPositions { get; set; }
        public DbSet<CompanyLocation> CompanyLocations { get; set; }
        public DbSet<CompanyArea> CompanyAreas { get; set; }
        public DbSet<CompanyBranch> CompanyBranches { get; set; }
        public DbSet<Permission> Permissions { get; set; }
        public DbSet<Page> Pages { get; set; }
        public DbSet<Role> Roles { get; set; }
        public DbSet<Module> Modules { get; set; }
        public DbSet<LoginLog> LoginLogs { get; set; }
        public DbSet<ModelLog> ModelsLogs { get; set; }
        public DbSet<Template> Templates { get; set; }
        public DbSet<Marker> Markers { get; set; }
        public DbSet<TemplateMarker> TemplatesMarkers { get; set; }
        public DbSet<Verb> Verbs { get; set; }
        public DbSet<Unit> Units { get; set; }
        public DbSet<Indicator> Indicators { get; set; }
        public DbSet<IndicatorMarkerAssignment> IndicatorsMarkerAssignments { get; set; }
        public DbSet<TeamMemberIndicatorAssignment> TeamMembersIndicatorsAssignments { get; set; }
        public DbSet<CoachingSession> CoachingSessions { get; set; }
        public DbSet<CoachingActionPlan> CoachingActionsPlans { get; set; }
        public DbSet<CoachingAction> CoachingActions { get; set; }
        public DbSet<Period> Periods { get; set; }






        protected override void OnModelCreating(ModelBuilder modelBuilder)
        {
            modelBuilder.Entity<Role>()
                .HasMany(r => r.Permissions)
                .WithMany(p => p.Roles)
                .UsingEntity<Dictionary<string, object>>(
                    "RolesPermissions",
                    j => j.HasOne<Permission>()
                          .WithMany()
                          .HasForeignKey("PermissionId"),
                    j => j.HasOne<Role>()
                          .WithMany()
                          .HasForeignKey("RoleId"),
                    j =>
                    {
                        j.HasKey("RoleId", "PermissionId");
                    });

            modelBuilder.Entity<TemplateMarker>()
                .HasKey(bc => new { bc.TemplateId, bc.Position });

            modelBuilder.Entity<TemplateMarker>()
                .HasOne(bc => bc.Template)
                .WithMany(b => b.TemplateMarkers)
                .HasForeignKey(bc => bc.TemplateId);

            modelBuilder.Entity<TemplateMarker>()
                .HasOne(bc => bc.Marker)
                .WithMany(c => c.TemplateMarkers)
                .HasForeignKey(bc => bc.MarkerId);


            modelBuilder.Entity<IndicatorMarkerAssignment>()
                .HasKey(x => new { x.IndicatorId, x.TemplateId, x.Position });

            modelBuilder.Entity<IndicatorMarkerAssignment>()
                .HasOne(x => x.Indicator)
                .WithMany(x => x.MarkerAssignments)
                .HasForeignKey(x => x.IndicatorId);

            modelBuilder.Entity<IndicatorMarkerAssignment>()
                .HasOne(x => x.TemplateMarker)
                .WithMany()
                .HasForeignKey(x => new { x.TemplateId, x.Position })
                .HasPrincipalKey(x => new { x.TemplateId, x.Position });

            modelBuilder.Entity<IndicatorMarkerAssignment>()
                .HasOne(x => x.Verb)
                .WithMany(x => x.MarkerAssignments)
                .HasForeignKey(x => x.VerbId)
                .OnDelete(DeleteBehavior.Restrict);

            modelBuilder.Entity<IndicatorMarkerAssignment>()
                .HasOne(x => x.Unit)
                .WithMany(x => x.MarkerAssignments)
                .HasForeignKey(x => x.UnitId)
                .OnDelete(DeleteBehavior.Restrict);

            modelBuilder.Entity<TeamLeader>(entity =>
            {
                entity.HasKey(x => new { x.TeamId, x.LeaderUserId });

                entity.HasOne(x => x.Team)
                    .WithMany(x => x.Leaders)
                    .HasForeignKey(x => x.TeamId)
                    .OnDelete(DeleteBehavior.Cascade);

                entity.HasOne(x => x.User)
                    .WithMany(x => x.TeamsLeaders)
                    .HasForeignKey(x => x.LeaderUserId)
                    .OnDelete(DeleteBehavior.Restrict);
            });

            modelBuilder.Entity<TeamMember>(entity =>
            {
                entity.HasKey(x => new { x.TeamId, x.MemberUserId });

                entity.HasOne(x => x.Team)
                    .WithMany(x => x.Members)
                    .HasForeignKey(x => x.TeamId)
                    .OnDelete(DeleteBehavior.Cascade);

                entity.HasOne(x => x.User)
                    .WithMany(x => x.TeamMembers)
                    .HasForeignKey(x => x.MemberUserId)
                    .OnDelete(DeleteBehavior.Restrict);
            });

            modelBuilder.Entity<CoachingSession>(entity =>
            {
                entity.HasKey(x => x.Id);

                entity.Property(x => x.AcceptanceStatus)
                    .IsConcurrencyToken();

                entity.Property(x => x.ReviewStatus)
                    .IsConcurrencyToken();

                entity.HasOne(x => x.TeamMember)
                    .WithMany()
                    .HasForeignKey(x => new { x.TeamId, x.MemberUserId })
                    .OnDelete(DeleteBehavior.Restrict);
            });

            modelBuilder.Entity<CoachingActionPlan>(entity =>
            {
                entity.HasKey(x => x.Id);

                entity.HasOne(x => x.Session)
                    .WithOne(x => x.ActionPlan)
                    .HasForeignKey<CoachingActionPlan>(x => x.CoachingSessionId)
                    .OnDelete(DeleteBehavior.Cascade);
            });

            modelBuilder.Entity<CoachingAction>(entity =>
            {
                entity.HasKey(x => x.Id);

                entity.HasOne(x => x.ActionPlan)
                    .WithMany(x => x.Actions)
                    .HasForeignKey(x => x.CoachingActionPlanId)
                    .OnDelete(DeleteBehavior.Cascade);
            });

            modelBuilder.Entity<TeamMemberIndicatorAssignment>(entity =>
            {
                entity.HasKey(x => x.Id);

                entity.HasIndex(x => new { x.CoachingSessionId, x.IndicatorId })
                    .IsUnique();

                entity.Property(x => x.Weight)
                    .HasPrecision(5, 2);

                entity.Property(x => x.TargetValue)
                    .HasPrecision(18, 2);

                entity.Property(x => x.AchievedValue)
                    .HasPrecision(18, 2);

                entity.Property(x => x.AchievementPercentage)
                    .HasPrecision(9, 2);

                entity.HasOne(x => x.Session)
                    .WithMany(x => x.IndicatorAssignments)
                    .HasForeignKey(x => x.CoachingSessionId)
                    .OnDelete(DeleteBehavior.Restrict);

                entity.HasOne(x => x.TargetUnit)
                    .WithMany()
                    .HasForeignKey(x => x.TargetUnitId)
                    .OnDelete(DeleteBehavior.Restrict);

                entity.HasOne(x => x.TeamMember)
                    .WithMany(x => x.IndicatorAssignments)
                    .HasForeignKey(x => new
                    {
                        x.TeamId,
                        x.MemberUserId
                    })
                    .OnDelete(DeleteBehavior.Cascade);

                entity.HasOne(x => x.Indicator)
                    .WithMany(x => x.TeamMemberAssignments)
                    .HasForeignKey(x => x.IndicatorId)
                    .OnDelete(DeleteBehavior.Restrict);
            });


            modelBuilder.Entity<UspGetAS400Queries>(e => e.HasNoKey()
                .Metadata.SetIsTableExcludedFromMigrations(true));


        }

    }
}




using ApiCoaching.Constants;
using ApiCoaching.Dtos;
using ApiCoaching.Dtos.Coaching;
using ApiCoaching.Dtos.Teams;
using ApiCoaching.Models;
using ApiCoaching.Repositories.Interfaces;
using ApiCoaching.Services.Interfaces;
using System.Security.Claims;

namespace ApiCoaching.Endpoints
{
    public static class LoggedUserEndpoints
    {
        public static void MapLoggedUserEndpoints(this IEndpointRouteBuilder app)
        {
            var loggedUserGroup = app.MapGroup("/api/logged-user")
                .WithTags("LoggedUser");

            loggedUserGroup.MapGet(string.Empty, GetLoggedUser)
                .WithName("GetLoggedUser")
                .WithSummary("Obtiene el id, nombre y rol del usuario autenticado según el id contenido en el JWT.")
                .RequireAuthorization()
                .Produces<ResponseObject<LoggedUserDto>>(StatusCodes.Status200OK)
                .Produces<ResponseObjectError>(StatusCodes.Status401Unauthorized)
                .Produces<ResponseObjectError>(StatusCodes.Status404NotFound)
                .Produces<ResponseObjectError>(StatusCodes.Status500InternalServerError);

            loggedUserGroup.MapGet("coaching/team-members", GetLoggedUserTeamMembers)
                .WithName("GetLoggedUserTeamMembers")
                .WithSummary("Obtiene los miembros del usuario autenticado agrupados por equipo cuando es líder(Coach).")
                .RequireAuthorization()
                .Produces<ResponseObject<List<LeaderTeamMembersGroupDto>>>(StatusCodes.Status200OK)
                .Produces<ResponseObjectError>(StatusCodes.Status401Unauthorized)
                .Produces<ResponseObjectError>(StatusCodes.Status403Forbidden)
                .Produces<ResponseObjectError>(StatusCodes.Status404NotFound)
                .Produces<ResponseObjectError>(StatusCodes.Status500InternalServerError);

            loggedUserGroup.MapGet("coaching/members/ongoing-assignments", GetLoggedUserMembersWithOngoingAssignments)
                .WithName("GetLoggedUserMembersWithOngoingAssignments")
                .WithSummary("Obtiene los miembros del coach agrupados por equipo, con asignaciones aprobadas e indicador activo; permite filtrar por nombre y código de empleado.")
                .RequireAuthorization()
                .Produces<ResponseObject<List<CoachActiveMembersGroupDto>>>(StatusCodes.Status200OK)
                .Produces<ResponseObjectError>(StatusCodes.Status401Unauthorized)
                .Produces<ResponseObjectError>(StatusCodes.Status403Forbidden)
                .Produces<ResponseObjectError>(StatusCodes.Status404NotFound)
                .Produces<ResponseObjectError>(StatusCodes.Status500InternalServerError);

            loggedUserGroup.MapPost("coaching/members/indicators", GetLoggedUserMemberIndicators)
                .WithName("GetLoggedUserMemberIndicators")
                .WithSummary("Obtiene los indicadores aprobados del primer grupo de asignaciones del miembro indicado de los equipos del coach autenticado.")
                .RequireAuthorization()
                .Produces<ResponseObject<List<MemberIndicatorAssignmentDto>>>(StatusCodes.Status200OK)
                .Produces<ResponseObjectError>(StatusCodes.Status400BadRequest)
                .Produces<ResponseObjectError>(StatusCodes.Status401Unauthorized)
                .Produces<ResponseObjectError>(StatusCodes.Status403Forbidden)
                .Produces<ResponseObjectError>(StatusCodes.Status404NotFound)
                .Produces<ResponseObjectError>(StatusCodes.Status500InternalServerError);

            loggedUserGroup.MapPost("sync/as400", SyncLoggedUserAs400)
                .WithName("SyncLoggedUserAs400")
                .WithSummary("Sincroniza la información AS400 del usuario autenticado usando el cajero asociado a su UserName.")
                .RequireAuthorization()
                .Produces<ResponseObject<LoggedUserDto>>(StatusCodes.Status200OK)
                .Produces<ResponseObjectError>(StatusCodes.Status400BadRequest)
                .Produces<ResponseObjectError>(StatusCodes.Status401Unauthorized)
                .Produces<ResponseObjectError>(StatusCodes.Status404NotFound)
                .Produces<ResponseObjectError>(StatusCodes.Status500InternalServerError);

            loggedUserGroup.MapGet("coaching/teams", GetLoggedUserTeams)
                .WithName("GetLoggedUserTeams")
                .WithSummary("Obtiene los equipos asignados al usuario autenticado cuando es líder(Coach).")
                .RequireAuthorization()
                .Produces<ResponseObject<List<TeamLookupDto>>>(StatusCodes.Status200OK)
                .Produces<ResponseObjectError>(StatusCodes.Status401Unauthorized)
                .Produces<ResponseObjectError>(StatusCodes.Status403Forbidden)
                .Produces<ResponseObjectError>(StatusCodes.Status404NotFound)
                .Produces<ResponseObjectError>(StatusCodes.Status500InternalServerError);
        }

        private static async Task<IResult> GetLoggedUser(
            ClaimsPrincipal claimsPrincipal,
            IUsersRepository usersRepository,
            ILoggerFactory loggerFactory)
        {
            var logger = loggerFactory.CreateLogger(typeof(LoggedUserEndpoints));

            try
            {
                var currentUserId = GetCurrentUserId(claimsPrincipal);

                if (string.IsNullOrWhiteSpace(currentUserId))
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = 401,
                        Message = "No se pudo obtener el identificador del usuario autenticado. "
                    }, statusCode: StatusCodes.Status401Unauthorized);
                }

                var user = await usersRepository.GetLoggedUserById(currentUserId);

                if (user is null)
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = 404,
                        Message = "El usuario autenticado no fue encontrado"
                    }, statusCode: StatusCodes.Status404NotFound);
                }

                var response = new ResponseObject<LoggedUserDto>
                {
                    Code = 200,
                    Message = "OK",
                    Data = MapUserData(user)
                };

                logger.LogInformation("Logged user retrieved successfully for UserId: {UserId}", currentUserId);

                return Results.Ok(response);
            }
            catch (Exception ex)
            {
                logger.LogError(ex, "GetLoggedUserError");
                return Results.Json(new ResponseObjectError
                {
                    Code = 500,
                    Message = GenericErrors.InternalServerError
                }, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        private static async Task<IResult> SyncLoggedUserAs400(
            ClaimsPrincipal claimsPrincipal,
            IUsersRepository usersRepository,
            IUsersTellersAs400Service coachingCajerosService,
            ILoggerFactory loggerFactory)
        {
            var logger = loggerFactory.CreateLogger(typeof(LoggedUserEndpoints));

            try
            {
                var currentUserId = GetCurrentUserId(claimsPrincipal);

                if (string.IsNullOrWhiteSpace(currentUserId))
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = 401,
                        Message = "No se pudo  obtener el identificador del usuario autenticado."
                    }, statusCode: StatusCodes.Status401Unauthorized);
                }

                var user = await usersRepository.GetLoggedUserById(currentUserId);

                if (user is null)
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = 404,
                        Message = "El usuario autenticado no fue encontrado"
                    }, statusCode: StatusCodes.Status404NotFound);
                }

                if (string.IsNullOrWhiteSpace(user.UserName))
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = 400,
                        Message = "El usuario autenticado no tiene un UserName válido para consultar AS400."
                    }, statusCode: StatusCodes.Status400BadRequest);
                }

                var cajero = await coachingCajerosService.ObtenerCajeroAsync(user.UserName);

                if (cajero is null)
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = 404,
                        Message = "No se encontró información en el AS400 para el usuario autenticado."
                    }, statusCode: StatusCodes.Status404NotFound);
                }

                await usersRepository.SyncLoggedUserAs400(user, cajero);

                var response = new ResponseObject<LoggedUserDto>
                {
                    Code = 200,
                    Message = "Perfil sincronizado correctamente.",
                    Data = MapUserData(user)
                };

                logger.LogInformation("Logged user synchronized successfully for UserId: {UserId}", currentUserId);

                return Results.Ok(response);
            }
            catch (Exception ex)
            {
                logger.LogError(ex, "SyncLoggedUserAs400Error");
                return Results.Json(new ResponseObjectError
                {
                    Code = 500,
                    Message = GenericErrors.InternalServerError
                }, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        private static async Task<IResult> GetLoggedUserTeams(
            ClaimsPrincipal claimsPrincipal,
            IUsersRepository usersRepository,
            ITeamsRepository teamsRepository,
            ILoggerFactory loggerFactory)
        {
            var logger = loggerFactory.CreateLogger(typeof(LoggedUserEndpoints));

            try
            {
                var currentUserId = GetCurrentUserId(claimsPrincipal);

                if (string.IsNullOrWhiteSpace(currentUserId))
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = 401,
                        Message = "No se pudo obtener el identificador del usuario autenticado"
                    }, statusCode: StatusCodes.Status401Unauthorized);
                }

                var user = await usersRepository.GetLoggedUserById(currentUserId);

                if (user is null)
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = 404,
                        Message = "El usuario autenticado no fue encontrado"
                    }, statusCode: StatusCodes.Status404NotFound);
                }

                if (!user.IsLeader)
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = 403,
                        Message = "El usuario autenticado no es líder"
                    }, statusCode: StatusCodes.Status403Forbidden);
                }

                var teams = await teamsRepository.GetByLeaderUserId(currentUserId);
                var response = new ResponseObject<List<TeamLookupDto>>
                {
                    Code = 200,
                    Message = "OK",
                    Data = [.. teams.Select(team => new TeamLookupDto
                    {
                        Id = team.Id,
                        Name = team.Name
                    })]
                };

                logger.LogInformation("Teams retrieved successfully for leader UserId: {UserId}", currentUserId);

                return Results.Ok(response);
            }
            catch (Exception ex)
            {
                logger.LogError(ex, "GetLoggedUserTeamsError");
                return Results.Json(new ResponseObjectError
                {
                    Code = 500,
                    Message = GenericErrors.InternalServerError
                }, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        private static async Task<IResult> GetLoggedUserTeamMembers(
            int? companyAreaId,
            int? teamId,
            int? companyPositionId,
            ClaimsPrincipal claimsPrincipal,
            IUsersRepository usersRepository,
            ITeamsRepository teamsRepository,
            ILoggerFactory loggerFactory)
        {
            var logger = loggerFactory.CreateLogger(typeof(LoggedUserEndpoints));

            try
            {
                var currentUserId = GetCurrentUserId(claimsPrincipal);

                if (string.IsNullOrWhiteSpace(currentUserId))
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = 401,
                        Message = "No se pudo obtener el identificador del usuario autenticado."
                    }, statusCode: StatusCodes.Status401Unauthorized);
                }

                var user = await usersRepository.GetLoggedUserById(currentUserId);

                if (user is null)
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = 404,
                        Message = "El usuario autenticado no fue encontrado."
                    }, statusCode: StatusCodes.Status404NotFound);
                }

                if (!user.IsLeader)
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = 403,
                        Message = "El usuario autenticado no es líder."
                    }, statusCode: StatusCodes.Status403Forbidden);
                }

                var members = await teamsRepository.GetMembersByLeaderUserId(
                    currentUserId,
                    companyAreaId,
                    teamId,
                    companyPositionId);

                var response = new ResponseObject<List<LeaderTeamMembersGroupDto>>
                {
                    Code = 200,
                    Message = "OK",
                    Data = [.. members
                        .GroupBy(member => new { member.TeamId, member.TeamName })
                        .OrderBy(group => group.Key.TeamName)
                        .ThenBy(group => group.Key.TeamId)
                        .Select(group => new LeaderTeamMembersGroupDto
                        {
                            TeamId = group.Key.TeamId,
                            TeamName = group.Key.TeamName,
                            Members = [.. group]
                        })]
                };

                logger.LogInformation("Team members retrieved successfully for leader UserId: {UserId}", currentUserId);

                return Results.Ok(response);
            }
            catch (Exception ex)
            {
                logger.LogError(ex, "GetLoggedUserTeamMembersError");
                return Results.Json(new ResponseObjectError
                {
                    Code = 500,
                    Message = GenericErrors.InternalServerError
                }, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        private static async Task<IResult> GetLoggedUserMembersWithOngoingAssignments(
            string? name,
            string? employeeCode,
            ClaimsPrincipal claimsPrincipal,
            IUsersRepository usersRepository,
            ITeamsRepository teamsRepository,
            ILoggerFactory loggerFactory)
        {
            var logger = loggerFactory.CreateLogger(typeof(LoggedUserEndpoints));

            try
            {
                var currentUserId = GetCurrentUserId(claimsPrincipal);

                if (string.IsNullOrWhiteSpace(currentUserId))
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = 401,
                        Message = "No se pudo obtener el identificador del usuario autenticado."
                    }, statusCode: StatusCodes.Status401Unauthorized);
                }

                var user = await usersRepository.GetLoggedUserById(currentUserId);

                if (user is null)
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = 404,
                        Message = "El usuario autenticado no fue encontrado."
                    }, statusCode: StatusCodes.Status404NotFound);
                }

                if (!user.IsLeader)
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = 403,
                        Message = "El usuario autenticado no es líder."
                    }, statusCode: StatusCodes.Status403Forbidden);
                }

                var members = await teamsRepository.GetMembersWithOngoingAssignments(currentUserId, name, employeeCode);

                return Results.Ok(new ResponseObject<List<CoachActiveMembersGroupDto>>
                {
                    Code = 200,
                    Message = "OK",
                    Data = [.. members
                        .GroupBy(member => new { member.TeamId, member.TeamName })
                        .OrderBy(group => group.Key.TeamName)
                        .ThenBy(group => group.Key.TeamId)
                        .Select(group => new CoachActiveMembersGroupDto
                        {
                            TeamId = group.Key.TeamId,
                            TeamName = group.Key.TeamName,
                            Members = [.. group]
                        })]
                });
            }
            catch (Exception ex)
            {
                logger.LogError(ex, "GetLoggedUserMembersWithOngoingAssignmentsError");
                return Results.Json(new ResponseObjectError
                {
                    Code = 500,
                    Message = GenericErrors.InternalServerError
                }, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        private static async Task<IResult> GetLoggedUserMemberIndicators(
            GetMemberIndicatorsRequestDto request,
            ClaimsPrincipal claimsPrincipal,
            IUsersRepository usersRepository,
            ICoachingRepository coachingRepository,
            ILoggerFactory loggerFactory)
        {
            var logger = loggerFactory.CreateLogger(typeof(LoggedUserEndpoints));

            try
            {
                var currentUserId = GetCurrentUserId(claimsPrincipal);

                if (string.IsNullOrWhiteSpace(currentUserId))
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = 401,
                        Message = "No se pudo obtener el identificador del usuario autenticado."
                    }, statusCode: StatusCodes.Status401Unauthorized);
                }

                var user = await usersRepository.GetLoggedUserById(currentUserId);

                if (user is null)
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = 404,
                        Message = "El usuario autenticado no fue encontrado."
                    }, statusCode: StatusCodes.Status404NotFound);
                }

                if (!user.IsLeader)
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = 403,
                        Message = "El usuario autenticado no es líder."
                    }, statusCode: StatusCodes.Status403Forbidden);
                }

                if (string.IsNullOrWhiteSpace(request.MemberUserId))
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = 400,
                        Message = "Debe enviar un identificador de miembro y no puede estar vacío."
                    }, statusCode: StatusCodes.Status400BadRequest);
                }

                var memberUserId = request.MemberUserId.Trim();

                var assignments = await coachingRepository.GetMemberIndicatorsAsync(currentUserId, memberUserId);

                return Results.Ok(new ResponseObject<List<MemberIndicatorAssignmentDto>>
                {
                    Code = 200,
                    Message = "OK",
                    Data = assignments
                });
            }
            catch (Exception ex)
            {
                logger.LogError(ex, "GetLoggedUserMemberIndicatorsError");
                return Results.Json(new ResponseObjectError
                {
                    Code = 500,
                    Message = GenericErrors.InternalServerError
                }, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        private static LoggedUserDto MapUserData(User user)
        {
            return new LoggedUserDto
            {
                Id = user.Id,
                FirstName = user.FirstName,
                LastName = user.LastName,
                FullName = user.FullName,
                UserName = user.UserName,
                Email = user.Email,
                TellerCode = user.TellerCode,
                EmployeeCode = user.EmployeeCode,
                EmployeeBranchUbication = user.EmployeeBranchUbication,
                Status = user.Status,
                CompanyPositionId = user.CompanyPositionId,
                CompanyPosition = user.CompanyPosition?.Name,
                CompanyLocationId = user.CompanyLocationId,
                CompanyLocation = user.CompanyLocation?.Name,
                CompanyBranchId = user.CompanyBranchId,
                CompanyBranch = user.CompanyBranch?.Name,
                CompanyAreaId = user.CompanyAreaId,
                CompanyArea = user.CompanyArea?.Name,
                RoleId = user.RoleId,
                Role = user.Role?.Name ?? string.Empty
            };
        }

        private static string? GetCurrentUserId(ClaimsPrincipal claimsPrincipal)
        {
            return claimsPrincipal.FindFirstValue("userId")
                ?? claimsPrincipal.FindFirstValue(ClaimTypes.NameIdentifier);
        }

