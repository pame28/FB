import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import { AlertCircle, Check, GripVertical, Loader2, Plus, Search, WandSparkles, X } from "lucide-react";
import { Modal, useToast } from "../../../../shared/components";
import { markersService } from "../../../../api/markersService";
import { templatesService } from "../../../../api/templatesService";
import { MARKER_TYPES, findMarkerType, toneClassOf } from "../markers/markerTypes";
import { buildTemplateBody, normalize } from "./templateUtils";
import styles from "../../../Pages.module.css";
import t from "./Templates.module.css";

const FORM_ID = "template-form";
const EMPTY_NEW_MARKER = { open: false, value: "", valueType: "", error: "", saving: false };

const mapMarker = (x) => ({ id: x.id, value: x.value ?? "", type: findMarkerType(x.valueType) });

/**
 * Modal para crear / editar una plantilla.
 * template: null = crear, objeto mapeado (mapTemplate) = editar
 */
export const TemplateFormModal = ({ open, template, onClose, onSaved }) => {
  const toast = useToast();
  const isEdit = Boolean(template);

  // Formulario
  const [items, setItems] = useState([]); // [{ uid, markerId, value, type }]
  const [example, setExample] = useState("");
  const [active, setActive] = useState(true);
  const [errors, setErrors] = useState({});
  const [saving, setSaving] = useState(false);
  const [submitError, setSubmitError] = useState("");

  // Marcadores disponibles
  const [markers, setMarkers] = useState([]);
  const [markersLoading, setMarkersLoading] = useState(false);
  const [markersError, setMarkersError] = useState("");
  const [paletteSearch, setPaletteSearch] = useState("");
  const [newMarker, setNewMarker] = useState(EMPTY_NEW_MARKER);

  // Arrastrar y soltar / foco
  const [dragUid, setDragUid] = useState(null);
  const uidRef = useRef(0);
  const pieceRefs = useRef(new Map());
  const nextUid = () => ++uidRef.current;

  /* ---------- Carga ---------- */
  const loadMarkers = useCallback(async () => {
    setMarkersLoading(true);
    setMarkersError("");
    try {
      const data = await markersService.list();
      const list = data.map(mapMarker).sort((a, b) => a.value.localeCompare(b.value, "es"));
      setMarkers(list);
      return list;
    } catch {
      setMarkersError("No se pudieron cargar los marcadores.");
      return [];
    } finally {
      setMarkersLoading(false);
    }
  }, []);

  // Cada vez que se abre: carga los datos de la plantilla (o limpia) y los marcadores
  useEffect(() => {
    if (!open) return;
    setItems(
      (template?.markers ?? []).map((x) => ({ uid: ++uidRef.current, markerId: x.markerId, value: x.value, type: x.type }))
    );
    setExample(template?.example ?? "");
    setActive(template ? template.active : true);
    setErrors({});
    setSubmitError("");
    setPaletteSearch("");
    setNewMarker(EMPTY_NEW_MARKER);
    loadMarkers();
  }, [open, template, loadMarkers]);

  /* ---------- Constructor ---------- */
  const focusPiece = (uid) => requestAnimationFrame(() => pieceRefs.current.get(uid)?.focus());

  const insertMarker = (marker) => {
    setItems((prev) => [...prev, { uid: nextUid(), markerId: marker.id, value: marker.value, type: marker.type }]);
    setErrors((e) => ({ ...e, structure: undefined }));
  };

  const removePiece = (uid) => {
    setItems((prev) => {
      const i = prev.findIndex((x) => x.uid === uid);
      const next = prev.filter((x) => x.uid !== uid);
      const neighbor = next[i] ?? next[i - 1];
      if (neighbor) focusPiece(neighbor.uid);
      return next;
    });
  };

  const movePiece = (uid, dir) => {
    setItems((prev) => {
      const i = prev.findIndex((x) => x.uid === uid);
      const j = i + dir;
      if (i < 0 || j < 0 || j >= prev.length) return prev;
      const next = [...prev];
      [next[i], next[j]] = [next[j], next[i]];
      return next;
    });
    focusPiece(uid);
  };

  const reorder = (fromUid, toUid) => {
    if (fromUid == null || fromUid === toUid) return;
    setItems((prev) => {
      const from = prev.findIndex((x) => x.uid === fromUid);
      const to = prev.findIndex((x) => x.uid === toUid);
      if (from < 0 || to < 0) return prev;
      const next = [...prev];
      const [moved] = next.splice(from, 1);
      next.splice(to, 0, moved);
      return next;
    });
  };

  const handlePieceKey = (e, uid) => {
    if (e.key === "ArrowLeft") { e.preventDefault(); movePiece(uid, -1); }
    if (e.key === "ArrowRight") { e.preventDefault(); movePiece(uid, 1); }
    if (e.key === "Delete" || e.key === "Backspace") { e.preventDefault(); removePiece(uid); }
  };

  const structureText = items.map((x) => `{${x.value}}`).join(" ");

  /* ---------- Paleta ---------- */
  const visibleMarkers = useMemo(() => {
    const q = normalize(paletteSearch);
    return q ? markers.filter((x) => normalize(x.value).includes(q)) : markers;
  }, [markers, paletteSearch]);

  /* ---------- Nuevo marcador ---------- */
  const nmTrimmed = newMarker.value.trim();
  const nmDuplicate = nmTrimmed ? markers.find((x) => normalize(x.value) === normalize(nmTrimmed)) : null;
  const canCreateMarker = Boolean(nmTrimmed) && newMarker.valueType !== "" && !nmDuplicate && !newMarker.saving;

  const createMarker = async () => {
    if (!canCreateMarker) return;
    setNewMarker((s) => ({ ...s, saving: true, error: "" }));
    try {
      await markersService.create({ value: nmTrimmed, valueType: Number(newMarker.valueType) });
      const list = await loadMarkers();
      const created = list.find((x) => normalize(x.value) === normalize(nmTrimmed));
      if (created) insertMarker(created);
      toast.success("Marcador creado", `{ ${nmTrimmed} } se agregó a la plantilla y ya está disponible para otras.`);
      setNewMarker(EMPTY_NEW_MARKER);
    } catch (err) {
      setNewMarker((s) => ({
        ...s,
        saving: false,
        error: err.noAccess
          ? "No tienes permiso para crear marcadores."
          : err.response?.data?.message ?? "No se pudo crear el marcador.",
      }));
    }
  };

  /* ---------- Guardar ---------- */
  const handleSubmit = async (e) => {
    e.preventDefault();
    const found = {};
    if (items.length === 0) found.structure = "Agrega al menos un marcador a la plantilla.";
    if (!example.trim()) found.example = "Escribe el ejemplo de la frase resultante.";
    setErrors(found);
    if (Object.keys(found).length > 0) return;

    setSaving(true);
    setSubmitError("");
    const body = buildTemplateBody({ example, active, items });
    try {
      if (isEdit) await templatesService.update(template.id, body);
      else await templatesService.create(body);
      toast.success(isEdit ? "Plantilla actualizada" : "Plantilla creada", example.trim());
      onSaved();
    } catch (err) {
      setSubmitError(err.noAccess
        ? `No tienes permiso para ${isEdit ? "editar" : "crear"} plantillas.`
        : err.response?.data?.message ?? "No se pudo guardar la plantilla. Intenta de nuevo.");
    } finally {
      setSaving(false);
    }
  };

  const handleClose = () => { if (!saving) onClose(); };

  /* ---------- Render ---------- */
  return (
    <Modal
      open={open}
      size="lg"
      title={isEdit ? "Editar plantilla" : "Nueva plantilla"}
      onClose={handleClose}
      footer={
        <>
          <button type="button" className={`${styles.btn} ${styles.btnOutline}`} onClick={handleClose} disabled={saving}>
            Cancelar
          </button>
          <button type="submit" form={FORM_ID} className={`${styles.btn} ${styles.btnPrimary}`} disabled={saving}>
            {saving ? <Loader2 size={16} className={styles.spin} /> : <Check size={16} />}
            {saving ? "Guardando..." : isEdit ? "Guardar cambios" : "Guardar plantilla"}
          </button>
        </>
      }
    >
      <form id={FORM_ID} onSubmit={handleSubmit} noValidate className={t.form}>
        <p className={t.formIntro}>
          Construye la plantilla insertando marcadores. Los componentes no se escriben: se eligen de la lista.
        </p>

        {submitError && (
          <div className={`${styles.banner} ${styles.bannerError}`} role="alert" style={{ margin: 0 }}>
            <AlertCircle size={18} />
            <p>{submitError}</p>
          </div>
        )}

        {/* ---------- 1. Estructura ---------- */}
        <section className={t.block}>
          <div className={t.blockHead}>
            <span className={t.step}>1</span>
            <div>
              <h3 className={t.blockTitle}>Plantilla<span className={styles.required}>*</span></h3>
              <p className={t.blockSub}>Arrastra para reordenar · usa ← → o Supr con el teclado</p>
            </div>
            {items.length > 0 && (
              <button type="button" className={t.clearBtn} onClick={() => setItems([])}>Vaciar</button>
            )}
          </div>

          <ul
            className={`${t.builder} ${items.length ? t.builderFilled : ""} ${errors.structure ? t.builderInvalid : ""}`}
            aria-label="Estructura de la plantilla"
            onDragOver={(e) => e.preventDefault()}
          >
            {items.length === 0 ? (
              <li className={t.builderEmpty}>Elige marcadores de la lista de abajo para construir la plantilla</li>
            ) : (
              items.map((it, i) => (
                <li
                  key={it.uid}
                  ref={(el) => (el ? pieceRefs.current.set(it.uid, el) : pieceRefs.current.delete(it.uid))}
                  className={`${t.piece} ${toneClassOf(it.type)} ${dragUid === it.uid ? t.pieceDragging : ""}`}
                  tabIndex={0}
                  draggable
                  aria-label={`${it.value}, posición ${i + 1} de ${items.length}`}
                  onDragStart={(e) => {
                    setDragUid(it.uid);
                    e.dataTransfer.effectAllowed = "move";
                    e.dataTransfer.setData("text/plain", String(it.uid));
                  }}
                  onDragEnter={() => reorder(dragUid, it.uid)}
                  onDragOver={(e) => e.preventDefault()}
                  onDragEnd={() => setDragUid(null)}
                  onKeyDown={(e) => handlePieceKey(e, it.uid)}
                >
                  <GripVertical size={13} className={t.pieceGrip} aria-hidden="true" />
                  <span>{`{ ${it.value} }`}</span>
                  <button
                    type="button"
                    className={t.pieceRemove}
                    onClick={() => removePiece(it.uid)}
                    aria-label={`Quitar ${it.value}`}
                    tabIndex={-1}
                  >
                    <X size={12} strokeWidth={2.6} />
                  </button>
                </li>
              ))
            )}
          </ul>
          {errors.structure && <span className={styles.fieldError}>{errors.structure}</span>}

          {/* Paleta de marcadores */}
          <div className={t.palette}>
            <div className={t.paletteHead}>
              <span className={t.paletteLabel}>Agregar campo</span>
              {markers.length > 8 && (
                <div className={t.paletteSearch}>
                  <Search size={14} />
                  <input
                    className={styles.input}
                    placeholder="Buscar marcador..."
                    value={paletteSearch}
                    onChange={(e) => setPaletteSearch(e.target.value)}
                    aria-label="Buscar marcador"
                  />
                </div>
              )}
            </div>

            {markersError ? (
              <p className={t.paletteMsg}>
                {markersError}{" "}
                <button type="button" className={styles.linkBtn} style={{ padding: 0 }} onClick={loadMarkers}>Reintentar</button>
              </p>
            ) : markersLoading && markers.length === 0 ? (
              <p className={t.paletteMsg}><Loader2 size={14} className={styles.spin} /> Cargando marcadores...</p>
            ) : (
              <div className={t.paletteList}>
                {visibleMarkers.map((mk) => (
                  <button
                    key={mk.id}
                    type="button"
                    className={t.paletteItem}
                    onClick={() => insertMarker(mk)}
                    title={`Insertar {${mk.value}}${mk.type ? ` · ${mk.type.label}` : ""}`}
                  >
                    <span className={`${t.paletteDot} ${toneClassOf(mk.type)}`} aria-hidden="true" />
                    {`{ ${mk.value} }`}
                  </button>
                ))}
                {visibleMarkers.length === 0 && (
                  <p className={t.paletteMsg}>
                    {markers.length === 0 ? "Aún no hay marcadores. Crea el primero." : "Ningún marcador coincide."}
                  </p>
                )}
              </div>
            )}

            {/* Crear marcador sin salir del modal */}
            {newMarker.open ? (
              <div className={t.newMarker}>
                <div className={t.newMarkerGrid}>
                  <div className={styles.field}>
                    <label className={styles.label} htmlFor="nm-value">Nombre</label>
                    <input
                      id="nm-value"
                      className={`${styles.input} ${nmDuplicate ? styles.invalid : ""}`}
                      placeholder="Ej. Frecuencia"
                      value={newMarker.value}
                      maxLength={60}
                      autoFocus
                      autoComplete="off"
                      onChange={(e) => setNewMarker((s) => ({ ...s, value: e.target.value, error: "" }))}
                      onKeyDown={(e) => {
                        if (e.key === "Enter") { e.preventDefault(); createMarker(); }
                        if (e.key === "Escape") { e.stopPropagation(); setNewMarker(EMPTY_NEW_MARKER); }
                      }}
                    />
                  </div>
                  <div className={styles.field}>
                    <label className={styles.label} htmlFor="nm-type">Tipo de valor</label>
                    <select
                      id="nm-type"
                      className={styles.select}
                      value={newMarker.valueType}
                      onChange={(e) => setNewMarker((s) => ({ ...s, valueType: e.target.value, error: "" }))}
                    >
                      <option value="">— Selecciona —</option>
                      {MARKER_TYPES.map((mt) => <option key={mt.value} value={mt.value}>{mt.label}</option>)}
                    </select>
                  </div>
                  <div className={t.newMarkerActions}>
                    <button type="button" className={`${styles.btn} ${styles.btnPrimary}`} onClick={createMarker} disabled={!canCreateMarker}>
                      {newMarker.saving ? <Loader2 size={16} className={styles.spin} /> : <Check size={16} />}
                      Crear
                    </button>
                    <button type="button" className={styles.iconBtn} onClick={() => setNewMarker(EMPTY_NEW_MARKER)} aria-label="Cancelar">
                      <X size={16} />
                    </button>
                  </div>
                </div>
                {(nmDuplicate || newMarker.error) && (
                  <span className={styles.fieldError}>
                    {nmDuplicate ? `Ya existe { ${nmDuplicate.value} }. Elígelo de la lista.` : newMarker.error}
                  </span>
                )}
              </div>
            ) : (
              <button type="button" className={t.newMarkerBtn} onClick={() => setNewMarker({ ...EMPTY_NEW_MARKER, open: true })}>
                <Plus size={15} /> Crear nuevo marcador
              </button>
            )}
          </div>
        </section>

        {/* ---------- 2. Ejemplo ---------- */}
        <section className={t.block}>
          <div className={t.blockHead}>
            <span className={t.step}>2</span>
            <div>
              <h3 className={t.blockTitle}>
                <label htmlFor="tpl-example">Ejemplo</label><span className={styles.required}>*</span>
              </h3>
              <p className={t.blockSub}>Una frase completa del indicador resultante, siguiendo la plantilla</p>
            </div>
          </div>

          {items.length > 0 && (
            <div className={t.guide}>
              <span className={t.guideLabel}>Guía</span>
              <code className={t.guideText}>{structureText}</code>
              {!example.trim() && (
                <button type="button" className={t.guideBtn} onClick={() => setExample(structureText)}>
                  <WandSparkles size={14} /> Usar como base
                </button>
              )}
            </div>
          )}

          <textarea
            id="tpl-example"
            className={`${styles.input} ${t.textarea} ${errors.example ? styles.invalid : ""}`}
            rows={3}
            maxLength={500}
            placeholder="Ej. Aumentar las ventas de 10 a 15 para el 31 de diciembre de 2026"
            value={example}
            onChange={(e) => { setExample(e.target.value); setErrors((er) => ({ ...er, example: undefined })); }}
            aria-invalid={!!errors.example}
          />
          {errors.example && <span className={styles.fieldError}>{errors.example}</span>}
        </section>

        {/* ---------- 3. Estado ---------- */}
        <section className={`${t.block} ${t.blockRow}`}>
          <div className={t.blockHead}>
            <span className={t.step}>3</span>
            <div>
              <h3 className={t.blockTitle}>Estado</h3>
              <p className={t.blockSub}>
                {active ? "Disponible para usarse en otros módulos" : "No estará disponible en otros módulos"}
              </p>
            </div>
          </div>
          <button
            type="button"
            role="switch"
            aria-checked={active}
            className={`${t.switch} ${active ? t.switchOn : ""}`}
            onClick={() => setActive((v) => !v)}
          >
            <span className={t.switchTrack} aria-hidden="true" />
            {active ? "Activa" : "Inactiva"}
          </button>
        </section>
      </form>
    </Modal>
  );
};















import { useCallback, useEffect, useRef, useState } from "react";
import { AlertCircle, ChevronLeft, ChevronRight, LayoutTemplate, Pencil, Plus, Search, Trash2 } from "lucide-react";
import { ConfirmDialog, useToast } from "../../../../shared/components";
import { templatesService } from "../../../../api/templatesService";
import { toneClassOf } from "../markers/markerTypes";
import { TemplateFormModal } from "./TemplateFormModal";
import { TEMPLATE_STATUS, mapTemplate } from "./templateUtils";
import styles from "../../../Pages.module.css";
import t from "./Templates.module.css";

const PAGE_SIZES = [10, 20, 50];
const STATUS_FILTERS = [
  { value: "all", label: "Todas" },
  { value: TEMPLATE_STATUS.ACTIVE, label: "Activas" },
  { value: TEMPLATE_STATUS.INACTIVE, label: "Inactivas" },
];

// [1, "…", 4, 5, 6, "…", 12]
const pageList = (page, totalPages) => {
  if (totalPages <= 7) return Array.from({ length: totalPages }, (_, i) => i + 1);
  const set = new Set([1, totalPages, page - 1, page, page + 1]);
  const pages = [...set].filter((p) => p >= 1 && p <= totalPages).sort((a, b) => a - b);
  return pages.flatMap((p, i) => (i > 0 && p - pages[i - 1] > 1 ? ["…", p] : [p]));
};

const StructureChips = ({ markers }) => (
  <div className={t.chips}>
    {markers.map((x, i) => (
      <span key={`${x.markerId}-${i}`} className={`${t.chip} ${toneClassOf(x.type)}`} title={x.type?.label}>
        {`{ ${x.value} }`}
      </span>
    ))}
  </div>
);

export const PlantillasPage = () => {
  const toast = useToast();

  // Listado
  const [rows, setRows] = useState([]);
  const [total, setTotal] = useState(0);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const requestRef = useRef(0);

  // Filtros y paginación
  const [search, setSearch] = useState("");
  const [query, setQuery] = useState("");
  const [statusFilter, setStatusFilter] = useState("all");
  const [page, setPage] = useState(1);
  const [pageSize, setPageSize] = useState(PAGE_SIZES[0]);

  // Acciones
  const [modal, setModal] = useState({ open: false, template: null });
  const [toggling, setToggling] = useState(() => new Set());
  const [toDelete, setToDelete] = useState(null);
  const [deleting, setDeleting] = useState(false);
  const [deleteError, setDeleteError] = useState("");

  const hasFilters = Boolean(query) || statusFilter !== "all";
  const totalPages = Math.max(1, Math.ceil(total / pageSize));

  /* ---------- Carga ---------- */
  const load = useCallback(async () => {
    const id = ++requestRef.current;
    setLoading(true);
    setError("");
    try {
      const { items, total: count } = await templatesService.filter({
        example: query || null,
        status: statusFilter === "all" ? null : statusFilter,
        pageNumber: page,
        pageSize,
      });
      if (id !== requestRef.current) return; // llegó una respuesta más nueva
      setRows(items.map(mapTemplate));
      setTotal(count);
    } catch (err) {
      if (id !== requestRef.current) return;
      setError(err.noAccess
        ? "No tienes permiso para ver las plantillas."
        : "No se pudieron cargar las plantillas. Intenta de nuevo.");
    } finally {
      if (id === requestRef.current) setLoading(false);
    }
  }, [query, statusFilter, page, pageSize]);

  useEffect(() => { load(); }, [load]);

  // Búsqueda con espera de 350 ms
  useEffect(() => {
    const timer = setTimeout(() => {
      setQuery(search.trim());
      setPage(1);
    }, 350);
    return () => clearTimeout(timer);
  }, [search]);

  /* ---------- Estatus ---------- */
  const toggleStatus = async (row) => {
    setToggling((s) => new Set(s).add(row.id));
    try {
      if (row.active) await templatesService.deactivate(row.id);
      else await templatesService.activate(row.id);

      setRows((rs) => rs.map((r) => (r.id === row.id ? { ...r, active: !r.active } : r)));
      toast.success(
        row.active ? "Plantilla inactivada" : "Plantilla activada",
        row.active ? "Ya no estará disponible en otros módulos." : "Ya está disponible para usarse en otros módulos."
      );
      if (statusFilter !== "all") load(); // deja de cumplir el filtro
    } catch (err) {
      toast.error(
        "No se pudo cambiar el estatus",
        err.noAccess ? "No tienes permiso para esta acción." : err.response?.data?.message ?? "Intenta de nuevo."
      );
    } finally {
      setToggling((s) => { const n = new Set(s); n.delete(row.id); return n; });
    }
  };

  /* ---------- Eliminar ---------- */
  const openDelete = (row) => {
    setDeleteError("");
    setToDelete(row);
  };

  const confirmDelete = async () => {
    setDeleting(true);
    setDeleteError("");
    try {
      await templatesService.remove(toDelete.id);
      toast.success("Plantilla eliminada", toDelete.example);
      setToDelete(null);
      if (rows.length === 1 && page > 1) setPage((p) => p - 1);
      else load();
    } catch (err) {
      setDeleteError(err.noAccess
        ? "No tienes permiso para eliminar plantillas."
        : err.response?.data?.message ?? "No se pudo eliminar. Es posible que la plantilla esté en uso en otro módulo.");
    } finally {
      setDeleting(false);
    }
  };

  /* ---------- Modal ---------- */
  const handleSaved = () => {
    setModal({ open: false, template: null });
    load();
  };

  const from = total === 0 ? 0 : (page - 1) * pageSize + 1;
  const to = Math.min(page * pageSize, total);

  /* ---------- Render ---------- */
  return (
    <>
      <header className={styles.pageHeader}>
        <div>
          <span className={styles.eyebrow}>Plantillas</span>
          <h1 className={styles.title}>Mantenimiento de plantillas</h1>
          <p className={styles.subtitle}>Estructuras de indicadores construidas con marcadores.</p>
        </div>
        <div className={styles.actions}>
          <button type="button" className={`${styles.btn} ${styles.btnPrimary}`}
            onClick={() => setModal({ open: true, template: null })}>
            <Plus size={18} /> Nueva plantilla
          </button>
        </div>
      </header>

      {error && (
        <div className={`${styles.banner} ${styles.bannerError}`} role="alert">
          <AlertCircle size={18} />
          <p>
            {error}{" "}
            <button type="button" className={styles.linkBtn} style={{ padding: 0 }} onClick={load}>Reintentar</button>
          </p>
        </div>
      )}

      {/* ---------- Filtros ---------- */}
      <div className={t.toolbar}>
        <div className={t.search}>
          <Search size={16} />
          <input className={styles.input} placeholder="Buscar por ejemplo..." value={search}
            onChange={(e) => setSearch(e.target.value)} aria-label="Buscar plantilla por ejemplo" />
        </div>

        <div className={t.segmented} role="group" aria-label="Filtrar por estatus">
          {STATUS_FILTERS.map((f) => (
            <button key={f.value} type="button"
              className={`${t.segBtn} ${statusFilter === f.value ? t.segBtnOn : ""}`}
              aria-pressed={statusFilter === f.value}
              onClick={() => { setStatusFilter(f.value); setPage(1); }}>
              {f.label}
            </button>
          ))}
        </div>
      </div>

      {/* ---------- Tabla ---------- */}
      <div className={t.tableCard}>
        <table className={t.table}>
          <thead>
            <tr>
              <th className={t.colActions}>Acciones</th>
              <th>Plantilla</th>
              <th>Ejemplo</th>
              <th className={t.colStatus}>Estatus</th>
            </tr>
          </thead>
          <tbody>
            {loading && rows.length === 0 ? (
              Array.from({ length: 4 }, (_, i) => (
                <tr key={i} aria-hidden="true">
                  <td><span className={t.skel} style={{ width: 56 }} /></td>
                  <td><span className={t.skel} style={{ width: `${70 - i * 8}%` }} /></td>
                  <td><span className={t.skel} style={{ width: `${85 - i * 6}%` }} /></td>
                  <td><span className={t.skel} style={{ width: 80 }} /></td>
                </tr>
              ))
            ) : rows.length === 0 ? (
              <tr>
                <td colSpan={4} className={t.emptyCell}>
                  {!error && (
                    hasFilters ? (
                      <p className={t.emptyText}>Ninguna plantilla coincide con la búsqueda o el filtro.</p>
                    ) : (
                      <div className={t.empty}>
                        <span className={t.emptyIcon}><LayoutTemplate size={26} /></span>
                        <h3>Aún no hay plantillas</h3>
                        <p>Crea la primera combinando marcadores como {"{ Verbo } { Que } { ValorX }"}.</p>
                        <button type="button" className={`${styles.btn} ${styles.btnPrimary}`}
                          onClick={() => setModal({ open: true, template: null })}>
                          <Plus size={18} /> Nueva plantilla
                        </button>
                      </div>
                    )
                  )}
                </td>
              </tr>
            ) : (
              rows.map((row) => (
                <tr key={row.id} className={`${!row.active ? t.rowInactive : ""} ${loading ? t.rowLoading : ""}`}>
                  <td data-label="Acciones" className={t.cellActions}>
                    <div className={t.actionBtns}>
                      <button type="button" className={t.actBtn} title="Editar" aria-label={`Editar plantilla ${row.example}`}
                        onClick={() => setModal({ open: true, template: row })}>
                        <Pencil size={16} />
                      </button>
                      <button type="button" className={`${t.actBtn} ${t.actBtnDanger}`} title="Eliminar"
                        aria-label={`Eliminar plantilla ${row.example}`} onClick={() => openDelete(row)}>
                        <Trash2 size={16} />
                      </button>
                    </div>
                  </td>
                  <td data-label="Plantilla" className={t.cellStructure}>
                    <StructureChips markers={row.markers} />
                  </td>
                  <td data-label="Ejemplo" className={t.cellExample}>
                    <p className={t.example} title={row.example}>{row.example}</p>
                  </td>
                  <td data-label="Estatus" className={t.cellStatus}>
                    <button
                      type="button"
                      role="switch"
                      aria-checked={row.active}
                      aria-label={`Estatus de ${row.example}`}
                      className={`${t.switch} ${row.active ? t.switchOn : ""}`}
                      disabled={toggling.has(row.id)}
                      onClick={() => toggleStatus(row)}
                    >
                      <span className={t.switchTrack} aria-hidden="true" />
                      {row.active ? "Activa" : "Inactiva"}
                    </button>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>

        {/* ---------- Paginación ---------- */}
        {total > 0 && (
          <div className={t.footer}>
            <span>
              Mostrando <strong>{from}–{to}</strong> de <strong>{total}</strong>
            </span>

            <div className={t.footerRight}>
              <label className={t.pageSize}>
                Filas
                <select className={styles.select} value={pageSize}
                  onChange={(e) => { setPageSize(Number(e.target.value)); setPage(1); }}>
                  {PAGE_SIZES.map((s) => <option key={s} value={s}>{s}</option>)}
                </select>
              </label>

              <nav className={t.pager} aria-label="Paginación">
                <button type="button" className={t.pageBtn} disabled={page === 1}
                  onClick={() => setPage((p) => p - 1)} aria-label="Página anterior">
                  <ChevronLeft size={16} />
                </button>
                {pageList(page, totalPages).map((p, i) =>
                  p === "…" ? (
                    <span key={`gap-${i}`} className={t.pageGap}>…</span>
                  ) : (
                    <button key={p} type="button" className={`${t.pageBtn} ${p === page ? t.pageBtnOn : ""}`}
                      aria-current={p === page ? "page" : undefined} onClick={() => setPage(p)}>
                      {p}
                    </button>
                  )
                )}
                <button type="button" className={t.pageBtn} disabled={page >= totalPages}
                  onClick={() => setPage((p) => p + 1)} aria-label="Página siguiente">
                  <ChevronRight size={16} />
                </button>
              </nav>
            </div>
          </div>
        )}
      </div>

      <TemplateFormModal
        open={modal.open}
        template={modal.template}
        onClose={() => setModal({ open: false, template: null })}
        onSaved={handleSaved}
      />

      <ConfirmDialog
        open={Boolean(toDelete)}
        danger
        title="¿Eliminar plantilla?"
        message="Si la plantilla está en uso en otro módulo no se podrá eliminar. Esta acción no se puede deshacer."
        detail={toDelete && (
          <div className={t.deleteDetail}>
            <StructureChips markers={toDelete.markers} />
            <p>{toDelete.example}</p>
          </div>
        )}
        confirmText={deleting ? "Eliminando..." : "Sí, eliminar"}
        loading={deleting}
        error={deleteError}
        onConfirm={confirmDelete}
        onCancel={() => setToDelete(null)}
      />
    </>
  );
};

















