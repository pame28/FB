            {cert && (
                <>
                    <div className={ui.approveBox}>
                        <div className={ui.approveTitle}>Aprobación manual de certificación</div>
                        <p className={ui.approveText}>
                            Al aprobar confirmas que el proceso de certificación fue completado satisfactoriamente. La aprobación quedará registrada con tu sesión activa.
                        </p>
                        <div className={ui.approveMeta}>
                            <div>
                                <span className={ui.approveMetaLabel}>Equipo</span>
                                <span className={ui.approveMetaValue}>{cert.teamName}</span>
                            </div>
                            <div>
                                <span className={ui.approveMetaLabel}>Líder</span>
                                <span className={ui.approveMetaValue}>{cert.leaderName}</span>
                            </div>
                            <div>
                                <span className={ui.approveMetaLabel}>Fecha</span>
                                <span className={ui.approveMetaValue}>{new Date().toLocaleDateString("es-ES")}</span>
                            </div>
                        </div>
                    </div>
                    <div className={`${base.field} ${ui.approveField}`}>
                        <label className={base.label} htmlFor="cert-result">Resultado de la certificación *</label>
                        <select id="cert-result" className={base.select} value={result} onChange={(e) => setResult(e.target.value)}>
                            <option value="">— Selecciona el resultado —</option>
                            {RESULT_OPTIONS.map((o) => <option key={o.value} value={o.value}>{o.label}</option>)}
                        </select>
                    </div>
                </>
            )}
        </Modal>
    );
}





