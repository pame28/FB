        private DataTable applyFilterByMCC(DataSet theDataSet, string NoTarjet)
        {
            SQL sql = new SQL(this.strConexion);
            DataTable dtFiltered = new DataTable();
            DataTable dtTrxsFilteredByMCC = sql.sp_Select("usp_DTGetTransactionsToDIVBXI", new SqlParameter("@Equivalente", NoTarjet)).Tables[0];

            if (dtTrxsFilteredByMCC.Rows.Count > 0)
            {

                dtFiltered = (from prismaResult in theDataSet.Tables[3].AsEnumerable()
                              join redencionResult in dtTrxsFilteredByMCC.AsEnumerable()
                                on prismaResult["CUT"].ToString() equals redencionResult["NoCut"].ToString()
                              into filteredResult
                              from leftJoin in filteredResult.DefaultIfEmpty()
                              where filteredResult.Count() != 0
                              select prismaResult).CopyToDataTable();
            }

            return dtFiltered;
        }

