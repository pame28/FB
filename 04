;WITH x AS (
  SELECT value AS linea, ROW_NUMBER() OVER (ORDER BY (SELECT 1)) AS n
  FROM sys.sql_modules
  CROSS APPLY STRING_SPLIT(REPLACE(definition, CHAR(13), ''), CHAR(10))
  WHERE object_id = OBJECT_ID('dbo.usp_PostParseoNP')
)
SELECT n, linea FROM x WHERE n BETWEEN 288 AND 296;








SELECT COLUMN_NAME, DATA_TYPE, CHARACTER_MAXIMUM_LENGTH
FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_NAME = 'CuotasPendientes'
  AND COLUMN_NAME IN ('NumeroCuenta', 'NoCuentaClaro');









SELECT NumeroCuenta, LEN(NumeroCuenta) AS Largo, DATALENGTH(NumeroCuenta) AS Bytes
FROM CuotasPendientes
WHERE ProcesadorOrigen = 'LOCAL'
  AND LEN(NumeroCuenta) > 20;