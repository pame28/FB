import { apiFeedbackAuthorized } from "./APIS";
import { endpointsAPI } from "./endpointApi";

export const markersService = {
  list: async () => {
    const { data } = await apiFeedbackAuthorized.get(endpointsAPI.markers);
    const result = data.data;
    return Array.isArray(result) ? result : result?.items ?? [];
  },

  // body: { value, valueType }
  create: async (body) => {
    const { data } = await apiFeedbackAuthorized.post(endpointsAPI.markers, body);
    return data.data;
  },

  update: async (id, body) => {
    const { data } = await apiFeedbackAuthorized.put(`${endpointsAPI.markers}/${id}`, body);
    return data.data;
  },

  remove: async (id) => {
    await apiFeedbackAuthorized.delete(`${endpointsAPI.markers}/${id}`);
  },
};











import {
  Banknote, Calculator, CalendarDays, CaseSensitive, DollarSign,
  Euro, Hash, Percent, Sigma, ToggleRight, Type,
} from "lucide-react";

/**
 * Tipos de valor de un marcador.
 * value: número que se envía en "valueType".
 * ⚠️ Confirmar con backend el número de cada tipo (asumido: orden de la lista, desde 0).
 * tone: familia de color de la etiqueta.
 * aliases: por si la API devuelve el tipo como texto.
 */
export const MARKER_TYPES = [
  { value: 0, label: "Texto", icon: Type, tone: "text", aliases: ["text"] },
  { value: 1, label: "Numérico", icon: Sigma, tone: "number", aliases: ["numeric", "number"] },
  { value: 2, label: "Alfanumérico", icon: CaseSensitive, tone: "text", aliases: ["alphanumeric"] },
  { value: 3, label: "Porcentaje (%)", icon: Percent, tone: "money", aliases: ["percentage", "percent"] },
  { value: 4, label: "Dólar ($)", icon: DollarSign, tone: "money", aliases: ["dollar", "usd"] },
  { value: 5, label: "Euro (€)", icon: Euro, tone: "money", aliases: ["euro", "eur"] },
  { value: 6, label: "Lempira (L)", icon: Banknote, tone: "money", aliases: ["lempira", "hnl"] },
  { value: 7, label: "Fecha", icon: CalendarDays, tone: "date", aliases: ["date"] },
  { value: 8, label: "Sí / No", icon: ToggleRight, tone: "bool", aliases: ["boolean", "bool", "yesno"] },
  { value: 9, label: "Número entero", icon: Hash, tone: "number", aliases: ["integer", "int"] },
  { value: 10, label: "Número decimal", icon: Calculator, tone: "number", aliases: ["decimal"] },
];

// "Sí / No" → "sino", "Porcentaje (%)" → "porcentaje"
const toKey = (text) =>
  String(text ?? "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().replace(/[^a-z0-9]/g, "");

/** Encuentra el tipo a partir de lo que mande la API (número o texto). */
export const findMarkerType = (raw) => {
  if (raw === null || raw === undefined || raw === "") return null;
  if (typeof raw === "number" || /^\d+$/.test(String(raw))) {
    return MARKER_TYPES.find((t) => t.value === Number(raw)) ?? null;
  }
  const key = toKey(raw);
  return MARKER_TYPES.find((t) => toKey(t.label).startsWith(key) || t.aliases.includes(key)) ?? null;
};
















