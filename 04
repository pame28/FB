// Crea un servicio CRUD para cualquier catálogo con la forma estándar /api/xxx y /api/xxx/{id}
const createCatalogService = (endpoint) => ({
  list: async () => {
    const { data } = await apiFeedbackAuthorized.get(endpoint);
    const result = data.data;
    return Array.isArray(result) ? result : result?.items ?? [];
  },

  create: async (body) => {
    const { data } = await apiFeedbackAuthorized.post(endpoint, body);
    return data.data;
  },

  update: async (id, body) => {
    const { data } = await apiFeedbackAuthorized.put(`${endpoint}/${id}`, { id, ...body });
    return data.data;
  },

  remove: async (id) => {
    await apiFeedbackAuthorized.delete(`${endpoint}/${id}`);
  },
});

