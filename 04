SELECT CUO.CodigoTransaccion,
       CUO.NumeroTarjeta AS TarjetaActual,
       MIG.NumeroTarjeta AS TarjetaNueva
FROM CuotasPendientes CUO
INNER JOIN CuotasPendientes_mig MIG
        ON CUO.CodigoTransaccion = MIG.CodigoCore
WHERE (CUO.NumeroTarjeta IS NULL OR LTRIM(RTRIM(CUO.NumeroTarjeta)) = '')
  AND MIG.NumeroTarjeta IS NOT NULL
  AND LTRIM(RTRIM(MIG.NumeroTarjeta)) <> '';







BEGIN TRAN;

UPDATE CUO
SET    CUO.NumeroTarjeta = MIG.NumeroTarjeta
FROM   CuotasPendientes CUO
INNER JOIN CuotasPendientes_mig MIG
        ON CUO.CodigoTransaccion = MIG.CodigoCore
WHERE (CUO.NumeroTarjeta IS NULL OR LTRIM(RTRIM(CUO.NumeroTarjeta)) = '')
  AND MIG.NumeroTarjeta IS NOT NULL
  AND LTRIM(RTRIM(MIG.NumeroTarjeta)) <> '';

SELECT @@ROWCOUNT AS FilasActualizadas;

