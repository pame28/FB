ALTER PROCEDURE [dbo].[sp_RegistraProceso]
  @Proceso NVARCHAR(100),
  @EstadoProceso NVARCHAR(5),
  @Mensaje NVARCHAR(500)
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @Hoy VARCHAR(10);
    DECLARE @ModoReproceso BIT = 0;

    IF EXISTS (SELECT 1 FROM ParametrosDescargaTablas
               WHERE Proceso = 'General' AND IdParametro = 'ModoReproceso'
                 AND ValorParametro = 'true')
        SET @ModoReproceso = 1;

    -- Fecha con la que se registra
    IF @ModoReproceso = 1
    BEGIN
        -- En reproceso: la fecha que se coloco manualmente en General.FechaProceso
        SELECT @Hoy = CONVERT(VARCHAR(10), TRY_CONVERT(DATE, LTRIM(RTRIM(ValorParametro)), 23), 23)
        FROM ParametrosDescargaTablas
        WHERE Proceso = 'General' AND IdParametro = 'FechaProceso';

        IF @Hoy IS NULL
            SET @Hoy = CONVERT(VARCHAR(10), GETDATE() - 1, 23);

        SET @Mensaje = LEFT(N'[REPROCESO] ' + @Mensaje, 500);
    END
    ELSE
        SET @Hoy = CONVERT(VARCHAR(10), GETDATE() - 1, 23); -- YYYY-MM-DD

    -- Registro de ejecucion:
    --   no existe       -> se inserta (normalmente el "Proceso Iniciado")
    --   existe + E o F  -> se actualiza con el resultado final
    --   existe + I      -> se ignora (mensajes informativos)
    IF NOT EXISTS (SELECT 1 FROM ParametrosEjecucionDescarga
                   WHERE Proceso = @Proceso AND FechaProceso = @Hoy)
    BEGIN
        INSERT INTO ParametrosEjecucionDescarga (Proceso, FechaProceso, EstadoProceso, Mensaje)
        VALUES (@Proceso, @Hoy, @EstadoProceso, @Mensaje);
    END
    ELSE IF @EstadoProceso IN ('E', 'F')
    BEGIN
        UPDATE ParametrosEjecucionDescarga
        SET EstadoProceso = @EstadoProceso,
            Mensaje       = @Mensaje
        WHERE Proceso = @Proceso AND FechaProceso = @Hoy;
    END

    -- En reproceso NO se toca General.FechaProceso
    IF @ModoReproceso = 1
        RETURN;

    -- Ejecucion normal: actualiza la fecha general (igual que antes)
    IF NOT EXISTS (SELECT 1 FROM ParametrosDescargaTablas
                   WHERE Proceso = 'General' AND IdParametro = 'FechaProceso'
                     AND ValorParametro = @Hoy)
    BEGIN
        UPDATE ParametrosDescargaTablas
        SET ValorParametro = @Hoy
        WHERE Proceso = 'General' AND IdParametro = 'FechaProceso';
    END
END
GO