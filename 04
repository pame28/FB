        private static async Task<IResult> CreateIndicatorAssignments(
            CreateIndicatorAssignmentsRequestDto request,
            IValidator<CreateIndicatorAssignmentsRequestDto> validator,
            ICoachingRepository repository,
            ClaimsPrincipal claimsPrincipal,
            ILoggerFactory loggerFactory)
        {
            var logger = loggerFactory.CreateLogger(typeof(CoachingEndpoints));
            var currentUserId = GetCurrentUserId(claimsPrincipal);

            try
            {
                if (string.IsNullOrWhiteSpace(currentUserId))
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = StatusCodes.Status401Unauthorized,
                        Message = GenericErrors.UnauthorizedUserMessage
                    }, statusCode: StatusCodes.Status401Unauthorized);
                }

                var validationResult = await validator.ValidateAsync(request);
                if (!validationResult.IsValid)
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = StatusCodes.Status400BadRequest,
                        Message = GenericErrors.RequestValidationErrorMessage,
                        Errors = validationResult.Errors
                            .ToDictionary(x => x.PropertyName, x => x.ErrorMessage)
                    }, statusCode: StatusCodes.Status400BadRequest);
                }

                var assignments = request.Teams
                    .SelectMany(team => team.Members.SelectMany(member =>
                    {
                        var session = new CoachingSession
                        {
                            TeamId = team.TeamId,
                            MemberUserId = member.MemberUserId,
                            CreatedAt = DateTime.Now,
                            CreatedBy = currentUserId
                        };

                        return member.Indicators.Select(indicator => new TeamMemberIndicatorAssignment
                        {
                            Session = session,
                            Weight = indicator.Weight,
                            TeamId = team.TeamId,
                            MemberUserId = member.MemberUserId,
                            IndicatorId = indicator.IndicatorId,
                            TargetValue = indicator.TargetValue,
                            TargetUnitId = indicator.TargetUnitId,
                            ValidFrom = indicator.ValidFrom,
                            ValidTo = indicator.ValidTo,
                            CreatedAt = DateTime.Now,
                            CreatedBy = currentUserId
                        });
                    }))
                    .ToList();

                var result = await repository.CreateIndicatorAssignmentsAsync(assignments);

                if (!result.Success)
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = StatusCodes.Status400BadRequest,
                        Message = result.ErrorMessage!
                    }, statusCode: StatusCodes.Status400BadRequest);
                }

                return Results.Created("/api/coaching/assignments", new ResponseObject<List<long>>
                {
                    Code = StatusCodes.Status201Created,
                    Message = "Asignaciones creadas correctamente.",
                    Data = [.. result.Assignments.Select(x => x.Id)]
                });
            }
            catch (Exception ex)
            {
                logger.LogError(ex, "CreateIndicatorAssignmentsError");

                return Results.Json(new ResponseObjectError
                {
                    Code = StatusCodes.Status500InternalServerError,
                    Message = GenericErrors.InternalServerError
                }, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        private static async Task<IResult> SaveCoachingResults(
            long sessionId,
            SaveCoachingResultsRequestDto request,
            IValidator<SaveCoachingResultsRequestDto> validator,
            ICoachingRepository repository,
            ClaimsPrincipal claimsPrincipal,
            ILoggerFactory loggerFactory)
        {
            var logger = loggerFactory.CreateLogger(typeof(CoachingEndpoints));
            var currentUserId = GetCurrentUserId(claimsPrincipal);

            try
            {
                if (string.IsNullOrWhiteSpace(currentUserId))
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = StatusCodes.Status401Unauthorized,
                        Message = GenericErrors.UnauthorizedUserMessage
                    }, statusCode: StatusCodes.Status401Unauthorized);
                }

                if (sessionId <= 0)
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = StatusCodes.Status400BadRequest,
                        Message = "El identificador de la sesión debe ser mayor que cero."
                    }, statusCode: StatusCodes.Status400BadRequest);
                }

                var validationResult = await validator.ValidateAsync(request);
                if (!validationResult.IsValid)
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = StatusCodes.Status400BadRequest,
                        Message = GenericErrors.RequestValidationErrorMessage,
                        Errors = validationResult.Errors
                            .GroupBy(error => error.PropertyName)
                            .ToDictionary(group => group.Key,
                                group => string.Join(" ", group.Select(error => error.ErrorMessage).Distinct()))
                    }, statusCode: StatusCodes.Status400BadRequest);
                }

                var result = await repository.SaveCoachingResultsAsync(sessionId, request, currentUserId);
                if (result.Status != SaveCoachingResultsStatus.Saved)
                {
                    var statusCode = result.Status switch
                    {
                        SaveCoachingResultsStatus.NotFound => StatusCodes.Status404NotFound,
                        SaveCoachingResultsStatus.AlreadyEvaluated => StatusCodes.Status409Conflict,
                        _ => StatusCodes.Status400BadRequest
                    };

                    return Results.Json(new ResponseObjectError
                    {
                        Code = statusCode,
                        Message = result.ErrorMessage!,
                        Errors = result.Errors
                    }, statusCode: statusCode);
                }

                return Results.Created($"/api/coaching/sessions/{sessionId}/results", new ResponseObject<CoachingResultsDto>
                {
                    Code = StatusCodes.Status201Created,
                    Message = "Resultados del coaching y plan de acción guardados correctamente.",
                    Data = result.Data
                });
            }
            catch (Exception exception)
            {
                logger.LogError(exception, "SaveCoachingResultsError");

                return Results.Json(new ResponseObjectError
                {
                    Code = StatusCodes.Status500InternalServerError,
                    Message = GenericErrors.InternalServerError
                }, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        private static async Task<IResult> CalculateCoachingAchievement(
            CalculateCoachingAchievementRequestDto request,
            IValidator<CalculateCoachingAchievementRequestDto> validator,
            ClaimsPrincipal claimsPrincipal,
            ILoggerFactory loggerFactory)
        {
            var logger = loggerFactory.CreateLogger(typeof(CoachingEndpoints));

            try
            {
                if (string.IsNullOrWhiteSpace(GetCurrentUserId(claimsPrincipal)))
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = StatusCodes.Status401Unauthorized,
                        Message = GenericErrors.UnauthorizedUserMessage
                    }, statusCode: StatusCodes.Status401Unauthorized);
                }

                var validationResult = await validator.ValidateAsync(request);
                if (!validationResult.IsValid)
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = StatusCodes.Status400BadRequest,
                        Message = GenericErrors.RequestValidationErrorMessage,
                        Errors = validationResult.Errors
                            .GroupBy(error => error.PropertyName)
                            .ToDictionary(group => group.Key,
                                group => string.Join(" ", group.Select(error => error.ErrorMessage).Distinct()))
                    }, statusCode: StatusCodes.Status400BadRequest);
                }

                if (!CoachingAchievementCalculator.TryCalculate(
                    request.AchievedValue!.Value,
                    request.TargetValue!.Value,
                    request.MinimumValue,
                    request.MaximumValue,
                    request.Rule,
                    request.Formula,
                    out var percentage,
                    out var errorMessage))
                {
                    return Results.Json(new ResponseObjectError
                    {
                        Code = StatusCodes.Status400BadRequest,
                        Message = errorMessage!
                    }, statusCode: StatusCodes.Status400BadRequest);
                }

                return Results.Ok(new ResponseObject<CoachingAchievementDto>
                {
                    Code = StatusCodes.Status200OK,
                    Message = "Porcentaje alcanzado calculado correctamente.",
                    Data = new CoachingAchievementDto { AchievementPercentage = percentage }
                });
            }
            catch (Exception exception)
            {
                logger.LogError(exception, "CalculateCoachingAchievementError");

                return Results.Json(new ResponseObjectError
                {
                    Code = StatusCodes.Status500InternalServerError,
                    Message = GenericErrors.InternalServerError
                }, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

