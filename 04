        opeEmpresa, OpeProductoByte, opeStatusByte, opeFrecPagInt, opeSector, opeOficial, opeInCong, opeGenDiv, opeRegion, opeRefinByte, opeVecesRefin,
        opeFecUltPagCapital, opeCAT, opeMontoCuotaPagar, opeTasaInteresMoratoria, opeSaldoTotal
