import { Link } from "react-router-dom";
import { ArrowLeft } from "lucide-react";
import { NavCard, CardGrid } from "../";
import styles from "./Pages.module.css";

export const ModulePage = ({ module }) => {
  const Icon = module.icon;

  return (
    <>
      <Link to="/home" className={styles.back}>
        <ArrowLeft size={16} /> Volver al inicio
      </Link>

      <header className={styles.header}>
        <div className={styles.headerIcon}>
          <Icon size={26} />
        </div>
        <div>
          <span className={styles.eyebrow}>Módulo</span>
          <h1 className={styles.title}>{module.label}</h1>
          <p className={styles.subtitle}>{module.description}</p>
        </div>
      </header>

      {module.pages.length > 0 ? (
        <CardGrid>
          {module.pages.map((p) => (
            <NavCard
              key={p.key}
              to={p.fullPath}
              icon={p.icon}
              title={p.label}
              description={p.description}
              meta="Abrir"
            />
          ))}
        </CardGrid>
      ) : (
        <div className={styles.empty}>Este módulo estará disponible próximamente.</div>
      )}
    </>
  );
};


