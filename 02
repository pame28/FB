import { useState } from "react";
import { useNavigate } from "react-router-dom";
import { useForm } from "../../hooks/useForm";
import { useAuthStore } from "../../hooks/useAuthStore";
import "./LoginPage.css";

const initialForm = { usuario: "", contraseña: "" };

// Convierte cualquier error en un mensaje entendible para el usuario
const getErrorMessage = (error) => {
    const data = error.response?.data;
    if (data?.message) {
        return data.errors?.mensaje ? `${data.message}: ${data.errors.mensaje}` : data.message;
    }
    if (error.response?.status === 401) return "Usuario o contraseña incorrectos.";
    if (error.code === "ERR_NETWORK") return "No se pudo conectar con el servidor. Verifica tu conexión.";
    return "Ocurrió un error inesperado. Intenta de nuevo.";
};

export const LoginPage = () => {
    const { usuario, contraseña, onInputChange, isValid } = useForm(initialForm);
    const [loading, setLoading] = useState(false);
    const [messageError, setMessageError] = useState("");

    const { startLogin } = useAuthStore();
    const navigate = useNavigate();

    const handleSubmit = async (e) => {
        e.preventDefault();
        if (!isValid || loading) return;

        setLoading(true);
        setMessageError("");

        try {
            await startLogin(usuario, contraseña);
            navigate("/home", { replace: true });
        } catch (error) {
            setMessageError(getErrorMessage(error));
        } finally {
            setLoading(false);
        }
    };


