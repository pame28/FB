import forge from "node-forge";

// Convierte un valor base64 del appsettings (.NET byte[]) a número grande para forge
const base64ToBigInt = (b64) =>
  new forge.jsbn.BigInteger(forge.util.bytesToHex(forge.util.decode64(b64)), 16);

// Encripta con la llave pública (RSA-OAEP + SHA-1), igual que RsaDecryptorService en la API
export const encryptPassword = (password) => {
  const publicKey = forge.pki.setRsaPublicKey(
    base64ToBigInt(config.rsaModulus),
    base64ToBigInt(config.rsaExponent)
  );
  const encrypted = publicKey.encrypt(forge.util.encodeUtf8(password), "RSA-OAEP", {
    md: forge.md.sha1.create(),
  });
  return forge.util.encode64(encrypted);
};










import { createSlice } from "@reduxjs/toolkit";

export const SESSION_KEY = "ecoaching.session";

// Al cargar la app, recupera la sesión guardada si no ha vencido
const loadSession = () => {
  try {
    const session = JSON.parse(localStorage.getItem(SESSION_KEY));
    if (session?.user && new Date(session.expiresAt) > new Date()) {
      return { status: "authenticated", user: session.user, expiresAt: session.expiresAt };
    }
  } catch {
    /* sesión dañada o sin acceso a storage */
  }
  return { status: "not-authenticated", user: null, expiresAt: null };
};

export const authSlice = createSlice({
  name: "auth",
  initialState: loadSession(),
  reducers: {
    onLogin: (state, { payload }) => {
      state.status = "authenticated";
      state.user = payload.user;
      state.expiresAt = payload.expiresAt;
    },
    onLogout: (state) => {
      state.status = "not-authenticated";
      state.user = null;
      state.expiresAt = null;
    },
  },
});

export const { onLogin, onLogout } = authSlice.actions;










