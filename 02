import { useEffect, useState } from "react";
import { apiFeedbackAuthorized } from "../api/APIS";
import { endpointsAPI } from "../api/endpointApi";

// ⚠️ TEMPORAL: mientras backend crea el endpoint de áreas.
// Copia aquí los Id y nombres de la tabla CompanyAreas.
const AREAS_TEMPORALES = [
  { value: 1, label: "HN - Agencias", description: "" },
];

const fetchList = async (endpoint, mapItem) => {
  try {
    const { data } = await apiFeedbackAuthorized.get(endpoint);
    return (data.data ?? []).map(mapItem);
  } catch {
    return [];
  }
};

export const useCatalogs = () => {
  const [catalogs, setCatalogs] = useState({ roles: [], areas: AREAS_TEMPORALES, positions: [] });

  useEffect(() => {
    let cancelled = false;

    fetchList(endpointsAPI.roles, (r) => ({
      value: r.id,
      label: r.roleName ?? r.name,
      description: r.roleDescription ?? r.description,
    })).then((roles) => {
      if (!cancelled) setCatalogs((c) => ({ ...c, roles }));
    });

    // Cuando existan los endpoints, se cargan aquí igual que roles:
    // fetchList(endpointsAPI.companyAreas, ...)  → areas
    // fetchList(endpointsAPI.companyPositions, ...) → positions

    return () => { cancelled = true; };
  }, []);

  return catalogs;
};









import { useDispatch, useSelector } from "react-redux";
import { apiFeedback } from "../api/APIS";
import { endpointsAPI } from "../api/endpointApi";
import { encryptPassword } from "../helpers/encryptPassword";
import { onLogin, onLogout, SESSION_KEY } from "../store/auth/authSlice";
import { useIDBStore } from "./useIDBStore";

export const useAuthStore = () => {
  const dispatch = useDispatch();
  const { status, user, expiresAt } = useSelector((state) => state.auth);
  const { crearIDB, addData, readData } = useIDBStore();

  // Guarda lo que devuelven login y refresh (tienen la misma forma)
  const saveSession = async ({ token, expiresIn, user }) => {
    await crearIDB("Authentication");
    await addData(token, "Authentication", "token");

    const expiresAt = new Date(Date.now() + expiresIn * 60_000).toISOString(); // expiresIn en minutos
    localStorage.setItem(SESSION_KEY, JSON.stringify({ user, expiresAt }));
    dispatch(onLogin({ user, expiresAt }));
  };

  const startLogin = async (userName, password) => {
    const { data } = await apiFeedback.post(endpointsAPI.login, {
      userName: userName.trim(),
      Password: encryptPassword(password),
    });
    await saveSession(data.data);
  };

  // Renueva el token. Si falla, lanza el error para que quien lo llame cierre la sesión.
  const refreshSession = async () => {
    const token = await readData("Authentication", "token");
    if (!token) throw new Error("No hay token para renovar");

    const { data } = await apiFeedback.post(endpointsAPI.refreshToken, { token });
    await saveSession(data.data);
  };

  const logout = async () => {
    try {
      await addData("", "Authentication", "token");
    } catch {
      /* si la BD indexada no existe, no hay token que borrar */
    }
    localStorage.removeItem(SESSION_KEY);
    dispatch(onLogout());
  };

  return {
    status,
    user,
    role: user?.role ?? null,
    expiresAt,
    startLogin,
    refreshSession,
    logout,
  };
};














  // Registra la última vez que el usuario interactuó con la página
  const lastActivity = useRef(Date.now());
  useEffect(() => {
    const markActivity = () => { lastActivity.current = Date.now(); };
    const events = ["pointerdown", "keydown", "scroll", "touchstart"];
    events.forEach((ev) => window.addEventListener(ev, markActivity, { passive: true }));
    return () => events.forEach((ev) => window.removeEventListener(ev, markActivity));
  }, []);

  // Renueva el token antes de que venza; si el usuario está inactivo o falla, cierra la sesión
  useEffect(() => {
    if (!expiresAt) return;
    const msUntilRefresh = new Date(expiresAt).getTime() - Date.now() - REFRESH_BEFORE_MS;

    const timer = setTimeout(async () => {
      if (Date.now() - lastActivity.current > MAX_IDLE_MS) {
        logout();
        return;
      }
      try {
        await refreshSession();
      } catch {
        logout();
      }
    }, Math.max(msUntilRefresh, 0));

    return () => clearTimeout(timer);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [expiresAt]);










import axios from "axios";
import { useIDBStore } from "../hooks/useIDBStore";
import { store } from "../store/store";
import { onLogout, SESSION_KEY } from "../store/auth/authSlice";

const { readData } = useIDBStore();

// En desarrollo usa el proxy de Vite (evita CORS); en producción la URL de config.js
const baseURL = import.meta.env.DEV ? "/" : atob(config.apiUrl);

// Peticiones sin token (login, refresh)
export const apiFeedback = axios.create({ baseURL });

// Peticiones con token
export const apiFeedbackAuthorized = axios.create({ baseURL });

// Agrega "Authorization: Bearer <token>" a cada petición
apiFeedbackAuthorized.interceptors.request.use(async (request) => {
  const token = await readData("Authentication", "token");
  if (token) request.headers.Authorization = `Bearer ${token}`;
  return request;
});

// Si el token ya no es válido, cierra la sesión
apiFeedbackAuthorized.interceptors.response.use(
  (response) => response,
  (error) => {
    if (error.response?.status === 401) {
      localStorage.removeItem(SESSION_KEY);
      store.dispatch(onLogout());
    }
    return Promise.reject(error);
  }
);











