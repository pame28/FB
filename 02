import { useState } from "react";
import { useNavigate } from "react-router-dom";
import forge from "node-forge";
import { apiFeedback } from "../../api/APIS";
import { endpointsAPI } from "../../api/endpointApi";
import { useForm } from "../../hooks/useForm";
import { useAuthStore } from "../../hooks/useAuthStore";
import { useIDBStore } from "../../hooks/useIDBStore";
import "./LoginPage.css";

const initialForm = { usuario: "", contraseña: "" };


const base64ToBigInt = (b64) =>
    new forge.jsbn.BigInteger(forge.util.bytesToHex(forge.util.decode64(b64)), 16);

// Encripta con la llave pública (RSA-OAEP + SHA-1)
const encryptPassword = (password) => {
    const publicKey = forge.pki.setRsaPublicKey(
        base64ToBigInt(config.rsaModulus),
        base64ToBigInt(config.rsaExponent)
    );
    const encrypted = publicKey.encrypt(forge.util.encodeUtf8(password), "RSA-OAEP", {
        md: forge.md.sha1.create(),
    });
    return forge.util.encode64(encrypted);
};

// Convierte cualquier error en un mensaje entendible para el usuario
const getErrorMessage = (error) => {
    const data = error.response?.data;
    if (data?.message) {
        return data.errors?.mensaje ? `${data.message}: ${data.errors.mensaje}` : data.message;
    }
    if (error.response?.status === 401) return "Usuario o contraseña incorrectos.";
    if (error.code === "ERR_NETWORK") return "No se pudo conectar con el servidor. Verifica tu conexión.";
    return "Ocurrió un error inesperado. Intenta de nuevo.";
};

export const LoginPage = () => {
    const { usuario, contraseña, onInputChange, isValid } = useForm(initialForm);
    const [loading, setLoading] = useState(false);
    const [messageError, setMessageError] = useState("");

    const { login } = useAuthStore();
    const { crearIDB, addData } = useIDBStore();
    const navigate = useNavigate();

    const handleSubmit = async (e) => {
        e.preventDefault();
        if (!isValid || loading) return;

        setLoading(true);
        setMessageError("");

        try {
            const body = {
                userName: usuario.trim(),
                Password: encryptPassword(contraseña),
               //Password: "QErVrc8P/a/wFWQnJhA5+lYkKgk6r6SprxbPtHABas+UkfyLiIIzJht7yBoHCTXXMo1wjt6jTVHTh/qT9flOF7MNQ1p2yaUcHP8EzmLj1r3sFuo5q56QnDytSFjQkyz/XJrUOyZ0IQ+sl9Fez7fe0ASkRMVcDTLmYgBPJaf93UI="
            };

            const { data: response } = await apiFeedback.post(endpointsAPI.login, body);
            const { token, expiresIn, user } = response.data;

            // Token en la base de datos indexada (lo usa apiFeedbackAuthorized)
            await crearIDB("Authentication");
            await addData(token, "Authentication", "token");

            // expiresIn viene en minutos
            const dateLimit = new Date(Date.now() + expiresIn * 60_000);
            localStorage.setItem("dateLimit", dateLimit.toISOString());
            localStorage.setItem("user", JSON.stringify(user));

            login(user);
            navigate("/home", { replace: true });
        } catch (error) {
            localStorage.setItem("status", "not-authenticated");
            setMessageError(getErrorMessage(error));
        } finally {
            setLoading(false);
        }
    };

    return (
        <div className="login-page">
            <div className="login-left">
                <div className="brand">
                    <img className="logo" src="/assets/images/logo_BP_V.png" alt="Banpaís" />
                    <hr className="hr-yellow" />
                    <h1>eCoaching</h1>
                </div>
            </div>

            <div className="login-right">
                <form className="login-card" onSubmit={handleSubmit} noValidate>
                    <div className="title">Bienvenido</div>
                    <div className="help">Ingresa tus credenciales para acceder al sistema eCoaching</div>

                    {messageError && (
                        <div className="div-error" role="alert">
                            <span className="label-error">{messageError}</span>
                        </div>
                    )}

                    <label className="login-label" htmlFor="usuario">USUARIO</label>
                    <div className="login-field">
                        <img src="/assets/images/user.png" alt="" />
                        <input
                            id="usuario"
                            type="text"
                            name="usuario"
                            autoComplete="off"
                            placeholder="Usuario de red"
                            value={usuario}
                            onChange={onInputChange}
                            disabled={loading}
                        />
                    </div>

                    <label className="login-label" htmlFor="contrasena">CONTRASEÑA</label>
                    <div className="login-field">
                        <img src="/assets/images/password.png" alt="" />
                        <input
                            id="contrasena"
                            type="password"
                            name="contraseña"
                            autoComplete="off"
                            placeholder="Contraseña de red"
                            value={contraseña}
                            onChange={onInputChange}
                            disabled={loading}
                        />
                    </div>

                    {loading && <img src="/assets/images/loading.gif" className="loading" alt="Cargando" />}

                    <button
                        type="submit"
                        className={isValid && !loading ? "login-btn" : "login-btn disabled"}
                        disabled={!isValid || loading}
                    >
                        {loading ? "Validando..." : "Iniciar sesión"}
                    </button>
                </form>
            </div>
        </div>
    );
};
