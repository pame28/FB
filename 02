import { useState } from "react";
import { Link, NavLink, useLocation } from "react-router-dom";
import { ArrowLeft, ChevronDown, ChevronLeft, Home, LayoutGrid, LogOut } from "lucide-react";
import styles from "./Sidebar.module.css";

const cx = (...classes) => classes.filter(Boolean).join(" ");
const linkClass = ({ isActive }) => cx(styles.link, isActive && styles.active);

export function Sidebar({
  modules = [],
  collapsed = false,
  open = false,
  onClose,
  onLogout,
  onToggleCollapse,
}) {
  const { pathname } = useLocation();
  const currentModule = modules.find(
    (m) => pathname === m.path || pathname.startsWith(`${m.path}/`)
  );

  return (
    <>
      {open && <div className={styles.overlay} onClick={onClose} aria-hidden="true" />}

      <aside
        className={cx(styles.sidebar, collapsed && styles.collapsed, open && styles.open)}
        aria-label="Navegación principal"
      >
        {onToggleCollapse && (
          <button
            type="button"
            className={styles.edgeToggle}
            onClick={onToggleCollapse}
            aria-label={collapsed ? "Expandir menú" : "Contraer menú"}
            title={collapsed ? "Expandir menú" : "Contraer menú"}
          >
            <ChevronLeft size={14} strokeWidth={2.5} />
          </button>
        )}

        <nav className={styles.nav}>
          {currentModule ? (
            <ModuleMenu module={currentModule} collapsed={collapsed} />
          ) : (
            <HomeMenu modules={modules} collapsed={collapsed} />
          )}
        </nav>

        <div className={styles.footer}>
          <button
            type="button"
            className={styles.link}
            onClick={onLogout}
            title={collapsed ? "Cerrar sesión" : undefined}
          >
            <LogOut size={18} strokeWidth={2.1} />
            <span className={styles.text}>Cerrar sesión</span>
          </button>
        </div>
      </aside>
    </>
  );
}

/* ------------------------------------------------------------
   Menú del Home: todos los módulos con submenús
   ------------------------------------------------------------ */
function HomeMenu({ modules, collapsed }) {
  const [openKeys, setOpenKeys] = useState([]);

  const toggle = (key) =>
    setOpenKeys((keys) => (keys.includes(key) ? keys.filter((k) => k !== key) : [...keys, key]));

  return (
    <>
      <span className={styles.label}>General</span>
      <NavLink to="/home" end className={linkClass} title={collapsed ? "Inicio" : undefined}>
        <Home size={18} strokeWidth={2.1} />
        <span className={styles.text}>Inicio</span>
      </NavLink>

      <span className={styles.label}>Módulos</span>

      {modules.map((m) => {
        const Icon = m.icon;
        const hasPages = m.pages.length > 0;
        const expanded = hasPages && !collapsed && openKeys.includes(m.key);

        if (!hasPages) {
          return (
            <div
              key={m.key}
              className={cx(styles.link, styles.disabled)}
              title={collapsed ? `${m.label} (próximamente)` : undefined}
              aria-disabled="true"
            >
              <Icon size={18} strokeWidth={2.1} />
              <span className={styles.text}>{m.label}</span>
              <span className={styles.soon}>Pronto</span>
            </div>
          );
        }

        return (
          <div key={m.key}>
            <div className={styles.row}>
              <NavLink to={m.path} className={linkClass} title={collapsed ? m.label : undefined}>
                <Icon size={18} strokeWidth={2.1} />
                <span className={styles.text}>{m.label}</span>
              </NavLink>

              {!collapsed && (
                <button
                  type="button"
                  className={cx(styles.chevron, expanded && styles.chevronOpen)}
                  onClick={() => toggle(m.key)}
                  aria-label={expanded ? `Contraer ${m.label}` : `Expandir ${m.label}`}
                  aria-expanded={expanded}
                >
                  <ChevronDown size={16} />
                </button>
              )}
            </div>

            <div className={cx(styles.submenu, expanded && styles.submenuOpen)}>
              <div className={styles.submenuInner}>
                {m.pages.map((p) => (
                  <NavLink
                    key={p.key}
                    to={p.fullPath}
                    tabIndex={expanded ? 0 : -1}
                    className={({ isActive }) => cx(styles.subLink, isActive && styles.subActive)}
                  >
                    {p.label}
                  </NavLink>
                ))}
              </div>
            </div>
          </div>
        );
      })}
    </>
  );
}

/* ------------------------------------------------------------
   Menú dentro de un módulo: solo sus páginas
   ------------------------------------------------------------ */
function ModuleMenu({ module, collapsed }) {
  const Icon = module.icon;

  return (
    <>
      <Link
        to="/home"
        className={cx(styles.link, styles.back)}
        title={collapsed ? "Volver al inicio" : undefined}
      >
        <ArrowLeft size={18} strokeWidth={2.1} />
        <span className={styles.text}>Volver al inicio</span>
      </Link>

      <div className={styles.moduleHeader} title={collapsed ? module.label : undefined}>
        <div className={styles.moduleIcon}>
          <Icon size={18} strokeWidth={2.2} />
        </div>
        <div className={styles.moduleInfo}>
          <span className={styles.moduleEyebrow}>Módulo</span>
          <span className={styles.moduleName}>{module.label}</span>
        </div>
      </div>

      <NavLink
        to={module.path}
        end
        className={linkClass}
        title={collapsed ? "Vista general" : undefined}
      >
        <LayoutGrid size={18} strokeWidth={2.1} />
        <span className={styles.text}>Vista general</span>
      </NavLink>

      {module.pages.length > 0 && <span className={styles.label}>Opciones</span>}

      {module.pages.map((p) => {
        const PageIcon = p.icon;
        return (
          <NavLink
            key={p.key}
            to={p.fullPath}
            className={linkClass}
            title={collapsed ? p.label : undefined}
          >
            <PageIcon size={18} strokeWidth={2.1} />
            <span className={styles.text}>{p.label}</span>
          </NavLink>
        );
      })}
    </>
  );
}