import { useDispatch, useSelector } from "react-redux";
import { apiFeedback } from "../api/APIS";
import { endpointsAPI } from "../api/endpointApi";
import { encryptPassword } from "../helpers/encryptPassword";
import { onLogin, onLogout, SESSION_KEY } from "../store/auth/authSlice";
import { useIDBStore } from "./useIDBStore";

export const useAuthStore = () => {
  const dispatch = useDispatch();
  const { status, user, expiresAt } = useSelector((state) => state.auth);
  const { crearIDB, addData } = useIDBStore();

  // Llama a la API. Si falla, lanza el error para que la pantalla muestre el mensaje.
  const startLogin = async (userName, password) => {
    const { data: response } = await apiFeedback.post(endpointsAPI.login, {
      userName: userName.trim(),
      Password: encryptPassword(password),
    });

    const { token, expiresIn, user } = response.data;

    // Token → IndexedDB (lo usa apiFeedbackAuthorized)
    await crearIDB("Authentication");
    await addData(token, "Authentication", "token");

    // Usuario y vencimiento → localStorage + Redux (expiresIn viene en minutos)
    const expiresAt = new Date(Date.now() + expiresIn * 60_000).toISOString();
    localStorage.setItem(SESSION_KEY, JSON.stringify({ user, expiresAt }));
    dispatch(onLogin({ user, expiresAt }));
  };

  const logout = async () => {
    try {
      await addData("", "Authentication", "token");
    } catch {
      /* si la BD indexada no existe, no hay token que borrar */
    }
    localStorage.removeItem(SESSION_KEY);
    dispatch(onLogout());
  };

  return {
    status,
    user,
    role: user?.role ?? null,
    expiresAt,
    startLogin,
    logout,
  };
};











import { useMemo } from "react";
import { useAuthStore } from "./useAuthStore";
import { getAllowedModules } from "../routes/routesConfig";

export const useAllowedModules = () => {
  const { role } = useAuthStore();
  return useMemo(() => getAllowedModules(role), [role]);
};






import { useMemo } from "react";
import { useAuthStore } from "./useAuthStore";

export const usePermissions = () => {
  const { role } = useAuthStore();

  const permissions = useMemo(
    () => new Set(role?.modules?.flatMap((m) => m.pages.flatMap((p) => p.permissions)) ?? []),
    [role]
  );

  const can = (permission) => permissions.has(permission);
  const canAny = (...list) => list.some(can);

  return { can, canAny, permissions };
};












import { usePermissions } from "../../../hooks/usePermissions";

/**
 * <Can permission="edit.users"> <button>Editar</button> </Can>
 */
export function Can({ permission, children, fallback = null }) {
  const { can } = usePermissions();
  return can(permission) ? children : fallback;
}










