import { Fragment } from 'react'
import { Navigate, Route, Routes } from 'react-router-dom'

import { useAuthStore } from '../hooks/useAuthStore'
import { useAllowedModules } from '../hooks/useAllowedModules'
import { MainLayout } from '../layout/MainLayout'
import { LoginPage } from '../pages/LoginPage/LoginPage'
import { HomePage } from '../pages/HomePage'
import { ModulePage } from '../pages/modules/ModulePage'

export const AppRouter = () => {
    const { status } = useAuthStore();
    const modules = useAllowedModules();

    if (status !== "authenticated") {
        return (
            <Routes>
                <Route path="/login" element={<LoginPage />} />
                <Route path="/*" element={<Navigate to="/login" replace />} />
            </Routes>
        );
    }

    return (
        <Routes>
            <Route element={<MainLayout />}>
                <Route path="/home" element={<HomePage />} />

                {modules.map((module) => (
                    <Fragment key={module.key}>
                        <Route path={module.path} element={<ModulePage module={module} />} />
                        {module.pages.map((page) => (
                            <Route key={page.key} path={page.fullPath} element={<page.component />} />
                        ))}
                    </Fragment>
                ))}

                {/* Cualquier ruta sin permiso o inexistente → Home */}
                <Route path="/*" element={<Navigate to="/home" replace />} />
            </Route>
        </Routes>
    );
}








import { useEffect, useState } from "react";
import { Outlet, useLocation } from "react-router-dom";
import { Navbar, Sidebar } from "../shared/components";
import { getBreadcrumb } from "../routes/routesConfig";
import { useMediaQuery } from "../hooks/useMediaQuery";
import { useAuthStore } from "../hooks/useAuthStore";
import { useAllowedModules } from "../hooks/useAllowedModules";
import styles from "./MainLayout.module.css";

const STORAGE_KEY = "ecoaching.sidebarCollapsed";

// Convierte el usuario del login al formato que usa el Navbar
const toNavbarUser = (user) => {
  if (!user) return undefined;
  const first = user.firstName ?? "";
  const last = user.lastName ?? "";
  return {
    name: `${first} ${last}`.trim(),
    role: user.role?.name ?? "",
    initials: `${first[0] ?? ""}${last[0] ?? ""}`.toUpperCase(),
  };
};

export const MainLayout = () => {
  const { pathname } = useLocation();
  const { user, expiresAt, logout } = useAuthStore();
  const modules = useAllowedModules();
  const isMobile = useMediaQuery("(max-width: 860px)");

  const [mobileOpen, setMobileOpen] = useState(false);
  const [collapsed, setCollapsed] = useState(() => {
    try { return localStorage.getItem(STORAGE_KEY) === "1"; } catch { return false; }
  });

  useEffect(() => {
    try { localStorage.setItem(STORAGE_KEY, collapsed ? "1" : "0"); } catch { /* sin storage */ }
  }, [collapsed]);

  useEffect(() => { setMobileOpen(false); }, [pathname, isMobile]);

  // Cierra la sesión automáticamente cuando vence el token
  useEffect(() => {
    if (!expiresAt) return;
    const msLeft = new Date(expiresAt).getTime() - Date.now();
    if (msLeft <= 0) { logout(); return; }
    const timer = setTimeout(logout, msLeft);
    return () => clearTimeout(timer);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [expiresAt]);

  return (
    <div className={styles.layout}>
      <Navbar
        user={toNavbarUser(user)}
        crumbs={getBreadcrumb(pathname)}
        onMenuClick={() => setMobileOpen((v) => !v)}
      />

      <div className={styles.body}>
        <Sidebar
          modules={modules}
          collapsed={collapsed && !isMobile}
          open={mobileOpen}
          onClose={() => setMobileOpen(false)}
          onLogout={logout}
          onToggleCollapse={isMobile ? undefined : () => setCollapsed((v) => !v)}
        />

        <main className={styles.content}>
          <div className={styles.container}>
            <Outlet />
          </div>
        </main>
      </div>
    </div>
  );
};










