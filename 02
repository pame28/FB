} from "../../../api/usersService";
import { useCatalogs } from "../../../hooks/useCatalogs";
import { usePermissions } from "../../../hooks/usePermissions";
import { toTitleCase } from "../../../helpers/format";
import styles from "../../Pages.module.css";

/* ============================================================
   Configuración
   ============================================================ */

// Máximo de registros por carga.
// ⚠️ Si backend limita el pageSize, ajustar a ese valor.
const MAX_ROWS = 1000;

const EMPTY_FILTERS = { search: "", companyAreaId: "", companyPositionId: "" };

const ZONES = [
  "Zona 1 Foránea",
  "Zona 1 Local",
  "Zona 2 Foránea",
  "Zona 2 Local",
  "Zona 3 Foránea",
  "Zona 3 Local",
];

// Ubicación = employeeBranchUbication.
// ⚠️ Confirmar con backend qué número es cada opción.
const UBICATIONS = [
  { value: 0, label: "Lobby" },
  { value: 1, label: "Ventanilla" },
];

/* ============================================================
   Helpers
   ============================================================ */
const toNumber = (value) => (value === "" ? undefined : Number(value));
const fullName = (u) => toTitleCase(`${u.firstName ?? ""} ${u.lastName ?? ""}`.trim());
const initials = (u) => `${u.firstName?.[0] ?? ""}${u.lastName?.[0] ?? ""}`.toUpperCase();
const isCashier = (u) => (u?.companyPosition ?? "").trim().toLowerCase() === "cajero";
const plural = (n, one, many) => `${n} ${n === 1 ? one : many}`;

const statusClass = (status) =>
  status === "Activo" ? styles.statusActive
    : status === "Inactivo" ? styles.statusInactive
      : styles.statusWarning;

const dash = <span className={styles.muted}>—</span>;

// Usuario → valores editables del formulario
const toFormValues = (u) => ({
  companyLocation: ZONES.includes(u.companyLocation) ? u.companyLocation : "",
  email: u.email ?? "",
  employeeBranchUbication: u.employeeBranchUbication != null ? String(u.employeeBranchUbication) : "",
  status: String(statusValueFromLabel(u.status)),
});

const validate = (v, cashier) => {
  const e = {};
  if (!v.companyLocation) e.companyLocation = "Selecciona una zona.";
  if (!v.email.trim()) e.email = "El correo es obligatorio.";
  else if (!/^\S+@\S+\.\S+$/.test(v.email)) e.email = "El correo no es válido.";
  if (v.status === "") e.status = "Selecciona un estatus.";
  if (cashier && v.employeeBranchUbication === "") e.employeeBranchUbication = "Selecciona la ubicación.";
  return e;
};

/* ============================================================
   Columnas del listado
   ============================================================ */
const columns = [
  { key: "userName", header: "Código", render: (u) => <span className={styles.mono}>{u.userName}</span> },
  { key: "name", header: "Nombre completo", render: (u) => <span className={styles.cellMain}>{fullName(u)}</span> },
  {
    key: "companyPosition",
    header: "Perfil de puesto",
    render: (u) => u.companyPosition
      ? <span className={`${styles.tag} ${styles.tagBlue}`}>{u.companyPosition}</span>
      : dash,
  },
  {
    key: "tellerCode",
    header: "Cód. cajero",
    render: (u) => u.tellerCode ? <span className={styles.mono}>{u.tellerCode}</span> : dash,
  },
  {
    key: "companyArea",
    header: "Área",
    render: (u) => u.companyArea
      ? <span className={`${styles.tag} ${styles.tagTeal}`}>{u.companyArea}</span>
      : dash,
  },
  {
    key: "status",
    header: "Estado",
     render: (u) => <span className={`${styles.statusPlain} ${statusClass(u.status)}`}>{u.status}</span>,
  },
];

/* ============================================================
   Página
   ============================================================ */
export const MantenimientoUsuariosPage = () => {
  const catalogs = useCatalogs();
  const { can } = usePermissions();
  const canEdit = can("edit.users");

  // Filtros
  const [filters, setFilters] = useState(EMPTY_FILTERS);
  const [confirmAllOpen, setConfirmAllOpen] = useState(false);

  // Listado (items = null → todavía no se ha cargado)
  const [users, setUsers] = useState({ items: null, total: 0 });
  const [loading, setLoading] = useState(false);
  const [listError, setListError] = useState("");
  const lastRequest = useRef(null);

  // Edición
  const [selected, setSelected] = useState(null);
  const [values, setValues] = useState(null);
  const [errors, setErrors] = useState({});
  const [saving, setSaving] = useState(false);
  const [saveError, setSaveError] = useState("");
  const [notice, setNotice] = useState("");
  const editRef = useRef(null);

  // Sincronización
  const [syncing, setSyncing] = useState(false);
  const [syncResult, setSyncResult] = useState(null); // { type: "success" | "error", text }

  const activeFilterCount = [filters.companyAreaId, filters.companyPositionId].filter(Boolean).length;
  const isValid = activeFilterCount > 0 || filters.search.trim().length >= 2;
  const hasAnyFilter = activeFilterCount > 0 || filters.search !== "";
  const cashier = isCashier(selected);

  /* ---------- Carga ---------- */
  const loadUsers = async (request) => {
    lastRequest.current = request;
    setLoading(true);
    setListError("");
    setSelected(null);
    setNotice("");

    try {
      const data = await usersService.filter({ ...request, pageNumber: 1, pageSize: MAX_ROWS });
      setUsers({ items: data.items, total: data.totalCount });
    } catch (err) {
      setUsers({ items: [], total: 0 });
      setListError(err.noAccess
        ? "No tienes permiso para consultar usuarios."
        : "No se pudieron cargar los usuarios. Intenta de nuevo.");
    } finally {
      setLoading(false);
    }
  };

  const handleLoad = (e) => {
    e.preventDefault();
    if (!isValid || loading) return;
    loadUsers({
      search: filters.search.trim() || undefined,
      companyAreaId: toNumber(filters.companyAreaId),
      companyPositionId: toNumber(filters.companyPositionId),
    });
  };

  const handleLoadAll = () => {
    setConfirmAllOpen(false);
    loadUsers({});
  };

  const handleFilterChange = (e) => {
    const { name, value } = e.target;
    setFilters((f) => ({ ...f, [name]: value }));
  };

  const clearFilters = () => setFilters(EMPTY_FILTERS);

  /* ---------- Selección ---------- */
  const selectUser = (u) => {
    setSelected(u);
    setValues(toFormValues(u));
    setErrors({});
    setSaveError("");
    setNotice("");
    requestAnimationFrame(() => editRef.current?.scrollIntoView({ behavior: "smooth", block: "start" }));
  };

  const closeEditor = () => {
    setSelected(null);
    setValues(null);
  };

  const handleValueChange = (e) => {
    const { name, value } = e.target;
    setValues((v) => ({ ...v, [name]: value }));
    setErrors((err) => ({ ...err, [name]: undefined }));
  };

  /* ---------- Guardar ---------- */
  const handleSave = async (e) => {
    e.preventDefault();
    const found = validate(values, cashier);
    setErrors(found);
    if (Object.keys(found).length > 0) return;

    setSaving(true);
    setSaveError("");
    setNotice("");

    const status = Number(values.status);
    const payload = {
      // Datos que no se editan aquí: se reenvían tal cual
      firstName: selected.firstName,
      lastName: selected.lastName,
      userName: selected.userName,
      companyPosition: selected.companyPosition ?? "",
      companyBranch: selected.companyBranch ?? "",
      companyAreaId: selected.companyAreaId,
      roleId: selected.roleId,
      // Editables
      email: values.email.trim(),
      companyLocation: values.companyLocation,
      status,
      userEnabled: status !== USER_STATUS.INACTIVO,
      // Solo los cajeros tienen ubicación y código de cajero
      employeeBranchUbication: cashier ? Number(values.employeeBranchUbication) : null,
      tellerCode: cashier ? selected.tellerCode : null,
    };

    try {
      const saved = await usersService.update(selected.id, payload);
      const updated = saved ?? {
        ...selected,
        email: payload.email,
        companyLocation: payload.companyLocation,
        employeeBranchUbication: payload.employeeBranchUbication,
        tellerCode: payload.tellerCode,
        status: statusLabelFromValue(status),
      };

      setUsers((prev) => ({ ...prev, items: prev.items.map((u) => (u.id === updated.id ? updated : u)) }));
      setSelected(updated);
      setValues(toFormValues(updated));
      setNotice(`Los cambios de ${fullName(updated)} se guardaron correctamente.`);
    } catch (err) {
      const data = err.response?.data;
      setSaveError(err.noAccess
        ? "No tienes permiso para editar usuarios."
        : data?.message ?? "No se pudieron guardar los cambios. Intenta de nuevo.");
    } finally {
      setSaving(false);
    }
  };

  /* ---------- Sincronizar AS400 ---------- */
  const handleSync = async () => {
    setSyncing(true);
    setSyncResult(null);
    try {
      await usersService.syncAs400();
      setSyncResult({ type: "success", text: "Sincronización con AS400 completada." });
      if (lastRequest.current) loadUsers(lastRequest.current); // refresca lo que estaba en pantalla
    } catch (err) {
      setSyncResult({
        type: "error",
        text: err.noAccess
          ? "No tienes permiso para sincronizar con AS400."
          : err.response?.data?.message ?? "No se pudo sincronizar con AS400. Intenta de nuevo.",
      });
    } finally {
      setSyncing(false);
    }
  };

  /* ---------- Render ---------- */
  return (
    <>
      <header className={styles.pageHeader}>
        <div>
          <span className={styles.eyebrow}>Mantenimientos</span>
          <h1 className={styles.title}>Mantenimiento de usuarios</h1>
          <p className={styles.subtitle}>Gestiona la información de cajeros, directores y asesores del sistema.</p>
        </div>

        <Can permission="syncas400.users">
          <div className={styles.actions}>
            <button type="button" className={`${styles.btn} ${styles.btnOutline}`} onClick={handleSync} disabled={syncing}>
              {syncing ? <Loader2 size={18} className={styles.spin} /> : <RefreshCw size={18} />}
              {syncing ? "Sincronizando..." : "Sincronizar con AS400"}
            </button>
          </div>
        </Can>
      </header>

      <div className={styles.banner}>
        <Info size={18} />
        <p>
          Aplica al menos un filtro antes de cargar usuarios. Si necesitas ver todos, usa la
          opción{" "}
          <button type="button" className={styles.linkBtn} style={{ padding: 0 }} onClick={() => setConfirmAllOpen(true)}>
            Cargar todos los usuarios
          </button>.
        </p>
      </div>

      {syncResult && (
        <div className={`${styles.banner} ${syncResult.type === "success" ? styles.bannerSuccess : styles.bannerError}`} role="status">
          {syncResult.type === "success" ? <CheckCircle2 size={18} /> : <AlertCircle size={18} />}
          <p>{syncResult.text}</p>
        </div>
      )}

      {listError && (
        <div className={`${styles.banner} ${styles.bannerError}`} role="alert">
          <AlertCircle size={18} />
          <p>{listError}</p>
        </div>
      )}

 {/* ---------- Filtros de búsqueda ---------- */}
      <form className={styles.filterCard} onSubmit={handleLoad}>
        <h2 className={styles.filterCardTitle}>
          <Filter size={16} /> Filtros de búsqueda
        </h2>

        <div className={styles.filterGrid}>
          <div className={styles.field}>
            <label className={styles.label} htmlFor="companyAreaId">Área</label>
            <select id="companyAreaId" name="companyAreaId" className={styles.select}
              value={filters.companyAreaId} onChange={handleFilterChange}>
              <option value="">Selecciona un área</option>
              {catalogs.areas.map((a) => <option key={a.value} value={a.value}>{a.label}</option>)}
            </select>
          </div>

          <div className={styles.field}>
            <label className={styles.label} htmlFor="companyPositionId">Perfil de puesto</label>
            <select id="companyPositionId" name="companyPositionId" className={styles.select}
              value={filters.companyPositionId} onChange={handleFilterChange}
              disabled={catalogs.positions.length === 0}>
              <option value="">
                {catalogs.positions.length === 0 ? "No disponible aún" : "Selecciona un perfil"}
              </option>
              {catalogs.positions.map((p) => <option key={p.value} value={p.value}>{p.label}</option>)}
            </select>
          </div>

          <div className={styles.field}>
            <label className={styles.label} htmlFor="search">Buscar usuario</label>
            <div className={styles.search}>
              <Search size={16} />
              <input id="search" name="search" className={styles.input} placeholder="Código o nombre..."
                value={filters.search} onChange={handleFilterChange} />
            </div>
          </div>
        </div>

        <div className={styles.filterActions}>
          <button type="submit" className={`${styles.btn} ${styles.btnPrimary}`}
            disabled={!isValid || loading}
            title={!isValid ? "Selecciona al menos un filtro o escribe al menos 2 letras" : undefined}>
            {loading ? <Loader2 size={16} className={styles.spin} /> : <Download size={16} />}
            Cargar
          </button>

          <button type="button" className={`${styles.btn} ${styles.btnGhost}`}
            onClick={() => setConfirmAllOpen(true)} disabled={loading}>
            <Users size={16} /> Cargar todos los usuarios
          </button>

          <button type="button" className={`${styles.btn} ${styles.btnGhost}`}
            onClick={clearFilters} disabled={!hasAnyFilter}>
            Limpiar filtros
          </button>

          {users.items !== null && !loading && (
            <span className={styles.count}>
              {plural(users.total, "usuario", "usuarios")}
              {users.total > users.items.length && ` · mostrando ${users.items.length}`}
            </span>
          )}
        </div>
      </form>

      {/* ---------- Listado (solo después de cargar) ---------- */}
      {(users.items !== null || loading) && (
        <section className={styles.panel}>
          <Datatable
            columns={columns}
            rows={users.items ?? []}
            loading={loading}
            maxHeight={420}
            onRowClick={selectUser}
            selectedKey={selected?.id}
            emptyMessage="Ningún usuario coincide con la búsqueda."
          />
        </section>
      )}

      {/* ---------- Usuario seleccionado ---------- */}
      {selected && values && (
        <>
          <div ref={editRef} className={styles.sectionLabel}>Información del usuario seleccionado</div>

          <div className={styles.selectedCard}>
            <div className={styles.selectedAvatar}>{initials(selected)}</div>
            <div style={{ minWidth: 0 }}>
              <div className={styles.selectedName}>{fullName(selected)}</div>
              <div className={styles.selectedMeta}>
                <span className={styles.mono}>{selected.userName}</span>
                {selected.companyPosition && <span className={`${styles.tag} ${styles.tagBlue}`}>{selected.companyPosition}</span>}
                {selected.companyBranch && <span className={`${styles.tag} ${styles.tagNeutral}`}>{toTitleCase(selected.companyBranch)}</span>}
                <span className={`${styles.status} ${statusClass(selected.status)}`}>{selected.status}</span>
              </div>
            </div>
            <button type="button" className={styles.iconBtn} style={{ marginLeft: "auto" }}
              onClick={closeEditor} aria-label="Cerrar edición" title="Cerrar">
              <X size={16} />
            </button>
          </div>

          {notice && (
            <div className={`${styles.banner} ${styles.bannerSuccess}`} role="status" style={{ marginTop: 16, marginBottom: 0 }}>
              <CheckCircle2 size={18} />
              <p>{notice}</p>
            </div>
          )}

          <form className={styles.card} onSubmit={handleSave} noValidate>
            <h2 className={styles.cardTitle}>Editar información</h2>

            {saveError && (
              <div className={`${styles.banner} ${styles.bannerError}`} role="alert">
                <AlertCircle size={18} />
                <p>{saveError}</p>
              </div>
            )}

            <div className={styles.form}>
              {/* Solo lectura */}
              <div className={styles.field}>
                <label className={styles.label} htmlFor="ro-code">
                  Código de empleado <span className={styles.readOnlyTag}>SOLO LECTURA</span>
                </label>
                <input id="ro-code" className={styles.input} value={selected.userName ?? ""} readOnly />
              </div>

              <div className={styles.field}>
                <label className={styles.label} htmlFor="ro-teller">
                  Código de cajero <span className={styles.readOnlyTag}>SOLO LECTURA</span>
                </label>
                <input id="ro-teller" className={styles.input} value={selected.tellerCode ?? "—"} readOnly />
                {!cashier && selected.tellerCode && (
                  <span className={styles.fieldWarning}>
                    Este usuario no es cajero: el código se quitará al guardar.
                  </span>
                )}
              </div>

              <div className={styles.field}>
                <label className={styles.label} htmlFor="ro-name">
                  Nombre <span className={styles.readOnlyTag}>SOLO LECTURA</span>
                </label>
                <input id="ro-name" className={styles.input} value={fullName(selected)} readOnly />
              </div>

              <div className={styles.field}>
                <label className={styles.label} htmlFor="ro-branch">
                  Agencia <span className={styles.readOnlyTag}>SOLO LECTURA</span>
                </label>
                <input id="ro-branch" className={styles.input}
                  value={selected.companyBranch ? toTitleCase(selected.companyBranch) : "—"} readOnly />
              </div>

              <div className={styles.formDivider}>Campos editables</div>

              {/* Editables */}
              <div className={styles.field}>
                <label className={styles.label} htmlFor="companyLocation">
                  Zona<span className={styles.required}>*</span>
                </label>
                <select id="companyLocation" name="companyLocation"
                  className={`${styles.select} ${errors.companyLocation ? styles.invalid : ""}`}
                  value={values.companyLocation} onChange={handleValueChange} disabled={!canEdit}
                  aria-invalid={!!errors.companyLocation}>
                  <option value="">Selecciona una zona</option>
                  {ZONES.map((z) => <option key={z} value={z}>{z}</option>)}
                </select>
                {errors.companyLocation && <span className={styles.fieldError}>{errors.companyLocation}</span>}
              </div>

              <div className={styles.field}>
                <label className={styles.label} htmlFor="email">
                  Correo<span className={styles.required}>*</span>
                </label>
                <input id="email" name="email" type="email"
                  className={`${styles.input} ${errors.email ? styles.invalid : ""}`}
                  placeholder="correo@banpais.hn" value={values.email} onChange={handleValueChange}
                  disabled={!canEdit} aria-invalid={!!errors.email} />
                {errors.email && <span className={styles.fieldError}>{errors.email}</span>}
              </div>

              <div className={styles.field}>
                <label className={styles.label} htmlFor="employeeBranchUbication">
                  Ubicación{cashier && <span className={styles.required}>*</span>}
                </label>
                <select id="employeeBranchUbication" name="employeeBranchUbication"
                  className={`${styles.select} ${errors.employeeBranchUbication ? styles.invalid : ""}`}
                  value={cashier ? values.employeeBranchUbication : ""} onChange={handleValueChange}
                  disabled={!cashier || !canEdit} aria-invalid={!!errors.employeeBranchUbication}>
                  <option value="">Selecciona</option>
                  {UBICATIONS.map((u) => <option key={u.value} value={u.value}>{u.label}</option>)}
                </select>
                {errors.employeeBranchUbication
                  ? <span className={styles.fieldError}>{errors.employeeBranchUbication}</span>
                  : !cashier && <span className={styles.hint}>Válido solo para cajeros</span>}
              </div>

              <div className={styles.field}>
                <label className={styles.label} htmlFor="status">
                  Estatus<span className={styles.required}>*</span>
                </label>
                <select id="status" name="status"
                  className={`${styles.select} ${errors.status ? styles.invalid : ""}`}
                  value={values.status} onChange={handleValueChange} disabled={!canEdit}
                  aria-invalid={!!errors.status}>
                  <option value="">Selecciona un estatus</option>
                  {USER_STATUS_OPTIONS.map((s) => <option key={s.value} value={s.value}>{s.label}</option>)}
                </select>
                {errors.status && <span className={styles.fieldError}>{errors.status}</span>}
              </div>
            </div>

            <div className={styles.cardFooter}>
              <button type="button" className={`${styles.btn} ${styles.btnOutline}`} onClick={closeEditor} disabled={saving}>
                Cancelar
              </button>
              <Can permission="edit.users">
                <button type="submit" className={`${styles.btn} ${styles.btnPrimary}`} disabled={saving}>
                  {saving ? <Loader2 size={18} className={styles.spin} /> : <Save size={18} />}
                  {saving ? "Guardando..." : "Guardar"}
                </button>
              </Can>
            </div>
          </form>
        </>
      )}

      {/* ---------- Confirmación: cargar todos ---------- */}
      <ConfirmDialog
        open={confirmAllOpen}
        icon={Users}
        title="Cargar todos los usuarios"
        message="Esta acción puede tardar varios segundos. ¿Desea continuar?"
        cancelText="No, cancelar"
        confirmText="Sí, cargar todos"
        onConfirm={handleLoadAll}
        onCancel={() => setConfirmAllOpen(false)}
      />
    </>
  );
};



