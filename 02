  transition: background 0.15s ease;
}
.switch::after {
  content: "";
  position: absolute;
  top: 3px;
  left: 3px;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
  transition: transform 0.15s ease;
}
.switch:checked { background: var(--bp-blue-expert); }
.switch:checked::after { transform: translateX(18px); }
.switch:focus-visible { outline: 3px solid color-mix(in srgb, var(--bp-blue-digital) 55%, transparent); outline-offset: 2px; }

.switchLabel { font-size: 14px; font-weight: 600; color: var(--bp-blue-expert); }

.optional {
  margin-left: 8px;
  padding: 2px 8px;
  border-radius: 999px;
  background: #fff3cc;
  font-size: 10.5px;
  font-weight: 800;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: #8a5a00;
}

/* ---- Responsive ---- */
@media (max-width: 768px) {
  .title { font-size: 22px; }
  .headerIcon { width: 46px; height: 46px; }

  .actions { width: 100%; }
  .actions .btn { flex: 1 1 auto; }

  .search { max-width: none; flex-basis: 100%; }
  .toolbar .select { flex: 1 1 140px; min-width: 0; }
  .count { width: 100%; margin-left: 0; }

  .form { grid-template-columns: 1fr; }
  .fieldAside { padding-top: 0; }
}

@media (prefers-reduced-motion: reduce) {
  .spin { animation: none; }
}











import { useEffect, useState } from "react";
import { AlertCircle, Loader2 } from "lucide-react";
import { Modal } from "../../../../shared/components";
import { usersService, USER_STATUS } from "../../../../api/usersService";
import styles from "../../../Pages.module.css";

const FORM_ID = "user-form";

const INITIAL_VALUES = {
  firstName: "",
  lastName: "",
  userName: "",
  email: "",
  companyPosition: "",
  status: String(USER_STATUS.ACTIVO),
  companyBranch: "",
  companyLocation: "",
  companyAreaId: "",
  roleId: "",
  isAgencyUser: false,
  tellerCode: "",
};

const validate = (v) => {
  const e = {};
  if (!v.firstName.trim()) e.firstName = "El nombre es obligatorio.";
  if (!v.lastName.trim()) e.lastName = "El apellido es obligatorio.";
  if (!v.userName.trim()) e.userName = "El usuario de red es obligatorio.";
  if (!v.email.trim()) e.email = "El correo es obligatorio.";
  else if (!/^\S+@\S+\.\S+$/.test(v.email)) e.email = "El correo no es válido.";
  if (!v.companyAreaId) e.companyAreaId = "Selecciona un área.";
  if (!v.roleId) e.roleId = "Selecciona un rol.";
  if (v.isAgencyUser && !v.tellerCode.trim()) e.tellerCode = "Ingresa el código de cajero.";
  return e;
};

// "CompanyAreaId" (backend) → "companyAreaId" (formulario)
const mapApiErrors = (errors = {}) =>
  Object.fromEntries(
    Object.entries(errors).map(([key, msg]) => [key.charAt(0).toLowerCase() + key.slice(1), msg])
  );

function Field({ label, name, required, error, hint, full, children }) {
  return (
    <div className={`${styles.field} ${full ? styles.fieldFull : ""}`}>
      <label className={styles.label} htmlFor={name}>
        {label}
        {required && <span className={styles.required}>*</span>}
      </label>
      {children}
      {error ? <span className={styles.fieldError}>{error}</span> : hint && <span className={styles.hint}>{hint}</span>}
    </div>
  );
}

export const UserFormModal = ({ open, onClose, onCreated, catalogs }) => {
  const [values, setValues] = useState(INITIAL_VALUES);
  const [errors, setErrors] = useState({});
  const [saving, setSaving] = useState(false);
  const [submitError, setSubmitError] = useState("");

  // Limpia el formulario cada vez que se abre
  useEffect(() => {
    if (open) {
      setValues(INITIAL_VALUES);
      setErrors({});
      setSubmitError("");
    }
  }, [open]);

  const handleChange = (e) => {
    const { name, value, type, checked } = e.target;
    setValues((v) => ({ ...v, [name]: type === "checkbox" ? checked : value }));
    setErrors((err) => ({ ...err, [name]: undefined }));
  };

  const inputClass = (name, base = styles.input) => `${base} ${errors[name] ? styles.invalid : ""}`;

  const selectedArea = catalogs.areas.find((a) => String(a.value) === values.companyAreaId);
  const selectedRole = catalogs.roles.find((r) => String(r.value) === values.roleId);

  const handleSubmit = async (e) => {
    e.preventDefault();
    const found = validate(values);
    setErrors(found);
    if (Object.keys(found).length > 0) return;

    setSaving(true);
    setSubmitError("");

    try {
      const status = Number(values.status);
      const created = await usersService.create({
        firstName: values.firstName.trim(),
        lastName: values.lastName.trim(),
        userName: values.userName.trim(),
        email: values.email.trim(),
        status,
        userEnabled: status === USER_STATUS.ACTIVO,
        employeeBranchUbication: 0, // ⚠️ confirmar con backend qué significa este campo
        tellerCode: values.isAgencyUser ? values.tellerCode.trim() : null,
        companyPosition: values.companyPosition.trim(),
        companyBranch: values.companyBranch.trim(),
        companyLocation: values.companyLocation.trim(),
        companyAreaId: Number(values.companyAreaId),
        roleId: Number(values.roleId),
      });
      onCreated(created);
    } catch (error) {
      const data = error.response?.data;
      if (data?.errors) setErrors(mapApiErrors(data.errors));
      setSubmitError(data?.message ?? "No se pudo guardar el usuario. Intenta de nuevo.");
    } finally {
      setSaving(false);
    }
  };

  const handleClose = () => { if (!saving) onClose(); };

  return (
    <Modal
      open={open}
      title="Nuevo usuario"
      onClose={handleClose}
      footer={
        <>
          <button type="button" className={`${styles.btn} ${styles.btnOutline}`} onClick={handleClose} disabled={saving}>
            Cancelar
          </button>
          <button type="submit" form={FORM_ID} className={`${styles.btn} ${styles.btnPrimary}`} disabled={saving}>
            {saving && <Loader2 size={18} className={styles.spin} />}
            {saving ? "Guardando..." : "Guardar usuario"}
          </button>
        </>
      }
    >
      <form id={FORM_ID} className={styles.form} onSubmit={handleSubmit} noValidate>
        {submitError && (
          <div className={`${styles.banner} ${styles.bannerError} ${styles.fieldFull}`} role="alert" style={{ marginBottom: 0 }}>
            <AlertCircle size={18} />
            <p>{submitError}</p>
          </div>
        )}

        <Field label="Nombre" name="firstName" required error={errors.firstName}>
          <input id="firstName" name="firstName" className={inputClass("firstName")} placeholder="Ej. María"
            value={values.firstName} onChange={handleChange} aria-invalid={!!errors.firstName} />
        </Field>

        <Field label="Apellido" name="lastName" required error={errors.lastName}>
          <input id="lastName" name="lastName" className={inputClass("lastName")} placeholder="Ej. López"
            value={values.lastName} onChange={handleChange} aria-invalid={!!errors.lastName} />
        </Field>

        <Field label="Usuario de red" name="userName" required error={errors.userName} hint="Credencial AD o AS400">
          <input id="userName" name="userName" className={inputClass("userName")} placeholder="Ej. mlopez"
            autoComplete="off" value={values.userName} onChange={handleChange} aria-invalid={!!errors.userName} />
        </Field>

        <Field label="Correo electrónico" name="email" required error={errors.email}>
          <input id="email" name="email" type="email" className={inputClass("email")} placeholder="mlopez@banpais.hn"
            value={values.email} onChange={handleChange} aria-invalid={!!errors.email} />
        </Field>

        <Field label="Puesto" name="companyPosition" error={errors.companyPosition}>
          <input id="companyPosition" name="companyPosition" className={inputClass("companyPosition")}
            placeholder="Ej. Oficial de crédito" value={values.companyPosition} onChange={handleChange} />
        </Field>

        <Field label="Estado" name="status" error={errors.status}>
          <select id="status" name="status" className={inputClass("status", styles.select)} value={values.status} onChange={handleChange}>
            <option value={USER_STATUS.ACTIVO}>Activo</option>
            <option value={USER_STATUS.INACTIVO}>Inactivo</option>
          </select>
        </Field>

        <Field label="Agencia" name="companyBranch" error={errors.companyBranch}>
          <input id="companyBranch" name="companyBranch" className={inputClass("companyBranch")}
            placeholder="Ej. Agencia Torre del País" value={values.companyBranch} onChange={handleChange} />
        </Field>

        <Field label="Zona" name="companyLocation" error={errors.companyLocation}>
          <input id="companyLocation" name="companyLocation" className={inputClass("companyLocation")}
            placeholder="Ej. SPS Norte" value={values.companyLocation} onChange={handleChange} />
        </Field>

        <Field label="Área" name="companyAreaId" required error={errors.companyAreaId}
          hint="Define la visibilidad y alcance del usuario en el sistema">
          <select id="companyAreaId" name="companyAreaId" className={inputClass("companyAreaId", styles.select)}
            value={values.companyAreaId} onChange={handleChange} aria-invalid={!!errors.companyAreaId}>
            <option value="">— Selecciona un área —</option>
            {catalogs.areas.map((a) => <option key={a.value} value={a.value}>{a.label}</option>)}
          </select>
        </Field>

        <div className={`${styles.field} ${styles.fieldAside}`}>
          <div className={styles.infoBox}>
            {selectedArea
              ? selectedArea.description || "Esta área no tiene descripción."
              : "Selecciona un área para ver su descripción."}
          </div>
        </div>

        <Field label="Rol asignado" name="roleId" required error={errors.roleId}>
          <select id="roleId" name="roleId" className={inputClass("roleId", styles.select)}
            value={values.roleId} onChange={handleChange} aria-invalid={!!errors.roleId}>
            <option value="">— Selecciona un rol —</option>
            {catalogs.roles.map((r) => <option key={r.value} value={r.value}>{r.label}</option>)}
          </select>
        </Field>

        <div className={`${styles.field} ${styles.fieldAside}`}>
          <div className={styles.infoBox}>
            {selectedRole
              ? selectedRole.description || "Este rol no tiene descripción."
              : "Selecciona un rol para ver qué puede hacer."}
          </div>
        </div>

        <label className={styles.switchRow} htmlFor="isAgencyUser">
          <input id="isAgencyUser" name="isAgencyUser" type="checkbox" role="switch" className={styles.switch}
            checked={values.isAgencyUser} onChange={handleChange} />
          <span className={styles.switchLabel}>
            ¿Usuario de agencia con código de cajero?
            <span className={styles.optional}>Opcional</span>
          </span>
        </label>

        {values.isAgencyUser && (
          <Field label="Código de cajero" name="tellerCode" required error={errors.tellerCode} full>
            <input id="tellerCode" name="tellerCode" className={inputClass("tellerCode")} placeholder="Ej. 30366"
              value={values.tellerCode} onChange={handleChange} aria-invalid={!!errors.tellerCode} />
          </Field>
        )}
      </form>
    </Modal>
  );
};











import { useEffect, useMemo, useState } from "react";
import {
  AlertCircle, CheckCircle2, FileSpreadsheet, FileText, Info,
  Loader2, Pencil, Plus, Search, Trash2,
} from "lucide-react";
import { Can, DataTable } from "../../../shared/components";
import { usersService, USER_STATUS } from "../../../api/usersService";
import { useCatalogs } from "../../../hooks/useCatalogs";
import { useDebounce } from "../../../hooks/useDebounce";
import { downloadBlob } from "../../../helpers/downloadFile";
import { toTitleCase } from "../../../helpers/format";
import { UserFormModal } from "./components/UserFormModal";
import styles from "../../Pages.module.css";

const PAGE_SIZE = 10;
const EMPTY_FILTERS = { search: "", roleId: "", companyAreaId: "", companyPositionId: "", status: "" };

// Cada área recibe siempre el mismo color, calculado a partir de su nombre
const AREA_TONES = [styles.tagBlue, styles.tagPurple, styles.tagPink, styles.tagAmber, styles.tagTeal];
const toneFor = (text) => AREA_TONES[[...text].reduce((sum, c) => sum + c.charCodeAt(0), 0) % AREA_TONES.length];

const toNumber = (value) => (value === "" ? undefined : Number(value));
const dash = <span className={styles.muted}>—</span>;

function StatCard({ value, label, tone }) {
  return (
    <div className={`${styles.statCard} ${tone}`}>
      <div className={styles.statValue}>{value ?? "—"}</div>
      <div className={styles.statLabel}>{label}</div>
    </div>
  );
}

export const UsuariosRolesPage = () => {
  const catalogs = useCatalogs();

  const [filters, setFilters] = useState(EMPTY_FILTERS);
  const search = useDebounce(filters.search, 400);
  const [page, setPage] = useState(1);

  const [result, setResult] = useState({ items: [], totalCount: 0, totalPages: 0, pageSize: PAGE_SIZE });
  const [stats, setStats] = useState({ total: null, active: null, inactive: null });
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [notice, setNotice] = useState("");
  const [exporting, setExporting] = useState(null); // "excel" | "pdf" | null
  const [modalOpen, setModalOpen] = useState(false);
  const [reloadKey, setReloadKey] = useState(0);

  // Filtros en el formato que espera la API
  const request = useMemo(() => ({
    search: search.trim() || undefined,
    roleId: toNumber(filters.roleId),
    companyAreaId: toNumber(filters.companyAreaId),
    companyPositionId: toNumber(filters.companyPositionId),
    status: toNumber(filters.status),
  }), [search, filters.roleId, filters.companyAreaId, filters.companyPositionId, filters.status]);

  const hasFilters = Object.values(filters).some((v) => v !== "");

  // Lista de usuarios (se recarga al cambiar filtros o página)
  useEffect(() => {
    let cancelled = false;
    setLoading(true);
    setError("");

    usersService
      .filter({ ...request, pageNumber: page, pageSize: PAGE_SIZE })
      .then((data) => { if (!cancelled) setResult(data); })
      .catch(() => { if (!cancelled) setError("No se pudo cargar la lista de usuarios. Intenta de nuevo."); })
      .finally(() => { if (!cancelled) setLoading(false); });

    return () => { cancelled = true; };
  }, [request, page, reloadKey]);

  // Tarjetas de resumen: piden solo el totalCount de cada consulta (pageSize 1)
  useEffect(() => {
    const count = (extra) =>
      usersService.filter({ ...extra, pageNumber: 1, pageSize: 1 }).then((d) => d.totalCount).catch(() => null);

    Promise.all([
      count({}),
      count({ status: USER_STATUS.ACTIVO }),
      count({ status: USER_STATUS.INACTIVO }),
    ]).then(([total, active, inactive]) => setStats({ total, active, inactive }));
  }, [reloadKey]);

  // El aviso de éxito desaparece solo
  useEffect(() => {
    if (!notice) return;
    const timer = setTimeout(() => setNotice(""), 5000);
    return () => clearTimeout(timer);
  }, [notice]);

  const handleFilterChange = (e) => {
    const { name, value } = e.target;
    setFilters((f) => ({ ...f, [name]: value }));
    setPage(1);
  };

  const clearFilters = () => {
    setFilters(EMPTY_FILTERS);
    setPage(1);
  };

  const handleExport = async (type) => {
    setExporting(type);
    setError("");
    try {
      const response = type === "excel"
        ? await usersService.exportExcel(request)
        : await usersService.exportPdf(request);
      downloadBlob(response, type === "excel" ? "usuarios.xlsx" : "usuarios.pdf");
    } catch {
      setError("No se pudo generar el archivo. Intenta de nuevo.");
    } finally {
      setExporting(null);
    }
  };

  const handleCreated = (user) => {
    setModalOpen(false);
    setNotice(`Usuario ${toTitleCase(`${user.firstName} ${user.lastName}`)} creado correctamente.`);
    setReloadKey((k) => k + 1);
  };

  // Pendientes: faltan los endpoints de editar y eliminar
  const handleEdit = (user) => console.log("Editar", user);
  const handleDelete = (user) => console.log("Eliminar", user);

  const columns = [
    {
      key: "name",
      header: "Nombre",
      render: (u) => <span className={styles.cellMain}>{toTitleCase(`${u.firstName} ${u.lastName}`)}</span>,
    },
    {
      key: "userName",
      header: "Usuario de red",
      render: (u) => <span className={styles.mono}>{u.userName}</span>,
    },
    {
      key: "companyPosition",
      header: "Puesto",
      render: (u) => u.companyPosition || dash,
    },
    {
      key: "companyArea",
      header: "Área",
      render: (u) => u.companyArea
        ? <span className={`${styles.tag} ${toneFor(u.companyArea)}`}>{u.companyArea}</span>
        : dash,
    },
    {
      key: "roleName",
      header: "Rol asignado",
      render: (u) => u.roleName
        ? <span className={`${styles.tag} ${styles.tagRole}`}>{u.roleName}</span>
        : <span className={`${styles.tag} ${styles.tagNeutral}`}>Sin rol</span>,
    },
    {
      key: "branch",
      header: "Agencia / Zona",
      render: (u) => (
        <>
          {u.companyBranch ? toTitleCase(u.companyBranch) : dash}
          {u.companyLocation && <span className={styles.cellSub}>{u.companyLocation}</span>}
        </>
      ),
    },
    {
      key: "tellerCode",
      header: "Cód. cajero",
      render: (u) => u.tellerCode
        ? <span className={`${styles.tag} ${styles.tagAmber}`}>{u.tellerCode}</span>
        : dash,
    },
    {
      key: "status",
      header: "Estado",
      render: (u) => (
        <span className={`${styles.status} ${u.status === "Activo" ? styles.statusActive : styles.statusInactive}`}>
          {u.status}
        </span>
      ),
    },
    {
      key: "actions",
      header: "Acciones",
      align: "right",
      render: (u) => (
        <div className={styles.rowActions}>
          <Can permission="edit.users">
            <button type="button" className={styles.iconBtn} title="Editar"
              aria-label={`Editar a ${u.firstName}`} onClick={() => handleEdit(u)}>
              <Pencil size={16} />
            </button>
          </Can>
          <Can permission="delete.users">
            <button type="button" className={`${styles.iconBtn} ${styles.iconBtnDanger}`} title="Eliminar"
              aria-label={`Eliminar a ${u.firstName}`} onClick={() => handleDelete(u)}>
              <Trash2 size={16} />
            </button>
          </Can>
        </div>
      ),
    },
  ];

  return (
    <>
      <header className={styles.pageHeader}>
        <div>
          <span className={styles.eyebrow}>Administración</span>
          <h1 className={styles.title}>Usuarios del sistema</h1>
          <p className={styles.subtitle}>Gestiona el acceso y el rol asignado. Cada usuario tiene un único rol.</p>
        </div>

        <div className={styles.actions}>
          <button type="button" className={`${styles.btn} ${styles.btnOutline} ${styles.btnExcel}`}
            onClick={() => handleExport("excel")} disabled={exporting !== null}>
            {exporting === "excel" ? <Loader2 size={18} className={styles.spin} /> : <FileSpreadsheet size={18} />}
            Exportar Excel
          </button>

          <button type="button" className={`${styles.btn} ${styles.btnOutline} ${styles.btnPdf}`}
            onClick={() => handleExport("pdf")} disabled={exporting !== null}>
            {exporting === "pdf" ? <Loader2 size={18} className={styles.spin} /> : <FileText size={18} />}
            Exportar PDF
          </button>

          <Can permission="crud.users">
            <button type="button" className={`${styles.btn} ${styles.btnPrimary}`} onClick={() => setModalOpen(true)}>
              <Plus size={18} /> Nuevo usuario
            </button>
          </Can>
        </div>
      </header>

      <section className={styles.stats} aria-label="Resumen de usuarios">
        <StatCard value={stats.total} label="Usuarios totales" tone={styles.statTeal} />
        <StatCard value={stats.active} label="Activos" tone={styles.statYellow} />
        <StatCard value={stats.inactive} label="Inactivos" tone={styles.statBlue} />
      </section>

      <div className={styles.banner}>
        <Info size={18} />
        <p>
          Los permisos se heredan del <strong>rol asignado</strong>. Para cambiar los permisos de un grupo
          de usuarios, modifica el rol en <strong>Permisos por rol</strong>.
        </p>
      </div>

      {notice && (
        <div className={`${styles.banner} ${styles.bannerSuccess}`} role="status">
          <CheckCircle2 size={18} />
          <p>{notice}</p>
        </div>
      )}

      {error && (
        <div className={`${styles.banner} ${styles.bannerError}`} role="alert">
          <AlertCircle size={18} />
          <p>{error}</p>
        </div>
      )}

      <section className={styles.panel}>
        <div className={styles.toolbar}>
          <label className={styles.search}>
            <Search size={16} />
            <input name="search" className={styles.input} placeholder="Buscar por nombre o usuario"
              value={filters.search} onChange={handleFilterChange} aria-label="Buscar usuarios" />
          </label>

          <select name="roleId" className={styles.select} value={filters.roleId}
            onChange={handleFilterChange} aria-label="Filtrar por rol">
            <option value="">Todos los roles</option>
            {catalogs.roles.map((r) => <option key={r.value} value={r.value}>{r.label}</option>)}
          </select>

          <select name="companyAreaId" className={styles.select} value={filters.companyAreaId}
            onChange={handleFilterChange} aria-label="Filtrar por área">
            <option value="">Todas las áreas</option>
            {catalogs.areas.map((a) => <option key={a.value} value={a.value}>{a.label}</option>)}
          </select>

          {catalogs.positions.length > 0 && (
            <select name="companyPositionId" className={styles.select} value={filters.companyPositionId}
              onChange={handleFilterChange} aria-label="Filtrar por puesto">
              <option value="">Todos los puestos</option>
              {catalogs.positions.map((p) => <option key={p.value} value={p.value}>{p.label}</option>)}
            </select>
          )}

          <select name="status" className={styles.select} value={filters.status}
            onChange={handleFilterChange} aria-label="Filtrar por estado">
            <option value="">Todos los estados</option>
            <option value={USER_STATUS.ACTIVO}>Activo</option>
            <option value={USER_STATUS.INACTIVO}>Inactivo</option>
          </select>

          {hasFilters && (
            <button type="button" className={styles.linkBtn} onClick={clearFilters}>Limpiar filtros</button>
          )}

          <span className={styles.count}>{result.totalCount} usuarios</span>
        </div>

        <DataTable
          columns={columns}
          rows={result.items}
          loading={loading}
          emptyMessage={hasFilters ? "Ningún usuario coincide con los filtros." : "Aún no hay usuarios registrados."}
          pagination={{
            page,
            pageSize: result.pageSize || PAGE_SIZE,
            totalCount: result.totalCount,
            totalPages: result.totalPages,
            onPageChange: setPage,
          }}
        />
      </section>

      <UserFormModal
        open={modalOpen}
        onClose={() => setModalOpen(false)}
        onCreated={handleCreated}
        catalogs={catalogs}
      />
    </>
  );
};











