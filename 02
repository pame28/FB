.moduleHeader {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 8px 0 6px;
  padding: 12px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.06);
  color: inherit;
  text-decoration: none;
  white-space: nowrap;
  overflow: hidden;
  transition: background 0.15s ease, border-color 0.15s ease;
}
.moduleHeader:hover { background: rgba(255, 255, 255, 0.1); }
.moduleHeader:focus-visible {
  outline: 2px solid var(--bp-yellow-opt, #f5b301);
  outline-offset: -2px;
}

/* Activo: cuando estás en la vista general del módulo */
.moduleHeaderActive {
  border-color: color-mix(in srgb, var(--bp-yellow-opt, #f5b301) 55%, transparent);
  background: rgba(255, 255, 255, 0.1);
}
.collapsed .moduleHeaderActive .moduleIcon {
  box-shadow: 0 0 0 2px var(--bp-blue-expert, #0b2545), 0 0 0 4px var(--bp-yellow-opt, #f5b301);
}