/* ---- Tarjeta de filtros ---- */
.filterCard {
  margin-bottom: 20px;
  padding: 20px 22px;
  border: 1px solid #e6ebf1;
  border-radius: 14px;
  background: #fff;
}

.filterCardTitle {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 0 0 16px;
  font-size: 14px;
  font-weight: 800;
  color: var(--bp-blue-expert);
}

.filterGrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px 24px;
}
.filterGrid .search { max-width: none; }

.filterActions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  margin-top: 18px;
}

.btnGhost { background: transparent; border-color: transparent; color: var(--bp-blue-expert); }
.btnGhost:hover:not(:disabled) { background: #f2f5f9; }

.statusPlain { font-size: 13px; font-weight: 700; }











