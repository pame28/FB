.login-page {
  width: 100%;
  min-height: 100vh;
  display: flex;
  align-items: stretch;
  background: var(--bp-grey-l);
}

.login-left {
  flex: 1 1 60%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 48px;
  position: relative;
  overflow: hidden;
  color: var(--bp-white);
  background: linear-gradient(180deg, var(--bp-blue) 0%, var(--bp-blue-expert) 100%);
}

.login-left .brand { text-align: center; }

.login-left .brand img.logo {
  width: 88px;
  height: auto;
  margin-bottom: 18px;
}

.login-left .brand h1 {
  font-size: 42px;
  font-weight: 700;
  letter-spacing: -1px;
}

.login-left .subtitle {
  margin-top: 14px;
  font-size: 18px;
  opacity: 0.9;
}

.login-right {
  flex: 1 1 40%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 56px 36px;
  background: var(--bp-grey-l);
}

.login-card {
  width: 100%;
  max-width: 420px;
  padding: 34px;
  border-radius: 12px;
  background: var(--bp-white);
  box-shadow: 0 -3px 0 0 var(--bp-yellow-opt);
}

.login-card .title {
  margin-bottom: 6px;
  font-size: 26px;
  font-weight: 700;
  color: var(--bp-blue-expert);
}

.login-card .help {
  margin-bottom: 22px;
  font-size: 13px;
  color: var(--bp-black);
}

.login-label {
  margin-top: 30px;
  font-size: 13px;
  font-weight: 700;
  color: var(--bp-blue-expert);
}

.login-field {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 15px 0 14px;
  padding: 10px 12px;
  border: 1px solid var(--bp-grey-l);
  border-radius: 8px;
  background: var(--bp-white);
}

.login-field img {
  width: 22px;
  height: 22px;
  opacity: 0.7;
}

.login-field input {
  flex: 1 1 auto;
  border: none;
  outline: none;
  background: transparent;
  font-size: 14px;
  color: var(--bp-blue-expert);
}

.login-field input::placeholder { color: var(--bp-grey-dark); }

.checkbox-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 10px 0 18px;
}

.checkbox-row input[type="checkbox"] {
  width: 18px;
  height: 18px;
}

.login-btn {
  width: 100%;
  margin-top: 40px;
  padding: 12px 16px;
  border: none;
  border-radius: 10px;
  background-color: var(--bp-yellow-opt);
  color: var(--bp-blue-expert);
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
  transition: opacity 0.2s ease;
}

.login-btn:hover:not(:disabled) { opacity: 0.9; }

.login-btn:disabled,
.login-btn.disabled {
  opacity: 0.6;
  cursor: not-allowed;
  background-color: var(--bp-grey-l);
}

.hr-yellow { border: 3px solid var(--bp-yellow-opt); }

.loading {
  display: block;
  height: 30px;
  margin: 8px auto;
}

.div-error {
  width: 100%;
  min-height: 50px;
  padding: 10px;
  border: 1px solid var(--bp-red-light);
  border-radius: 5px;
  background-color: var(--bp-white);
  box-shadow: -3px 0 0 0 var(--bp-red);
}

.label-error {
  width: 100%;
  font-size: 12px;
  color: var(--bp-red);
}

@media (max-width: 900px) {
  .login-page { flex-direction: column; }
  .login-left { display: none; }
  .login-right {
    flex: 1 1 100%;
    min-height: 100vh;
    padding: 24px;
  }
}