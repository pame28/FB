// Quita filtros vacíos para que el backend no los interprete como filtro
const cleanFilters = (filters = {}) =>
  Object.fromEntries(
    Object.entries(filters).filter(([, v]) => v !== "" && v !== null && v !== undefined)
  );

export const usersService = {
  filter: async (filters) => {
    const { data } = await apiFeedbackAuthorized.post(endpointsAPI.usersFilter, cleanFilters(filters));
    return data.data; // { items, pageNumber, pageSize, totalCount, totalPages }
  },

  create: async (user) => {
    const { data } = await apiFeedbackAuthorized.post(endpointsAPI.users, user);
    return data.data;
  },

  // Sin pageNumber/pageSize → exporta todo lo filtrado
  exportExcel: (filters) =>
    apiFeedbackAuthorized.post(endpointsAPI.usersExportExcel, cleanFilters(filters), { responseType: "blob" }),

  exportPdf: (filters) =>
    apiFeedbackAuthorized.post(endpointsAPI.usersExportPdf, cleanFilters(filters), { responseType: "blob" }),
};









export const toTitleCase = (text = "") =>
  text.toLowerCase().replace(/(^|\s)\S/g, (c) => c.toUpperCase());







export const downloadBlob = (response, fallbackName) => {
  const disposition = response.headers?.["content-disposition"] ?? "";
  const match = disposition.match(/filename\*?=(?:UTF-8'')?["']?([^"';]+)/i);
  const fileName = match ? decodeURIComponent(match[1]) : fallbackName;

  const url = URL.createObjectURL(response.data);
  const link = document.createElement("a");
  link.href = url;
  link.download = fileName;
  document.body.appendChild(link);
  link.click();
  link.remove();
  URL.revokeObjectURL(url);
};







import { useEffect, useState } from "react";

export const useDebounce = (value, delay = 400) => {
  const [debounced, setDebounced] = useState(value);

  useEffect(() => {
    const timer = setTimeout(() => setDebounced(value), delay);
    return () => clearTimeout(timer);
  }, [value, delay]);

  return debounced;
};











import { useEffect, useState } from "react";
import { apiFeedbackAuthorized } from "../api/APIS";
import { endpointsAPI } from "../api/endpointApi";

const fetchList = async (endpoint, mapItem) => {
  try {
    const { data } = await apiFeedbackAuthorized.get(endpoint);
    return (data.data ?? []).map(mapItem);
  } catch {
    return [];
  }
};

export const useCatalogs = () => {
  const [catalogs, setCatalogs] = useState({ roles: [], areas: [], positions: [] });

  useEffect(() => {
    let cancelled = false;

    Promise.all([
      // Roles: campos de RoleDto (id, roleName, roleDescription)
      fetchList(endpointsAPI.roles, (r) => ({ value: r.id, label: r.roleName, description: r.roleDescription })),
      // ⚠️ Áreas y puestos: ajusta los nombres de campos a lo que devuelva la API
      fetchList(endpointsAPI.companyAreas, (a) => ({ value: a.id, label: a.name, description: a.description })),
      fetchList(endpointsAPI.companyPositions, (p) => ({ value: p.id, label: p.name })),
    ]).then(([roles, areas, positions]) => {
      if (!cancelled) setCatalogs({ roles, areas, positions });
    });

    return () => { cancelled = true; };
  }, []);

  return catalogs;
};










import { ChevronLeft, ChevronRight } from "lucide-react";
import styles from "./DataTable.module.css";

/**
 * <DataTable
 *   columns={[{ key, header, render?: (row) => node, align?: "left" | "center" | "right", width? }]}
 *   rows={[...]}
 *   rowKey="id"
 *   loading={false}
 *   pagination={{ page, pageSize, totalCount, totalPages, onPageChange }}
 * />
 */
export function DataTable({
  columns,
  rows = [],
  rowKey = "id",
  loading = false,
  emptyMessage = "No hay registros para mostrar.",
  pagination,
}) {
  const getKey = (row, i) => (typeof rowKey === "function" ? rowKey(row) : row[rowKey]) ?? i;

  return (
    <div className={styles.wrapper}>
      <div className={styles.scroll}>
        <table className={styles.table}>
          <thead>
            <tr>
              {columns.map((col) => (
                <th key={col.key} style={{ width: col.width, textAlign: col.align }}>
                  {col.header}
                </th>
              ))}
            </tr>
          </thead>

          <tbody>
            {loading ? (
              Array.from({ length: 5 }, (_, i) => (
                <tr key={`skeleton-${i}`}>
                  {columns.map((col) => (
                    <td key={col.key}><span className={styles.skeleton} /></td>
                  ))}
                </tr>
              ))
            ) : rows.length === 0 ? (
              <tr>
                <td colSpan={columns.length} className={styles.empty}>{emptyMessage}</td>
              </tr>
            ) : (
              rows.map((row, i) => (
                <tr key={getKey(row, i)}>
                  {columns.map((col) => (
                    <td key={col.key} style={{ textAlign: col.align }}>
                      {col.render ? col.render(row) : row[col.key] ?? "—"}
                    </td>
                  ))}
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>

      {pagination && pagination.totalCount > 0 && <Pagination {...pagination} />}
    </div>
  );
}

function Pagination({ page, pageSize, totalCount, totalPages, onPageChange }) {
  const from = (page - 1) * pageSize + 1;
  const to = Math.min(page * pageSize, totalCount);

  return (
    <div className={styles.pagination}>
      <span>Mostrando {from}–{to} de {totalCount}</span>

      <div className={styles.pager}>
        <button
          type="button"
          className={styles.pageBtn}
          onClick={() => onPageChange(page - 1)}
          disabled={page <= 1}
          aria-label="Página anterior"
        >
          <ChevronLeft size={16} />
        </button>
        <span className={styles.pageInfo}>Página {page} de {Math.max(totalPages, 1)}</span>
        <button
          type="button"
          className={styles.pageBtn}
          onClick={() => onPageChange(page + 1)}
          disabled={page >= totalPages}
          aria-label="Página siguiente"
        >
          <ChevronRight size={16} />
        </button>
      </div>
    </div>
  );
}







