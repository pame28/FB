.layout {
  --navbar-h: 80px;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f4f6fa;
}

.body { flex: 1; display: flex; min-height: 0; }

.content { flex: 1; min-width: 0; padding: 32px; }

.container { max-width: 1280px; margin: 0 auto; }

@media (max-width: 860px) {
  .content { padding: 20px 16px; }
}