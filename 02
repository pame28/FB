import axios from "axios"
import { useIDBStore } from "../hooks/useIDBStore"
const { readData } = useIDBStore();

//Configuración de BaseURL para API Feedback Colaboradores
const apiFeedback = axios.create({
    baseURL: atob(config.apiUrl)
})

//Configuración de BaseURL para API Feedback Colaboradores
const apiFeedbackAuthorized = axios.create({
    baseURL: atob(config.apiUrl)
})

//Configuración de Authorization para API Feedback Colaboradores
//Esto permite que para todas las peticiones que se realicen se envie siempre el header Authorization con el Bearer Token
apiFeedbackAuthorized.interceptors.request.use(async (configuration) => {
    const token = await readData('Authentication', 'token');
    // const token = localStorage.getItem("token");
    configuration.headers = {
        Authorization: 'Bearer ' + token
    }
    return configuration;
})


export { apiFeedback, apiFeedbackAuthorized } 






