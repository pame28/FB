// Campos que acepta el filtro. null = ese filtro no se aplica.
const FILTER_FIELDS = [
  "search",
  "status",
  "employeeBranchUbication",
  "companyPositionId",
  "companyLocationId",
  "companyAreaId",
  "companyBranchId",
  "roleId",
  "pageNumber",
  "pageSize",
];

const toFilterRequest = (filters = {}) =>
  Object.fromEntries(
    FILTER_FIELDS.map((field) => {
      const value = filters[field];
      return [field, value === "" || value === undefined ? null : value];
    })
  );











export const usersService = {
  filter: async (filters) => {
    const { data } = await apiFeedbackAuthorized.post(endpointsAPI.usersFilter, toFilterRequest(filters));
    return data.data;
  },

  create: async (user) => {
    const { data } = await apiFeedbackAuthorized.post(endpointsAPI.users, user);
    return data.data;
  },

  // pageNumber y pageSize en null → exporta todo lo filtrado
  exportExcel: (filters) =>
    apiFeedbackAuthorized.post(endpointsAPI.usersExportExcel, toFilterRequest(filters), { responseType: "blob" }),

  exportPdf: (filters) =>
    apiFeedbackAuthorized.post(endpointsAPI.usersExportPdf, toFilterRequest(filters), { responseType: "blob" }),
};









