// Agrega a cada página su ruta completa, ej: "/mantenimientos/usuarios"
export const MODULES = RAW_MODULES.map((m) => ({
  ...m,
  pages: m.pages.map((p) => ({ ...p, fullPath: `${m.path}/${p.path}` })),
}));

/* ============================================================
   Accesos
   ============================================================ */

// Páginas sin pageId: visibles en desarrollo (npm run dev), ocultas en producción
const SHOW_PENDING_PAGES = import.meta.env.DEV;

// Módulos "Próximamente": cambia a false si prefieres ocultarlos
const SHOW_COMING_SOON = true;

/**
 * Devuelve solo los módulos y páginas que el rol puede ver.
 * Se usa en Home, Sidebar y AppRouter.
 */
export const getAllowedModules = (role) => {
  const allowedPageIds = new Set(
    role?.modules?.flatMap((m) => m.pages.map((p) => p.pageId)) ?? []
  );

  const canSeePage = (page) =>
    page.pageId == null ? SHOW_PENDING_PAGES : allowedPageIds.has(page.pageId);

  return MODULES.flatMap((m) => {
    if (m.pages.length === 0) return SHOW_COMING_SOON ? [m] : [];

    const pages = m.pages.filter(canSeePage);
    return pages.length > 0 ? [{ ...m, pages }] : []; // sin páginas permitidas, el módulo no aparece
  });
};

/**
 * Junta todos los permisos del rol en un Set, ej: "edit.users", "read.users"...
 * Lo usa usePermissions() para mostrar u ocultar botones.
 */
export const getPermissions = (role) =>
  new Set(
    role?.modules?.flatMap((m) => m.pages.flatMap((p) => p.permissions)) ?? []
  );

/* ============================================================
   Breadcrumb del navbar
   ============================================================ */
export const getBreadcrumb = (pathname) => {
  const module = MODULES.find((m) => pathname === m.path || pathname.startsWith(`${m.path}/`));
  if (!module) return [];

  const crumbs = [{ label: module.label, to: module.path }];
  const page = module.pages.find((p) => pathname.startsWith(p.fullPath));
  if (page) crumbs.push({ label: page.label, to: page.fullPath });
  return crumbs;
};