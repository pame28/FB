using ApiFeedbackColaboradores.Configuration;
using ApiFeedbackColaboradores.Data;
using ApiFeedbackColaboradores.Endpoints.Security;
using ApiFeedbackColaboradores.Extensions;
using Microsoft.EntityFrameworkCore;
using Serilog;

var builder = WebApplication.CreateBuilder(args);


builder.Configuration.AddJsonFile("serilogsettings.json", optional: false, reloadOnChange: false);

//Configuración de logs
Log.Logger = new LoggerConfiguration()
    .ReadFrom.Configuration(builder.Configuration)
    .CreateLogger();

var appSettings = builder.Configuration.GetSection("Settings").Get<AppSettings>() ?? new AppSettings();

builder.Services.AddSingleton(appSettings);
builder.Services.AddConfiguredCors(appSettings);

builder.Services.AddDbContext<AppDbContext>(
    options => options.UseSqlServer(builder.Configuration.GetConnectionString("FeedbackColaboradoresDB"))
);

var corsPolicyName = "FeedBackColaboradoresCorsPolicy";
builder.Services.AddCors(options =>
{
    options.AddPolicy(
        name: corsPolicyName,
        policy =>
        {
            if (appSettings.CorsPolicy.AllowedOrigins.Length <= 0)
                policy.AllowAnyOrigin();
            else
                policy.WithOrigins(appSettings.CorsPolicy.AllowedOrigins);

            if (appSettings.CorsPolicy.AllowedMethods.Length <= 0)
                policy.AllowAnyMethod();
            else
                policy.WithMethods(appSettings.CorsPolicy.AllowedMethods);

            if (appSettings.CorsPolicy.AllowedHeaders.Length <= 0)
                policy.AllowAnyHeader();
            else
                policy.WithHeaders(appSettings.CorsPolicy.AllowedHeaders);

            if (appSettings.CorsPolicy.AllowCredentials)
                policy.AllowCredentials();
        }
    );
});


builder.Services.AddRepositories();
builder.Services.AddServices();
builder.Services.AddSwagger();

var app = builder.Build();

app.UseSwagger();
app.UseSwaggerUI();
app.UseConfiguredCors(appSettings);

app.MapSecurityEndpoints();

await app.RunAsync();





