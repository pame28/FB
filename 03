        public bool EjecutarBulkInsertBandejaVasa(DataTable tableCuentas)
        {
            ConnectionManager cm = Dts.Connections["BANDEJAVASA"];
            SqlConnection conn = null;

            try
            {
                conn = cm.AcquireConnection(null) as SqlConnection;
                if (conn == null)
                {
                    throw new InvalidOperationException("No se pudo obtener la conexión desde el Connection Manager.");
                }

                using (SqlBulkCopy bulkCopy = new SqlBulkCopy(conn))
                {
                    bulkCopy.DestinationTableName = parametros["ArchivoDestino"];
                    bulkCopy.BulkCopyTimeout = TimeoutSegundos;
                    bulkCopy.BatchSize = 5000;
                    bulkCopy.WriteToServer(tableCuentas);
                }

                return true;

            }


            catch (Exception ex)
            {
                RegistraProceso("F", $"Falló bulkInsert {parametros["ArchivoDestino"]} con error {ex.Message}");

                return false;
            }
            finally
            {
                if (conn != null)
                    cm.ReleaseConnection(conn);
            }
        }

       
        public bool UpdateArchivoAS400()
        {

            ConnectionManager cm = Dts.Connections["AS400"];
            OleDbConnection conn = null;

            try
            {
                conn = cm.AcquireConnection(null) as OleDbConnection;
                if (conn == null)
                {
                    throw new InvalidOperationException("No se pudo obtener la conexión desde el Connection Manager.");
                }

                using (IDbCommand cmd = conn.CreateCommand())
                {
                    cmd.CommandText = sql_ConsultaActualizar;
                    cmd.CommandTimeout = TimeoutSegundos;
                    int rowsAffected = cmd.ExecuteNonQuery();

                    if (rowsAffected == 0)
                    {
                        RegistraProceso("F", $"Actualizar estado archivo: {parametros["ArchivoControl"]} no afectó ningún registro");
                        return false;
                    }
                }

            }
            catch (Exception ex)
            {
                RegistraProceso("F", $"Falló actualizar estado archivo: {parametros["ArchivoControl"]} con error {ex.Message}");

                return false;
            }
            finally
            {
                if (conn != null)
                    cm.ReleaseConnection(conn);
            }

            return true;
        }

        private object LimpiarEspacios(object valor)
        {
            if (valor == null || valor == DBNull.Value)
                return DBNull.Value;

            // Convertimos a string y eliminamos espacios
            var texto = valor.ToString().Trim();

            // Si después del Trim queda vacío, lo tratamos como NULL
            if (texto.Length == 0)
                return DBNull.Value;

            return texto;
        }

        public void RegistraProceso(string estadoProceso, string mensaje)
        {
            ConnectionManager cm = Dts.Connections["DESCARGAINFO"];
            SqlConnection conn = null;

            try
            {
                conn = cm.AcquireConnection(null) as SqlConnection;
                if (conn == null)
                {
                    throw new InvalidOperationException("No se pudo obtener la conexión desde el Connection Manager.");
                }

                using (SqlCommand cmd = new SqlCommand(parametros["RegistroProceso"], conn))
                {
                    cmd.CommandType = CommandType.StoredProcedure;
                    cmd.CommandTimeout = TimeoutSegundos;

                    cmd.Parameters.Add("@Proceso", SqlDbType.VarChar).Value = "Etarjetas";
                    cmd.Parameters.Add("@EstadoProceso", SqlDbType.VarChar).Value = estadoProceso;
                    cmd.Parameters.Add("@Mensaje", SqlDbType.VarChar).Value = mensaje;

                    cmd.ExecuteNonQuery();
                }

            }
            catch (Exception ex)
            {
                // Si el log falla, al menos queda en el historial del Job / log de SSIS
                Dts.Events.FireWarning(0, "RegistraProceso",
                    $"No se pudo registrar en log. Mensaje original: {mensaje} | Error: {ex.Message}", "", 0);
            }
            finally
            {
                if (conn != null)
                    cm.ReleaseConnection(conn);
            }
        }


