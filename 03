using System;
using System.Collections.Generic;
using System.Linq;
using System.Web;
using System.Web.UI;
using System.Web.UI.WebControls;
using System.Data.SqlClient;
using System.Configuration;
using DevExpress.Web.ASPxEditors;

namespace BasePerdidasOperativas.Mantenimientos
{
    public partial class UsuarioAcceso : System.Web.UI.Page
    {
        protected void Page_Load(object sender, EventArgs e)
        {
            if (Session["usuarioid"] == null)
            {
                Response.Redirect("~/Transacciones/Login.aspx");
            }

            if (!Page.IsPostBack)
            {
                GridView1.SelectedIndex = 0;
            }

            if (Convert.ToInt32(Session["privilegioid"]) != 1)
            {
                GridView1.Visible = false;
                DetailsView1.Visible = false;
                LblError.Visible = true;
                LblError.ForeColor = System.Drawing.Color.Red;
                LblError.Text = "NO TIENE PERMISOS PARA INGRESAR A ESTE MANTENIMIENTO.";
            }
            else
            {
                LblError.Visible = false;
            }
        }

        protected void ImageButton1_Click(object sender, ImageClickEventArgs e)
        {
            String filtro = "";
            for (int i = 0; i < TxtFiltro.Text.Length; i++)
            {
                if (TxtFiltro.Text.Substring(i, 1) != "'" & TxtFiltro.Text.Substring(i, 1) != "[" & TxtFiltro.Text.Substring(i, 1) != "]" & TxtFiltro.Text.Substring(i, 1) != "}" & TxtFiltro.Text.Substring(i, 1) != "{")
                {
                    filtro += TxtFiltro.Text.Substring(i, 1);
                }
            }
            SqlDataSource1.FilterExpression = string.Format("Acceso like '%{0}%'", filtro);
        }

        protected void ImageButton2_Click(object sender, ImageClickEventArgs e)
        {
            DetailsView1.ChangeMode(DetailsViewMode.Insert);
        }

        protected void ImageButton3_Click(object sender, ImageClickEventArgs e)
        {
            DetailsView1.ChangeMode(DetailsViewMode.Insert);
        }

        protected void DetailsView1_ItemDeleted(object sender, DetailsViewDeletedEventArgs e)
        {
            if (e.Exception == null)
            {
                //DisplayValues(e);
                LblError.Visible = true;
                LblError.Text = "REGISTRO ELIMINADO.";
                LblError.ForeColor = System.Drawing.Color.Green;
            }
            else
            {
                string[] error = { e.Exception.Message };

                string[] Errores = { "REFERENCE" };

                foreach (string s in error)
                {

                    if (System.Text.RegularExpressions.Regex.IsMatch(s, Errores[0], System.Text.RegularExpressions.RegexOptions.IgnoreCase))
                    {
                        LblError.Visible = true;
                        LblError.ForeColor = System.Drawing.Color.Red;
                        LblError.Text = "NO SE PUEDE ELIMINAR EL REGISTRO. ESTE ACCESO ESTÁ SIENDO UTILIZADO.";
                    }
                }

                // Use the ExceptionHandled property to indicate that the 
                // exception is already handled.
                e.ExceptionHandled = true;

            }
            actualizarpage();
        }

        /// <summary>
        /// Actualiza el Grid, DetailGrid y limpia el Texbox de Filtro.
        /// </summary>
        public void actualizarpage()
        {
            GridView1.DataBind();
            DetailsView1.DataBind();
            TxtFiltro.Text = "";
        }

       

        protected void DetailsView1_ItemInserted(object sender, DetailsViewInsertedEventArgs e)
        {
            if (e.Exception == null)
            {
                //DisplayValues(e);
                LblError.Visible = true;
                LblError.Text = "REGISTRO ALMACENADO.";
                LblError.ForeColor = System.Drawing.Color.Green;
            }
            else
            {
                string[] error = { e.Exception.Message };

                string[] Errores = { "Cannot insert duplicate key", "Cannot insert the value NULL" };

                foreach (string s in error)
                {

                    if (System.Text.RegularExpressions.Regex.IsMatch(s, Errores[0], System.Text.RegularExpressions.RegexOptions.IgnoreCase))
                    {
                        LblError.Visible = true;
                        LblError.ForeColor = System.Drawing.Color.Red;
                        LblError.Text = "NO SE PUEDE ALMACENAR EL REGISTRO. ACCESO YA EXISTE.";
                        break;
                    }
                    if (System.Text.RegularExpressions.Regex.IsMatch(s, Errores[1], System.Text.RegularExpressions.RegexOptions.IgnoreCase))
                    {
                        LblError.Visible = true;
                        LblError.ForeColor = System.Drawing.Color.Red;
                        LblError.Text = "NO SE PUEDE ALMACENAR EL REGISTRO. FAVOR DE LLENAR LOS CAMPOS OBLIGATORIOS.";
                        break;
                    }
                    else
                    {
                        LblError.Visible = true;
                        LblError.ForeColor = System.Drawing.Color.Red;
                        LblError.Text = "ERROR: " + e.Exception.Message;
                    }
                }

                // Use the ExceptionHandled property to indicate that the 
                // exception is already handled.
                e.ExceptionHandled = true;
                // When an exception occurs, keep the DetailsView
                // control in edit mode.
                e.KeepInInsertMode = true;
            }
            actualizarpage();
        }

        protected void Button1_Click(object sender, EventArgs e)
        {
            Response.Redirect("~/Mantenimientos/Usuarios.aspx");
        }


    }
