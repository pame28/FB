    <asp:SqlDataSource ID="SqlDataSourceAccesosExtra" runat="server" 
        ConnectionString="<%$ ConnectionStrings:BasePerdidasOperativas.Properties.Settings.SettingConnectionString %>" 
        SelectCommand="SELECT [idMenu]
      ,[padre]
      ,[URL]
      ,[Acceso]
      ,[orden]
      ,[activo]
      ,[visible]
  FROM [Menu] X
  WHERE NOT EXISTS(SELECT 1
	FROM   UsuarioAcceso pa
		   INNER JOIN Menu m
				ON  m.idMenu = pa.idMenu 
		   INNER JOIN tblUsuarios u
				ON  u.privilegioid = pa.privilegioid
				INNER JOIN tblPrivilegios p
				ON p.privilegioid = pa.privilegioid
	WHERE  u.UsuarioId = @UsuarioId
		   AND u.activo = 1
		   AND m.activo = 1
		   AND m.idMenu=X.idMenu
	UNION ALL
	SELECT DISTINCT 1
	FROM   Menu m
		   INNER JOIN tblAccesoExtra ae
				ON  m.idMenu = ae.idMenu
	Where ae.UsuarioId = @UsuarioId AND m.idMenu=X.idMenu)
  order by idMenu asc" 
        DeleteCommand="DELETE FROM tblAccesoExtra WHERE (usuarioid= @usuarioid) AND (idMenu=@idMenu)
DELETE FROM tblMenu WHERE (usuarioid= @usuarioid) AND (idMenu=@idMenu)" 
        InsertCommand="INSERT INTO tblAccesoExtra VALUES  (@usuarioid,@IdMenu)
">
        <DeleteParameters>
            <asp:SessionParameter Name="usuarioid" SessionField="UsuarioAcceso" />
            <asp:Parameter Name="idMenu" />
        </DeleteParameters>
        <InsertParameters>
            <asp:SessionParameter Name="usuarioid" SessionField="UsuarioAcceso"/>
            <asp:Parameter Name="IdMenu" />
