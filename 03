using ApiCoaching.Dtos.Coaching;
using ApiCoaching.Models;

namespace ApiCoaching.Repositories.Interfaces
{
    public interface ICoachingRepository
    {
        Task<Team?> GetTeamMembersByLeaderIdAsync(string userLeaderId);

        Task<List<MemberIndicatorAssignmentDto>> GetMemberIndicatorsAsync(string leaderUserId, string memberUserId);

        Task<List<MyCoachingSessionDto>> GetMySessionsAsync(string memberUserId, CoachingSessionAcceptanceStatus? status);

        Task<RespondSessionStatus> RespondSessionAcceptanceAsync(
            long sessionId, string memberUserId, bool accept, string? reason);

        Task<List<CoachingHistoryDto>> GetCoachHistoryAsync(string coachUserId);

        Task<List<MyCoachingProcessDto>> GetMyProcessesAsync(string memberUserId, CoachingSessionReviewStatus? status);

        Task<RespondSessionStatus> RespondSessionReviewAsync(
            long sessionId, string memberUserId, bool approve, string? reason);

        Task<CreateIndicatorAssignmentsResult> CreateIndicatorAssignmentsAsync(
            IEnumerable<TeamMemberIndicatorAssignment> assignments);

        Task<SaveCoachingResultsResult> SaveCoachingResultsAsync(
            long sessionId,
            SaveCoachingResultsRequestDto request,
            string leaderUserId);
    };

     Task<CoachingSessionExportDto?> GetSessionExportAsync(long sessionId, string userId);

    public enum RespondSessionStatus
    {
        Done,
        NotFound,
        Invalid
    }

    public sealed record CreateIndicatorAssignmentsResult(
        bool Success,
        string? ErrorMessage,
        List<TeamMemberIndicatorAssignment> Assignments);

    public enum SaveCoachingResultsStatus
    {
        Saved,
        NotFound,
        Invalid,
        AlreadyEvaluated
    }

    public sealed record SaveCoachingResultsResult(
        SaveCoachingResultsStatus Status,
        string? ErrorMessage,
        CoachingResultsDto? Data,
        Dictionary<string, string>? Errors = null);
}







