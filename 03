protected global::System.Web.UI.WebControls.DetailsView DetailsView1;







protected void DetailsView1_ItemInserting(object sender, DetailsViewInsertEventArgs e)
{
    // Acceso seleccionado en el combo
    object valor = e.Values["idMenu"];
    if (valor == null)
    {
        ASPxComboBox combo = (ASPxComboBox)DetailsView1.FindControl("ASPxComboBox4");
        valor = combo != null ? combo.Value : null;
    }
    if (valor == null) return;

    int idMenu = Convert.ToInt32(valor);
    int usuarioDestino = Convert.ToInt32(Session["UsuarioAcceso"]);

    // 6 = menú "Reportes"
    if (idMenu == 6 && EsGestor(usuarioDestino))
    {
        e.Cancel = true; // No guarda
        LblError.Visible = true;
        LblError.ForeColor = System.Drawing.Color.Red;
        LblError.Text = "NO SE PUEDE ASIGNAR ESTE REPORTE YA QUE EL USUARIO DESTINO NO ES ADMINISTRADOR";
    }
}

private bool EsGestor(int usuarioId)
{
    string cadena = ConfigurationManager.ConnectionStrings[
        "BasePerdidasOperativas.Properties.Settings.SettingConnectionString"].ConnectionString;
    const string sql = "SELECT privilegioid FROM tblUsuarios WHERE usuarioid = @usuarioid";
    using (SqlConnection cn = new SqlConnection(cadena))
    using (SqlCommand cmd = new SqlCommand(sql, cn))
    {
        cmd.Parameters.AddWithValue("@usuarioid", usuarioId);
        cn.Open();
        object r = cmd.ExecuteScalar();
        return r != null && Convert.ToInt32(r) == 2; // 2 = GESTORES
    }
}










