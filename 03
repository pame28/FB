USE PerdidasOperativas_DESA;
GO
SELECT m.idMenu, m.Acceso, m.padre,
       CASE WHEN EXISTS (SELECT 1 FROM UsuarioAcceso ua
                         WHERE ua.privilegioid = 1 AND ua.IdMenu = m.idMenu)
            THEN 'OK' ELSE 'FALTA' END AS Estado
FROM Menu m
WHERE m.padre IN (1021, 1022) AND m.activo = 1
ORDER BY m.padre, m.orden;





INSERT INTO UsuarioAcceso (privilegioid, usuarioid, IdMenu)
SELECT 1, NULL, m.idMenu
FROM Menu m
WHERE m.padre IN (1021, 1022) AND m.activo = 1
  AND NOT EXISTS (SELECT 1 FROM UsuarioAcceso ua
                  WHERE ua.privilegioid = 1 AND ua.IdMenu = m.idMenu);