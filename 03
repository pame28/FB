        protected bool compararEstructura(DataTable datos)
        {
            bool iguales = true;
            string rutaPlantilla = HttpContext.Current.Request.MapPath("~/Transacciones/Plantillas/PlantillaDemandasJuiciosEjecucion.xlsx");

            try
            {
                //Carga el archivo de plantilla
                //if (File.Exists(rutaPlantilla)) File.Delete(rutaPlantilla);
                //uploadArchivoExcel.SaveAs(rutaPlantilla);
                //
                //Validar Excel
                //
                FileInfo fi = new FileInfo(rutaPlantilla);
                ExcelPackage pk = new ExcelPackage(fi);
                DataTable dtPlantilla = new DataTable();
                dtPlantilla = ExcelPackageToDataTable(pk);

                //Se valida si tienen el mismo número de columnas
                if (dtPlantilla.Columns.Count != datos.Columns.Count)
                {
                    iguales = false;
                    return iguales;
                }

                //Se valida que las columnas se llamen igual y que sean del mismo tipo de dato
                for (int i = 0; i < dtPlantilla.Columns.Count; i++)
                {
                    if (dtPlantilla.Columns[i].ColumnName != datos.Columns[i].ColumnName)
                    {
                        iguales = false;
                    }
                }

            }
            catch (Exception ex)
            {
                LblError.Text = "Ocurrió un error al compararEstructura de archivo." + ex.Message;
                LblError.Visible = true;
                LblError.ForeColor = System.Drawing.Color.Red;
            }

            return iguales;
        }

