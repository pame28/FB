	--INSERTAR EN DEMANDAS Y JUICIOS LOS QUE NO QUEDARON EL NULL
	INSERT INTO tblRegistroDemandasJuiciosEjecucion
	
	SELECT 
		CAST(GETDATE() AS DATE) AS FechaRegistro, E.empresaid, X.empresa, Z.zonaid,	X.Zona,	X.NumeroDemanda,	X.NumeroExpediente,	
		X.FechaPresentacion as FechaPresentacion,
		N.Codigo AS CodigoNaturalezaDemanda, X.NaturalezaDemanda,	X.NombreDemandado,	X.NombreDemandante,	D.Codigo AS CodigoTipoDemandante, X.TipoDemandante,	T.Codigo AS CodigoTipoDemanda,
		X.TipoDemanda,	X.MotivoDemanda,	X.AccionInstitucion,	J.Codigo AS CodigoJuzgadoDemanda,X.JuzgadoDemanda,	X.NombreJuzgado,	X.MontoDemandado,  m.monedaid, X.moneda,  X.TipoCambio,
		P.Codigo AS CodigoResultadoPrimera, X.ResultadoPrimera,	X.FechaActuacion as FechaActuacion,
		S.Codigo AS CodigoResultadoSegunda, X.ResultadoSegunda,	X.MontoGastosLegalesHonorarios,	C.Codigo as CodigoDemandaAsociadaRiesgoCredito, X.DemandaAsociadaRiesgoCredito, G.Id AS IdTipoGarantia,	X.TipoGarantia,	
		PP.Id AS IdProbabilidadPerdida, X.ProbabilidadPerdida,	X.ProcuradorAsignado, @usuario as usuarioCreador, CAST(GETDATE() AS DATE) as FechaInsercion, 'EN PROCESO', 1 as EstadoResgitro,NULL,NULL,NULL,NULL
	FROM [dbo].[tblExcelDemandasJuiciosEjecucion] x
	LEFT JOIN tblEmpresas E
		ON  E.empresa=X.empresa
	LEFT JOIN tblZonas Z
		ON Z.zona=X.Zona
	LEFT JOIN tblNaturalezaDemanda N
		ON TRIM(Convert( varchar(50),N.Codigo)) + ' ' + N.Descripcion=X.NaturalezaDemanda
	LEFT JOIN tblTipoDemandante D
		ON TRIM(Convert( varchar(50),D.Codigo)) + ' ' + D.Descripcion=X.TipoDemandante
	LEFT JOIN tblTipoDemanda T
		ON TRIM(Convert( varchar(50),T.Codigo)) + ' ' + T.Descripcion=X.TipoDemanda
	LEFT JOIN tblJuzgadoDemanda J
		ON TRIM(Convert( varchar(50),J.Codigo)) + ' ' + J.Descripcion=X.JuzgadoDemanda
	LEFT JOIN tblMonedas M
		ON M.moneda=X.moneda
	LEFT JOIN tblResultadoPrimeraInstancia P
		ON TRIM(Convert( varchar(50),P.Codigo)) + ' ' + P.Descripcion=X.ResultadoPrimera
	LEFT JOIN tblResultadoSegundaInstancia S
		ON TRIM(Convert( varchar(50),S.Codigo)) + ' ' + S.Descripcion=X.ResultadoPrimera
	LEFT JOIN tblDemandaAsociadaRiesgoCredito C
		ON TRIM(Convert( varchar(50),C.Codigo)) + ' ' + C.Descripcion=X.DemandaAsociadaRiesgoCredito
	LEFT JOIN tblTipoGarantia G
		ON G.Descripcion=X.TipoGarantia
	LEFT JOIN tblProbabilidadPerdida PP
		ON PP.Descripcion=X.ProbabilidadPerdida
	WHERE X.RegistroError is null

