        protected void DetailsView2_DataBound(object sender, EventArgs e)
        {
            if (DetailsView1.Rows.Count > 0 && DetailsView2.DataItemCount > 0)
            {
                if (DetailsView2.CurrentMode == DetailsViewMode.ReadOnly)
                {
                    Session["empresaid"] = ((Label)DetailsView2.FindControl("LabelEmpresaid")).Text;
                    Session["areaid"] = ((Label)DetailsView2.FindControl("LabelAreaid")).Text;
                }
            }
            if (DetailsView2.CurrentMode == DetailsViewMode.Edit)
            {
                Session["empresaid"] = ((DropDownList)DetailsView2.FindControl("DropDownEmpresa2")).SelectedValue;
            }
            if (DetailsView2.CurrentMode == DetailsViewMode.Insert)
            {
                Session["empresaid"] = ((DropDownList)DetailsView2.FindControl("DropDownEmpresa3")).SelectedValue;
                SqlDataSourceAreas.SelectParameters["empresaid"].DefaultValue = Session["empresaid"].ToString();
            }
        }

