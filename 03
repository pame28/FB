import { useEffect, useMemo, useState } from "react";
import { Link } from "react-router-dom";
import { AlertCircle, Eye, Search, ShieldCheck, TriangleAlert } from "lucide-react";
import { DataTable } from "../../../shared/components";
import { usersService } from "../../../api/usersService";
import { useCatalogs } from "../../../hooks/useCatalogs";
import { useDebounce } from "../../../hooks/useDebounce";
import { userColumns } from "./components/userColumns";
import styles from "../../Pages.module.css";

const PAGE_SIZE = 10;
const EMPTY_FILTERS = { search: "", roleId: "", companyAreaId: "", companyPositionId: "" };

const toNumber = (value) => (value === "" ? undefined : Number(value));
const plural = (n, one, many) => `${n} ${n === 1 ? one : many}`;

export const VistaUsuarioRolPage = () => {
  const catalogs = useCatalogs();

  const [filters, setFilters] = useState(EMPTY_FILTERS);
  const search = useDebounce(filters.search, 400);
  const [page, setPage] = useState(1);

  const [result, setResult] = useState({ items: [], totalCount: 0, totalPages: 0, pageSize: PAGE_SIZE });
  const [loading, setLoading] = useState(true);
  const [firstLoad, setFirstLoad] = useState(true);
  const [error, setError] = useState("");

  const request = useMemo(() => ({
    search: search.trim() || undefined,
    roleId: toNumber(filters.roleId),
    companyAreaId: toNumber(filters.companyAreaId),
    companyPositionId: toNumber(filters.companyPositionId),
  }), [search, filters.roleId, filters.companyAreaId, filters.companyPositionId]);

  const hasFilters = Object.values(filters).some((v) => v !== "");
  const selectedRole = catalogs.roles.find((r) => String(r.value) === filters.roleId);

  // Lista de usuarios
  useEffect(() => {
    let cancelled = false;
    setLoading(true);
    setError("");

    usersService
      .filter({ ...request, pageNumber: page, pageSize: PAGE_SIZE })
      .then((data) => {
        if (!cancelled) {
          setResult(data);
          setFirstLoad(false);
        }
      })
      .catch((err) => {
        if (!cancelled) setError(err.noAccess
          ? "No tienes permiso para ver la lista de usuarios."
          : "No se pudo cargar la lista de usuarios. Intenta de nuevo.");
      })
      .finally(() => { if (!cancelled) setLoading(false); });

    return () => { cancelled = true; };
  }, [request, page]);

  const handleFilterChange = (e) => {
    const { name, value } = e.target;
    setFilters((f) => ({ ...f, [name]: value }));
    setPage(1);
  };

  const clearFilters = () => {
    setFilters(EMPTY_FILTERS);
    setPage(1);
  };

  return (
    <>
      <header className={styles.pageHeader}>
        <div>
          <span className={styles.eyebrow}>Administración</span>
          <h1 className={styles.title}>Vista de usuarios por rol</h1>
          <p className={styles.subtitle}>Consulta de solo lectura. Filtra por rol, área o busca un usuario específico.</p>
        </div>
      </header>

      <div className={styles.banner}>
        <Eye size={18} />
        <p>
          Vista de <strong>solo lectura</strong>. Para modificar el rol de un usuario ve
          a <Link to="/administracion/usuarios-roles" className={styles.bannerLink}>Usuarios y roles</Link>.
        </p>
      </div>

      {catalogs.warnings.map((warning) => (
        <div key={warning} className={`${styles.banner} ${styles.bannerWarning}`} role="status">
          <TriangleAlert size={18} />
          <p>{warning} Algunos filtros no estarán disponibles.</p>
        </div>
      ))}

      {error && (
        <div className={`${styles.banner} ${styles.bannerError}`} role="alert">
          <AlertCircle size={18} />
          <p>{error}</p>
        </div>
      )}

      {/* Resumen del rol seleccionado (sale de GET /api/roles) */}
      {selectedRole && (
        <section className={styles.roleSummary} aria-label={`Resumen del rol ${selectedRole.label}`}>
          <div className={styles.roleSummaryHead}>
            <div className={styles.roleIcon}>
              <ShieldCheck size={20} />
            </div>
            <div>
              <h2 className={styles.roleName}>{selectedRole.label}</h2>
              <p className={styles.roleDesc}>{selectedRole.description || "Este rol no tiene descripción."}</p>
            </div>
            {!loading && (
              <span className={styles.roleCount}>{plural(result.totalCount, "usuario", "usuarios")}</span>
            )}
          </div>

          <div className={styles.roleAccess}>
            <span className={styles.label}>Acceso a</span>
            {selectedRole.modules.length > 0 ? (
              <div className={styles.chips}>
                {selectedRole.modules.flatMap((m) =>
                  m.pages.map((p) => (
                    <span key={`${m.id}-${p.id}`} className={`${styles.tag} ${styles.tagRole}`}>
                      {m.name} · {p.name}
                    </span>
                  ))
                )}
              </div>
            ) : (
              <span className={styles.muted}>Este rol no tiene páginas asignadas.</span>
            )}
          </div>
        </section>
      )}

      <section className={styles.panel}>
        <div className={styles.toolbar}>
          <label className={styles.search}>
            <Search size={16} />
            <input name="search" className={styles.input} placeholder="Buscar por nombre o usuario de red"
              value={filters.search} onChange={handleFilterChange} aria-label="Buscar usuarios" />
          </label>

          <select name="roleId" className={styles.select} value={filters.roleId}
            onChange={handleFilterChange} aria-label="Filtrar por rol">
            <option value="">Todos los roles</option>
            {catalogs.roles.map((r) => <option key={r.value} value={r.value}>{r.label}</option>)}
          </select>

          {catalogs.areas.length > 0 && (
            <select name="companyAreaId" className={styles.select} value={filters.companyAreaId}
              onChange={handleFilterChange} aria-label="Filtrar por área">
              <option value="">Todas las áreas</option>
              {catalogs.areas.map((a) => <option key={a.value} value={a.value}>{a.label}</option>)}
            </select>
          )}

          {catalogs.positions.length > 0 && (
            <select name="companyPositionId" className={styles.select} value={filters.companyPositionId}
              onChange={handleFilterChange} aria-label="Filtrar por puesto">
              <option value="">Todos los puestos</option>
              {catalogs.positions.map((p) => <option key={p.value} value={p.value}>{p.label}</option>)}
            </select>
          )}

          {hasFilters && (
            <button type="button" className={styles.linkBtn} onClick={clearFilters}>Limpiar filtros</button>
          )}

          <span className={styles.count}>
            {firstLoad ? "" : plural(result.totalCount, "usuario", "usuarios")}
          </span>
        </div>

        <DataTable
          columns={userColumns}
          rows={result.items}
          loading={loading}
          emptyMessage={
            selectedRole
              ? `Ningún usuario tiene el rol ${selectedRole.label}${filters.search || filters.companyAreaId ? " con esos filtros" : ""}.`
              : hasFilters ? "Ningún usuario coincide con los filtros." : "Aún no hay usuarios registrados."
          }
          pagination={{
            page,
            pageSize: result.pageSize || PAGE_SIZE,
            totalCount: result.totalCount,
            totalPages: result.totalPages,
            onPageChange: setPage,
          }}
        />
      </section>
    </>
  );
};








