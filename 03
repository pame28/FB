UPDATE Menu
SET Acceso = 'Registro de Información CNBS'
WHERE idMenu = 7;



SELECT u.usuario, u.privilegioid
FROM tblAccesoExtra ae JOIN tblUsuarios u ON u.usuarioid = ae.UsuarioId
WHERE ae.idMenu = 7 AND u.privilegioid <> 2;




SELECT u.usuario, u.nombreenlace, m.idMenu, m.Acceso
FROM tblAccesoExtra ae
JOIN tblUsuarios u ON u.usuarioid = ae.UsuarioId
JOIN Menu m ON m.idMenu = ae.idMenu
WHERE u.privilegioid = 2
  AND (m.idMenu IN (6, 1022) OR m.padre = 1022);