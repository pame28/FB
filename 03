ALTER PROCEDURE [dbo].[usp_ObtenerMenUsuario] 
	-- Add the parameters for the stored procedure here
@Usuario VARCHAR (20)
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;
	--Obtiene usuario ID para hacer la busqueda en la tabla Menú
	DECLARE @UsuarioId INT = (SELECT usuarioid FROM tblUsuarios WHERE usuario=@Usuario)
	 SELECT DISTINCT m.idMenu,
       m.padre,
       m.Acceso,
       m.[URL],
       u.UsuarioId,
       m.visible,
       m.orden
	FROM   UsuarioAcceso pa
		   INNER JOIN Menu m
				ON  m.idMenu = pa.idMenu 
		   INNER JOIN tblUsuarios u
				ON  u.privilegioid = pa.privilegioid
				INNER JOIN tblPrivilegios p
				ON p.privilegioid = pa.privilegioid
	WHERE  u.UsuarioId = @UsuarioId
		   AND u.activo = 1
		   AND m.activo = 1
	UNION ALL
	SELECT DISTINCT m.idMenu,
       m.padre,
       m.Acceso,
       m.[URL],
       ae.UsuarioId,
       m.visible,
       m.orden
	FROM   Menu m
		   INNER JOIN tblAccesoExtra ae
				ON  m.idMenu = ae.idMenu
	Where ae.UsuarioId = @UsuarioId
END





