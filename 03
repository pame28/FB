                    cm.ReleaseConnection(conn);
            }

            return true;
        }

        private object LimpiarEspacios(object valor)
        {
            if (valor == null || valor == DBNull.Value)
                return DBNull.Value;

            // Convertimos a string y eliminamos espacios
            var texto = valor.ToString().Trim();

            // Si después del Trim queda vacío, lo tratamos como NULL
            if (texto.Length == 0)
                return DBNull.Value;

            return texto;
        }

        public void RegistraProceso(string estadoProceso, string mensaje)
        {
            ConnectionManager cm = Dts.Connections["DESCARGAINFO"];
            SqlConnection conn = null;

            try
            {
                conn = cm.AcquireConnection(null) as SqlConnection;
                if (conn == null)
                {
                    throw new InvalidOperationException("No se pudo obtener la conexión desde el Connection Manager.");
                }

                using (SqlCommand cmd = new SqlCommand(parametros["RegistroProceso"], conn))
                {
