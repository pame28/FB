        public List<ModelosLiquidacion> ObtenerInfoSqlServer()
        {
            List<ModelosLiquidacion> modelosLiquidacion = new List<ModelosLiquidacion>();
            ConnectionManager cm = Dts.Connections["BANDEJAVASA"]; 
            SqlConnection conn = null;

            try
            {
                conn = cm.AcquireConnection(null) as SqlConnection;
                if (conn == null)
                {
                    throw new InvalidOperationException("No se pudo obtener la conexión desde el Connection Manager.");
                }

                using (SqlCommand cmd = conn.CreateCommand())
                {
                    cmd.CommandText = sql_ConsultaOrigenBandejaVasa;
                    using (SqlDataReader reader = cmd.ExecuteReader())
                    {
                        while (reader.Read())
