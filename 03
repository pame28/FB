.personInfo {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2px;
  min-width: 0;
  text-align: left;
}

.personName {
  max-width: 100%;
  font-size: 14.5px;
  font-weight: 700;
  color: var(--bp-blue-expert);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}