        private DataTable ObtenerMenu ()
        {
            DataTable dt = new DataTable();
            string connection_String = System.Configuration.ConfigurationManager.ConnectionStrings["BasePerdidasOperativas.Properties.Settings.SettingConnectionString"].ConnectionString;
            SqlConnection sqlcone = new SqlConnection(connection_String);
            SqlCommand cmd = new SqlCommand();
            sqlcone.Open();
            cmd.Connection = sqlcone;
            cmd.CommandText = "usp_ObtenerMenUsuario";
            cmd.CommandType = CommandType.StoredProcedure;
            cmd.Parameters.Add(new SqlParameter("@Usuario",ASPxTextBoxUsr.Text));

            using (SqlDataReader reader = cmd.ExecuteReader())
            {
                dt.Load(reader);

                if (!reader.IsClosed)
                    reader.Close();
            }

            sqlcone.Close();

            return dt;
        }
    }


