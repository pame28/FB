using System;
using System.Collections.Generic;
using System.Linq;
using System.Web;
using System.Web.UI;
using System.Web.UI.WebControls;
using System.Configuration;
using DevExpress.Web;
using System.Data;

namespace BasePerdidasOperativas
{
    public partial class MasterPageBanpais : System.Web.UI.MasterPage
    {
        protected void Page_Load(object sender, EventArgs e)
        {
            if (Session["nombreenlace"] == null || Session["MenuUsuario"]==null)
            {
                redireccionar();
            }
            LblUsuario.Text = Session["nombreenlace"].ToString();

            if (!IsPostBack)
            {
                if (Session["UsuarioId"] == null || Session["MenuUsuario"] == null)
                {
                    redireccionar();
                }

                if (ASPxMenu1.Items.Count == 0 && Session["MenuUsuario"] != null)
                {
                    crearMenu();
                }

                if (ASPxMenu1.Items.Count == 0 && Session["MenuUsuario"] == null)
                {
                    ASPxMenu1.Items.Add(agregarOpcionMenu(null));
                }
                LblUsuario.Text = Session["nombreenlace"].ToString();
            }
        }

        private void crearMenu()
        {
            DataRow[] MenuUsuario = ((DataTable)(Session["MenuUsuario"])).Select("visible = True", "padre, orden");

            Dictionary<string, DevExpress.Web.ASPxMenu.MenuItem> menuItems =
                new Dictionary<string, DevExpress.Web.ASPxMenu.MenuItem>();

            //Recorriendo registros de accesos de usuario
            for (int i = 0; i < MenuUsuario.Length; i++)
            {
                //Obtiene registro por registro
                //DataRow row = MenuUsuario.Rows[i];
                DataRow row = MenuUsuario[i];
                DevExpress.Web.ASPxMenu.MenuItem item = agregarOpcionMenu(row);
                string itemID = row["idMenu"].ToString();
                string parentID = row["padre"].ToString();

                //Busca el padre el menú para asignar los hijos.
                if (menuItems.ContainsKey(parentID))
                    menuItems[parentID].Items.Add(item);
                else
                {
                    // Si es padre solo se crea.
                    if (parentID == "0")
                        ASPxMenu1.Items.Add(item);
                }
                menuItems.Add(itemID, item);
            }
            ASPxMenu1.Items.Add(agregarOpcionMenu(null));
        }

        private DevExpress.Web.ASPxMenu.MenuItem agregarOpcionMenu(DataRow row)
        {
            //Define variable de tipo MenuItem de DevExpress
            DevExpress.Web.ASPxMenu.MenuItem ret = new DevExpress.Web.ASPxMenu.MenuItem();

            if (row != null)
            {
                //Asigna texto a mostrar en el menú
                ret.Text = row["Acceso"].ToString();
                //Asigna ruta de acceso al item nuevo.
                ret.NavigateUrl = row["URL"].ToString();

                if (ret.Text == "Inicio") {
                    ret.Image.Url="~/Imagenes/homepage.png";
                }
                if (ret.Text == "Parámetros" || ret.Text == "Usuarios" || ret.Text == "Ubicación" || ret.Text == "General")
                {
                    ret.Image.Url = "~/Imagenes/mantenimiento.png";
                }
                if (ret.Text == "Reportes Varios" || ret.Text == "Reportes Detallados")
                {
                    ret.Image.Url = "~/Imagenes/report.png";
                }
                if (ret.Text == "Reportes CNBS")
                {
                    ret.Image.Url = "~/Imagenes/cn.png";
                }
                if (ret.Text == "Reportes CNBS")
                {
                    ret.Image.Url = "~/Imagenes/cn.png";
                }
                //if (ret.Text == "Salir")
                //{
                //    ret.Image.Url = "~/Imagenes/Log Off.png";
                //}
            }
            else
            {
                //Asigna texto a mostrar en el menú
                ret.Text = "Salir";
                ret.Image.Url = "~/Imagenes/Log Off.png";
                //Asigna ruta de acceso al item nuevo.
                ret.NavigateUrl = "~/Transacciones/Login.aspx";
            }
            return ret;
        }

        private void redireccionar()
        {
            try
            {
                if (!Page.IsCallback)
                {
                    Response.Redirect("~/Transacciones/Login.aspx");
                }
                else
                {
                    Response.Redirect("~/Transacciones/Login.aspx");
                }
            }
            catch (Exception)
            {
                Response.Redirect("~/Transacciones/Login.aspx");
            }
        }

    }
}





