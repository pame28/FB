-- Usuarios de la BD sin login asociado
SELECT dp.name, dp.sid
FROM sys.database_principals dp
LEFT JOIN sys.server_principals sp ON dp.sid = sp.sid
WHERE sp.sid IS NULL
  AND dp.type IN ('S','U')
  AND dp.authentication_type_desc = 'INSTANCE';





