import { ChevronLeft, ChevronRight } from "lucide-react";
import styles from "./DataTable.module.css";

/**
 * <DataTable
 *   columns={[{ key, header, render?: (row) => node, align?, width? }]}
 *   rows={[...]}
 *   rowKey="id"
 *   loading={false}
 *   pagination={{ page, pageSize, totalCount, totalPages, onPageChange }}   // opcional
 *   onRowClick={(row) => {}}   // opcional: filas seleccionables
 *   selectedKey={id}           // opcional: fila resaltada
 *   maxHeight={420}            // opcional: scroll vertical con encabezado fijo
 * />
 */
export function DataTable({
  columns,
  rows = [],
  rowKey = "id",
  loading = false,
  emptyMessage = "No hay registros para mostrar.",
  pagination,
  onRowClick,
  selectedKey,
  maxHeight,
}) {
  const getKey = (row, i) => (typeof rowKey === "function" ? rowKey(row) : row[rowKey]) ?? i;
  const clickable = Boolean(onRowClick);

  const handleKeyDown = (e, row) => {
    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      onRowClick(row);
    }
  };

  return (
    <div className={styles.wrapper}>
      <div className={styles.scroll} style={maxHeight ? { maxHeight, overflowY: "auto" } : undefined}>
        <table className={styles.table}>
          <thead>
            <tr>
              {columns.map((col) => (
                <th key={col.key} style={{ width: col.width, textAlign: col.align }}>
                  {col.header}
                </th>
              ))}
            </tr>
          </thead>

          <tbody>
            {loading ? (
              Array.from({ length: 5 }, (_, i) => (
                <tr key={`skeleton-${i}`}>
                  {columns.map((col) => (
                    <td key={col.key}><span className={styles.skeleton} /></td>
                  ))}
                </tr>
              ))
            ) : rows.length === 0 ? (
              <tr>
                <td colSpan={columns.length} className={styles.empty}>{emptyMessage}</td>
              </tr>
            ) : (
              rows.map((row, i) => {
                const key = getKey(row, i);
                const selected = selectedKey != null && key === selectedKey;
                return (
                  <tr
                    key={key}
                    className={`${clickable ? styles.clickable : ""} ${selected ? styles.selected : ""}`}
                    onClick={clickable ? () => onRowClick(row) : undefined}
                    onKeyDown={clickable ? (e) => handleKeyDown(e, row) : undefined}
                    tabIndex={clickable ? 0 : undefined}
                    aria-selected={clickable ? selected : undefined}
                  >
                    {columns.map((col) => (
                      <td key={col.key} style={{ textAlign: col.align }}>
                        {col.render ? col.render(row) : row[col.key] ?? "—"}
                      </td>
                    ))}
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>

      {pagination && pagination.totalCount > 0 && <Pagination {...pagination} />}
    </div>
  );
}

function Pagination({ page, pageSize, totalCount, totalPages, onPageChange }) {
  const from = (page - 1) * pageSize + 1;
  const to = Math.min(page * pageSize, totalCount);

  return (
    <div className={styles.pagination}>
      <span>Mostrando {from}–{to} de {totalCount}</span>

      <div className={styles.pager}>
        <button type="button" className={styles.pageBtn} onClick={() => onPageChange(page - 1)}
          disabled={page <= 1} aria-label="Página anterior">
          <ChevronLeft size={16} />
        </button>
        <span className={styles.pageInfo}>Página {page} de {Math.max(totalPages, 1)}</span>
        <button type="button" className={styles.pageBtn} onClick={() => onPageChange(page + 1)}
          disabled={page >= totalPages} aria-label="Página siguiente">
          <ChevronRight size={16} />
        </button>
      </div>
    </div>
  );
}









