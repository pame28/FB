		#region Transformacion de filas
		/// <summary>
		/// Mapea una fila de AS400 (106 columnas) a la fila destino (108 columnas):
		/// inserta larId en la posicion 105 y ProcesadorOrigen al final.
		/// El TRIM ya viene resuelto desde la consulta de AS400 (los textos sin valor llegan como cadena vacia).
		/// </summary>
		private void LlenarFila(object[] origen, object[] destino, Type[] tipos, string[] nombres)
		{
			for (int i = 0; i < PosicionLarId; i++)
				destino[i] = Convertir(origen[i], tipos[i], nombres[i]);

			destino[PosicionLarId] = _larId;

			for (int i = PosicionLarId; i < ColumnasOrigen; i++)
				destino[i + 1] = Convertir(origen[i], tipos[i + 1], nombres[i + 1]);

			destino[ColumnasDestino - 1] = ProcesadorOrigen;

			// Reglas de negocio que ya tenia el proceso de Eusuarios
			destino[ColFactorLimiteCompraCuotas] = AjustarFactor(destino[ColFactorLimiteCompraCuotas]);
			destino[ColGrupoAfinidad] = RecortarTexto(destino[ColGrupoAfinidad], MaxLongitudGrupoAfinidad);
		}

		/// <summary>
		/// Conversion tipada.
		/// - Numericos de AS400 (decimal) a decimal/int/short/byte sin pasar por texto.
		/// - Numerico de AS400 hacia columna texto (GrupoAfinidad): ToString invariante.
		/// - Texto hacia columna numerica (FormaPago): vacio = NULL, si no se convierte.
		/// - Fechas: yyyy-MM-dd; invalida o menor a 1900 = 1900-01-01 (comportamiento anterior).
		/// </summary>
		private static object Convertir(object valor, Type destino, string columna)
		{
			if (valor == null || valor == DBNull.Value)
				return DBNull.Value;

			string texto = valor as string;
			if (texto != null)
			{
				if (destino == typeof(string))
					return texto;

				if (destino == typeof(DateTime))
					return ConvertirFecha(texto);

				if (texto.Trim().Length == 0)
					return DBNull.Value;

				try
				{
					return Convert.ChangeType(texto.Trim(), destino, CultureInfo.InvariantCulture);
				}
				catch (Exception ex)
				{
					throw new FormatException("El valor '" + texto + "' no se puede convertir a " + destino.Name +
											  " para la columna '" + columna + "': " + ex.Message, ex);
				}
			}

			if (destino == typeof(string))
				return Convert.ToString(valor, CultureInfo.InvariantCulture);

			if (destino == typeof(decimal))
				return Convert.ToDecimal(valor);

			if (destino == typeof(int) || destino == typeof(short) || destino == typeof(byte))
			{
				decimal d = Convert.ToDecimal(valor);
				try
				{
					return Convert.ChangeType(d, destino);
				}
				catch (OverflowException)
				{
					throw new OverflowException("El valor " + d + " no cabe en " + destino.Name + " (columna '" + columna + "').");
				}
			}

			return valor;
		}

		private static DateTime ConvertirFecha(string texto)
		{
			DateTime fecha;
			if (!DateTime.TryParseExact(texto, FormatoFecha, CultureInfo.InvariantCulture, DateTimeStyles.AllowWhiteSpaces, out fecha) &&
				!DateTime.TryParse(texto, out fecha))
				return FechaMinima;

			return fecha.Year < 1900 ? FechaMinima : fecha;
		}

		// Redondeo a 1 decimal (alejandose de cero) y limite -99.9 .. 99.9
		private static object AjustarFactor(object valor)
		{
			if (!(valor is decimal))
				return valor;

			decimal factor = Math.Round((decimal)valor, 1, MidpointRounding.AwayFromZero);
			return Math.Min(Math.Max(factor, -99.9m), 99.9m);
		}

		private static object RecortarTexto(object valor, int maximo)
		{
			string texto = valor as string;
			if (texto == null || texto.Length <= maximo)
				return valor;
			return texto.Substring(0, maximo);
		}

