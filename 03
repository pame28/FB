        public bool EjecutarBulkInsertBandejaVasa(DataTable tableCuentas)
        {
            ConnectionManager cm = Dts.Connections["BANDEJAVASA"];
            SqlConnection conn = null;

            try
            {
                conn = cm.AcquireConnection(null) as SqlConnection;
                if (conn == null)
                {
                    throw new InvalidOperationException("No se pudo obtener la conexión desde el Connection Manager.");
                }

                using (SqlBulkCopy bulkCopy = new SqlBulkCopy(conn))
                {
                    bulkCopy.DestinationTableName = parametros["ArchivoDestino"];
                    bulkCopy.WriteToServer(tableCuentas);
                }

                return true;

            }


            catch (Exception ex)
            {
                RegistraProceso("F", $"Falló bulkInsert {parametros["ArchivoDestino"]}  con error {ex.Message.ToString()}");

                return false;
            }
            finally
            {
                if (conn != null)
                    cm.ReleaseConnection(conn);
            }
        }

        public bool UpdateArchivoAS400()
