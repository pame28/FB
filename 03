export const UsuariosRolesPage = () => {
  const catalogs = useCatalogs();

  const [filters, setFilters] = useState(EMPTY_FILTERS);
  const search = useDebounce(filters.search, 400);
  const [page, setPage] = useState(1);

  const [result, setResult] = useState({ items: [], totalCount: 0, totalPages: 0, pageSize: PAGE_SIZE });
  const [stats, setStats] = useState({ active: null, inactive: null });
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [notice, setNotice] = useState("");
  const [exporting, setExporting] = useState(null); // "excel" | "pdf" | null
  const [reloadKey, setReloadKey] = useState(0);

  // Formulario: open + user (null = crear, objeto = editar)
  const [form, setForm] = useState({ open: false, user: null });

  // Eliminar
  const [toDelete, setToDelete] = useState(null);
  const [deleting, setDeleting] = useState(false);
  const [deleteError, setDeleteError] = useState("");

  // Filtros en el formato que espera la API
  const request = useMemo(() => ({
    search: search.trim() || undefined,
    roleId: toNumber(filters.roleId),
    companyAreaId: toNumber(filters.companyAreaId),
    companyPositionId: toNumber(filters.companyPositionId),
    status: toNumber(filters.status),
  }), [search, filters.roleId, filters.companyAreaId, filters.companyPositionId, filters.status]);

  const hasFilters = Object.values(filters).some((v) => v !== "");

  // Lista de usuarios
  useEffect(() => {
    let cancelled = false;
    setLoading(true);
    setError("");

    usersService
      .filter({ ...request, pageNumber: page, pageSize: PAGE_SIZE })
      .then((data) => { if (!cancelled) setResult(data); })
      .catch((err) => {
        if (!cancelled) setError(err.noAccess
          ? "No tienes permiso para ver la lista de usuarios."
          : "No se pudo cargar la lista de usuarios. Intenta de nuevo.");
      })
      .finally(() => { if (!cancelled) setLoading(false); });

    return () => { cancelled = true; };
  }, [request, page, reloadKey]);

  // Tarjetas: usan los mismos filtros que la tabla
  useEffect(() => {
    let cancelled = false;

    const count = (status) =>
      usersService
        .filter({ ...request, status, pageNumber: 1, pageSize: 1 })
        .then((d) => d.totalCount)
        .catch(() => null);

    // Si ya se filtró por un estado, el otro estado es 0 sin necesidad de consultar
    const applies = (status) => request.status === undefined || request.status === status;

    Promise.all([
      applies(USER_STATUS.ACTIVO) ? count(USER_STATUS.ACTIVO) : 0,
      applies(USER_STATUS.INACTIVO) ? count(USER_STATUS.INACTIVO) : 0,
    ]).then(([active, inactive]) => {
      if (!cancelled) setStats({ active, inactive });
    });

    return () => { cancelled = true; };
  }, [request, reloadKey]);

  // El aviso de éxito desaparece solo
