        private void EnviarCorreoAlerta(List<string> diferencias)
        {
            string cuerpo = "Se encontraron diferencias en ModelosLiquidacion:\n\n";
            string destinatarios = parametros["MailTo"];

            foreach (var dif in diferencias)
            {
                cuerpo += dif + "\n";
            }


            using (var mail = new MailMessage())
            {
                mail.From = new MailAddress(parametros["MailFrom"]);
                foreach(var correo in destinatarios.Split(';'))
                {
                    mail.To.Add(correo.Trim());
                }

                mail.Subject = parametros["MailSubject"];
                mail.Body = cuerpo;

                using (var smtp = new SmtpClient(parametros["MailServer"]))
                {

                    smtp.Send(mail);
                }
            }
        }

        private void ActualizarModelo(ModelosLiquidacion modeloDb2)
        {
            ConnectionManager cm = Dts.Connections["BANDEJAVASA"];
            SqlConnection conn = null;

            try
            {
                conn = cm.AcquireConnection(null) as SqlConnection;
                if (conn == null)
                {
                    throw new InvalidOperationException("No se pudo obtener la conexión desde el Connection Manager.");
                }

                using (SqlCommand cmd = conn.CreateCommand())
                {
                    cmd.CommandText = parametros["ConsultUpdate"];

                    cmd.Parameters.AddWithValue("@TasaML", modeloDb2.TASAML);
                    cmd.Parameters.AddWithValue("@TasaUSD", modeloDb2.TASAUSD);
                    cmd.Parameters.AddWithValue("@ModeloLiquidacion", modeloDb2.MODELOLIQUIDACION);

                    cmd.ExecuteNonQuery();
                }
            }
            catch (Exception ex)
            {
                RegistraProceso("F", $"Error al actualizar modelo {modeloDb2.MODELOLIQUIDACION}: {ex.Message}");
            }
            finally
            {
                if (conn != null)
                    cm.ReleaseConnection(conn);
            }
        }


        public bool validaDiferencias(List<ModelosLiquidacion> modelosAS400, List<ModelosLiquidacion> modelosSQL)
        {
            try
            {
                bool exito = false;
                var diferencias = new List<string>();

                foreach (var modeloDb2 in modelosAS400)
                {
                    var modeloSql = modelosSQL.Find(m => m.MODELOLIQUIDACION == modeloDb2.MODELOLIQUIDACION);

                    if (modeloSql == null)
                    {
                        diferencias.Add($"Modelo {modeloDb2.MODELOLIQUIDACION} existe en core pero no en ParModelosLiquidacion.");
                    }
                    else
                    {
                        if (modeloDb2.TASAML != modeloSql.TASAML || modeloDb2.TASAUSD != modeloSql.TASAUSD)
                        {
                            diferencias.Add($"Modelo {modeloDb2.MODELOLIQUIDACION} difiere en tasas. Core: ML={modeloDb2.TASAML}, USD={modeloDb2.TASAUSD} | ParModelosLiquidacion: ML={modeloSql.TASAML}, USD={modeloSql.TASAUSD}");

                            if (parametros["PrismaActivo"] == "true")
                            {
                                ActualizarModelo(modeloDb2);
                            }
                        }
                    }
                }

                if (diferencias.Count > 0)
                {
                    EnviarCorreoAlerta(diferencias);
                }

                exito = true;
                return exito;
                
            }
            catch (Exception ex)
            {
                RegistraProceso("F", $"Error en comparación: {ex.Message}");
                return false;
            }

        }




