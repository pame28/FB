ALTER PROCEDURE [dbo].[usp_ReporteDemandaJuicioEjecucion] --'2025-1-1', '2025-7-1'
	@fecha_inicio DATE = NULL
	,@fecha_fin DATE = NULL
AS
BEGIN

    SET NOCOUNT ON;

	IF(@fecha_inicio IS NOT NULL AND @fecha_fin IS NOT NULL)
	BEGIN
		SELECT 
		Id_RegistroDemanda, 
		NumeroDemanda, 
		NaturalezaDemanda, 
		REPLACE(CONVERT(DATE,FechaPresentacion), '-', '/') AS FechaPresentacion,
		NombreDemandado,
		NombreDemandante, 
		MontoDemandado, 
		TipoGarantia,
		ProcuradorAsignado, 
		MotivoDemanda, 
		JuzgadoDemanda, 
		AccionInstitucion,
		Zona, 
		FechaActuacion, 
		ProbabilidadPerdida 
		FROM tblRegistroDemandasJuiciosEjecucion 
	WHERE CONVERT(DATE,FechaPresentacion) BETWEEN @fecha_inicio AND @fecha_fin
	END
END






