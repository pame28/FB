                    int rowsAffected = cmd.ExecuteNonQuery();

                    if (rowsAffected == 0)
                    {
                        return false;
                    }
                }

            }
            catch (Exception ex)
            {

                RegistraProceso("F", $"Falló actualizar estado archivo: {parametros["ArchivoControl"]}  con error {ex.Message.ToString()}");

                Dts.TaskResult = (int)ScriptResults.Failure;

