        protected void Page_Load(object sender, EventArgs e)
        {
            if (Session["usuarioid"] == null)
            {
                Response.Redirect("~/Transacciones/Login.aspx");
            }

            if (!Page.IsPostBack)
            {
                GridView1.SelectedIndex = 0;
            }
            else
            {
                if (DetailsView2.CurrentMode == DetailsViewMode.Insert)
                {
                    string a = SqlDataSourceAreas.SelectParameters["empresaid"].DefaultValue;
                    Session["empresaid"] = ((DropDownList)DetailsView2.FindControl("DropDownEmpresa3")).SelectedValue;
                }
            }

            if (Convert.ToInt32(Session["privilegioid"]) != 1)
            {
                GridView1.Visible = false;
                DetailsView1.Visible = false;
                LblError.Visible = true;
                LblError.ForeColor = System.Drawing.Color.Red;
                LblError.Text = "NO TIENE PERMISOS PARA INGRESAR A ESTE MANTENIMIENTO.";
            }
            else
            {
                LblError.Visible = false;
            }
        }

        protected void ImageButton1_Click(object sender, ImageClickEventArgs e)
        {
            String filtro = "";
            for (int i = 0; i < TxtFiltro.Text.Length; i++)
            {
                if (TxtFiltro.Text.Substring(i, 1) != "'" & TxtFiltro.Text.Substring(i, 1) != "[" & TxtFiltro.Text.Substring(i, 1) != "]" & TxtFiltro.Text.Substring(i, 1) != "}" & TxtFiltro.Text.Substring(i, 1) != "{")
                {
                    filtro += TxtFiltro.Text.Substring(i, 1);
                }
            }
            SqlDataSource1.FilterExpression = string.Format("nombreenlace like '%{0}%'", filtro);
        }

