.personChip {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  border: 1px solid #e6ebf1;
  border-radius: 12px;
  background: #f8fafc;
}

.personAvatar {
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--bp-blue-expert);
  color: #fff;
  font-size: 14px;
  font-weight: 800;
}

.personInfo { display: flex; flex-direction: column; gap: 2px; min-width: 0; }

.personName {
  font-size: 14.5px;
  font-weight: 700;
  color: var(--bp-blue-expert);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.personMeta {
  font-family: ui-monospace, "Cascadia Mono", Consolas, monospace;
  font-size: 12.5px;
  color: #8592a3;
}









const initials = (u) => `${u.firstName?.[0] ?? ""}${u.lastName?.[0] ?? ""}`.toUpperCase();






